{
    "name": "cxvm",
    "version": "2.0.21",
    "description": "cxvm v2: Fullstack Cross-Platform Cex Distribution Engine & Runtime Version Manager (Pure Cex: cexr + cexp, zero C++ dependency), powered by Lighting MVC",
    "main": "src/index.cex",
    "author": "2-TEK Ecosystem",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/2-tek/cxvm.git"
    },
    "homepage": "https://github.com/2-tek/cxvm#readme",
    "bugs": "https://github.com/2-tek/cxvm/issues",
    "runtime": "v8",
    "target": "runtime",
    "required": {
        "cexr": "^8",
        "cexp": ">= 6",
        "cxvm": ">= v8"
    },
    "alias": {
        "@": ".",
        "@/src": "./src"
    },
    "thunder": {
        "output": [
            {
                "container": 3080,
                "out": 3080,
                "name": "cxvm"
            }
        ]
    },
    "scripts": {
        "install": "cex-pack downloads",
        "downloads": "cex-pack downloads",
        "dev": "cxvm dev",
        "lint": "cxvm lint",
        "test": "cxvm --app test run",
        "run": "cxvm --app cexr run",
        "cexr": "cxvm --app cexr",
        "build:auto": "cxvm build",
        "build:thunder": "cxvm --app thunder build",
        "build:cexp": "cxvm build cexp all",
        "build:cexr": "cxvm build cexr all",
        "build:toolchain": "cxvm build toolchain all",
        "thunder": "cxvm --app thunder",
        "thunder:start": "cxvm start thunder",
        "thunder:stop": "cxvm stop thunder",
        "thunder:status": "cxvm status thunder",
        "thunder:build": "cxvm --app thunder build",
        "thunder:ps": "cxvm --app thunder ps",
        "thunder:images": "cxvm --app thunder images",
        "thunder:stats": "cxvm --app thunder stats",
        "docker": "cxvm docker",
        "start": "cxvm start",
        "build": "cxvm --app cli build",
        "cli": "cxvm --app cli",
        "cli:dev": "cxvm light dev",
        "cli:build": "cxvm --app cli build",
        "cli:start": "cxvm start",
        "cli:test": "cxvm --app test run",
        "cli:doctor": "cxvm --app cli doctor",
        "cli:thunder": "cxvm --app thunder",
        "doctor": "cxvm doctor",
        "watch": "cxvm watch",
        "agents": "cxvm agents",
        "lint:fix": "cxvm lint --fix",
        "racer": "cxvm racer",
        "racer:status": "cxvm racer status",
        "racer:queues": "cxvm racer queues",
        "runners": "cxvm runner",
        "multi:build": "cxvm multi build",
        "multi:start": "cxvm multi start",
        "multi:process": "cxvm multi process",
        "migrate:app-alias": "bash scripts/migrate_cxvm_app_alias.sh --fix"
    },
    "dependencies": {
        "cex-env": "1.0.0",
        "cex-logger": "1.0.0",
        "cex-test": "1.0.0",
        "cex-service": "1.0.0",
        "cex-lint": "1.0.0",
        "cex-pack": "1.0.0",
        "cex-cli": "1.0.1",
        "cex-racer": "1.0.0",
        "cex-runners": "1.0.0",
        "cex-log": "1.0.0"
    },
    "includeDirs": ["./src"],
    "lint": {
        "onBuild": true,
        "onDev": true,
        "include": ["src", "tests"],
        "rules": {
            "indent": {
                "level": "error",
                "size": 4
            },
            "quotes": {
                "level": "error",
                "style": "double"
            },
            "semi": "error",
            "no-tabs": "error",
            "no-trailing-spaces": "error",
            "eol-last": "error",
            "no-duplicate-imports": "error",
            "class-name-case": "error"
        }
    }
}
