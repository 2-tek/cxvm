{
    "name": "@2tek/cxvm",
    "version": "2.1.43",
    "description": "cxvm v2: Fullstack Cross-Platform Cex Distribution Engine & Runtime Version Manager (Pure Cex: cexr + cexp, zero C++ dependency), powered by Lighting MVC",
    "main": "src/index.cex",
    "author": "2-TEK Ecosystem",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/2-tek/cxvm.git"
    },
    "homepage": "https://github.com/2-tek/cxvm#readme",
    "bugs": "https://github.com/2-tek/cxvm/issues",
    "runtime": "cexr-factory",
    "target": "runtime",
    "alias": {
        "@": ".",
        "@/src": "./src"
    },
    "required": {
        "cexp": "^8",
        "cexp-v8-stable": "^8",
        "cexp-v8": "^8",
        "cexr-bean": "^1",
        "cexr-factory": "^1"
    },
    "scripts": {
        "install": "cex-pack downloads",
        "downloads": "cex-pack downloads",
        "dev": "cexr-factory src/index.cex",
        "start": "cexr-bean src/index.cex",
        "build": "cexp-v8-stable build src/index.cex -o .bin",
        "lint": "cex-lint fix .",
        "test": "cext tests/install.test.cex"
    },
    "dependencies": {
        "cex-test": "2.0.0",
        "mvc-lighting": "6.1.10",
        "cex-std": "2.0.0",
        "cex-log": "2.0.0",
        "cex-lint": "2.0.0",
        "cex-pack": "2.0.0",
        "cex-cli": "2.0.0",
        "cex-cvm-cli": "2.0.0",
        "cex-builder": "2.0.0",
        "builder": "2.0.0"
    },
    "includeDirs": [
        "./src"
    ],
    "lint": {
        "onBuild": true,
        "include": [
            "src",
            "tests"
        ],
        "rules": {
            "indent": {
                "level": "error",
                "size": 4
            },
            "quotes": {
                "level": "error",
                "style": "double"
            },
            "semi": "error",
            "no-tabs": "error",
            "no-trailing-spaces": "error",
            "eol-last": "error",
            "no-duplicate-imports": "error",
            "class-name-case": "error"
        }
    }
}
