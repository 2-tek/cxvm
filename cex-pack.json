  "bugs": "https://github.com/2-tek/cxvm/issues",
  "target": "runtime",
  "required": {
    "cexr": "^8",
    "cexp": "^8"
  },
  "dependencies": {
    "@cex-test": "1.0.0",
    "@cex-service": "1.0.0",
