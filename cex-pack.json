{
    "name": "@2tek/cxvm",
    "version": "2.1.34",
    "description": "cxvm v2: Fullstack Cross-Platform Cex Distribution Engine & Runtime Version Manager (Pure Cex: cexr + cexp, zero C++ dependency), powered by Lighting MVC",
    "main": "src/index.cex",
    "author": "2-TEK Ecosystem",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/2-tek/cxvm.git"
    },
    "homepage": "https://github.com/2-tek/cxvm#readme",
    "bugs": "https://github.com/2-tek/cxvm/issues",
    "runtime": "v8",
    "target": "runtime",
    "alias": {
        "@": ".",
        "@/src": "./src"
    },
    "required": {
        "cexp": "^8",
        "cexr-bean": "^1",
        "cexr-factory": "^1",
        "cexp-v8": "^8"
    },
    "scripts": {
        "install": "cex-pack downloads",
        "downloads": "cex-pack downloads",
        "dev": "cxvm --app cexr-factory src/index.cex",
        "start": "cxvm --app cexr-bean src/index.cex",
        "build": "cxvm --app cexr-bean src/index.cex",
        "lint": "cxvm --app cex-lint fix .",
        "test": "cxvm --app cext run tests/cxvm.test.cex"
    },
    "dependencies": {
        "cex-test": "1.0.0",
        "cex-service": "1.0.0",
        "cex-log": "1.0.0",
        "cex-lint": "1.0.0",
        "cex-pack": "1.1.0",
        "cex-cli": "1.0.0"
    },
    "includeDirs": ["./src"],
    "lint": {
        "onBuild": true,
        "include": ["src", "tests"],
        "rules": {
            "indent": {
                "level": "error",
                "size": 4
            },
            "quotes": {
                "level": "error",
                "style": "double"
            },
            "semi": "error",
            "no-tabs": "error",
            "no-trailing-spaces": "error",
            "eol-last": "error",
            "no-duplicate-imports": "error",
            "class-name-case": "error"
        }
    }
}
