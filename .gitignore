# Cex runtime cache & active states
.cex_cache/
.cex_active_runtime

# Binaries and build outputs
bin/*
!bin/.gitkeep
!bin/.cvmkeep
!bin/cex
!bin/cexr
!bin/cxvm
!bin/*.cmd
!bin/*.ps1
!bin/cex-pack
!bin/*/
!bin/**/cex-pack
!bin/**/cex-pack.cmd
!bin/**/.gitkeep
!bin/**/.cvmkeep
**/bin/*
!**/bin/.gitkeep
!**/bin/.cvmkeep
!**/bin/*/
!**/bin/*/.gitkeep
!**/bin/*/.cvmkeep
!**/bin/cex-pack
!**/bin/cex-pack.cmd
!**/bin/*/cex-pack
!**/bin/*/cex-pack.cmd
*.bin
*.out
# Rule 69: target is runtime, do not use .gitignore for dist bundle file (keep dist/ with download of cxvm cross platforms)

# Modular box cache (.cex_boxes & cex_boxes)
.cex_boxes
.cex_boxes/
**/.cex_boxes
**/.cex_boxes/
cex_boxes
cex_boxes/
**/cex_boxes
**/cex_boxes/

# Native compiled artifacts
*.o
*.obj
*.so
*.dylib
*.a

# OS & Logs
.DS_Store
*.log
packages/*
downloads/
