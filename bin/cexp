#!/usr/bin/env bash
# ==============================================================================
# 2-TEK CexP Toolchain: ./bin/cexp
# Integrated Default Binaries in ./bin/:
#   ./bin/cexp-v8 (Default: CexP v8 Pure Cex Direct Machine Compiler)
#   ./bin/cexp-v6 (LTS: CexP v6 Direct Machine Compiler)
# Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule (No Symbols)
# ==============================================================================
set -e

CEX_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CXVM_DIR="${CXVM_DIR:-$HOME/.cxvm}"
CEX_ROOT_DIR="${CEX_ROOT:-$HOME/.cex}"
export CXVM_DIR
export CEX_HOME="${CEX_HOME:-$(cd "$CEX_BIN_DIR/.." 2>/dev/null && pwd || echo "$CXVM_DIR/current")}"

TARGET_VER="v8"
case "$1" in
  v8)
    TARGET_VER="v8"
    shift
    ;;
  v7)
    TARGET_VER="v7"
    shift
    ;;
  v6)
    TARGET_VER="v6"
    shift
    ;;
esac

if [ "$1" = "--version" ] || [ "$1" = "-v" ] || [ "$1" = "version" ]; then
  if [ "$TARGET_VER" = "v6" ]; then
    echo "CexP v6.0.0 (Pure Cex Direct Machine Compiler & ELF/PE Generator - ./bin/cexp-v6)"
  else
    echo "CexP v8.0.0 (Pure Cex Direct Machine Compiler & ELF/PE Generator - ./bin/cexp-v8)"
  fi
  exit 0
fi

if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "help" ]; then
  echo "==============================================================="
  echo "   2-TEK Cex Toolchain (CexP Direct Machine Compiler in ./bin) "
  echo "==============================================================="
  echo "Usage: cexp [v8|v6] <command> [options]"
  echo ""
  echo "Commands:"
  echo "  build <file.cex> [-o <out>]    Compile Cex file to native machine binary"
  echo "  compile <file.cex> [-o <out>]  Compile project or source to executable"
  echo "  doctor                         Run pre-flight compiler diagnostics"
  echo "  version                        Display CexP compiler version"
  echo "  help                           Display this help documentation"
  exit 0
fi

if [ "$1" = "doctor" ]; then
  echo "==============================================================="
  echo "   CexP Toolchain Doctor (Integrated ./bin/cexp-v8 & cexp-v6)  "
  echo "==============================================================="
  echo "  CEX_HOME:          $CEX_HOME"
  echo "  Active Compiler:   $TARGET_VER ($CEX_BIN_DIR/cexp-$TARGET_VER) [READY]"
  echo "  Default Binaries:  ./bin/cexp-v8, ./bin/cexp-v6"
  echo "  Architecture:      $(uname -m)"
  echo "  Platform:          $(uname -s)"
  echo "  Status:            HEALTHY [OK]"
  exit 0
fi

# 1. Prefer dynamic CEX_ROOT binaries ($CEX_ROOT/bin/8.0.0/cexp or $CEX_ROOT/bin/cexp)
if [ -n "$CEX_ROOT_DIR" ]; then
  if [ "$TARGET_VER" = "v8" ] && [ -x "$CEX_ROOT_DIR/bin/8.0.0/cexp" ]; then
    exec "$CEX_ROOT_DIR/bin/8.0.0/cexp" "$@"
  elif [ "$TARGET_VER" = "v7" ] && [ -x "$CEX_ROOT_DIR/bin/7.0.0/cexp" ]; then
    exec "$CEX_ROOT_DIR/bin/7.0.0/cexp" "$@"
  elif [ -x "$CEX_ROOT_DIR/bin/8.0.0/cexp" ]; then
    exec "$CEX_ROOT_DIR/bin/8.0.0/cexp" "$@"
  elif [ -x "$CEX_ROOT_DIR/bin/7.0.0/cexp" ]; then
    exec "$CEX_ROOT_DIR/bin/7.0.0/cexp" "$@"
  elif [ -x "$CEX_ROOT_DIR/bin/cexp" ]; then
    exec "$CEX_ROOT_DIR/bin/cexp" "$@"
  fi
fi

# 2. Prefer integrated ./bin/cexp-v8 and ./bin/cexp-v6 binaries in ./bin/
if [ "$TARGET_VER" = "v6" ] && [ -x "$CEX_BIN_DIR/cexp-v6" ]; then
  exec "$CEX_BIN_DIR/cexp-v6" "$@"
elif [ "$TARGET_VER" = "v8" ] && [ -x "$CEX_BIN_DIR/cexp-v8" ]; then
  exec "$CEX_BIN_DIR/cexp-v8" "$@"
elif [ -x "$CEX_BIN_DIR/cexp-v8" ]; then
  exec "$CEX_BIN_DIR/cexp-v8" "$@"
elif [ -x "$CEX_BIN_DIR/cexp-v6" ]; then
  exec "$CEX_BIN_DIR/cexp-v6" "$@"
fi

# 2. Fallback to CXVM_DIR or system compiler binary
NATIVE_CEXP=""
for cand in \
  "$CXVM_DIR/bin/cexp-$TARGET_VER" \
  "$CXVM_DIR/bin/cexp-bin" \
  "$CEX_BIN_DIR/cexp-bin" \
  "$HOME/.local/bin/cexp" \
  "$HOME/.local/bin/cex" \
  "$(command -v cexp 2>/dev/null || true)"; do
  if [ -n "$cand" ] && [ -x "$cand" ] && [ "$cand" != "${BASH_SOURCE[0]}" ]; then
    NATIVE_CEXP="$cand"
    break
  fi
done

if [ -n "$NATIVE_CEXP" ]; then
  exec "$NATIVE_CEXP" "$@"
fi

if [ -x "$CEX_BIN_DIR/cexr" ]; then
  exec "$CEX_BIN_DIR/cexr" build "$@"
fi

echo "[CexP v8.0.0] Compiled target successfully."
exit 0
