#!/usr/bin/env bash
# 2-TEK CXVM Installed App Launcher: cex-env (v8.0.0)
set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJ_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
RUNNER="$PROJ_ROOT/bin/cexr"
if [ ! -f "$RUNNER" ]; then RUNNER="cexr"; fi
TARGET="$PROJ_ROOT/.cex_boxes/cex-env/src/index.cex"
if [ -f "$TARGET" ]; then
  exec "$RUNNER" "$TARGET" "$@"
else
  exec "$RUNNER" "$@"
fi
