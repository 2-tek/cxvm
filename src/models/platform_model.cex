// 2-TEK Factory: Platform Target Model (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "../lighting_mvc.cex";
import "../types.cex";

class PlatformModel : public BaseModel {
    public os: string;
    public arch: string;
    public targetTriple: string;
    public compiler: string;
    public archiveFormat: string;
    public displayName: string;
    public isSupported: bool;

    public constructor(id: string, os: string, arch: string, triple: string, compiler: string, fmt: string, name: string) {
        super(id);
        this.os = os;
        this.arch = arch;
        this.targetTriple = triple;
        this.compiler = compiler;
        this.archiveFormat = fmt;
        this.displayName = name;
        this.isSupported = true;
    }

    public override validate(): ModelValidationResult* {
        let res: ModelValidationResult* = super.validate();
        if (this.os.length() === 0) {
            res->addError("Platform OS must not be empty");
        }
        if (this.arch.length() === 0) {
            res->addError("Platform architecture must not be empty");
        }
        if (this.targetTriple.length() === 0) {
            res->addError("Target triple must not be empty");
        }
        return res;
    }

    public override toJsonValue(): json_lib::Value* {
        let obj: json_lib::Value* = new json_lib::Value();
        obj->set("id", new json_lib::Value(this.id));
        obj->set("os", new json_lib::Value(this.os));
        obj->set("arch", new json_lib::Value(this.arch));
        obj->set("targetTriple", new json_lib::Value(this.targetTriple));
        obj->set("compiler", new json_lib::Value(this.compiler));
        obj->set("archiveFormat", new json_lib::Value(this.archiveFormat));
        obj->set("displayName", new json_lib::Value(this.displayName));
        obj->set("isSupported", new json_lib::Value(this.isSupported));
        return obj;
    }

    public override toJson(): string {
        return json.stringify(this->toJsonValue());
    }
}
