// 2-TEK Factory: Distribution Artifact Model (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "../lighting_mvc.cex";
import "../types.cex";

class ArtifactModel : public BaseModel {
    public filename: string;
    public version: string;
    public platform: string;
    public arch: string;
    public sizeBytes: int;
    public sha256: string;
    public downloadUrl: string;
    public isBuilt: bool;

    public constructor(fname: string, ver: string, plat: string, arch: string, size: int, hash: string, url: string) {
        super(fname);
        this.filename = fname;
        this.version = ver;
        this.platform = plat;
        this.arch = arch;
        this.sizeBytes = size;
        this.sha256 = hash;
        this.downloadUrl = url;
        this.isBuilt = (size > 0);
    }

    public override validate(): ModelValidationResult* {
        let res: ModelValidationResult* = super.validate();
        if (this.filename.length() === 0) {
            res->addError("Artifact filename must not be empty");
        }
        if (this.sha256.length() === 0) {
            res->addError("SHA256 checksum must not be empty");
        }
        return res;
    }

    public override toJsonValue(): json_lib::Value* {
        let obj: json_lib::Value* = new json_lib::Value();
        obj->set("id", new json_lib::Value(this.id));
        obj->set("filename", new json_lib::Value(this.filename));
        obj->set("version", new json_lib::Value(this.version));
        obj->set("platform", new json_lib::Value(this.platform));
        obj->set("arch", new json_lib::Value(this.arch));
        obj->set("sizeBytes", new json_lib::Value(this.sizeBytes));
        obj->set("sha256", new json_lib::Value(this.sha256));
        obj->set("downloadUrl", new json_lib::Value(this.downloadUrl));
        obj->set("isBuilt", new json_lib::Value(this.isBuilt));
        return obj;
    }

    public override toJson(): string {
        return json.stringify(this->toJsonValue());
    }
}
