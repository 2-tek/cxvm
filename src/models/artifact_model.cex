// 2-TEK Factory: Distribution Artifact Model (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "../lighting_mvc.cex";

class ArtifactModel : BaseModel {
    public filename: string;
    public version: string;
    public platform: string;
    public arch: string;
    public sizeBytes: int;
    public sha256: string;
    public downloadUrl: string;
    public isBuilt: bool;

    public constructor(string fname, string ver, string plat, string arch, int size, string hash, string url) {
        super(fname);
        this.filename = fname;
        this.version = ver;
        this.platform = plat;
        this.arch = arch;
        this.sizeBytes = size;
        this.sha256 = hash;
        this.downloadUrl = url;
        this.isBuilt = (size > 0);
    }

    public override ModelValidationResult* validate() {
        let res: ModelValidationResult* = new ModelValidationResult();
        if (this.id.length() === 0) {
            res->addError("Model ID must not be empty");
        }
        if (this.filename.length() === 0) {
            res->addError("Artifact filename must not be empty");
        }
        if (this.sha256.length() === 0) {
            res->addError("SHA256 checksum must not be empty");
        }
        return res;
    }

    public virtual JsonValue* toJsonValue() {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "id", this.id);
        JsonDoc::setStr(doc, "filename", this.filename);
        JsonDoc::setStr(doc, "version", this.version);
        JsonDoc::setStr(doc, "platform", this.platform);
        JsonDoc::setStr(doc, "arch", this.arch);
        JsonDoc::setNum(doc, "sizeBytes", this.sizeBytes);
        JsonDoc::setStr(doc, "sha256", this.sha256);
        JsonDoc::setStr(doc, "downloadUrl", this.downloadUrl);
        JsonDoc::setBool(doc, "isBuilt", this.isBuilt);
        return doc;
    }

    public override string toJson() {
        let obj: JsonValue* = Json::obj();
        Json::setString(obj, "filename", this.filename);
        Json::setString(obj, "version", this.version);
        Json::setString(obj, "platform", this.platform);
        Json::setString(obj, "arch", this.arch);
        Json::setInt(obj, "sizeBytes", this.sizeBytes);
        Json::setString(obj, "sha256", this.sha256);
        Json::setString(obj, "downloadUrl", this.downloadUrl);
        Json::setBool(obj, "isBuilt", this.isBuilt);
        return Json::stringify(obj);
    }
}
