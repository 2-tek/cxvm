// 2-TEK Factory: Runtime Version Model (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "../lighting_mvc.cex";
import "../types.cex";

class VersionModel extends BaseModel {
    public version: string;
    public channel: string;
    public releaseDate: string;
    public minCpp: string;
    public description: string;
    public isDefault: bool;

    public constructor(ver: string, chan: string, date: string, cpp: string, desc: string, isDef: bool) {
        super("v" + ver);
        this.version = ver;
        this.channel = chan;
        this.releaseDate = date;
        this.minCpp = cpp;
        this.description = desc;
        this.isDefault = isDef;
    }

    public override validate(): ModelValidationResult* {
        let res: ModelValidationResult* = super.validate();
        if (this.version.length() === 0) {
            res->addError("Version number must not be empty");
        }
        if (this.channel !== "STABLE" && this.channel !== "LTS" && this.channel !== "CANARY") {
            res->addError("Channel must be STABLE, LTS, or CANARY");
        }
        return res;
    }

    public virtual toJsonValue(): JsonValue* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "id", this.id);
        JsonDoc::setStr(doc, "version", this.version);
        JsonDoc::setStr(doc, "channel", this.channel);
        JsonDoc::setStr(doc, "releaseDate", this.releaseDate);
        JsonDoc::setStr(doc, "minCpp", this.minCpp);
        JsonDoc::setStr(doc, "description", this.description);
        JsonDoc::setBool(doc, "isDefault", this.isDefault);
        return doc;
    }

    public override toJson(): string {
        return JsonDoc::stringify(this.toJsonValue());
    }
}
