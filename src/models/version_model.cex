// 2-TEK Factory: Runtime Version Model (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "../lighting_mvc.cex";

class VersionModel : BaseModel {
    public string version;
    public string channel;
    public string releaseDate;
    public string minCpp;
    public string description;
    public bool isDefault;

    public constructor(string ver, string chan, string date, string cpp, string desc, bool isDef) {
        super("v" + ver);
        this.version = ver;
        this.channel = chan;
        this.releaseDate = date;
        this.minCpp = cpp;
        this.description = desc;
        this.isDefault = isDef;
    }

    public override ModelValidationResult* validate() {
        ModelValidationResult* res = new ModelValidationResult();
        if (this.id.length() === 0) {
            res->addError("Model ID must not be empty");
        }
        if (this.version.length() === 0) {
            res->addError("Version number must not be empty");
        }
        if (this.channel !== "STABLE" && this.channel !== "LTS" && this.channel !== "CANARY") {
            res->addError("Channel must be STABLE, LTS, or CANARY");
        }
        return res;
    }

    public virtual JsonValue* toJsonValue() {
        JsonValue* doc = JsonDoc::obj();
        JsonDoc::setStr(doc, "id", this.id);
        JsonDoc::setStr(doc, "version", this.version);
        JsonDoc::setStr(doc, "channel", this.channel);
        JsonDoc::setStr(doc, "releaseDate", this.releaseDate);
        JsonDoc::setStr(doc, "minCpp", this.minCpp);
        JsonDoc::setStr(doc, "description", this.description);
        JsonDoc::setBool(doc, "isDefault", this.isDefault);
        return doc;
    }

    public override string toJson() {
        JsonValue* obj = Json::obj();
        Json::setString(obj, "version", this.version);
        Json::setString(obj, "channel", this.channel);
        Json::setString(obj, "releaseDate", this.releaseDate);
        Json::setString(obj, "minCpp", this.minCpp);
        Json::setString(obj, "description", this.description);
        Json::setBool(obj, "isDefault", this.isDefault);
        return Json::stringify(obj);
    }
}
