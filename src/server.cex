// 2-TEK Factory: Production Server Executable (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule (No Symbols)

import "@/src/app.cex";
import "@cex-log/src/log.cex";

typedef FactoryApp FactoryServer;

#define DEFAULT_PORT 3080

fn main(argc: int, argv: char**): int {
    let isDryRun: bool = false;
    let isCheck: bool = false;
    let portEnv: char* = getenv("PORT");
    let port: int = (portEnv != nullptr && string(portEnv).length() > 0) ? atoi(portEnv) : DEFAULT_PORT;

    for (let i: int = 1; i < argc; i++) {
        let arg: string = (string)argv[i];
        if (arg == "--dry-run" || arg == "-d") {
            isDryRun = true;
        } else if (arg == "--check" || arg == "-c") {
            isCheck = true;
        } else if (arg == "--port" && i + 1 < argc) {
            i++;
            port = std::stoi((string)argv[i]);
        }
    }

    if (isDryRun || isCheck) {
        println("[OK] cxvm production server binary integrity check passed (dry-run mode)");
        return 0;
    }

    let app: FactoryApp* = new FactoryApp(port);
    app->start();
    Log::info("[cxvm server] 2-TEK cxvm Server: Production Distribution Engine (Lighting Fullstack MVC)");
    Log::info("[cxvm server] Server Port: " + to_string(app->port));
    Log::info("[cxvm server] Downloads Store: " + app->downloadsDir);
    Log::info("[cxvm server] Active Routes: " + to_string(app->router->getRouteCount()));
    Log::info("[OK] cxvm server initialized successfully");

    return 0;
}
