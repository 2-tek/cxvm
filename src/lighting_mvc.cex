import json from "json";
import "./json.cex";
import "@cex-std/src/filesystem.cex";
import "@cex-std/src/chrono.cex";

using JsonValue = json_lib::Value;

class JsonDocHelper {
    static public JsonValue* obj() {
        JsonValue* v = new JsonValue();
        v->type = json_lib::JsonType::Object;
        return v;
    }

    static public JsonValue* arr() {
        JsonValue* v = new JsonValue();
        v->type = json_lib::JsonType::Array;
        return v;
    }

    static public JsonValue* str(string s) {
        return new JsonValue(s);
    }

    static public JsonValue* num(int n) {
        return new JsonValue(n);
    }

    static public JsonValue* numDouble(double n) {
        return new JsonValue(n);
    }

    static public JsonValue* boolean(bool b) {
        return new JsonValue(b);
    }

    static public JsonValue* parse(string s) {
        return json.parse(s);
    }

    static public string stringify(JsonValue* v) {
        return json.stringify(v);
    }

    static public string stringifyIndent(JsonValue* v, int indent) {
        return json.stringify(v, indent);
    }

    static public void setStr(JsonValue* o, string key, string val) {
        o->set(key, new JsonValue(val));
    }

    static public void setNum(JsonValue* o, string key, int val) {
        o->set(key, new JsonValue(val));
    }

    static public void setDouble(JsonValue* o, string key, double val) {
        o->set(key, new JsonValue(val));
    }

    static public void setBool(JsonValue* o, string key, bool val) {
        o->set(key, new JsonValue(val));
    }

    static public void setVal(JsonValue* o, string key, JsonValue* val) {
        o->set(key, val);
    }

    static public void pushStr(JsonValue* a, string val) {
        a->push(new JsonValue(val));
    }

    static public void pushNum(JsonValue* a, int val) {
        a->push(new JsonValue(val));
    }

    static public void pushVal(JsonValue* a, JsonValue* val) {
        a->push(val);
    }
}

class HttpRequest {
    public method: string;
    public path: string;
    public body: string;
    public contentType: string;
    public queryParams: Array<string>* = new Array<string>();
    public pathParams: Array<string>* = new Array<string>();

    public constructor(string method, string path, string body, string cType) {
        this.method = method;
        this.path = path;
        this.body = body;
        this.contentType = cType;
    }

    public void addQueryParam(string key, string value) {
        this.queryParams->push(key + "=" + value);
    }

    public string getQuery(string key) {
        string prefix = key + "=";
        int count = (int)this.queryParams->length();
        for (int i = 0; i < count; i++) {
            string item = this.queryParams->get(i);
            if (item.find(prefix) == 0) {
                return item.substr((int)prefix.length(), (int)item.length() - (int)prefix.length());
            }
        }
        return "";
    }

    public void addPathParam(string key, string value) {
        this.pathParams->push(key + ":" + value);
    }

    public string getParam(string key) {
        string prefix = key + ":";
        int count = (int)this.pathParams->length();
        for (int i = 0; i < count; i++) {
            string item = this.pathParams->get(i);
            if (item.find(prefix) == 0) {
                return item.substr((int)prefix.length(), (int)item.length() - (int)prefix.length());
            }
        }
        return "";
    }

}

class HttpResponse {
    public statusCode: int;
    public statusMessage: string;
    public contentType: string;
    public body: string;
    public isRedirect: bool = false;
    public redirectUrl: string = "";

    public constructor(int code, string msg, string cType, string body) {
        this.statusCode = code;
        this.statusMessage = msg;
        this.contentType = cType;
        this.body = body;
    }

    static public HttpResponse* ok(string body, string cType) {
        return new HttpResponse(200, "OK", cType, body);
    }

    static public HttpResponse* json(JsonValue* val) {
        return new HttpResponse(200, "OK", "application/json", JsonDocHelper::stringify(val));
    }

    static public HttpResponse* json(string str) {
        return new HttpResponse(200, "OK", "application/json", str);
    }

    static public HttpResponse* html(string htmlBody) {
        return new HttpResponse(200, "OK", "text/html; charset=utf-8", htmlBody);
    }

    static public HttpResponse* notFound(string msg) {
        JsonValue* doc = JsonDocHelper::obj();
        JsonDocHelper::setStr(doc, "error", msg);
        JsonDocHelper::setNum(doc, "statusCode", 404);
        return new HttpResponse(404, "Not Found", "application/json", JsonDocHelper::stringify(doc));
    }

    static public HttpResponse* badRequest(string msg) {
        JsonValue* doc = JsonDocHelper::obj();
        JsonDocHelper::setStr(doc, "error", msg);
        JsonDocHelper::setNum(doc, "statusCode", 400);
        return new HttpResponse(400, "Bad Request", "application/json", JsonDocHelper::stringify(doc));
    }

    static public HttpResponse* redirect(string url) {
        HttpResponse* res = new HttpResponse(302, "Found", "text/plain", "Redirecting to " + url);
        res->isRedirect = true;
        res->redirectUrl = url;
        return res;
    }

    public void display() {
        print("HTTP/1.1 ");
        print(this.statusCode);
        print(" ");
        println(this.statusMessage);
        println("Content-Type: " + this.contentType);
        println("Content-Length: " + std::to_string((int)this.body.length()));
        println("");
        println(this.body);
    }

    public void displayCurl(string method, string url) {
        println("─── Simulated cURL Request ────────────────────────────────────");
        println("> " + method + " " + url + " HTTP/1.1");
        println("< HTTP/1.1 " + std::to_string(this.statusCode) + " " + this.statusMessage);
        println("< Content-Type: " + this.contentType);
        println("< Content-Length: " + std::to_string((int)this.body.length()));
        println("<");
        if (this.body.length() > 200) {
            println(this.body.substr(0, 200) + "\n... [truncated]");
        } else {
            println(this.body);
        }
        println("───────────────────────────────────────────────────────────────");
    }

}

class ViewEngine {
    static public string renderLayout(string title, string bodyContent) {
        string html = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n";
        html += "  <meta charset=\"UTF-8\">\n";
        html += "  <title>" + title + "</title>\n";
        html += "  <style>\n";
        html += "    body { font-family: system-ui; background: #0b1120; color: #f8fafc; padding: 24px; }\n";
        html += "    .card { background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 20px; }\n";
        html += "  </style>\n</head>\n<body>\n";
        html += "  <div class=\"card\">\n";
        html += bodyContent;
        html += "  </div>\n";
        html += "</body>\n</html>\n";
        return html;
    }
}

class ModelValidationResult {
    public isValid: bool = true;
    public errors: Array<string>* = new Array<string>();

    public constructor() {}

    public void addError(string err) {
        this.isValid = false;
        this.errors->push(err);
    }

    public int getErrorCount() {
        return (int)this.errors->length();
    }
}

class BaseModel {
    public id: string;

    public constructor(string id) {
        this.id = id;
    }

    public virtual ModelValidationResult* validate() {
        ModelValidationResult* res = new ModelValidationResult();
        if (this.id.length() === 0) {
            res->addError("Model ID must not be empty");
        }
        return res;
    }

    public virtual JsonValue* toJsonValue() {
        JsonValue* doc = JsonDocHelper::obj();
        JsonDocHelper::setStr(doc, "id", this.id);
        return doc;
    }

    public virtual string toJson() {
        JsonValue* obj = Json::obj();
        Json::setString(obj, "id", this.id);
        return Json::stringify(obj);
    }
}

class LightingRouteEntry {
    public method: string;
    public pattern: string;
    public handlerId: string;

    public constructor(string m, string p, string h) {
        this.method = m;
        this.pattern = p;
        this.handlerId = h;
    }

    public bool match(string reqMethod, string reqPath, HttpRequest* req) {
        if (this.method !== reqMethod) {
            return false;
        }

        if (this.pattern === reqPath) {
            return true;
        }

        if (this.pattern.find("/:id") != -1) {
            string prefix = this.pattern.substr(0, (int)this.pattern.find("/:id"));
            if (reqPath.find(prefix) == 0 && reqPath.length() > prefix.length() + 1) {
                string idVal = reqPath.substr((int)prefix.length() + 1, (int)reqPath.length() - (int)prefix.length() - 1);
                if (idVal.find("/") == -1) {
                    req->addPathParam("id", idVal);
                    return true;
                }
            }
        }

        return false;
    }
}

class LightingRouter {
    public routes: Array<LightingRouteEntry*>* = new Array<LightingRouteEntry*>();

    public constructor() {}

    public void addRoute(string method, string pattern, string handlerId) {
        this.routes->push(new LightingRouteEntry(method, pattern, handlerId));
    }

    public void get(string pattern, string handlerId) {
        this.addRoute("GET", pattern, handlerId);
    }

    public void post(string pattern, string handlerId) {
        this.addRoute("POST", pattern, handlerId);
    }

    public void put(string pattern, string handlerId) {
        this.addRoute("PUT", pattern, handlerId);
    }

    public void del(string pattern, string handlerId) {
        this.addRoute("DELETE", pattern, handlerId);
    }

    public LightingRouteEntry* findRoute(HttpRequest* req) {
        int count = (int)this.routes->length();
        for (int i = 0; i < count; i++) {
            LightingRouteEntry* r = this.routes->get(i);
            if (r->match(req->method, req->path, req)) {
                return r;
            }
        }
        return nullptr;
    }

    public int getRouteCount() {
        return (int)this.routes->length();
    }
}

class MiddlewareResult {
    public proceed: bool;
    public errorResponse: HttpResponse*;

    public constructor(bool proceed, HttpResponse* err) {
        this.proceed = proceed;
        this.errorResponse = err;
    }
}

class LightingMiddleware {
    static public void runLogger(HttpRequest* req) {
        print("[Lighting MVC Logger] ");
        print(req->method);
        print(" ");
        println(req->path);
    }

    static public MiddlewareResult* runAuth(HttpRequest* req) {
        if (req->path.find("/admin") != -1) {
            string authHeader = req->getParam("auth");
            if (authHeader !== "admin-token") {
                JsonValue* doc = JsonDocHelper::obj();
                JsonDocHelper::setStr(doc, "error", "Unauthorized access");
                JsonDocHelper::setNum(doc, "statusCode", 401);
                HttpResponse* errResp = new HttpResponse(401, "Unauthorized", "application/json", JsonDocHelper::stringify(doc));
                return new MiddlewareResult(false, errResp);
            }
        }
        return new MiddlewareResult(true, nullptr);
    }

    static public void applyCors(HttpResponse* res) {
    }
}

class BaseController {
    public constructor() {}

    public HttpResponse* html(string body) {
        return HttpResponse::html(body);
    }

    public HttpResponse* json(JsonValue* val) {
        return HttpResponse::json(val);
    }

    public HttpResponse* json(string str) {
        return HttpResponse::json(str);
    }

    public HttpResponse* badRequest(string message) {
        return HttpResponse::badRequest(message);
    }

    public HttpResponse* notFound(string message) {
        return HttpResponse::notFound(message);
    }

    public HttpResponse* redirect(string url) {
        return HttpResponse::redirect(url);
    }
}
