import json from "json";

using JsonValue = json_lib::Value;

class JsonDoc {
    public static obj(): JsonValue* {
        let v: JsonValue* = new JsonValue();
        v->type = json_lib::JsonType::Object;
        return v;
    }

    public static arr(): JsonValue* {
        let v: JsonValue* = new JsonValue();
        v->type = json_lib::JsonType::Array;
        return v;
    }

    public static str(s: string): JsonValue* {
        return new JsonValue(s);
    }

    public static num(n: int): JsonValue* {
        return new JsonValue(n);
    }

    public static numDouble(n: double): JsonValue* {
        return new JsonValue(n);
    }

    public static boolean(b: bool): JsonValue* {
        return new JsonValue(b);
    }

    public static parse(s: string): JsonValue* {
        return json.parse(s);
    }

    public static stringify(v: JsonValue*): string {
        return json.stringify(v);
    }

    public static stringifyIndent(v: JsonValue*, indent: int): string {
        return json.stringify(v, indent);
    }

    public static setStr(o: JsonValue*, key: string, val: string): void {
        o->set(key, new JsonValue(val));
    }

    public static setNum(o: JsonValue*, key: string, val: int): void {
        o->set(key, new JsonValue(val));
    }

    public static setDouble(o: JsonValue*, key: string, val: double): void {
        o->set(key, new JsonValue(val));
    }

    public static setBool(o: JsonValue*, key: string, val: bool): void {
        o->set(key, new JsonValue(val));
    }

    public static setVal(o: JsonValue*, key: string, val: JsonValue*): void {
        o->set(key, val);
    }

    public static pushStr(a: JsonValue*, val: string): void {
        a->push(new JsonValue(val));
    }

    public static pushNum(a: JsonValue*, val: int): void {
        a->push(new JsonValue(val));
    }

    public static pushVal(a: JsonValue*, val: JsonValue*): void {
        a->push(val);
    }
}

class HttpRequest {
    public method: string;
    public path: string;
    public body: string;
    public contentType: string;
    public queryParams: Array<string>*;
    public pathParams: Array<string>*;

    public constructor(method: string, path: string, body: string, cType: string) {
        this.method = method;
        this.path = path;
        this.body = body;
        this.contentType = cType;
        this.queryParams = new Array<string>();
        this.pathParams = new Array<string>();
    }

    public addQueryParam(key: string, value: string): void {
        this.queryParams->push(key + "=" + value);
    }

    public getQuery(key: string): string {
        let prefix: string = key + "=";
        let count: int = (int)this.queryParams->length();
        for (let i: int = 0; i < count; i++) {
            let item: string = this.queryParams->get(i);
            if (item.find(prefix) == 0) {
                return item.substr((int)prefix.length(), (int)item.length() - (int)prefix.length());
            }
        }
        return "";
    }

    public addPathParam(key: string, value: string): void {
        this.pathParams->push(key + ":" + value);
    }

    public getParam(key: string): string {
        let prefix: string = key + ":";
        let count: int = (int)this.pathParams->length();
        for (let i: int = 0; i < count; i++) {
            let item: string = this.pathParams->get(i);
            if (item.find(prefix) == 0) {
                return item.substr((int)prefix.length(), (int)item.length() - (int)prefix.length());
            }
        }
        return "";
    }
}

class HttpResponse {
    public statusCode: int;
    public statusMessage: string;
    public contentType: string;
    public body: string;
    public isRedirect: bool;
    public redirectUrl: string;

    public constructor(code: int, msg: string, cType: string, body: string) {
        this.statusCode = code;
        this.statusMessage = msg;
        this.contentType = cType;
        this.body = body;
        this.isRedirect = false;
        this.redirectUrl = "";
    }

    public static ok(body: string, cType: string): HttpResponse* {
        return new HttpResponse(200, "OK", cType, body);
    }

    public static json(val: JsonValue*): HttpResponse* {
        return new HttpResponse(200, "OK", "application/json", JsonDoc::stringify(val));
    }

    public static json(str: string): HttpResponse* {
        return new HttpResponse(200, "OK", "application/json", str);
    }

    public static html(htmlBody: string): HttpResponse* {
        return new HttpResponse(200, "OK", "text/html; charset=utf-8", htmlBody);
    }

    public static notFound(msg: string): HttpResponse* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "error", msg);
        JsonDoc::setNum(doc, "statusCode", 404);
        return new HttpResponse(404, "Not Found", "application/json", JsonDoc::stringify(doc));
    }

    public static badRequest(msg: string): HttpResponse* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "error", msg);
        JsonDoc::setNum(doc, "statusCode", 400);
        return new HttpResponse(400, "Bad Request", "application/json", JsonDoc::stringify(doc));
    }

    public static redirect(url: string): HttpResponse* {
        let res: HttpResponse* = new HttpResponse(302, "Found", "text/plain", "Redirecting to " + url);
        res->isRedirect = true;
        res->redirectUrl = url;
        return res;
    }

    public display(): void {
        print("HTTP/1.1 ");
        print(this.statusCode);
        print(" ");
        println(this.statusMessage);
        println("Content-Type: " + this.contentType);
        println("Content-Length: " + std::to_string((int)this.body.length()));
        println("");
        println(this.body);
    }

    public displayCurl(method: string, url: string): void {
        println("─── Simulated cURL Request ────────────────────────────────────");
        println("> " + method + " " + url + " HTTP/1.1");
        println("< HTTP/1.1 " + std::to_string(this.statusCode) + " " + this.statusMessage);
        println("< Content-Type: " + this.contentType);
        println("< Content-Length: " + std::to_string((int)this.body.length()));
        println("<");
        if (this.body.length() > 200) {
            println(this.body.substr(0, 200) + "\n... [truncated]");
        } else {
            println(this.body);
        }
        println("───────────────────────────────────────────────────────────────");
    }
}

class ViewEngine {
    public static renderLayout(title: string, bodyContent: string): string {
        let html: string = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n";
        html += "  <meta charset=\"UTF-8\">\n";
        html += "  <title>" + title + "</title>\n";
        html += "  <style>\n";
        html += "    body { font-family: system-ui; background: #0b1120; color: #f8fafc; padding: 24px; }\n";
        html += "    .card { background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 20px; }\n";
        html += "  </style>\n</head>\n<body>\n";
        html += "  <div class=\"card\">\n";
        html += bodyContent;
        html += "  </div>\n";
        html += "</body>\n</html>\n";
        return html;
    }
}

class ModelValidationResult {
    public isValid: bool;
    public errors: Array<string>*;

    public constructor() {
        this.isValid = true;
        this.errors = new Array<string>();
    }

    public addError(err: string): void {
        this.isValid = false;
        this.errors->push(err);
    }

    public getErrorCount(): int {
        return (int)this.errors->length();
    }
}

class BaseModel {
    public id: string;

    public constructor(id: string) {
        this.id = id;
    }

    public virtual validate(): ModelValidationResult* {
        let res: ModelValidationResult* = new ModelValidationResult();
        if (this.id.length() === 0) {
            res->addError("Model ID must not be empty");
        }
        return res;
    }

    public virtual toJsonValue(): JsonValue* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "id", this.id);
        return doc;
    }

    public virtual toJson(): string {
        return JsonDoc::stringify(this->toJsonValue());
    }
}

class RouteEntry {
    public method: string;
    public pattern: string;
    public handlerId: string;

    public constructor(m: string, p: string, h: string) {
        this.method = m;
        this.pattern = p;
        this.handlerId = h;
    }

    public match(reqMethod: string, reqPath: string, req: HttpRequest*): bool {
        if (this.method !== reqMethod) {
            return false;
        }

        if (this.pattern === reqPath) {
            return true;
        }

        if (this.pattern.find("/:id") != -1) {
            let prefix: string = this.pattern.substr(0, (int)this.pattern.find("/:id"));
            if (reqPath.find(prefix) == 0 && reqPath.length() > prefix.length() + 1) {
                let idVal: string = reqPath.substr((int)prefix.length() + 1, (int)reqPath.length() - (int)prefix.length() - 1);
                if (idVal.find("/") == -1) {
                    req->addPathParam("id", idVal);
                    return true;
                }
            }
        }

        return false;
    }
}

class LightingRouter {
    public routes: Array<RouteEntry*>*;

    public constructor() {
        this.routes = new Array<RouteEntry*>();
    }

    public addRoute(method: string, pattern: string, handlerId: string): void {
        this.routes->push(new RouteEntry(method, pattern, handlerId));
    }

    public get(pattern: string, handlerId: string): void {
        this.addRoute("GET", pattern, handlerId);
    }

    public post(pattern: string, handlerId: string): void {
        this.addRoute("POST", pattern, handlerId);
    }

    public put(pattern: string, handlerId: string): void {
        this.addRoute("PUT", pattern, handlerId);
    }

    public del(pattern: string, handlerId: string): void {
        this.addRoute("DELETE", pattern, handlerId);
    }

    public findRoute(req: HttpRequest*): RouteEntry* {
        let count: int = (int)this.routes->length();
        for (let i: int = 0; i < count; i++) {
            let r: RouteEntry* = this.routes->get(i);
            if (r->match(req->method, req->path, req)) {
                return r;
            }
        }
        return nullptr;
    }

    public getRouteCount(): int {
        return (int)this.routes->length();
    }
}

class MiddlewareResult {
    public proceed: bool;
    public errorResponse: HttpResponse*;

    public constructor(proceed: bool, err: HttpResponse*) {
        this.proceed = proceed;
        this.errorResponse = err;
    }
}

class LightingMiddleware {
    public static runLogger(req: HttpRequest*): void {
        print("[Lighting MVC Logger] ");
        print(req->method);
        print(" ");
        println(req->path);
    }

    public static runAuth(req: HttpRequest*): MiddlewareResult* {
        if (req->path.find("/admin") != -1) {
            let authHeader: string = req->getParam("auth");
            if (authHeader !== "admin-token") {
                let doc: JsonValue* = JsonDoc::obj();
                JsonDoc::setStr(doc, "error", "Unauthorized access");
                JsonDoc::setNum(doc, "statusCode", 401);
                let errResp: HttpResponse* = new HttpResponse(401, "Unauthorized", "application/json", JsonDoc::stringify(doc));
                return new MiddlewareResult(false, errResp);
            }
        }
        return new MiddlewareResult(true, nullptr);
    }

    public static applyCors(res: HttpResponse*): void {
    }
}

class BaseController {
    public constructor() {}

    public html(body: string): HttpResponse* {
        return HttpResponse::html(body);
    }

    public json(val: JsonValue*): HttpResponse* {
        return HttpResponse::json(val);
    }

    public json(str: string): HttpResponse* {
        return HttpResponse::json(str);
    }

    public badRequest(message: string): HttpResponse* {
        return HttpResponse::badRequest(message);
    }

    public notFound(message: string): HttpResponse* {
        return HttpResponse::notFound(message);
    }

    public redirect(url: string): HttpResponse* {
        return HttpResponse::redirect(url);
    }
}
