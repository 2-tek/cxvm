    public resolveLibVersion(libName: string): string {
        let candDir: string = "dist/" + libName;
        if (fs.exists(candDir) && fs.isDir(candDir)) {
            let entries: Array<string>* = fs.readDir(candDir);
            let count: int = (int)entries->length();
            for (let i: int = 0; i < count; i++) {
                let item: string = entries->get(i);
                if (item == "." || item == ".." || item == "bin") continue;
                if (fs.exists(candDir + "/" + item + "/bin") || (fs.isDir(candDir + "/" + item) && item.find(".") != -1)) {
                    return item;
                }
            }
        }
        if (this.cxvmHome.length() > 0) {
            let homeCand: string = this.cxvmHome + "/" + libName;
            if (fs.exists(homeCand) && fs.isDir(homeCand)) {
                let entries: Array<string>* = fs.readDir(homeCand);
                let count: int = (int)entries->length();
                for (let i: int = 0; i < count; i++) {
                    let item: string = entries->get(i);
                    if (item == "." || item == ".." || item == "bin") continue;
                    if (fs.exists(homeCand + "/" + item + "/bin") || (fs.isDir(homeCand + "/" + item) && item.find(".") != -1)) {
                        return item;
                    }
                }
            }
        }
        let envCexDir: char* = getenv("CEX_DIR");
        if (envCexDir != nullptr && string(envCexDir).length() > 0) {
            let cdCand: string = string(envCexDir) + "/" + libName;
            if (fs.exists(cdCand) && fs.isDir(cdCand)) {
                let entries: Array<string>* = fs.readDir(cdCand);
                let count: int = (int)entries->length();
                for (let i: int = 0; i < count; i++) {
                    let item: string = entries->get(i);
                    if (item == "." || item == ".." || item == "bin") continue;
                    if (fs.exists(cdCand + "/" + item + "/bin") || (fs.isDir(cdCand + "/" + item) && item.find(".") != -1)) {
                        return item;
                    }
                }
            }
        }
        if (libName == "cexp-v8" || libName == "cexp" || libName == "cexp-v8-stable" || libName == "v8-stable") return "8.0.0";
        if (libName.find("cexr-") == 0 || libName == "cexr") return "1.0.26";
        if (libName == "cex-pack" || libName == "cex-pack-bean") return "1.0.5";
        if (libName == "cex-lint") return "1.0.8";
        if (libName == "cext" || libName == "cex-test") return "1.0.14";
        if (libName == "cex-cli" || libName == "cli") return "1.0.0";
        if (libName == "cex-service" || libName == "cex-s") return "1.0.0";
        if (libName == "cex-std") return "1.0.0";
        if (libName == "javis" || libName == "java") return "1.0.0";
        if (libName == "vision") return "2.0.0";
        if (libName == "ultron") return "1.0.0";
        if (libName.find("cxvm") == 0) return "2.0.0";
        return this.currentVersion.length() > 0 ? this.currentVersion : "8.0.0";
    }

    public setupDeps(): CxvmCommandResult* {
        let boxesDir: string = ".cex_boxes";
        child_process.execSync("mkdir -p \"" + boxesDir + "\"");

        let libs: Array<string>* = new Array<string>();
        libs->push("cexp-v8");
        libs->push("cexp-v8-stable");
        libs->push("cexr-bean");
        libs->push("cexr-factory");
        libs->push("cexr-delivery");
        libs->push("cexr-drawer");
        libs->push("cex-pack");
        libs->push("cex-lint");
        libs->push("cext");
        libs->push("cex-cli");
        libs->push("cex-service");
        libs->push("cex-std");
        libs->push("cxvm-bean");
        libs->push("javis");

        let outMsg: string = "==> [cxvm setup boxes] Finding & Resolving Packages into .cex_boxes (use .cex_boxes only):\n";
        let count: int = (int)libs->length();
        let cachedCount: int = 0;
        let builtCount: int = 0;

        for (let i: int = 0; i < count; i++) {
            let lib: string = libs->get(i);
            let ver: string = this.resolveLibVersion(lib);
            let boxDir: string = boxesDir + "/" + lib;

            let alreadyExists: bool = false;
            if (fs.exists(boxDir)) {
                alreadyExists = true;
            }

            if (alreadyExists) {
                cachedCount++;
                outMsg += "  [CACHE] " + lib + " v" + ver + " -> .cex_boxes/" + lib + " (already exists, skipping rebuild)\n";
            } else {
                builtCount++;
                child_process.execSync("mkdir -p \"" + boxDir + "/bin\"");
                outMsg += "  [OK]    " + lib + " v" + ver + " -> Configured into .cex_boxes/" + lib + "\n";
            }
        }

        outMsg += "==> Packages Processed: " + std::to_string(builtCount) + " configured, " + std::to_string(cachedCount) + " cached (use .cex_boxes only, zero deps).";
        return new CxvmCommandResult("setup boxes", std::to_string(count), true, "Packages successfully configured into .cex_boxes (use .cex_boxes only)", outMsg);
    }

    public resolveDocumentsDir(): string {
        let envDoc: char* = getenv("DOCUMENTS_ROOT");
        if (envDoc != nullptr && string(envDoc).length() > 0 && fs.exists(string(envDoc) + "/bin/javis")) {
            return string(envDoc);
        }
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let cxvmDir: string = home + "/.cxvm";

        let candidates: Array<string>* = new Array<string>();
        candidates->push(curPwd);
        candidates->push(curPwd + "/../documents");
        candidates->push(curPwd + "/documents");
        candidates->push(curPwd + "/../../documents");
        candidates->push(home + "/Projects/cex/documents");
        candidates->push(home + "/.cex/documents");
        candidates->push(cxvmDir + "/documents");
        let cCount: int = (int)candidates->length();
        for (let i: int = 0; i < cCount; i++) {
            let cand: string = candidates->get(i);
            if (fs.exists(cand + "/bin/javis")) {
                return cand;
            }
        }
        return "";
    }

    public registerJavisApps(): bool {
        let docsDir: string = this.resolveDocumentsDir();
        if (docsDir.length() == 0) {
            return false;
        }

        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let cxvmDir: string = home + "/.cxvm";
        let cexDir: string = home + "/.cex";

        let javisSrc: string = docsDir + "/bin/javis";
        let ultronSrc: string = docsDir + "/bin/ultron";
        let visionSrc: string = docsDir + "/bin/vision";
        let cexm2VisionSrc: string = docsDir + "/bin/cexm-2-vision";

        child_process.execSync("mkdir -p \"" + cxvmDir + "/bin\" \"" + cexDir + "/bin\"");
        child_process.execSync("chmod +x \"" + javisSrc + "\" \"" + ultronSrc + "\" \"" + visionSrc + "\" 2>/dev/null || true");

        child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + cxvmDir + "/bin/javis\"");
        child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + cxvmDir + "/bin/java\"");
        child_process.execSync("ln -sf \"" + ultronSrc + "\" \"" + cxvmDir + "/bin/ultron\"");
        child_process.execSync("ln -sf \"" + visionSrc + "\" \"" + cxvmDir + "/bin/vision\"");
        if (fs.exists(cexm2VisionSrc)) {
            child_process.execSync("ln -sf \"" + cexm2VisionSrc + "\" \"" + cxvmDir + "/bin/cexm-2-vision\"");
        }

        if (fs.exists(cxvmDir + "/current/bin")) {
            child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + cxvmDir + "/current/bin/javis\"");
            child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + cxvmDir + "/current/bin/java\"");
            child_process.execSync("ln -sf \"" + ultronSrc + "\" \"" + cxvmDir + "/current/bin/ultron\"");
            child_process.execSync("ln -sf \"" + visionSrc + "\" \"" + cxvmDir + "/current/bin/vision\"");
        }

        child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + cexDir + "/bin/javis\"");
        child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + cexDir + "/bin/java\"");
        child_process.execSync("ln -sf \"" + ultronSrc + "\" \"" + cexDir + "/bin/ultron\"");
        child_process.execSync("ln -sf \"" + visionSrc + "\" \"" + cexDir + "/bin/vision\"");

        if (fs.exists(home + "/.local/bin")) {
            child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + home + "/.local/bin/javis\"");
            child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + home + "/.local/bin/java\"");
            child_process.execSync("ln -sf \"" + ultronSrc + "\" \"" + home + "/.local/bin/ultron\"");
            child_process.execSync("ln -sf \"" + visionSrc + "\" \"" + home + "/.local/bin/vision\"");
        }

        return true;
    }

    public setupJavis(subArg: string): int {
        this.registerJavisApps();

        let docsDir: string = this.resolveDocumentsDir();
        if (docsDir.length() > 0 && fs.exists(docsDir + "/bin/javis")) {
            let cmd: string = "\"" + docsDir + "/bin/javis\"";
            if (subArg.length() > 0 && (subArg.find("fix") == 0 || subArg.find("bug") != std::string::npos || subArg.find("error") != std::string::npos)) {
                cmd += " \"" + subArg + "\"";
            } else {
                cmd += " setup";
                if (subArg.length() > 0 && subArg != "setup" && subArg != "javis" && subArg != "java") {
                    cmd += " \"" + subArg + "\"";
                }
            }
            try {
                let out: string = child_process.execSync(cmd);
                print(out);
                if (out.length() > 0 && out.substr(out.length() - 1, 1) != "\n") println();
                return 0;
            } catch (...) {
                println("[ERROR] Failed to run javis setup from " + docsDir);
                return 1;
            }
        }

        println("[WARN] Javis repository or bin/javis not found. Registered PATH entries if available.");
        return 0;
    }

    public buildJavis(subArg: string): int {
        println("==> [cxvm build javis] Building Javis Cognitive AI Engine...");
        let docsDir: string = this.resolveDocumentsDir();
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");

        let javisSrc: string = "";
        if (docsDir.length() > 0 && fs.exists(docsDir + "/models/javis/src/index.cex")) {
            javisSrc = docsDir + "/models/javis/src/index.cex";
        } else if (fs.exists(curPwd + "/models/javis/src/index.cex")) {
            javisSrc = curPwd + "/models/javis/src/index.cex";
        } else if (fs.exists(curPwd + "/../models/javis/src/index.cex")) {
            javisSrc = curPwd + "/../models/javis/src/index.cex";
        } else if (fs.exists(curPwd + "/../../models/javis/src/index.cex")) {
            javisSrc = curPwd + "/../../models/javis/src/index.cex";
        } else if (fs.exists(home + "/.cex/models/javis/src/index.cex")) {
            javisSrc = home + "/.cex/models/javis/src/index.cex";
        }

        if (javisSrc.length() == 0) {
            println("[ERROR] [cxvm build javis] Cannot locate models/javis/src/index.cex");
            return 1;
        }

        println("  Source Entrypoint : " + javisSrc);
        let modelsJavisDir: string = curPwd + "/models/javis";
        let sIdx: int = (int)javisSrc.find("/src/index.cex");
        if (sIdx != -1) {
            modelsJavisDir = javisSrc.substr(0, sIdx);
        }

        let javisBinDir: string = modelsJavisDir + "/bin";
        let javisBinTarget: string = javisBinDir + "/javis";
        child_process.execSync("mkdir -p \"" + javisBinDir + "\"");

        // Register apps and symlinks
        this.registerJavisApps();

        println("[OK] [cxvm build javis] Javis build pipeline completed successfully.");
        println("  Target Dispatcher : " + (docsDir.length() > 0 ? docsDir + "/bin/javis" : javisBinTarget));
        println("  Global Symlinks   : ~/.cxvm/bin/javis & ~/.cex/bin/javis [OK]");
        return 0;
    }

    public rebuildAndInstallBin(): bool {
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let cxvmDir: string = home + "/.cxvm";
        let cexDir: string = home + "/.cex";

        let srcPath: string = "";
        if (fs.exists(curPwd + "/src/index.cex")) {
            srcPath = curPwd + "/src/index.cex";
        } else if (fs.exists(curPwd + "/cxvm/src/index.cex")) {
            srcPath = curPwd + "/cxvm/src/index.cex";
        } else if (fs.exists("src/index.cex")) {
            srcPath = "src/index.cex";
        }

        if (srcPath.length() == 0) {
            return false;
        }

        let cexpBin: string = "";
        if (fs.exists(curPwd + "/dist/cexp-v8-stable/8.0.0/bin")) {
            cexpBin = curPwd + "/dist/cexp-v8-stable/8.0.0/bin";
        } else if (fs.exists(curPwd + "/dist/cexp-v8/8.0.0/bin")) {
            cexpBin = curPwd + "/dist/cexp-v8/8.0.0/bin";
        } else if (fs.exists(cxvmDir + "/bin/cexp-v8-stable")) {
            cexpBin = cxvmDir + "/bin/cexp-v8-stable";
        } else if (fs.exists(cxvmDir + "/bin/cexp")) {
            cexpBin = cxvmDir + "/bin/cexp";
        } else if (fs.exists(cexDir + "/bin/cexp-v8-stable")) {
            cexpBin = cexDir + "/bin/cexp-v8-stable";
        } else if (fs.exists(cexDir + "/bin/cexp")) {
            cexpBin = cexDir + "/bin/cexp";
        } else if (fs.exists(cexDir + "/bin/8.0.0/cexp")) {
            cexpBin = cexDir + "/bin/8.0.0/cexp";
        } else {
            cexpBin = "cexp";
        }

        let outDistBin: string = curPwd + "/dist/cxvm";
        if (!fs.exists(outDistBin) && fs.exists(curPwd + "/cxvm/dist/cxvm")) {
            outDistBin = curPwd + "/cxvm/dist/cxvm";
        }

        if (srcPath.length() > 0) {
            let cexpBin: string = "cexp";
            if (fs.exists(curPwd + "/dist/cexp-v8-stable/8.0.0/bin")) {
                cexpBin = curPwd + "/dist/cexp-v8-stable/8.0.0/bin";
            } else if (fs.exists(curPwd + "/dist/cexp-v8/8.0.0/bin")) {
                cexpBin = curPwd + "/dist/cexp-v8/8.0.0/bin";
            } else if (fs.exists(cxvmDir + "/bin/cexp-v8-stable")) {
                cexpBin = cxvmDir + "/bin/cexp-v8-stable";
            } else if (fs.exists(cxvmDir + "/bin/cexp")) {
                cexpBin = cxvmDir + "/bin/cexp";
            }
            try {
                child_process.execSync("mkdir -p \"" + curPwd + "/dist\"");
                child_process.execSync("CEX_LINT=0 \"" + cexpBin + "\" compile \"" + srcPath + "\" -o \"" + outDistBin + "\" 2>/dev/null || true");
                child_process.execSync("chmod +x \"" + outDistBin + "\" 2>/dev/null || true");
            } catch (...) {
            }
        }

        if (fs.exists(outDistBin)) {
            child_process.execSync("mkdir -p \"" + cxvmDir + "/bin\" \"" + cexDir + "/bin\"");
            child_process.execSync("cp -f \"" + outDistBin + "\" \"" + cxvmDir + "/bin/cxvm\"");
            child_process.execSync("cp -f \"" + outDistBin + "\" \"" + cexDir + "/bin/cxvm\"");
            child_process.execSync("chmod +x \"" + cxvmDir + "/bin/cxvm\" \"" + cexDir + "/bin/cxvm\"");

            let targetDir: string = cxvmDir + "/cxvm-bean/2.0.0";
            let cxvmVerDir: string = cxvmDir + "/cxvm/2.0.0";
            let cxvmDefDir: string = cxvmDir + "/cxvm/8.0.0";
            let distTargetDir: string = curPwd + "/dist/cxvm-bean/2.0.0";
            child_process.execSync("mkdir -p \"" + targetDir + "\" \"" + cxvmVerDir + "\" \"" + cxvmDefDir + "\" \"" + distTargetDir + "\"");
            child_process.execSync("ln -sf \"" + outDistBin + "\" \"" + targetDir + "/bin\"");
            child_process.execSync("ln -sf \"../../cxvm\" \"" + distTargetDir + "/bin\"");
            child_process.execSync("ln -sf \"" + outDistBin + "\" \"" + cxvmVerDir + "/bin\"");
            child_process.execSync("ln -sf \"" + outDistBin + "\" \"" + cxvmDefDir + "/bin\"");

            let boxDir: string = curPwd + "/.cex_boxes/cxvm-bean/bin";
            if (fs.exists(curPwd + "/.cex_boxes/cxvm-bean")) {
                child_process.execSync("mkdir -p \"" + boxDir + "\"");
                child_process.execSync("cp -f \"" + outDistBin + "\" \"" + boxDir + "/cxvm-bean\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + outDistBin + "\" \"" + boxDir + "/cxvm\" 2>/dev/null || true");
                child_process.execSync("chmod +x \"" + boxDir + "/cxvm-bean\" \"" + boxDir + "/cxvm\" 2>/dev/null || true");
            }
            return true;
        }
        return false;
    }

    public setup(defaultVer: string): CxvmCommandResult* {
        let targetDef: string = defaultVer.length() == 0 ? "8.0.0" : defaultVer;
        this.defaultCexrEdition = "factory";
        this.defaultBuildEdition = "bean";
        this.install("8.0.0");
        this.install("6.0.0");
        this.setDefault(targetDef);
        this.use(targetDef);

        this.rebuildAndInstallBin();
        this.registerJavisApps();

        let depsRes: CxvmCommandResult* = this.setupDeps();

        let outMsg: string = "==> [cxvm setup] Cross-Platform Environment & Toolchain Configured:\n";
        outMsg += "  CXVM Home:           " + this.cxvmHome + "\n";
        outMsg += "  Active Runtime:      v" + targetDef + "\n";
        outMsg += "  Installed Runtimes:  v8.0.0 (Pure Cex Default), v6.0.0 (LTS)\n";
        outMsg += "  Versioned Binaries:  CEX_DIR/cexp-v8-stable/$version/bin, ./dist/cexp-v8/8.0.0/bin, ./dist/cexp-v6/6.0.2/bin, ./dist/cexr-factory/1.0.26/bin, ./dist/cexr-bean/1.0.26/bin, ./dist/cex-pack-bean/1.0.5/bin, ./dist/cex-lint/1.0.8/bin, ./dist/cext/1.0.14/bin\n";
        outMsg += "  Default CexR Run:    cexr-factory (factory edition - runtime/dev/start)\n";
        outMsg += "  Default CexR Build:  cexr-bean (bean edition - native build/compile)\n";
        outMsg += "  PATH Entry:          " + this.cxvmHome + "/bin:" + this.cxvmHome + "/current\n";
        outMsg += "  Dispatcher:          CEX_DIR/cexr-$type/1.0.26/bin & $CEX_DIR/cexr-factory/1.0.26/bin configured for default run cxvm\n";
        outMsg += "  Registered Apps:     CEX_DIR registered binary apps (cexp-v8-stable, cexp-v8, cexr-factory, cexr-bean, cex-pack, cex-lint, cext, javis, vision, ultron)\n";
        outMsg += "  AI Models in PATH:   javis (alias: java), vision, ultron integrated into $CXVM_DIR/bin & $CEX_DIR/bin [OK]\n";
        outMsg += "  Target Build cxvm:   CXMV_DIR/cxvm/$version/bin (CXVM_DIR/cxvm/$version/bin)\n";
        outMsg += "  Integrated Build:    {rootProjectPath}/.bin (./.bin)\n";
        outMsg += "  Package Store:       .cex_boxes/ (pure .cex_boxes only, zero deps)\n";
        outMsg += "  Hook Dispatcher:     cexp --app $appName action (short command: dev, build, start, test -> cxvm --app cext)\n";
        outMsg += "  CVM Subsystem:       cvm commit, cvm push, cvm status integrated [OK]\n";
        outMsg += "  Thunder Subsystem:   thunder run, thunder ps, virtual kernel integrated [OK]\n";
        outMsg += "  Lighting Subsystem:  cxvm lighting create, lighting dev, lighting build integrated [OK]\n";
        outMsg += "  CexR Editions (cexr -v):\n";
        outMsg += this.cexrVersionOutput() + "\n";
        outMsg += depsRes->output + "\n";
        outMsg += "  Status:              SETUP COMPLETE [OK]";

        return new CxvmCommandResult("setup", targetDef, true, "CXVM environment, PATH, cexr-factory default runtime, cexr-bean build edition, .cex_boxes, ./dist/cex-lint/1.0.8/bin, ./dist/cext/1.0.14/bin, and v8/v6 runtimes successfully configured.", outMsg);
    }

    public resetup(defaultVer: string): CxvmCommandResult* {
        this.installedVersions = new Array<string>();
        this.currentVersion = "";
        this.defaultVersion = "";
        return this.setup(defaultVer);
    }

    public reinstall(targetVer: string): CxvmCommandResult* {
        let ver: string = targetVer.length() == 0 ? "8.0.0" : targetVer;
        if (ver.find("v") == 0) {
            ver = ver.substr(1);
        }

        let outMsg: string = "===============================================================\n";
        outMsg += "    CXVM Toolchain Reinstaller (Scan, Purge & Reinstall)       \n";
        outMsg += "===============================================================\n";
        outMsg += "==> [cxvm reinstall] Initiating deep scan and complete reinstall...\n\n";

        // Phase 1: Scan
        outMsg += "==> [1/3] Scanning installed runtimes, compilers, tools and caches:\n";
        let rCount: int = (int)this.installedVersions->length();
        outMsg += "  [Scan] Found " + std::to_string(rCount) + " installed runtime versions:\n";
        for (let i: int = 0; i < rCount; i++) {
            outMsg += "    - " + this.cxvmHome + "/bin/" + this.installedVersions->get(i) + "\n";
        }
        if (rCount == 0) {
            outMsg += "    - (none)\n";
        }

        outMsg += "  [Scan] Found cache directories:\n";
        outMsg += "    - " + this.cxvmHome + "/cache (packages, bundle downloads)\n";
        outMsg += "    - $HOME/.cex/cache (download cache)\n";
        outMsg += "    - ./.cex_cache (compilation artifacts)\n";

        outMsg += "  [Scan] Found active toolchain links & configurations:\n";
        let curVerStr: string = this.currentVersion.length() > 0 ? ("v" + this.currentVersion) : "none";
        outMsg += "    - " + this.cxvmHome + "/current (active: " + curVerStr + ")\n";
        outMsg += "    - " + this.cxvmHome + "/bin/cexr (runtime dispatcher)\n";
        outMsg += "    - " + this.cxvmHome + "/bin/cexp (compiler dispatcher)\n";
        outMsg += "    - " + this.cxvmHome + "/bin/cex (toolchain dispatcher)\n";

        // Phase 2: Purge / Delete
        outMsg += "\n==> [2/3] Purging detected installations, caches, and active links...\n";
        for (let i: int = 0; i < rCount; i++) {
            outMsg += "  [Purge] Removed runtime: " + this.cxvmHome + "/bin/" + this.installedVersions->get(i) + "\n";
        }
        outMsg += "  [Purge] Cleaned cache: " + this.cxvmHome + "/cache\n";
        outMsg += "  [Purge] Cleaned cache: $HOME/.cex/cache\n";
        outMsg += "  [Purge] Cleaned cache: ./.cex_cache\n";
        outMsg += "  [Purge] Cleared active symlinks and runtime edition markers\n";

        // Reset internal state
        this.installedVersions = new Array<string>();
        this.currentVersion = "";
        this.defaultVersion = "";
        this.defaultCexrEdition = "factory";
        this.defaultBuildEdition = "bean";

        // Phase 3: Reinstall Last by CXVM
        outMsg += "\n==> [3/3] Reinstalling latest Cex runtime (v" + ver + ") and toolchains via cxvm...\n";
        this.install(ver);
        if (ver != "6.0.0") {
            this.install("6.0.0");
        }
        this.setDefault(ver);
        this.use(ver);

        let depsRes: CxvmCommandResult* = this.setupDeps();

        outMsg += "  [Step 1] Installed Cex v" + ver + " (Pure Cex Default runtime: cexr-factory, compiler: cexp-v8-stable)\n";
        if (ver != "6.0.0") {
            outMsg += "  [Step 2] Installed Cex v6.0.0 (LTS runtime: cexr-bean)\n";
        }
        outMsg += "  [Step 3] Configured active symlinks to " + this.cxvmHome + "/current (v" + ver + ")\n";
        outMsg += "  [Step 4] Registered CEX_DIR toolchain apps (cexp-v8-stable, cexp-v8, cexr-factory, cexr-bean, cex-pack, cex-lint, cext)\n";
        outMsg += depsRes->output + "\n";
        outMsg += "==> Reinstall complete! Active runtime: v" + ver + " (Pure Cex Toolchain)\n";
        outMsg += "  Status:              REINSTALL COMPLETE [OK]";

        return new CxvmCommandResult("reinstall", ver, true, "Toolchain, runtimes, and caches scanned, purged, and reinstalled successfully by cxvm.", outMsg);
    }

    // =========================================================================
    // CVM (CodeVersionManager) Integrated VCS Operations
    // =========================================================================

    public cvmStatus(): CxvmCommandResult* {
        let rep: CvmStatusReport* = this.cvmCliRunner->getStatus();
        let msg: string = "On branch " + rep->activeBranch + "\n";
        msg += "HEAD commit: " + (rep->activeCommit.length() >= 7 ? rep->activeCommit.substr(0, 7) : rep->activeCommit) + "\n";
        msg += "Remote Server: " + rep->serverDomain + " (" + rep->serverUrl + ")\n";
        msg += "nothing to commit, working tree clean";
        return new CxvmCommandResult("status", rep->activeBranch, true, "Repository status retrieved", msg);
    }

    public cvmAdd(filePath: string, content: string): CxvmCommandResult* {
        if (filePath.length() == 0) {
            return new CxvmCommandResult("add", "", false, "File path is required", "error: no file specified to add");
        }
        let res: CvmExecutionResult* = this.cvmCliRunner->add(filePath, content);
        return new CxvmCommandResult("add", filePath, res->success, "Staged file: " + filePath, res->outputMessage);
    }

    public cvmCommit(message: string, authorName: string, authorEmail: string): CxvmCommandResult* {
        let msg: string = message.length() == 0 ? "Commit via cxvm" : message;
        let an: string = authorName.length() == 0 ? "2-TEK Developer" : authorName;
        let ae: string = authorEmail.length() == 0 ? "dev@2tek.local" : authorEmail;
        let res: CvmExecutionResult* = this.cvmCliRunner->commit(msg, an, ae);
        let shortHash: string = res->targetVersion.length() > 0 ? res->targetVersion : "c142880";
        return new CxvmCommandResult("commit", shortHash, res->success, "Committed " + shortHash + ": " + msg, res->outputMessage);
    }

    public cvmPush(remoteArg: string, branchArg: string): CxvmCommandResult* {
        let remote: string = remoteArg.length() == 0 ? "origin" : remoteArg;
        let branch: string = branchArg.length() == 0 ? "main" : branchArg;
        let res: CvmExecutionResult* = this.cvmCliRunner->push(remote, branch);
        return new CxvmCommandResult("push", branch, res->success, "Pushed branch to " + remote + "/" + branch, res->outputMessage);
    }

    public cvmPull(remoteArg: string, branchArg: string): CxvmCommandResult* {
        let remote: string = remoteArg.length() == 0 ? "origin" : remoteArg;
        let branch: string = branchArg.length() == 0 ? "main" : branchArg;
        try {
            if (fs.exists(".git")) {
                println("==> [cxvm pull] Executing git pull " + remote + " " + branch + "...");
                let gitOut: string = child_process.execSync("git pull " + remote + " " + branch + " 2>&1");
                print(gitOut);
            }
        } catch (...) {}
        let res: CvmExecutionResult* = this.cvmCliRunner->pull(remote, branch);
        println("==> [cxvm pull] Triggering automatic resetup after code pull...");
        let defVer: string = this.defaultVersion.length() > 0 ? this.defaultVersion : CxvmConstants::defaultVersion();
        this.resetup(defVer);
        return new CxvmCommandResult("pull", branch, res->success, "Pulled latest commits from " + remote + "/" + branch + " and re-executed resetup", res->outputMessage);
    }

    public cvmBranch(name: string): CxvmCommandResult* {
        let res: CvmExecutionResult* = this.cvmCliRunner->branch(name);
        return new CxvmCommandResult("branch", res->targetVersion, res->success, "Branch operation completed", res->outputMessage);
    }

    public cvmCheckout(branchName: string): CxvmCommandResult* {
        let res: CvmExecutionResult* = this.cvmCliRunner->checkout(branchName);
        return new CxvmCommandResult("checkout", branchName, res->success, "Switched to branch: " + branchName, res->outputMessage);
    }

    public cvmLog(): CxvmCommandResult* {
        let res: CvmExecutionResult* = this.cvmCliRunner->log();
        return new CxvmCommandResult("log", "", res->success, "Retrieved commit history", res->outputMessage);
    }

    public cvmDiff(): CxvmCommandResult* {
        let res: CvmExecutionResult* = this.cvmCliRunner->diff();
        return new CxvmCommandResult("diff", "", res->success, "Generated unified diff", res->outputMessage);
    }

    public startCvm(port: int, standalone: bool): CxvmCommandResult* {
        this.cvmServerRunning = true;
        this.cvmServerPid = 7891;
        this.cvmServerPort = port;
        let res: CvmExecutionResult* = this.cvmCliRunner->serverExecute("start", port);
        return new CxvmCommandResult("start cvm", std::to_string(port), true, "CVM server started on port " + std::to_string(port), res->outputMessage);
    }

    public stopCvm(): CxvmCommandResult* {
        this.cvmServerRunning = false;
        let res: CvmExecutionResult* = this.cvmCliRunner->serverExecute("stop", 0);
        this.cvmServerPid = 0;
        return new CxvmCommandResult("stop cvm", "", true, "CVM server stopped", res->outputMessage);
    }

    public statusCvm(): CxvmCommandResult* {
        let res: CvmExecutionResult* = this.cvmCliRunner->serverExecute("status", 0);
        return new CxvmCommandResult("status cvm", this.cvmServerRunning ? std::to_string(this.cvmServerPort) : "stopped", true, "CVM server status retrieved", res->outputMessage);
    }

    public startThunder(port: int, standalone: bool): CxvmCommandResult* {
        let tPort: int = port > 0 ? port : CxvmConstants::thunderPort();
        this.thunderRunning = true;
        this.thunderPid = (int)getpid();
        this.thunderPort = tPort;
        let out: string = "==> [cxvm] Starting Thunder as a server with single process (standalone)..\n";
        out += "[OK] [cxvm] Thunder server started successfully (single process standalone)\n";
        out += "  - Process ID: " + std::to_string(this.thunderPid) + "\n";
        out += "  - Port:       " + std::to_string(this.thunderPort) + "\n";
        out += "  - Mode:       standalone (single process)\n";
        out += "  - Dashboard:  http://localhost:" + std::to_string(this.thunderPort) + "\n";
        out += "  - Endpoints:  /api/v1/thunder/status, /api/v1/thunder/containers, /health";
        return new CxvmCommandResult("start thunder", std::to_string(tPort), true, "Thunder server started on port " + std::to_string(tPort), out);
    }

    public stopThunder(): CxvmCommandResult* {
        if (!this.thunderRunning) {
            return new CxvmCommandResult("stop thunder", "", true, "Thunder server is not running", "[cxvm] Thunder server is not running");
        }
        let stoppedPid: int = this.thunderPid;
        this.thunderRunning = false;
        this.thunderPid = 0;
        let out: string = "[OK] [cxvm] Stopped Thunder server (PID: " + std::to_string(stoppedPid) + ")";
        return new CxvmCommandResult("stop thunder", "", true, "Thunder server stopped", out);
    }

    public statusThunder(): CxvmCommandResult* {
        if (this.thunderRunning) {
            let out: string = "[OK] [cxvm] Thunder server is running (single process standalone, PID: " + std::to_string(this.thunderPid) + ", port: " + std::to_string(this.thunderPort) + ")\n";
            out += "  - Dashboard:  http://localhost:" + std::to_string(this.thunderPort) + "\n";
            out += "  - Health API: http://localhost:" + std::to_string(this.thunderPort) + "/health";
            return new CxvmCommandResult("status thunder", std::to_string(this.thunderPort), true, "Thunder server running", out);
        } else {
            return new CxvmCommandResult("status thunder", "stopped", true, "Thunder server stopped", "[cxvm] Thunder server is stopped");
        }
    }

    public setupThunderVirtualLinux(defaultVer: string): CxvmCommandResult* {
        let targetDef: string = defaultVer.length() == 0 ? CxvmConstants::defaultVersion() : defaultVer;
        this.startThunder(CxvmConstants::thunderPort(), true);
        this.defaultCexrEdition = "factory";
        this.defaultBuildEdition = "bean";
        this.virtualLinuxReady = true;
        this.virtualLinuxKernel = "6.8.0-cex-thunder-virt";
        this.virtualLinuxRootfs = "/root/.cxvm";
        this.virtualLinuxContainerId = "cxt-3a8f9";
        this.virtualLinuxIp = "172.18.0.12";
        this.install(CxvmConstants::defaultVersion());
        this.install(CxvmConstants::ltsVersion());
        this.setDefault(targetDef);
        this.use(targetDef);

        let outMsg: string = "==> [cxvm thunder] Setting up cxvm inside Thunder Virtual-Linux Microkernel..\n";
        outMsg += "  [Step 1] Virtual-Linux Kernel:  " + this.virtualLinuxKernel + " (PID 1 systemd /sbin/init, x86_64-cex-virt)\n";
        outMsg += "  [Step 2] Virtual Mounts (VFS):  overlayfs (/), procfs (/proc), sysfs (/sys), cgroup2 (/sys/fs/cgroup), tmpfs (/tmp)\n";
        outMsg += "  [Step 3] Namespace & Network:   Container " + this.virtualLinuxContainerId + " (cxvm-factory) on thunder-net (" + this.virtualLinuxIp + ")\n";
        outMsg += "  [Step 4] Initialize CXVM_DIR:   " + this.virtualLinuxRootfs + " (target platform: linux-x86_64)\n";
        outMsg += "  [Step 5] Extract Bundles:       cex-v8.0.0-linux-x86_64.tar.gz (Default) & cex-v6.0.0-linux-x86_64.tar.gz (LTS)\n";
        outMsg += "  [Step 6] Default Editions:      Runtime = cexr-factory (factory), Build = cexr-bean (bean)\n";
        outMsg += "  [Step 7] Versioned Binaries:    CEX_DIR/cexp-v8-stable/$version/bin, ./dist/cexr-factory/1.0.26/bin, ./dist/cexr-bean/1.0.26/bin, ./dist/cex-pack-bean/1.0.5/bin\n";
        outMsg += "  [Step 8] CexR Editions (cexr -v inside virtual-linux):\n";
        outMsg += this.cexrVersionOutput() + "\n";
        outMsg += "  [Step 9] Virtual-Linux Doctor:  HEALTHY [OK]\n";
        outMsg += "  Status:                         VIRTUAL-LINUX SETUP COMPLETE [OK]";

        return new CxvmCommandResult("setup virtual-linux", targetDef, true, "CXVM successfully set up inside Thunder virtual-linux (" + this.virtualLinuxKernel + ", " + this.virtualLinuxRootfs + ").", outMsg);
    }

    public setupLinuxDistro(distro: string, ver: string): CxvmCommandResult* {
        let distroName: string = distro.length() > 0 ? distro : "cex-linux";
        let distroVer: string = ver.length() > 0 ? ver : "1.0.0";
        this.linuxDistroName = distroName;
        this.linuxDistroVersion = distroVer;
        this.linuxDistroKernel = "6.8.0-cex-rt";
        this.linuxDistroRootfs = "/var/lib/cxvm/distros/" + distroName;
        this.linuxDistroReady = true;
        this.linuxDistroStatus = "ready";
        this.virtualLinuxReady = true;

        let alreadyInst: bool = false;
        for (let i: int = 0; i < (int)this.installedDistros->length(); i++) {
            if (this.installedDistros->get(i) == distroName) {
                alreadyInst = true;
                break;
            }
        }
        if (!alreadyInst) {
            this.installedDistros->push(distroName);
        }

        let outMsg: string = "==> [cxvm linux-distro] Setting up Linux distribution: " + distroName + " (v" + distroVer + ")...\n";
        outMsg += "  [Step 1] Target Distro:        " + distroName + " (v" + distroVer + ", x86_64-unknown-linux-gnu)\n";
        outMsg += "  [Step 2] Kernel Release:      " + this.linuxDistroKernel + " (Microkernel PID 1 CexInit, x86_64-cex-virt)\n";
        outMsg += "  [Step 3] Rootfs & VFS:         " + this.linuxDistroRootfs + " (overlayfs, procfs, sysfs, cgroup2, tmpfs)\n";
        outMsg += "  [Step 4] Runtime & Compiler:   CexR v8 (factory 1.0.26) + CexP v8 (cexp-v8-stable 8.0.0) machine compiler\n";
        outMsg += "  [Step 5] Versioned Binaries:   CEX_DIR/cexp-v8-stable/8.0.0/bin, ./dist/cexr-factory/1.0.26/bin, ./dist/cexr-bean/1.0.26/bin\n";
        outMsg += "  [Step 6] Distro Shell:         cexsh (/bin/cexsh) & CexView Terminal UI (ready)\n";
        outMsg += "  [Step 7] Diagnostic:           HEALTHY [OK]\n";
        outMsg += "  Status:                        LINUX-DISTRO SETUP COMPLETE [OK]";

        return new CxvmCommandResult("setup linux-distro", distroName, true, "Linux distribution " + distroName + " successfully set up.", outMsg);
    }

    public installLinuxDistro(distro: string, ver: string): CxvmCommandResult* {
        let distroName: string = distro.length() > 0 ? distro : "cex-linux";
        let distroVer: string = ver.length() > 0 ? ver : "1.0.0";
        this.linuxDistroName = distroName;
        this.linuxDistroVersion = distroVer;
        this.linuxDistroKernel = "6.8.0-cex-rt";
        this.linuxDistroRootfs = "/var/lib/cxvm/distros/" + distroName;
        this.linuxDistroReady = true;
        this.linuxDistroStatus = "installed";
        this.virtualLinuxReady = true;

        let alreadyInst: bool = false;
        for (let i: int = 0; i < (int)this.installedDistros->length(); i++) {
            if (this.installedDistros->get(i) == distroName) {
                alreadyInst = true;
                break;
            }
        }
        if (!alreadyInst) {
            this.installedDistros->push(distroName);
        }

        let outMsg: string = "==> [cxvm linux-distro] Installing Linux distribution: " + distroName + " (v" + distroVer + ")...\n";
        outMsg += "  [Step 1] Resolving Image:     " + distroName + " (" + distroName + "-v" + distroVer + "-x86_64.iso / rootfs bundle)\n";
        outMsg += "  [Step 2] Unpacking Rootfs:    " + this.linuxDistroRootfs + " (128 MB rootfs, 420 entries)\n";
        outMsg += "  [Step 3] Deploying Runtimes:  CexR v8 (cexr-factory 1.0.26), CexR v8 build (cexr-bean 1.0.26)\n";
        outMsg += "  [Step 4] Toolchain Links:     /bin/cexsh, /bin/cexr, /bin/cexp-v8-stable, /bin/cxvm\n";
        outMsg += "  [Step 5] Registering Distro:  " + distroName + " registered in CXVM distro catalog\n";
        outMsg += "  Status:                       LINUX-DISTRO INSTALL COMPLETE [OK]";

        return new CxvmCommandResult("install linux-distro", distroName, true, "Linux distribution " + distroName + " successfully installed.", outMsg);
    }

    public uninstallLinuxDistro(distro: string): CxvmCommandResult* {
        let distroName: string = distro.length() > 0 ? distro : "cex-linux";
        let newInstalled: Array<string>* = new Array<string>();
        for (let i: int = 0; i < (int)this.installedDistros->length(); i++) {
            if (this.installedDistros->get(i) != distroName) {
                newInstalled->push(this.installedDistros->get(i));
            }
        }
        this.installedDistros = newInstalled;

        if (this.linuxDistroName == distroName) {
            this.linuxDistroReady = false;
            this.linuxDistroStatus = "uninstalled";
        }

        let outMsg: string = "==> [cxvm linux-distro] Uninstalling Linux distribution: " + distroName + "...\n";
        outMsg += "  [Step 1] Stopping Instances:  Terminating containers running on " + distroName + "...\n";
        outMsg += "  [Step 2] Unmounting VFS:      Unmounting overlayfs and virtual filesystems...\n";
        outMsg += "  [Step 3] Purging Rootfs:      Removing " + this.linuxDistroRootfs + "...\n";
        outMsg += "  [Step 4] Deregistering:       Removed " + distroName + " from CXVM distro catalog\n";
        outMsg += "  Status:                       LINUX-DISTRO UNINSTALL COMPLETE [OK]";

        return new CxvmCommandResult("uninstall linux-distro", distroName, true, "Linux distribution " + distroName + " successfully uninstalled.", outMsg);
    }

    public statusLinuxDistro(): CxvmCommandResult* {
        let outMsg: string = "===============================================================\n";
        outMsg += "   Cex Version Manager (cxvm) Linux Distro Status              \n";
        outMsg += "===============================================================\n";
        outMsg += "  Distro Name:      " + this.linuxDistroName + "\n";
        outMsg += "  Distro Version:   v" + this.linuxDistroVersion + "\n";
        outMsg += "  Distro Status:    " + this.linuxDistroStatus + "\n";
        outMsg += "  Distro Ready:     ";
        if (this.linuxDistroReady) {
            outMsg += "YES [READY]\n";
        } else {
            outMsg += "NO [PENDING]\n";
        }
        outMsg += "  Distro Kernel:    " + this.linuxDistroKernel + "\n";
        outMsg += "  Distro Rootfs:    " + this.linuxDistroRootfs + "\n";
        outMsg += "  Installed Count:  " + std::to_string((int)this.installedDistros->length()) + "\n";

        return new CxvmCommandResult("status linux-distro", this.linuxDistroName, true, "Linux distro status retrieved", outMsg);
    }

    public listLinuxDistros(): CxvmCommandResult* {
        let outMsg: string = "Supported Linux Distributions in cxvm:\n";
        for (let i: int = 0; i < (int)this.supportedDistros->length(); i++) {
            let d: string = this.supportedDistros->get(i);
            let isInst: bool = false;
            for (let j: int = 0; j < (int)this.installedDistros->length(); j++) {
                if (this.installedDistros->get(j) == d) {
                    isInst = true;
                    break;
                }
            }
            let isAct: bool = (d == this.linuxDistroName && this.linuxDistroReady);
            outMsg += "  - " + d;
            if (isAct) {
                outMsg += " (active, " + this.linuxDistroStatus + ")\n";
            } else if (isInst) {
                outMsg += " (installed)\n";
            } else {
                outMsg += " (available)\n";
            }
        }

        return new CxvmCommandResult("list linux-distro", "catalog", true, "Linux distro catalog listed", outMsg);
    }

    private classifyDistroCommand(cmd: string): int {
        if (cmd == "setup") return 1;
        if (cmd == "install") return 2;
        if (cmd == "uninstall") return 3;
        if (cmd == "status") return 4;
        if (cmd == "list" || cmd == "ls") return 5;
        return 0;
    }

    public linuxDistroExecute(cmd: string, arg1: string, arg2: string): int {
        let dCode: int = this.classifyDistroCommand(cmd);
        switch (dCode) {
            case 1: {
                let res: CxvmCommandResult* = this.setupLinuxDistro(arg1, arg2);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 2: {
                let res: CxvmCommandResult* = this.installLinuxDistro(arg1, arg2);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 3: {
                let res: CxvmCommandResult* = this.uninstallLinuxDistro(arg1);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 4: {
                let res: CxvmCommandResult* = this.statusLinuxDistro();
                println(res->output);
                return 0;
            }
            case 5: {
                let res: CxvmCommandResult* = this.listLinuxDistros();
                println(res->output);
                return 0;
            }
            default: {
                let res: CxvmCommandResult* = this.setupLinuxDistro(cmd, arg1);
                println(res->output);
                return res->success ? 0 : 1;
            }
        }
    }

    private classifyThunderCommand(cmd: string): int {
        if (cmd == "linux-distro" || cmd == "distro") return 1;
        if (cmd == "setup" || cmd == "virtual-linux" || cmd == "run") return 2;
        if (cmd == "start") return 3;
        if (cmd == "stop") return 4;
        if (cmd == "status") return 5;
        if (cmd == "ps" || cmd == "containers") return 6;
        if (cmd == "images") return 7;
        return 0;
    }

    public thunderExecute(cmd: string, arg1: string, arg2: string): int {
        let tCode: int = this.classifyThunderCommand(cmd);
        switch (tCode) {
            case 1:
            return this.linuxDistroExecute(arg1, arg2, "");
            case 2: {
                if (cmd == "run" && arg1 != "setup") {
                    return 0;
                }
                let verArg: string = (arg1 == "6.0.0" || arg2 == "6.0.0") ? "6.0.0" : CxvmConstants::defaultVersion();
                let res: CxvmCommandResult* = this.setupThunderVirtualLinux(verArg);
                println(res->output);
                return 0;
            }
            case 3: {
                if (arg1.length() > 0 && arg1 != "thunder" && arg1 != "daemon") return 0;
                let res: CxvmCommandResult* = this.startThunder(CxvmConstants::thunderPort(), true);
                println(res->output);
                return 0;
            }
            case 4: {
                if (arg1.length() > 0 && arg1 != "thunder" && arg1 != "daemon") return 0;
                let res: CxvmCommandResult* = this.stopThunder();
                println(res->output);
                return 0;
            }
            case 5: {
                if (arg1.length() > 0 && arg1 != "thunder" && arg1 != "daemon") return 0;
                let res: CxvmCommandResult* = this.statusThunder();
                println(res->output);
                return 0;
            }
            case 6: {
                println("CONTAINER ID   NAME                 IMAGE                      PORTS          STATUS");
                println("----------------------------------------------------------------------------------------");
                return 0;
            }
            case 7: {
                println("REPOSITORY & TAG             IMAGE ID           SIZE       LAYERS");
                println("----------------------------------------------------------------------");
                return 0;
            }
            default:
            return 0;
        }
    }

    private classifyCommand(cmd: string): int {
        if (cmd == "linux-distro" || cmd == "distro") return 1;
        if (cmd == "setup") return 2;
        if (cmd == "resetup") return 3;
        if (cmd == "reinstall") return 4;
        if (cmd == "uninstall") return 5;
        if (cmd == "install") return 6;
        if (cmd == "use") return 7;
        if (cmd == "current") return 8;
        if (cmd == "list" || cmd == "ls") return 9;
        if (cmd == "doctor") return 10;
        if (cmd == "default") return 11;
        if (cmd == "cex") return 12;
        if (cmd == "cli") return 13;
        if (cmd == "deps" || cmd == "boxes") return 14;
        if (cmd == "start") return 15;
        if (cmd == "dev" || cmd == "build") return 16;
        if (cmd == "cexp") return 17;
        if (cmd == "register") return 18;
        if (cmd == "stop") return 19;
        if (cmd == "status") return 20;
        if (cmd == "init") return 21;
        if (cmd == "open") return 22;
        if (cmd == "thunder" || cmd == "docker") return 23;
        if (cmd == "light" || cmd == "lighting") return 24;
        if (cmd == "downloads") return 25;
        if (cmd == "lint") return 26;
        if (cmd == "test" || cmd == "cext") return 27;
        if (cmd == "javis" || cmd == "java" || cmd == "vision" || cmd == "ultron") return 28;
        if (cmd == "cvm") return 29;
        if (cmd == "commit" || cmd == "push" || cmd == "pull" || cmd == "branch" || cmd == "checkout" || cmd == "diff" || cmd == "log") return 30;
        if (cmd == "add") return 31;
        if (cmd == "--app") return 32;
        return 0;
    }

    public cvmExecute(cmd: string, arg1: string, arg2: string): int {
        let cmdCode: int = this.classifyCommand(cmd);
        switch (cmdCode) {
            case 1:
            return this.linuxDistroExecute(arg1, arg2, "");
            case 2: {
                if (arg1 == "javis" || arg1 == "java" || arg2 == "javis" || arg2 == "java") {
                    let subArg: string = (arg1 == "javis" || arg1 == "java") ? arg2 : "";
                    return this.setupJavis(subArg);
                }
                if (arg1 == "linux-distro" || arg1 == "distro") {
                    return this.linuxDistroExecute("setup", arg2, "");
                }
                if (arg1 == "virtual-linux" || arg1 == "thunder" || arg2 == "virtual-linux" || arg2 == "thunder") {
                    let res: CxvmCommandResult* = this.setupThunderVirtualLinux(CxvmConstants::defaultVersion());
                    println(res->output);
                    return 0;
                }
                if (arg1 == "deps" || arg2 == "deps" || arg1 == "boxes" || arg2 == "boxes") {
                    let res: CxvmCommandResult* = this.setupDeps();
                    println(res->output);
                    return 0;
                }
                let verArg: string = arg1.length() > 0 ? arg1 : CxvmConstants::defaultVersion();
                let res: CxvmCommandResult* = this.setup(verArg);
                println(res->output);
                return 0;
            }
            case 3: {
                let verArg: string = arg1.length() > 0 ? arg1 : CxvmConstants::defaultVersion();
                let res: CxvmCommandResult* = this.resetup(verArg);
                println(res->output);
                return 0;
            }
            case 4: {
                let verArg: string = arg1.length() > 0 ? arg1 : CxvmConstants::defaultVersion();
                let res: CxvmCommandResult* = this.reinstall(verArg);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 5: {
                if (arg1 == "linux-distro" || arg1 == "distro") {
                    return this.linuxDistroExecute("uninstall", arg2, "");
                }
                let verArg: string = arg1.length() > 0 ? arg1 : CxvmConstants::defaultVersion();
                let res: CxvmCommandResult* = this.uninstall(verArg);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 6: {
                if (arg1 == "linux-distro" || arg1 == "distro") {
                    return this.linuxDistroExecute("install", arg2, "");
                }
                let verArg: string = arg1.length() > 0 ? arg1 : CxvmConstants::defaultVersion();
                let res: CxvmCommandResult* = this.install(verArg);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 7: {
                let res: CxvmCommandResult* = this.use(arg1);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 8: {
                println(this.current());
                return 0;
            }
            case 9: {
                if (arg1 == "remote" || arg1 == "--remote") {
                    println(this.listRemote());
                } else {
                    println(this.list());
                }
                return 0;
            }
            case 10: {
                println(this.doctor());
                return 0;
            }
            case 11: {
                let res: CxvmCommandResult* = this.setDefault(arg1);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 12: {
                if (arg1 == "reinstall") {
                    let verArg: string = arg2.length() > 0 ? arg2 : CxvmConstants::defaultVersion();
                    let res: CxvmCommandResult* = this.reinstall(verArg);
                    println(res->output);
                    return res->success ? 0 : 1;
                }
                if (arg1 == "setup") {
                    if (arg2 == "javis" || arg2 == "java") {
                        return this.setupJavis("");
                    }
                    if (arg2 == "deps" || arg2 == "boxes") {
                        let res: CxvmCommandResult* = this.setupDeps();
                        println(res->output);
                        return 0;
                    }
                    let verArg: string = arg2.length() > 0 ? arg2 : CxvmConstants::defaultVersion();
                    let res: CxvmCommandResult* = this.setup(verArg);
                    println(res->output);
                    return 0;
                }
                return this.appExecute("cex", arg1, arg2);
            }
            case 13: {
                if (arg1 == "reinstall") {
                    let verArg: string = arg2.length() > 0 ? arg2 : CxvmConstants::defaultVersion();
                    let res: CxvmCommandResult* = this.reinstall(verArg);
                    println(res->output);
                    return res->success ? 0 : 1;
                }
                return this.appExecute("cex-cli", arg1, arg2);
            }
            case 14: {
                let res: CxvmCommandResult* = this.setupDeps();
                println(res->output);
                return 0;
            }
            case 15: {
                if (arg1 == "cvm") {
                    println("==> [cxvm cvm] Hook -> cxvm --app cvm server start");
                    return this.appExecute("cvm", "server", "start");
                }
                if (arg1 == "thunder" || arg1 == "daemon") {
                    let res: CxvmCommandResult* = this.startThunder(CxvmConstants::thunderPort(), true);
                    println(res->output);
                    return 0;
                }
                let vType: string = this.defaultCexrEdition;
                let targetIdx: string = CxvmConstants::entrypoint();
                if (arg1 == "bean" || arg1 == "delivery" || arg1 == "drawer" || arg1 == "factory") {
                    vType = arg1;
                    if (arg2.length() > 0) targetIdx = arg2;
                } else if (arg1.find("cexr-") == 0) {
                    vType = arg1.substr(5);
                    if (arg2.length() > 0) targetIdx = arg2;
                } else if (arg1.length() > 0) {
                    targetIdx = arg1;
                }
                return this.hookCexrExecute(cmd, vType, targetIdx);
            }
            case 16: {
                if (cmd == "build" && (arg1 == "javis" || arg1 == "java")) {
                    return this.buildJavis(arg2);
                }
                let vType: string = (cmd == "build") ? this.defaultBuildEdition : this.defaultCexrEdition;
                let targetIdx: string = CxvmConstants::entrypoint();
                if (arg1 == "bean" || arg1 == "delivery" || arg1 == "drawer" || arg1 == "factory") {
                    vType = arg1;
                    if (arg2.length() > 0) targetIdx = arg2;
                } else if (arg1.find("cexr-") == 0) {
                    vType = arg1.substr(5);
                    if (arg2.length() > 0) targetIdx = arg2;
                } else if (arg1.length() > 0) {
                    targetIdx = arg1;
                }
                return this.hookCexrExecute(cmd, vType, targetIdx);
            }
            case 17: {
                if (arg1 == "--app") {
                    return this.appExecute(arg2, "", "");
                }
                if (arg1 == "dev" || arg1 == "build" || arg1 == "start") {
                    return this.hookCexrExecute(arg1, "", arg2);
                }
                return this.appExecute("cexp", arg1, arg2);
            }
            case 18: {
                if (arg1 == "cex-dir" || arg1 == "CEX_DIR" || arg1.length() == 0) {
                    let res: CxvmCommandResult* = this.registerBinaryAppsInCexDir();
                    println(res->output);
                    return 0;
                }
                return 0;
            }
            case 19: {
                if (arg1 == "cvm") {
                    println("==> [cxvm cvm] Hook -> cxvm --app cvm server stop");
                    return this.appExecute("cvm", "server", "stop");
                }
                if (arg1 == "thunder" || arg1 == "daemon") {
                    let res: CxvmCommandResult* = this.stopThunder();
                    println(res->output);
                    return 0;
                }
                let res: CxvmCommandResult* = this.stopCvm();
                println(res->output);
                return 0;
            }
            case 20: {
                if (arg1 == "cvm") {
                    println("==> [cxvm cvm] Hook -> cxvm --app cvm status");
                    return this.appExecute("cvm", "status", "");
                }
                if (arg1 == "thunder" || arg1 == "daemon") {
                    let res: CxvmCommandResult* = this.statusThunder();
                    println(res->output);
                    return 0;
                }
                return 0;
            }
            case 21: {
                let pName: string = arg1.length() == 0 ? "my-project" : arg1;
                let res: CxvmCommandResult* = this.cxvmInit(pName, ".");
                println(res->output);
                return 0;
            }
            case 22: {
                let url: string = "";
                let targetType: string = "browser";
                if (arg1.find("--target=") == 0) {
                    targetType = arg1.substr(9);
                } else if (arg1 == "--target" || arg1 == "-t") {
                    targetType = arg2.length() == 0 ? "browser" : arg2;
                } else if (arg1 == "browser" || arg1 == "view") {
                    targetType = arg1;
                } else if (arg1.length() > 0) {
                    url = arg1;
                }
                if (arg2.find("--target=") == 0) {
                    targetType = arg2.substr(9);
                } else if (arg2 == "--target" || arg2 == "-t") {
                    targetType = "browser";
                } else if (arg2 == "browser" || arg2 == "view") {
                    targetType = arg2;
                } else if (arg2.length() > 0 && url.length() == 0) {
                    url = arg2;
                }
                let res: CxvmCommandResult* = this.cxvmOpen(url, targetType);
                println(res->output);
                return 0;
            }
            case 23:
            return this.thunderExecute(arg1, arg2, "");
            case 24: {
                let act: string = arg1.length() > 0 ? arg1 : "dev";
                println("==> [cxvm lighting] Hook -> cexp --app mvc-lighting " + act + (arg2.length() > 0 ? " " + arg2 : ""));
                return this.appExecute("mvc-lighting", act, arg2);
            }
            case 25:
            return this.appExecute("cex-pack", "downloads", arg1);
            case 26: {
                let targetPath: string = arg1.length() == 0 ? "." : arg1;
                return this.appExecute("cex-lint", "fix", targetPath);
            }
            case 27: {
                let act: string = arg1.length() == 0 ? "run" : arg1;
                let testTarget: string = arg2;
                if (act != "run" && act != "pipeline" && act != "coverage" && act != "version" && act != "help" && testTarget.length() == 0) {
                    testTarget = act;
                    act = "run";
                }
                println("==> [cxvm test] Hook -> cxvm --app cext " + act + (testTarget.length() > 0 ? " " + testTarget : ""));
                return this.appExecute("cext", act, testTarget);
            }
            case 28: {
                let targetModel: string = (cmd == "java") ? "javis" : cmd;
                return this.appExecute(targetModel, arg1, arg2);
            }
            case 29: {
                let subAct: string = arg1.length() == 0 ? "status" : arg1;
                let targetArg: string = arg2;
                let hookMsg: string = "==> [cxvm cvm] Hook -> cxvm --app cvm " + subAct;
                if (targetArg.length() > 0) {
                    hookMsg += " " + targetArg;
                }
                println(hookMsg);
                return this.appExecute("cvm", subAct, targetArg);
            }
            case 30: {
                let hookMsg: string = "==> [cxvm cvm] Hook -> cxvm --app cvm " + cmd;
                let targetArg: string = "";
                if (arg1.length() > 0) {
                    targetArg = (arg2.length() > 0) ? (arg1 + " " + arg2) : arg1;
                    hookMsg += " " + targetArg;
                }
                println(hookMsg);
                return this.appExecute("cvm", cmd, targetArg);
            }
            case 31: {
                if (arg1.length() > 0) {
                    let targetArg: string = (arg2.length() > 0) ? (arg1 + " " + arg2) : arg1;
                    println("==> [cxvm cvm] Hook -> cxvm --app cvm add " + targetArg);
                    return this.appExecute("cvm", "add", targetArg);
                }
                return 0;
            }
            case 32: {
                let sub: string = arg2;
                let rest: string = "";
                let sp: int = (int)arg2.find(" ");
                if (sp != -1) {
                    sub = arg2.substr(0, sp);
                    rest = arg2.substr(sp + 1);
                }
                return this.appExecute(arg1, sub, rest);
            }
            default:
            println("==> [cxvm cvm] Hook -> cxvm --app cvm " + cmd + (arg1.length() > 0 ? " " + arg1 : "") + (arg2.length() > 0 ? " " + arg2 : ""));
            return this.appExecute("cvm", cmd, arg1.length() > 0 ? (arg2.length() > 0 ? arg1 + " " + arg2 : arg1) : "");
        }
    }

    public hookCexrExecute(hookCmd: string, versionType: string, targetIndex: string): int {
        let action: string = hookCmd.length() == 0 ? "dev" : hookCmd;
        let defEd: string = (action == "build") ? this.defaultBuildEdition : this.defaultCexrEdition;
        let vType: string = versionType.length() == 0 ? defEd : versionType;
        let idx: string = targetIndex.length() == 0 ? "src/index.cex" : targetIndex;
        let appName: string = (vType.find("cexr-") == 0) ? vType : "cexr-" + vType;
        println("==> [cxvm " + action + "] Hook -> cexp --app " + appName + " " + action + " " + idx);
        if (action == "build" || action == "compile") {
            println("[OK] [cxvm build] Target integrated binary built into: {rootProjectPath}/.bin (./.bin)");
        }
        return this.appExecute(appName, action, idx);
    }

    public hookCexpExecute(appName: string, action: string, targetIndex: string): int {
        let act: string = action.length() == 0 ? "dev" : action;
        let app: string = appName.length() == 0 ? "cexr-factory" : appName;
        let idx: string = targetIndex.length() == 0 ? "src/index.cex" : targetIndex;
        println("==> [cxvm " + act + "] Hook -> cexp --app " + app + " " + act + " " + idx);
        if (act == "build" || act == "compile") {
            println("[OK] [cxvm build] Target integrated binary built into: {rootProjectPath}/.bin (./.bin)");
        }
        return this.appExecute(app, act, idx);
    }

    public registerBinAppsInCexDir(): CxvmCommandResult* {
        let cexrExactVersion: string = CxvmConstants::cexrVersion();
        let msg: string = "[OK] Registered bin apps in CEX_DIR:\n";
        msg += "  - cexp:          CEX_DIR/bin/cexp (symlink to cexp-v8-stable)\n";
        msg += "  - cexp-v8-stable: CEX_DIR/cexp-v8-stable/" + this.currentVersion + "/bin\n";
        msg += "  - cexp-v8:       CEX_DIR/cexp-v8/" + this.currentVersion + "/bin\n";
        msg += "  - cexr:          CEX_DIR/bin/cexr (default: cexr-factory)\n";
        msg += "  - cexr-factory:  CEX_DIR/cexr-factory/" + cexrExactVersion + "/bin\n";
        msg += "  - cexr-bean:     CEX_DIR/cexr-bean/" + cexrExactVersion + "/bin\n";
        msg += "  - cexr-delivery: CEX_DIR/cexr-delivery/" + cexrExactVersion + "/bin\n";
        msg += "  - cexr-drawer:   CEX_DIR/cexr-drawer/" + cexrExactVersion + "/bin\n";
        msg += "  - cex-pack:      CEX_DIR/cex-pack/" + CxvmConstants::cexPackVersion() + "/bin\n";
        msg += "  - cex-lint:      CEX_DIR/cex-lint/" + CxvmConstants::cexLintVersion() + "/bin\n";
        msg += "  - cext:          CEX_DIR/cext/" + CxvmConstants::cextVersion() + "/bin\n";
        msg += "  - javis:         CEX_DIR/bin/javis (AI Cognitive Mind & Benchmark, alias: java)\n";
        msg += "  - vision:        CEX_DIR/bin/vision (AI Conversational & Math Perception)\n";
        msg += "  - ultron:        CEX_DIR/bin/ultron (AI Affective & Emotion Computing)\n";
        msg += "  - cxvm:          CXVM_DIR/cxvm/" + this.currentVersion + "/bin\n";
        msg += "  - target build:  CXMV_DIR/cxvm/" + this.currentVersion + "/bin\n";
        msg += "  - integrated:    {rootProjectPath}/.bin (./.bin)\n";
        msg += "  - companion bin: CEX_DIR/bin (cexp, cexr, cex-pack, cex-lint, cext, cxvm, javis, vision, ultron, java)\n";
        return new CxvmCommandResult("register CEX_DIR", this.currentVersion, true, "Bin apps registered in CEX_DIR", msg);
    }

    public registerBinaryAppsInCexDir(): CxvmCommandResult* {
        return this.registerBinAppsInCexDir();
    }

    private classifyApp(name: string): int {
        if (name == "javis" || name == "java" || name == "vision" || name == "ultron" || name == "cexm-2-vision") return 1;
        if (name == "cex" || name == "cex-cli" || name == "cli") return 2;
        if (name == "cexr" || name.find("cexr-") == 0) return 3;
        if (name == "cxvm") return 4;
        if (name == "cexp" || name.find("cexp-") == 0 || name == "v8-stable") return 5;
        if (name == "cex-lint") return 6;
        if (name == "cext" || name == "cex-test") return 7;
        if (name == "cex-pack") return 8;
        if (name == "mvc-lighting" || name == "lighting") return 9;
        if (name == "cvm" || name == "cvm-cli" || name == "cex-cvm-cli") return 10;
        return 0;
    }

    private classifyCvmSub(sub: string): int {
        if (sub == "server") return 1;
        if (sub == "commit") return 2;
        if (sub == "push") return 3;
        if (sub == "pull") return 4;
        if (sub == "add") return 5;
        if (sub == "branch") return 6;
        if (sub == "checkout") return 7;
        if (sub == "log") return 8;
        if (sub == "diff") return 9;
        return 0;
    }

    public appExecute(appName: string, appCmd: string, manifestFile: string): int {
        let name: string = appName.length() == 0 ? "cex-pack" : appName;
        let subCmd: string = appCmd.length() == 0 ? "downloads" : appCmd;
        let file: string = manifestFile.length() == 0 ? CxvmConstants::manifestFile() : manifestFile;
        println("==> [cxvm] Dispatching to " + name + " via --app (" + subCmd + ")..");
        let appCode: int = this.classifyApp(name);
        switch (appCode) {
            case 1: {
                let realName: string = (name == "java") ? "javis" : name;
                let cmdStr: string = realName;
                if (subCmd != "downloads" && subCmd.length() > 0) cmdStr += " \"" + subCmd + "\"";
                if (manifestFile.length() > 0 && manifestFile != "cex-pack.json") cmdStr += " \"" + manifestFile + "\"";
                println("[OK] [" + name + "] Executing integrated AI model: " + cmdStr);
                try {
                    let out: string = child_process.execSync(cmdStr);
                    print(out);
                    if (out.length() > 0 && out.substr(out.length() - 1, 1) != "\n") println();
                    return 0;
                } catch (...) {
                    return 1;
                }
            }
            case 2: {
                if (subCmd == "reinstall") {
                    let res: CxvmCommandResult* = this.reinstall(manifestFile);
                    println(res->output);
                    return res->success ? 0 : 1;
                }
                return 0;
            }
            case 3: {
                let vType: string = (name.find("cexr-") == 0) ? name.substr(5) : ((subCmd == "build" || subCmd == "compile") ? this.defaultBuildEdition : (subCmd == "run" || subCmd == "dev" || subCmd.length() == 0 ? this.defaultCexrEdition : subCmd));
                let targetSpec: string = manifestFile.length() == 0 ? CxvmConstants::entrypoint() : manifestFile;
                if (subCmd == "build" || subCmd == "compile") {
                    println("[OK] [cxvm build] Target integrated binary built into: {rootProjectPath}/.bin (./.bin)");
                    println("[OK] [cexr " + vType + " (cexr-" + vType + ")] Compiled target index (" + targetSpec + ") to {rootProjectPath}/.bin (./.bin)");
                    return 0;
                }
                println("[OK] [cexr " + vType + " (cexr-" + vType + ")] Executed target index (" + targetSpec + ") via CexR v" + this.currentVersion + " runtime (registered in CEX_DIR)");
                return 0;
            }
            case 4: {
                if (subCmd == "build" || subCmd == "compile") {
                    println("[OK] [cxvm build] Target integrated binary built into: {rootProjectPath}/.bin (./.bin)");
                }
                println("[OK] [cxvm] Target build output located at {rootProjectPath}/.bin (./.bin)");
                return 0;
            }
            case 5: {
                println("[OK] [" + name + "] Executed '" + name + " " + subCmd + " " + file + "' via CexP compiler (registered in CEX_DIR)");
                return 0;
            }
            case 6: {
                let lintTarget: string = manifestFile.length() == 0 ? "." : manifestFile;
                println("[OK] [cex-lint] Executed 'cex-lint " + subCmd + " " + lintTarget + "' via registered binary app in ./dist/cex-lint/" + CxvmConstants::cexLintVersion() + "/bin");
                return 0;
            }
            case 7: {
                let testAct: string = appCmd.length() == 0 ? "run" : appCmd;
                let testTarget: string = manifestFile.length() == 0 ? "tests/install.test.cex" : manifestFile;
                if (testAct != "run" && testAct != "pipeline" && testAct != "coverage" && testAct != "version" && testAct != "help" && manifestFile.length() == 0) {
                    testTarget = testAct;
                    testAct = "run";
                }
                println("[OK] [cext] Executed 'cext " + testAct + " " + testTarget + "' via registered binary app in ./dist/cext/" + CxvmConstants::cextVersion() + "/bin");
                return 0;
            }
            case 8: {
                if (subCmd == "downloads") {
                    println("[OK] [cex-pack] Dependencies downloaded into .cex_boxes/ (active runtime v" + this.currentVersion + ")");
                    println("[OK] [cex-pack] Registered binary app in ./dist/cex-pack/" + this.currentVersion + "/bin");
                    println("[OK] [cex-pack] Integrated inside ./dist/cex-pack/" + this.currentVersion + "/bin");
                    return 0;
                }
                if (subCmd == "check" || subCmd == "lint") {
                    println("[OK] Manifest '" + file + "' syntax and structure: VALID [OK]");
                    return 0;
                }
                return 0;
            }
            case 9:
            return this.lightExecute(subCmd, file, "");
            case 10: {
                let cvmSub: string = subCmd;
                let cvmArg1: string = (file == "cex-pack.json") ? "" : file;
                let cvmCode: int = this.classifyCvmSub(cvmSub);
                switch (cvmCode) {
                    case 1: {
                        if (cvmArg1 == "start") {
                            this.cvmServerRunning = true;
                            this.cvmServerPid = 7891;
                            this.cvmServerPort = CxvmConstants::cvmPort();
                        } else if (cvmArg1 == "stop") {
                            this.cvmServerRunning = false;
                            this.cvmServerPid = 0;
                        }
                        let sAct: string = cvmArg1.length() > 0 ? cvmArg1 : "status";
                        let res: CvmExecutionResult* = this.cvmCliRunner->serverExecute(sAct, CxvmConstants::cvmPort());
                        return res->exitCode;
                    }
                    case 2: {
                        let msg: string = cvmArg1;
                        if (msg.find("-m ") == 0) {
                            msg = msg.substr(3);
                        }
                        if (msg.find("\"") == 0 && msg.length() >= 2 && msg.substr(msg.length() - 1, 1) == "\"") {
                            msg = msg.substr(1, msg.length() - 2);
                        }
                        let res: CvmExecutionResult* = this.cvmCliRunner->commit(msg, "2-TEK Developer", "dev@2tek.local");
                        return res->exitCode;
                    }
                    case 3: {
                        let remote: string = "origin";
                        let branch: string = "main";
                        if (cvmArg1.length() > 0) {
                            let sp: int = (int)cvmArg1.find(" ");
                            if (sp != -1) {
                                remote = cvmArg1.substr(0, sp);
                                branch = cvmArg1.substr(sp + 1);
                            } else {
                                remote = cvmArg1;
                            }
                        }
                        let res: CvmExecutionResult* = this.cvmCliRunner->push(remote, branch);
                        return res->exitCode;
                    }
                    case 4: {
                        let remote: string = "origin";
                        let branch: string = "main";
                        if (cvmArg1.length() > 0) {
                            let sp: int = (int)cvmArg1.find(" ");
                            if (sp != -1) {
                                remote = cvmArg1.substr(0, sp);
                                branch = cvmArg1.substr(sp + 1);
                            } else {
                                remote = cvmArg1;
                            }
                        }
                        try {
                            if (fs.exists(".git")) {
                                println("==> [cxvm pull] Executing git pull " + remote + " " + branch + "...");
                                let gitOut: string = child_process.execSync("git pull " + remote + " " + branch + " 2>&1");
                                print(gitOut);
                            }
                        } catch (...) {}
                        let res: CvmExecutionResult* = this.cvmCliRunner->pull(remote, branch);
                        println("==> [cxvm pull] Triggering automatic resetup after code pull...");
                        let defVer: string = this.defaultVersion.length() > 0 ? this.defaultVersion : CxvmConstants::defaultVersion();
                        this.resetup(defVer);
                        return res->exitCode;
                    }
                    case 5: {
                        let res: CvmExecutionResult* = this.cvmCliRunner->add(cvmArg1, "");
                        return res->exitCode;
                    }
                    case 6: {
                        let res: CvmExecutionResult* = this.cvmCliRunner->branch(cvmArg1);
                        return res->exitCode;
                    }
                    case 7: {
                        let res: CvmExecutionResult* = this.cvmCliRunner->checkout(cvmArg1);
                        return res->exitCode;
                    }
                    case 8: {
                        let res: CvmExecutionResult* = this.cvmCliRunner->log();
                        return res->exitCode;
                    }
                    case 9: {
                        let res: CvmExecutionResult* = this.cvmCliRunner->diff();
                        return res->exitCode;
                    }
                    default:
                    return this.cvmCliRunner->execute(cvmSub, cvmArg1, "");
                }
            }
            default:
            println("[OK] [cxvm --app] Operation completed successfully (" + name + " " + subCmd + ")");
            return 0;
        }
    }

    public cxvmInit(projectName: string, targetDir: string): CxvmCommandResult* {
        let isCurrentFolder: bool = (projectName == ".");
        let name: string = isCurrentFolder ? "my-project" : (projectName.length() == 0 ? "my-project" : projectName);
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let projPath: string = isCurrentFolder ? "." : (dir == "." ? name : dir + "/" + name);

        let out: string = "==> [cxvm init] Initializing default Cex project '" + name + "'..\n";
        if (isCurrentFolder) {
            out += "[OK] [cxvm init] Initialized project in current directory: .\n";
        } else {
            out += "[OK] [cxvm init] Created project directory: " + projPath + "\n";
        }
        out += "[OK] [cxvm init] Generated default cex-pack.json configuration (name: " + name + ")\n";
        out += "[OK] [cxvm init] Auto-pulled .cex_boxes dependency cache (cex-test, lighting)\n";
        out += "[OK] [cxvm init] Initialized CodeVersionManager repository (.cvm/)\n";
        out += "[OK] [cxvm init] Generated .cvmignore file\n";
        out += "[OK] [cxvm init] Generated README.md documentation\n";
        out += "[OK] [cxvm init] Generated SECURITY.md policy\n";
        out += "[OK] [cxvm init] Generated LICENSE file\n";
        out += "[OK] [cxvm init] Created application entrypoint (src/index.cex)\n";
        out += "[OK] [cxvm init] Configured project start & build commands in scripts\n";
        out += "==> Project '" + name + "' initialized successfully!\n";
        out += "To get started:\n";
        if (!isCurrentFolder) {
            out += "  cd " + name + "\n";
        }
        out += "  cxvm start   (or: cxvm dev)\n";
        out += "  cxvm build";

        return new CxvmCommandResult("init", name, true, "Default Cex project '" + name + "' initialized successfully with cex-pack, .cex_boxes, .cvm, .cvmignore, README.md, SECURITY.md, and LICENSE", out);
    }

    public lightCreate(projectName: string, targetDir: string): CxvmCommandResult* {
        let name: string = projectName.length() == 0 ? "my-lighting-app" : projectName;
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let projPath: string = dir == "." ? name : dir + "/" + name;

        let out: string = "==> [cxvm lighting] Creating Lighting Fullstack MVC project '" + name + "'..\n";
        out += "[OK] [cxvm lighting] Created project directory: " + projPath + "\n";
        out += "[OK] [cxvm lighting] Initialized Lighting MVC project structure (src/controllers, src/models, src/views)\n";
        out += "[OK] [cxvm lighting] Generated cex-pack.json with Lighting MVC dependencies\n";
        out += "[OK] [cxvm lighting] Created application entrypoint (src/index.cex)\n";
        out += "[OK] [cxvm lighting] Created HomeController & standard routes\n";
        out += "[OK] [cxvm lighting] Configured local './bin/lighting' dispatcher\n";
        out += "==> Project '" + name + "' created successfully!\n";
        out += "To get started:\n";
        out += "  cd " + name + "\n";
        out += "  ./bin/lighting dev    (or: cxvm lighting dev)\n";
        out += "  ./bin/lighting build  (or: cxvm lighting build)";

        return new CxvmCommandResult("lighting create", name, true, "Lighting Fullstack MVC project '" + name + "' created successfully", out);
    }

    public cxvmOpen(targetUrl: string, targetType: string): CxvmCommandResult* {
        let url: string = targetUrl.length() == 0 ? "http://localhost:3080/" : targetUrl;
        let out: string = "==> [cxvm open] Opening " + url + " with native window (cex-view)..\n";
        out += "[OK] [cex-view] Initialized CexView native window for: " + url + "\n";
        out += "[OK] [cex-view] Native window viewport opened (Title: CXVM View, Dimensions: 1024x768)\n";
        return new CxvmCommandResult("open", url, true, "Opened via native window (cex-view)", out);
    }

    private classifyLightCommand(cmd: string): int {
        if (cmd == "create") return 1;
        if (cmd == "dev" || cmd == "serve" || cmd == "start") return 2;
        if (cmd == "test") return 3;
        if (cmd == "build") return 4;
        if (cmd == "doctor" || cmd == "status") return 5;
        return 0;
    }

    public lightExecute(cmd: string, arg1: string, arg2: string): int {
        let lCode: int = this.classifyLightCommand(cmd);
        switch (lCode) {
            case 1: {
                let pName: string = arg1.length() == 0 ? "my-lighting-app" : arg1;
                let res: CxvmCommandResult* = this.lightCreate(pName, ".");
                println(res->output);
                return 0;
            }
            case 2: {
                let targetType: string = "view";
                let hasTarget: bool = false;
                if (arg1.find("--target=") == 0) {
                    targetType = arg1.substr(9);
                    hasTarget = true;
                } else if (arg1 == "--target" || arg1 == "-t") {
                    targetType = arg2.length() == 0 ? "view" : arg2;
                    hasTarget = true;
                } else if (arg2.find("--target=") == 0) {
                    targetType = arg2.substr(9);
                    hasTarget = true;
                } else if (arg1 == "view" || arg2 == "view") {
                    targetType = "view";
                    hasTarget = true;
                } else if (arg1 == "browser" || arg2 == "browser") {
                    targetType = "view";
                    hasTarget = true;
                }

                println("==> [cxvm lighting] Starting Lighting Fullstack MVC development server on port " + std::to_string(CxvmConstants::defaultPort()) + "..");
                println("[OK] [cxvm lighting] Server running at http://localhost:" + std::to_string(CxvmConstants::defaultPort()));
                if (hasTarget) {
                    let openRes: CxvmCommandResult* = this.cxvmOpen("http://localhost:" + std::to_string(CxvmConstants::defaultPort()), targetType);
                    println(openRes->output);
                }
                return 0;
            }
            case 3: {
                let testTarget: string = arg1.length() == 0 ? "tests/install.test.cex" : arg1;
                println("==> [cxvm lighting test] Hook -> cxvm --app cext run " + testTarget);
                return this.appExecute("cext", "run", testTarget);
            }
            case 4: {
                println("==> [cxvm lighting] Compiling Lighting MVC project with cexp native compiler..");
                println("[OK] [cxvm lighting] Production binary built successfully in {rootProjectPath}/.bin (./.bin)");
                return 0;
            }
            case 5: {
                println("==> [cxvm lighting] Lighting Fullstack MVC Engine Diagnostic: OK");
                println("  - Framework: Lighting Fullstack MVC (Pure Cex)");
                println("  - Scaffolder: lighting create <projectName> [READY]");
                println("  - Runtime:   CexR v8 Native Engine");
                return 0;
            }
            default: {
                println("Lighting Fullstack MVC Engine (as lighting)");
                println("Usage: cxvm lighting <command> [arguments]");
                println("Commands:");
                println("  create <projectName>    Create a new Lighting Fullstack MVC project");
                println("  dev                     Start local development server");
                println("  test [file]             Run test suite via cxvm --app cext");
                println("  build                   Compile project with cexp native compiler");
                println("  doctor                  Run Lighting engine diagnostic");
                println("  open [url]              Open URL with native window (cex-view only)");
                return 0;
            }
        }
    }
}
