// 2-TEK Factory: Cex Version Manager (cxvm) Engine (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "./types.cex";
import "./models/version_model.cex";
import "@cex-cvm-cli/src/cli.cex";
import "./lighting_mvc.cex";
import child_process from "child_process";
import "@cex-cli/src/terminal.cex";
import "@cex-cli/src/cli.cex";
import "@cex-service/src/app.cex";
import "@cex-std/src/filesystem.cex";
import "@cex-std/src/chrono.cex";

class CxvmEngine {
    public currentVersion: string = "";
    public defaultVersion: string = "";
    public cliRunner: CexCLI* = new CexCLI();
    public installedVersions: Array<string>* = new Array<string>();
    public availableVersions: Array<VersionModel*>* = new Array<VersionModel*>();
    public supportedPlatforms: Array<string>* = new Array<string>();
    public cxvmHome: string = "$HOME/.cxvm";
    public cvmCliRunner: CexCvmCLI* = new CexCvmCLI();
    public cvmServerRunning: bool = false;
    public cvmServerPid: int = 0;
    public cvmServerPort: int = CxvmConstants::cvmPort();
    public thunderRunning: bool = false;
    public thunderPid: int = 0;
    public thunderPort: int = CxvmConstants::thunderPort();
    public thunderContainersRunning: int = 0;
    public thunderTotalImages: int = 0;
    public lightEngineReady: bool = true;
    public lightingHome: string = "$CXVM_DIR/lighting";
    public defaultTarget: string = "view";
    public defaultCexrEdition: string = "factory";
    public defaultBuildEdition: string = "bean";
    public virtualLinuxReady: bool = false;
    public virtualLinuxKernel: string = "6.8.0-cex-thunder-virt";
    public virtualLinuxRootfs: string = "/root/.cxvm";
    public virtualLinuxContainerId: string = "cxt-3a8f9";
    public virtualLinuxIp: string = "172.18.0.12";
    public linuxDistroReady: bool = false;
    public linuxDistroName: string = "cex-linux";
    public linuxDistroVersion: string = "1.0.0";
    public linuxDistroKernel: string = "6.8.0-cex-rt";
    public linuxDistroRootfs: string = "/var/lib/cxvm/distros/cex-linux";
    public linuxDistroStatus: string = "uninstalled";
    public installedDistros: Array<string>* = new Array<string>();
    public supportedDistros: Array<string>* = new Array<string>();
    public isForce: bool = false;

    public constructor() {
        this.supportedDistros->push("cex-linux");
        this.supportedDistros->push("alpine");
        this.supportedDistros->push("ubuntu");
        this.supportedDistros->push("debian");
        this.supportedDistros->push("arch");

        this.initCatalog();
        this.initPlatforms();
        this.install(CxvmConstants::defaultVersion());
        this.use(CxvmConstants::defaultVersion());
        this.setDefault(CxvmConstants::defaultVersion());
    }

    private initPlatforms(): void {
        this.supportedPlatforms->push("linux-x86_64");
        this.supportedPlatforms->push("linux-aarch64");
        this.supportedPlatforms->push("darwin-arm64");
        this.supportedPlatforms->push("darwin-x86_64");
        this.supportedPlatforms->push("windows-x64");
        this.supportedPlatforms->push("windows-arm64");
    }

    private initCatalog(): void {
        this.availableVersions->push(new VersionModel("8.0.0", "STABLE", "2026-10-07", "CexR v8 & CexP v8 Pure Engine", "CexR v8 Native cex_boxes Dist Loader Runtime & CexP v8 Direct Machine Compiler (Default)", true));
        this.availableVersions->push(new VersionModel("6.0.0", "LTS", "2026-10-07", "CexR v6 & CexP v6 Pure Engine", "CexR v6 High-Performance Native Server Engine & Direct Machine Compiler", false));
        this.availableVersions->push(new VersionModel("5.0.0", "LTS", "2026-10-07", "CexR v5 & CexP v5 Pure Engine", "CexR v5 Native Server Engine & Direct Machine Compiler", false));
        this.availableVersions->push(new VersionModel("3.0.0", "LTS", "2026-10-07", "CexR v3 & CexP v3 Pure Engine", "CexR v3 Native Machine Engine & CexP v3 Direct Compiler", false));
        this.availableVersions->push(new VersionModel("2.0.0", "LTS", "2026-09-01", "CexR v2 & CexP v2 Pure Engine", "CexR v2 Multi-Source Compiler & Self-Hosted Engine", false));
        this.availableVersions->push(new VersionModel("1.0.0", "LEGACY", "2026-08-01", "CexR v1 & CexP v1 Pure Engine", "CexR v1 Native Machine Runtime & Standard Libraries", false));
    }

    public isVersionAvailable(ver: string): bool {
        let count: int = (int)this.availableVersions->length();
        for (let i: int = 0; i < count; i++) {
            if (this.availableVersions->get(i)->version === ver) {
                return true;
            }
        }
        return false;
    }

    public isVersionInstalled(ver: string): bool {
        let count: int = (int)this.installedVersions->length();
        for (let i: int = 0; i < count; i++) {
            if (this.installedVersions->get(i) === ver) {
                return true;
            }
        }
        return false;
    }

    public isPlatformSupported(platformId: string): bool {
        let count: int = (int)this.supportedPlatforms->length();
        for (let i: int = 0; i < count; i++) {
            if (this.supportedPlatforms->get(i) === platformId) {
                return true;
            }
        }
        return false;
    }

    public resolveRootBuildPath(): string {
        let envRootPath: char* = getenv("ROOT_PATH");
        if (envRootPath != nullptr && string(envRootPath).length() > 0) return string(envRootPath);
        let envBuild: char* = getenv("ROOT_BUILD_PATH");
        if (envBuild != nullptr && string(envBuild).length() > 0) return string(envBuild);
        let envCexBuild: char* = getenv("CEX_BUILD_PATH");
        if (envCexBuild != nullptr && string(envCexBuild).length() > 0) return string(envCexBuild);
        let envCexDir: char* = getenv("CEX_DIR");
        if (envCexDir != nullptr && string(envCexDir).length() > 0) return string(envCexDir);
        let envCxvmDir: char* = getenv("CXVM_DIR");
        if (envCxvmDir != nullptr && string(envCxvmDir).length() > 0) return string(envCxvmDir);
        return this.cxvmHome;
    }

    public resolveBinary(toolName: string): string {
        let envKey: string = toolName + "_BIN";
        for (let i: int = 0; i < (int)envKey.length(); i++) {
            let cVal: int = (int)envKey[i];
            if (cVal >= 97 && cVal <= 122) {
                envKey[i] = (char)(cVal - 32);
            } else if (cVal == 45) {
                envKey[i] = (char)95;
            }
        }
        let envBin: char* = getenv(envKey.c_str());
        if (envBin != nullptr && string(envBin).length() > 0 && fs.exists(string(envBin))) {
            return string(envBin);
        }
        let envBinDirect: char* = getenv(toolName.c_str());
        if (envBinDirect != nullptr && string(envBinDirect).length() > 0 && fs.exists(string(envBinDirect))) {
            return string(envBinDirect);
        }
        let rootPath: string = this.resolveRootBuildPath();
        if (rootPath.length() > 0 && fs.exists(rootPath + "/" + toolName + "/bin")) {
            return rootPath + "/" + toolName + "/bin";
        }
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        if (fs.exists(curPwd + "/.bin")) {
            return curPwd + "/.bin";
        }
        if (fs.exists(this.cxvmHome + "/bin/" + toolName)) {
            return this.cxvmHome + "/bin/" + toolName;
        }
        return toolName;
    }

    public getArchiveFilename(version: string, platformId: string): string {
        let ext: string = "tar.gz";
        if (platformId.find("windows") != -1) {
            ext = "zip";
        }
        return "cex-v" + version + "-" + platformId + "." + ext;
    }

    public download(version: string, platformId: string): CxvmCommandResult* {
        let ver: string = version.length() === 0 ? "8.0.0" : version;
        if (!this.isVersionAvailable(ver)) {
            return new CxvmCommandResult("download", ver, false, "Version v" + ver + " is not available in Factory catalog.", "Error: Remote version not found");
        }

        let plat: string = platformId.length() === 0 ? "linux-x86_64" : platformId;
        if (!this.isPlatformSupported(plat)) {
            return new CxvmCommandResult("download", ver, false, "Platform " + plat + " is not supported.", "Error: Unsupported target platform");
        }

        let archive: string = this.getArchiveFilename(ver, plat);
        let cachePath: string = this.cxvmHome + "/cache/" + archive;

        let outMsg: string = "==> [cxvm] Downloading cross-platform bundle for " + plat + " (Cex v" + ver + " to install cexr)..\n";
        outMsg += "--> Cache location: " + cachePath + "\n";
        let fmt: string = plat.find("windows") != -1 ? "zip" : "tar.gz";
        outMsg += "--> Verified format: " + fmt + " archive\n";
        outMsg += "==> Successfully cached " + archive + " in " + this.cxvmHome + "/cache/ ready for install";

        return new CxvmCommandResult("download", ver, true, "Successfully downloaded " + archive + " to cache for cexr install", outMsg);
    }

    public downloadAll(version: string): CxvmCommandResult* {
        let ver: string = version.length() === 0 ? "8.0.0" : version;
        if (!this.isVersionAvailable(ver)) {
            return new CxvmCommandResult("download", ver, false, "Version v" + ver + " is not available in Factory catalog.", "Error: Remote version not found");
        }

        let count: int = (int)this.supportedPlatforms->length();
        let outMsg: string = "==> [cxvm] Downloading all " + std::to_string(count) + " cross-platform bundles for Cex v" + ver + " to install cexr:\n";
        for (let i: int = 0; i < count; i++) {
            let plat: string = this.supportedPlatforms->get(i);
            let archive: string = this.getArchiveFilename(ver, plat);
            outMsg += "  [" + std::to_string(i + 1) + "/" + std::to_string(count) + "] " + archive + " -> " + this.cxvmHome + "/cache/" + archive + " [OK]\n";
        }
        outMsg += "==> All cross-platform distribution bundles ready for installing cexr across Linux, macOS, and Windows";

        return new CxvmCommandResult("download", ver, true, "Successfully downloaded all " + std::to_string(count) + " cross-platform bundles for v" + ver, outMsg);
    }

    public install(version: string): CxvmCommandResult* {
        if (!this.isVersionAvailable(version)) {
            return new CxvmCommandResult("install", version, false, "Version v" + version + " is not available in Factory catalog.", "Error: Remote version not found");
        }

        if (this.isVersionInstalled(version)) {
            return new CxvmCommandResult("install", version, true, "Version v" + version + " is already installed.", "v" + version + " already installed in " + this.cxvmHome);
        }

        this.installedVersions->push(version);
        if (this.currentVersion.length() === 0) {
            this.currentVersion = version;
            this.defaultVersion = version;
        }

        let shortVer: string = (int)version.length() > 0 ? "v" + version.substr(0, 1) : "v8";
        let outMsg: string = "==> Installing Cex v" + version + " (" + shortVer + " - Pure Cex Native Engine)..\n";
        outMsg += "--> Verified checksum: PASSED [OK]\n";
        let rootBuild: string = this.resolveRootBuildPath();
        outMsg += "--> Deployed into " + rootBuild + "/cexp-" + shortVer + "/" + version + "/bin & " + rootBuild + "/cexr-factory/1.0.26/bin\n";
        outMsg += "  [OK] [auto-install] cexr v" + version + " runtime engine installed\n";
        outMsg += "  [OK] [auto-install] cexp v" + version + " (" + shortVer + ") machine compiler installed\n";
        outMsg += "  [OK] [auto-install] cex-lint v1.0.8 integrated into " + rootBuild + "/cex-lint/1.0.8/bin\n";
        outMsg += "  [OK] [auto-install] cext v1.0.14 integrated into " + rootBuild + "/cext/1.0.14/bin\n";
        outMsg += "  [OK] [auto-install] cvm CodeVersionManager engine installed\n";
        outMsg += "  [OK] [auto-install] thunder Container Engine & Virtual Microkernel installed\n";
        outMsg += "  [OK] [auto-install] lighting Lighting Fullstack MVC Engine (as light) installed\n";
        outMsg += "  [OK] [auto-start] cexr runtime engine active & verified\n";
        outMsg += "  [OK] [auto-start] cexp direct machine compiler ready\n";
        outMsg += "  [OK] [auto-start] cvm server started (single process standalone on port 4000)\n";
        outMsg += "  [OK] [auto-start] thunder server started (single process standalone on port 3050)\n";
        outMsg += "  [OK] [auto-start] lighting CLI & scaffolder engine ready (cxvm lighting create <project>)\n";
        outMsg += "==> Successfully installed and auto-started cexr, cexp, cvm, thunder, lighting for v" + version;

        this.startCvm(4000, true);
        this.startThunder(3050, true);
        return new CxvmCommandResult("install", version, true, "Successfully installed and auto-started cexr, cexp, cvm, thunder, lighting for v" + version, outMsg);
    }

    public use(version: string): CxvmCommandResult* {
        if (!this.isVersionInstalled(version)) {
            return new CxvmCommandResult("use", version, false, "Cex v" + version + " is not installed. Run 'cxvm install " + version + "' first.", "Error: Version not installed");
        }

        this.currentVersion = version;
        let shortVer: string = (int)version.length() > 0 ? "v" + version.substr(0, 1) : "v8";
        let outMsg: string = "==> Now using Cex v" + version + " (" + this.cxvmHome + "/bin/" + version + "/cexp-" + shortVer + ")";
        return new CxvmCommandResult("use", version, true, "Active version set to v" + version, outMsg);
    }

    public current(): string {
        if (this.currentVersion.length() === 0) {
            return "none";
        }
        return "v" + this.currentVersion;
    }

    public list(): string {
        let count: int = (int)this.installedVersions->length();
        if (count === 0) {
            return "  (No Cex versions installed. Run 'cxvm install 8.0.0')";
        }

        let out: string = "Installed Cex versions:\n";
        for (let i: int = 0; i < count; i++) {
            let ver: string = this.installedVersions->get(i);
            let verStatus: int = (ver === this.currentVersion) ? 1 : ((ver === this.defaultVersion) ? 2 : 0);
            switch (verStatus) {
                case 1:
                out += "  -> v" + ver + " (active";
                if (ver === this.defaultVersion) out += ", default";
                out += ")\n";
                break;
                case 2:
                out += "     v" + ver + " (default)\n";
                break;
                default:
                out += "     v" + ver + "\n";
                break;
            }
        }
        return out;
    }

    public listRemote(): string {
        let out: string = "Available Cex runtime versions (from Factory):\n";
        let count: int = (int)this.availableVersions->length();
        for (let i: int = 0; i < count; i++) {
            let v: VersionModel* = this.availableVersions->get(i);
            out += "  v" + v->version + " [" + v->channel + "] - " + v->description + "\n";
        }
        return out;
    }

    public setDefault(version: string): CxvmCommandResult* {
        if (!this.isVersionInstalled(version)) {
            return new CxvmCommandResult("default", version, false, "Cex v" + version + " must be installed before setting as default.", "Error: Not installed");
        }

        this.defaultVersion = version;
        this.currentVersion = version;
        return new CxvmCommandResult("default", version, true, "Default Cex set to v" + version, "==> Default Cex version set to v" + version);
    }

    public uninstall(version: string): CxvmCommandResult* {
        let count: int = (int)this.installedVersions->length();
        let foundIdx: int = -1;
        for (let i: int = 0; i < count; i++) {
            if (this.installedVersions->get(i) === version) {
                foundIdx = i;
                break;
            }
        }

        if (foundIdx === -1) {
            return new CxvmCommandResult("uninstall", version, false, "Version v" + version + " is not installed.", "Error: Version not found");
        }

        // Remove from list
        let nextList: Array<string>* = new Array<string>();
        for (let i: int = 0; i < count; i++) {
            if (i !== foundIdx) {
                nextList->push(this.installedVersions->get(i));
            }
        }
        this.installedVersions = nextList;

        if (this.currentVersion === version) {
            if ((int)this.installedVersions->length() > 0) {
                this.currentVersion = this.installedVersions->get(0);
            } else {
                this.currentVersion = "";
            }
        }

        if (this.defaultVersion === version) {
            this.defaultVersion = this.currentVersion;
        }

        return new CxvmCommandResult("uninstall", version, true, "Uninstalled v" + version, "==> Uninstalled Cex v" + version);
    }

    public cexrVersionOutput(): string {
        let ver: string = this.currentVersion.length() > 0 ? this.currentVersion : "8.0.0";
        let out: string = "CexR v" + ver + " (Native Machine Engine; Default Runtime: cexr-factory; Default Build: cexr-bean; CexR v8 cex_boxes Dist Loader; Pure Cex Toolchain)\n";
        out += "  [default-runtime] cexr-factory : CexR [factory] standalone (version " + ver + ", cexp ^8) - target: support for api cex-virtual-dom, cex-dom ; jit debug runtime; best for development\n";
        out += "  [default-build]   cexr-bean    : CexR [bean] standalone (version " + ver + ", cexp ^8) - target: one time compile, best performance with API\n";
        out += "  [edition]         cexr-delivery: CexR [delivery] standalone (version " + ver + ", cexp ^8) - target: jit support api only; best for api debug\n";
        out += "  [edition]         cexr-drawer  : CexR [drawer] standalone (version " + ver + ", cexp ^8) - target: jit support, but only cex-virtual-dom, cex-dom support, best for client\n";
        out += "  [compiler]        cexp         : Cex Engine (cexp-v8-stable) version " + ver + "\n";
        out += "  [pack-manager]    cex-pack     : cex-pack v1.0.5 (2-TEK Package & Dependency Manager for CexR v8)\n";
        out += "  [linter]          cex-lint     : CexLint v1.0.8 (" + this.resolveBinary("cex-lint") + ")\n";
        out += "  [test-runner]     cext         : CexTest v1.0.14 (" + this.resolveBinary("cext") + ")";
        return out;
    }

