        let out: string = "===============================================================\n";
        out += "       Cex Version Manager (cxvm v2) System Diagnostic Doctor   \n";
        out += "===============================================================\n";
        out += "  CXVM Home:         " + this.cxvmHome + "\n";
        out += "  Active Cex:        " + this.current() + "\n";
        out += "  Default Cex:       " + (this.defaultVersion.length() > 0 ? "v" + this.defaultVersion : "none") + "\n";
        out += "  CexR Runtime:      v8 (cex_boxes Dist Loader Runtime Engine [READY])\n";
        out += "  CexR Default Run:  cexr-" + this.defaultCexrEdition + " (" + this.defaultCexrEdition + " edition - JIT debug & DOM/API runtime [READY])\n";
        out += "  CexR Default Build: cexr-" + this.defaultBuildEdition + " (" + this.defaultBuildEdition + " edition - one-time compile & max performance [READY])\n";
        out += "  CexR Setup:        Cross-Platform Native Runtime Ready [OK]\n";
        out += "  CexP Compiler:     cexp-v8-stable (Direct Machine Code & ELF Emitter [READY])\n";
        out += "  CexLint Binary:    " + this.resolveBinary("cex-lint") + " [READY]\n";
        out += "  CexTest Binary:    " + this.resolveBinary("cext") + " [READY]\n";
        out += "  Toolchain Model:   Pure Cex Native Engine (cexr + cexp; zero C++ dependency)\n";
        out += "  CVM VCS Engine:    INTEGRATED [Git object store, commit graph, DAG merges, .cvm patches]\n";
        out += "  CVM Commands:      init, commit, push, pull, status, add, branch, checkout, log, diff [READY]\n";
        let cvmSrvStr: string = this.cvmServerRunning ? "RUNNING [Single Process Standalone on port " + std::to_string(this.cvmServerPort) + ", PID: " + std::to_string(this.cvmServerPid) + "]" : "STOPPED (run: cxvm start cvm)";
        out += "  CVM Server:        " + cvmSrvStr + "\n";
        out += "  Thunder Engine:    INTEGRATED [Virtual Linux 6.8 Microkernel, OCI Store, Cgroups v2, Auto-scaler]\n";
        out += "  Thunder Commands:  thunder, docker, container, run, ps, images, stats [READY]\n";
        let thunSrvStr: string = this.thunderRunning ? "RUNNING [Single Process Standalone on port " + std::to_string(this.thunderPort) + ", PID: " + std::to_string(this.thunderPid) + "]" : "STOPPED (run: cxvm start thunder)";
        out += "  Thunder Daemon:    " + thunSrvStr + "\n";
        out += "  Lighting Engine:   INTEGRATED [Lighting Fullstack MVC, Pure Cex Engine, lighting CLI scaffolder]\n";
        out += "  Lighting Commands: light, lighting, lighting create <project>, lighting dev, lighting build [READY]\n";
        out += "  Target Opener:     INTEGRATED [Native Window (cex-view only) READY]\n";
        out += "  CXVM Init:         INTEGRATED [cxvm init <name> (default: my-project, cex-pack, cex_boxes, .cvm, .cvmignore, README, SECURITY, LICENSE)]\n";
        out += "  Cross-Platform:    Linux (x86_64, aarch64), macOS (arm64, x86_64), Windows (x64, arm64)\n";
        out += "  Supported Targets: " + std::to_string((int)this.supportedPlatforms->length()) + " architectures (download & install ready)\n";
        out += "  Installed Count:   " + std::to_string((int)this.installedVersions->length()) + "\n";
        out += "  Runtime Bridge:    PASSED [CexR v8 native machine bridge active]\n";
        out += "  Diagnostic:        HEALTHY [OK]\n";
        return out;
    }

    public resolveLibVersion(libName: string): string {
        if (libName == "cxvm" || libName == "cxvm-bean") {
            let rootPack: string = "cex-pack.json";
            if (fs.exists(rootPack)) {
                let rRaw: string = fs.readFile(rootPack);
                let parsed: JsonValue* = JsonDoc::parse(rRaw);
                if (parsed != nullptr && parsed->has("version")) {
                    let vVal: JsonValue* = (JsonValue*)parsed->get("version");
                    if (vVal != nullptr) {
                        return vVal->asString();
                    }
                }
            }
        }
        if (libName == "cext" || libName == "cex-test") {
            return CxvmConstants::cextVersion();
        }
        if (libName.find("cexr-") == 0 || libName == "cexr") {
            return CxvmConstants::cexrVersion();
        }
        if (libName == "cex-lint") {
            return CxvmConstants::cexLintVersion();
        }
        if (libName == "cex-pack" || libName == "cex-pack-bean") {
            return CxvmConstants::cexPackVersion();
        }
        if (libName == "javis" || libName == "java" || libName == "models" || libName == "ultron") {
            return "1.0.0";
        }
        if (libName == "vision") {
            return "2.0.0";
        }
        if (libName == "builder" || libName == "cex-builder") {
            return "1.0.0";
        }
        let boxPack: string = "cex_boxes/" + libName + "/cex-pack.json";
        if (fs.exists(boxPack)) {
            let pRaw: string = fs.readFile(boxPack);
            let parsed: JsonValue* = JsonDoc::parse(pRaw);
            if (parsed != nullptr && parsed->has("version")) {
                let vVal: JsonValue* = (JsonValue*)parsed->get("version");
                if (vVal != nullptr) {
                    return vVal->asString();
                }
            }
        }
        let rootBuild: string = this.resolveRootBuildPath();
        let candDir: string = rootBuild + "/" + libName;
        if (fs.exists(candDir + "/bin")) {
            let linkTarget: string = child_process.execSync("readlink \"" + candDir + "/bin\" 2>/dev/null | tr -d '\\n'");
            if (linkTarget.length() > 0) {
                let slashPos: int = (int)linkTarget.find("/");
                if (slashPos != -1) {
                    return linkTarget.substr(0, slashPos);
                }
            }
        }
        if (fs.exists(candDir) && fs.isDir(candDir)) {
            let entries: Array<string>* = fs.readDir(candDir);
            let count: int = (int)entries->length();
            for (let i: int = 0; i < count; i++) {
                let item: string = entries->get(i);
                if (item == "." || item == ".." || item == "bin") continue;
                if (fs.exists(candDir + "/" + item + "/bin") || (fs.isDir(candDir + "/" + item) && item.find(".") != -1)) {
                    return item;
                }
            }
        }
        if (this.cxvmHome.length() > 0) {
            let homeCand: string = this.cxvmHome + "/" + libName;
            if (fs.exists(homeCand) && fs.isDir(homeCand)) {
                let entries: Array<string>* = fs.readDir(homeCand);
                let count: int = (int)entries->length();
                for (let i: int = 0; i < count; i++) {
                    let item: string = entries->get(i);
                    if (item == "." || item == ".." || item == "bin") continue;
                    if (fs.exists(homeCand + "/" + item + "/bin") || (fs.isDir(homeCand + "/" + item) && item.find(".") != -1)) {
                        return item;
                    }
                }
            }
        }
        let envCexDir: char* = getenv("CEX_DIR");
        if (envCexDir != nullptr && string(envCexDir).length() > 0) {
            let cdCand: string = string(envCexDir) + "/" + libName;
            if (fs.exists(cdCand) && fs.isDir(cdCand)) {
                let entries: Array<string>* = fs.readDir(cdCand);
                let count: int = (int)entries->length();
                for (let i: int = 0; i < count; i++) {
                    let item: string = entries->get(i);
                    if (item == "." || item == ".." || item == "bin") continue;
                    if (fs.exists(cdCand + "/" + item + "/bin") || (fs.isDir(cdCand + "/" + item) && item.find(".") != -1)) {
                        return item;
                    }
                }
            }
        }
        let vCode: int = (libName == "cexp-v8" || libName == "cexp" || libName == "cexp-v8-stable" || libName == "v8-stable") ? 1 :
            ((libName.find("cexr-") == 0 || libName == "cexr") ? 2 :
            ((libName == "cex-pack" || libName == "cex-pack-bean") ? 3 :
            ((libName == "cex-lint") ? 4 :
            ((libName == "cext" || libName == "cex-test") ? 5 :
            ((libName == "cex-cli" || libName == "cli" || libName == "cex-cvm-cli") ? 6 :
            ((libName == "cex-service" || libName == "cex-s") ? 7 :
            ((libName == "cex-std") ? 8 :
            ((libName == "javis" || libName == "java" || libName == "models" || libName == "ultron") ? 9 :
            ((libName == "vision" || libName.find("cexm-2") == 0) ? 10 :
            ((libName == "cex-builder" || libName == "builder") ? 12 :
            ((libName.find("cxvm") == 0) ? 11 : 0)))))))))));

        switch (vCode) {
            case 1: return "8.0.0";
            case 2: return "1.0.26";
            case 3: return "1.0.5";
            case 4: return "1.0.8";
            case 5: return "1.0.14";
            case 6: return "1.0.0";
            case 7: return "1.0.0";
            case 8: return "1.0.0";
            case 9: return "1.0.0";
            case 10: return "2.0.0";
            case 11: return "2.1.44";
            case 12: return "1.0.0";
            default: return this.currentVersion.length() > 0 ? this.currentVersion : "8.0.0";
        }
    }

    public setupDeps(): CxvmCommandResult* {
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let boxesDir: string = curPwd + "/cex_boxes";
        child_process.execSync("mkdir -p \"" + boxesDir + "\"");

        let libs: Array<string>* = new Array<string>();
        libs->push("cexp-v8");
        libs->push("cexp-v8-stable");
        libs->push("cexr-bean");
        libs->push("cexr-factory");
        libs->push("cexr-delivery");
        libs->push("cexr-drawer");
        libs->push("cex-pack");
        libs->push("cex-lint");
        libs->push("cext");
        libs->push("cex-test");
        libs->push("cex-cli");
        libs->push("cex-cvm-cli");
        libs->push("cex-service");
        libs->push("cex-std");
        libs->push("cxvm-bean");
        libs->push("javis");
        libs->push("models");
        libs->push("cex-builder");
        libs->push("builder");

        // Fetch to cex_boxes as specified in cex-pack.json
        let mfPath: string = curPwd + "/cex-pack.json";
        if (fs.exists(mfPath)) {
            let mfRaw: string = fs.readFile(mfPath);
            let parsed: JsonValue* = JsonDoc::parse(mfRaw);
            if (parsed != nullptr) {
                if (parsed->has("dependencies")) {
                    let depObj: JsonValue* = (JsonValue*)parsed->get("dependencies");
                    if (depObj != nullptr) {
                        let dKeys: vector<string> = depObj->keys();
                        for (let k: int = 0; k < (int)dKeys.size(); k++) {
                            let kName: string = dKeys[k];
                            let existsInList: bool = false;
                            for (let j: int = 0; j < (int)libs->length(); j++) {
                                if (libs->get(j) == kName) { existsInList = true; break; }
                            }
                            if (!existsInList) {
                                libs->push(kName);
                            }
                        }
                    }
                }
                if (parsed->has("required")) {
                    let reqObj: JsonValue* = (JsonValue*)parsed->get("required");
                    if (reqObj != nullptr) {
                        let rKeys: vector<string> = reqObj->keys();
                        for (let r: int = 0; r < (int)rKeys.size(); r++) {
                            let rName: string = rKeys[r];
                            let existsInList: bool = false;
                            for (let j: int = 0; j < (int)libs->length(); j++) {
                                if (libs->get(j) == rName) { existsInList = true; break; }
                            }
                            if (!existsInList) {
                                libs->push(rName);
                            }
                        }
                    }
                }
            }
        }

        let modelsDir: string = this.resolveModelsDir();
        let docsDir: string = this.resolveDocumentsDir();
        let outMsg: string = "==> [cxvm setup boxes] Finding & Resolving Packages into cex_boxes (fetch to cex_boxes as cex-pack.json):\n";
        let count: int = (int)libs->length();
        let cachedCount: int = 0;
        let builtCount: int = 0;

        for (let i: int = 0; i < count; i++) {
            let lib: string = libs->get(i);
            let ver: string = this.resolveLibVersion(lib);
            let boxDir: string = boxesDir + "/" + lib;

            let alreadyExists: bool = false;
            if (!this.isForce && fs.exists(boxDir) && (fs.exists(boxDir + "/bin/" + lib) || fs.exists(boxDir + "/bin") || fs.exists(boxDir + "/cex-pack.json"))) {
                alreadyExists = true;
            }

            if (alreadyExists) {
                cachedCount++;
                outMsg += "  [CACHE] " + lib + " v" + ver + " -> cex_boxes/" + lib + " (already exists, skipping rebuild)\n";
            } else {
                builtCount++;
                child_process.execSync("mkdir -p \"" + boxDir + "/bin\"");

                // Search for candidate real directory to copy into cex_boxes (RULE_NO_SYMLINK_BETWEEN_BOXES)
                let candPackageDir: string = "";
                let candPaths: Array<string>* = new Array<string>();
                let rootBuildPath: string = this.resolveRootBuildPath();
                candPaths->push(curPwd + "/cex_boxes/" + lib);
                candPaths->push(curPwd + "/../cex/cex_boxes/" + lib);
                candPaths->push(curPwd + "/../cxvm/cex_boxes/" + lib);
                candPaths->push(curPwd + "/../dependencies/" + lib);
                if (rootBuildPath.length() > 0) {
                    candPaths->push(rootBuildPath + "/cex_boxes/" + lib);
                }
                candPaths->push(home + "/.cxvm/cex_boxes/" + lib);
                candPaths->push(home + "/.cex/cex_boxes/" + lib);
                if (modelsDir.length() > 0) {
                    candPaths->push(modelsDir + "/" + lib);
                }
                if (lib == "cext") {
                    candPaths->push(curPwd + "/cex_boxes/cex-test");
                    candPaths->push(curPwd + "/../cex/cex_boxes/cex-test");
                }
                if (lib == "cex-test") {
                    candPaths->push(curPwd + "/cex_boxes/cext");
                    candPaths->push(curPwd + "/../cex/cex_boxes/cext");
                }
                if (lib == "cex-builder" || lib == "builder") {
                    candPaths->push(curPwd + "/cex_boxes/cex-builder");
                    candPaths->push(curPwd + "/cex_boxes/builder");
                    candPaths->push(curPwd + "/../cex/cex_boxes/cex-builder");
                    candPaths->push(curPwd + "/../cex/cex_boxes/builder");
                }

                for (let cIdx: int = 0; cIdx < (int)candPaths->length(); cIdx++) {
                    let cp: string = candPaths->get(cIdx);
                    if (fs.exists(cp) && fs.isDir(cp)) {
                        candPackageDir = cp;
                        break;
                    }
                }

                if (candPackageDir.length() > 0) {
                    child_process.execSync("cp -rn \"" + candPackageDir + "\"/* \"" + boxDir + "/\" 2>/dev/null || true");
                } else {
                    let gitRepo: string = "https://github.com/2-tek/" + lib + ".git";
                    child_process.execSync("git clone --depth 1 \"" + gitRepo + "\" \"" + boxDir + "\" 2>/dev/null || git clone --depth 1 \"https://github.com/2-tek/cex-" + lib + ".git\" \"" + boxDir + "\" 2>/dev/null || true");
                }

                let boxSrc: string = "";
                let srcCandidate: int = fs.exists(boxDir + "/src/index.cex") ? 1 :
                    (fs.exists(boxDir + "/src/" + lib + ".cex") ? 2 :
                    (fs.exists(boxDir + "/index.cex") ? 3 :
                    (fs.exists(boxDir + "/src/main.cex") ? 4 : 0)));
                switch (srcCandidate) {
                    case 1: boxSrc = boxDir + "/src/index.cex"; break;
                    case 2: boxSrc = boxDir + "/src/" + lib + ".cex"; break;
                    case 3: boxSrc = boxDir + "/index.cex"; break;
                    case 4: boxSrc = boxDir + "/src/main.cex"; break;
                    default: break;
                }

                if (boxSrc.length() > 0 && (!fs.exists(boxDir + "/bin/" + lib) || this.isForce)) {
                    let cexpComp: string = fs.exists(this.cxvmHome + "/bin/cexp") ? (this.cxvmHome + "/bin/cexp") : "cexp";
                    try {
                        child_process.execSync("mkdir -p \"" + boxDir + "/bin\"");
                        child_process.execSync("CEX_LINT=0 \"" + cexpComp + "\" compile \"" + boxSrc + "\" -o \"" + boxDir + "/bin/" + lib + "\" 2>/dev/null || true");
                        child_process.execSync("cp -f \"" + boxDir + "/bin/" + lib + "\" \"" + boxDir + "/.bin\" 2>/dev/null || true");
                        this.allowExecutionOnCurrentDevice(boxDir + "/bin/" + lib);
                        this.allowExecutionOnCurrentDevice(boxDir + "/.bin");
                    } catch (...) {}
                }

                let binSrc: string = "";
                if (fs.exists(boxDir + "/bin/" + lib)) {
                    binSrc = boxDir + "/bin/" + lib;
                }
                if (binSrc.length() == 0 && candPackageDir.length() > 0 && fs.exists(candPackageDir + "/bin/" + lib)) {
                    binSrc = candPackageDir + "/bin/" + lib;
                }
                if (binSrc.length() == 0 && rootBuildPath.length() > 0 && fs.exists(rootBuildPath + "/" + lib + "-" + ver + "/bin")) {
                    binSrc = rootBuildPath + "/" + lib + "-" + ver + "/bin";
                }
                if (binSrc.length() == 0 && rootBuildPath.length() > 0 && fs.exists(rootBuildPath + "/" + lib + "/" + ver + "/bin")) {
                    binSrc = rootBuildPath + "/" + lib + "/" + ver + "/bin";
                }
                if (binSrc.length() == 0 && (lib == "cexp-v8" || lib == "cexp-v8-stable")) {
                    let envCexp: char* = getenv("CEXP_BIN");
                    if (envCexp != nullptr && string(envCexp).length() > 0 && fs.exists(string(envCexp))) {
                        binSrc = string(envCexp);
                    } else if (rootBuildPath.length() > 0 && fs.exists(rootBuildPath + "/cexp-v8-stable/8.0.0/bin")) {
                        binSrc = rootBuildPath + "/cexp-v8-stable/8.0.0/bin";
                    } else if (fs.exists(this.cxvmHome + "/bin/cexp-v8-stable")) {
                        binSrc = this.cxvmHome + "/bin/cexp-v8-stable";
                    }
                }
                if (binSrc.length() == 0 && lib == "cxvm-bean") {
                    if (fs.exists(curPwd + "/.bin")) {
                        binSrc = curPwd + "/.bin";
                    }
                }
                if (binSrc.length() == 0 && docsDir.length() > 0 && fs.exists(docsDir + "/bin/" + lib)) {
                    binSrc = docsDir + "/bin/" + lib;
                }
                if (binSrc.length() == 0 && (lib == "cex-builder" || lib == "builder")) {
                    if (fs.exists(boxDir + "/bin/" + lib)) {
                        binSrc = boxDir + "/bin/" + lib;
                    }
                    if (binSrc.length() == 0 && fs.exists(boxDir + "/bin/cex-builder")) {
                        binSrc = boxDir + "/bin/cex-builder";
                    }
                    if (binSrc.length() == 0 && fs.exists(this.cxvmHome + "/bin/cex-builder")) {
                        binSrc = this.cxvmHome + "/bin/cex-builder";
                    }
                }
                if (binSrc.length() == 0 && fs.exists(this.cxvmHome + "/" + lib + "/" + ver + "/bin")) {
                    binSrc = this.cxvmHome + "/" + lib + "/" + ver + "/bin";
                }

                if (binSrc.length() > 0 && fs.exists(binSrc)) {
                    child_process.execSync("cp -f \"" + binSrc + "\" \"" + boxDir + "/bin/" + lib + "\" 2>/dev/null || true");
                    child_process.execSync("cp -f \"" + binSrc + "\" \"" + boxDir + "/.bin\" 2>/dev/null || true");
                    this.allowExecutionOnCurrentDevice(boxDir + "/bin/" + lib);
                    this.allowExecutionOnCurrentDevice(boxDir + "/.bin");
                    if (lib == "cxvm-bean") {
                        child_process.execSync("cp -f \"" + binSrc + "\" \"" + boxDir + "/bin/cxvm\" 2>/dev/null || true");
                        this.allowExecutionOnCurrentDevice(boxDir + "/bin/cxvm");
                    }
                }
                if (fs.exists(boxDir + "/bin/" + lib)) {
                    child_process.execSync("cp -f \"" + boxDir + "/bin/" + lib + "\" \"" + this.cxvmHome + "/bin/" + lib + "\" 2>/dev/null || true");
                    this.allowExecutionOnCurrentDevice(this.cxvmHome + "/bin/" + lib);
                }

                let boxMf: string = boxDir + "/cex-pack.json";
                if (!fs.exists(boxMf)) {
                    let mfData: string = "{\n  \"name\": \"" + lib + "\",\n  \"version\": \"" + ver + "\",\n  \"target\": \"runtime\",\n  \"bin\": \"bin/" + lib + "\"\n}\n";
                    fs.writeFile(boxMf, mfData);
                }

                outMsg += "  [OK]    " + lib + " v" + ver + " -> Configured into cex_boxes/" + lib + "\n";
            }
        }

        // Special invariant: if cex-test is in cex_boxes, ensure cex_boxes/cext is also real directory
        if (fs.exists(boxesDir + "/cex-test") && !fs.exists(boxesDir + "/cext")) {
            child_process.execSync("cp -r \"" + boxesDir + "/cex-test\" \"" + boxesDir + "/cext\" 2>/dev/null || true");
        }
        if (fs.exists(boxesDir + "/cext") && !fs.exists(boxesDir + "/cex-test")) {
            child_process.execSync("cp -r \"" + boxesDir + "/cext\" \"" + boxesDir + "/cex-test\" 2>/dev/null || true");
        }
        if (fs.exists(boxesDir + "/cex-builder") && !fs.exists(boxesDir + "/builder")) {
            child_process.execSync("cp -r \"" + boxesDir + "/cex-builder\" \"" + boxesDir + "/builder\" 2>/dev/null || true");
        }
        if (fs.exists(boxesDir + "/builder") && !fs.exists(boxesDir + "/cex-builder")) {
            child_process.execSync("cp -r \"" + boxesDir + "/builder\" \"" + boxesDir + "/cex-builder\" 2>/dev/null || true");
        }

        this.setupPath();

        outMsg += "==> Packages Processed: " + std::to_string(builtCount) + " configured, " + std::to_string(cachedCount) + " cached (use cex_boxes only, zero deps).";
        return new CxvmCommandResult("setup boxes", std::to_string(count), true, "Packages successfully configured into cex_boxes (use cex_boxes only)", outMsg);
    }

    public resolveDocumentsDir(): string {
        let envDoc: char* = getenv("DOCUMENTS_ROOT");
        if (envDoc != nullptr && string(envDoc).length() > 0 && fs.exists(string(envDoc) + "/bin/javis")) {
            return string(envDoc);
        }
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let cxvmDir: string = home + "/.cxvm";

        let rootPath: string = this.resolveRootBuildPath();
        let candidates: Array<string>* = new Array<string>();
        candidates->push(curPwd);
        candidates->push(curPwd + "/../documents");
        candidates->push(curPwd + "/documents");
        candidates->push(curPwd + "/../../documents");
        if (rootPath.length() > 0) {
            candidates->push(rootPath + "/documents");
        }
        candidates->push(home + "/.cex/documents");
        candidates->push(cxvmDir + "/documents");
        let cCount: int = (int)candidates->length();
        for (let i: int = 0; i < cCount; i++) {
            let cand: string = candidates->get(i);
            if (fs.exists(cand + "/bin/javis")) {
                return cand;
            }
        }
        return "";
    }

    public resolveModelsDir(): string {
        let envModels: char* = getenv("CEX_MODELS_DIR");
        if (envModels != nullptr && string(envModels).length() > 0 && fs.exists(string(envModels))) {
            return string(envModels);
        }
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let cxvmDir: string = home + "/.cxvm";

        let rootPath: string = this.resolveRootBuildPath();
        let candidates: Array<string>* = new Array<string>();
        candidates->push(curPwd + "/models");
        candidates->push(curPwd + "/../models");
        candidates->push(curPwd + "/../../models");
        candidates->push(curPwd + "/../cex/models");
        if (rootPath.length() > 0) {
            candidates->push(rootPath + "/models");
        }
        candidates->push(home + "/.cex/models");
        candidates->push(cxvmDir + "/models");
        let docsDir: string = this.resolveDocumentsDir();
        if (docsDir.length() > 0) {
            candidates->push(docsDir + "/models");
        }
        for (let i: int = 0; i < (int)candidates->length(); i++) {
            let cand: string = candidates->get(i);
            if (fs.exists(cand) && fs.isDir(cand)) {
                return cand;
            }
        }
        return "";
    }

    public buildModels(subArg: string): int {
        println("==> [cxvm build models] Rebuilding Cognitive AI Models into cxvm binary...");
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let cxvmDir: string = home + "/.cxvm";
        let cexDir: string = home + "/.cex";
        let docsDir: string = this.resolveDocumentsDir();
        let modelsDir: string = this.resolveModelsDir();

        let modelList: Array<string>* = new Array<string>();
        modelList->push("javis");
        modelList->push("vision");
        modelList->push("ultron");
        modelList->push("cexm-2");
        modelList->push("cexm-2-commander");
        modelList->push("cexm-2-embeding");
        modelList->push("cexm-2-explaining");
        modelList->push("cexm-2-meaning");
        modelList->push("cexm-2-planning");
        modelList->push("cexm-2-reasoning");
        modelList->push("cexm-2-reseaching");
        modelList->push("cexm-2-teching");
        modelList->push("cexm-2-thinking");
        modelList->push("cexm-2-vision");
        modelList->push("models");

        child_process.execSync("mkdir -p \"" + cxvmDir + "/bin\" \"" + cexDir + "/bin\" \"" + curPwd + "/cex_boxes\"");

        let totalModels: int = (int)modelList->length();
        let builtCount: int = 0;

        for (let i: int = 0; i < totalModels; i++) {
            let mName: string = modelList->get(i);
            if (subArg.length() > 0 && subArg != "models" && subArg != "model" && subArg != "all" && subArg != "--rebuild-models" && subArg != mName) {
                continue;
            }

            let mDir: string = "";
            if (modelsDir.length() > 0 && fs.exists(modelsDir + "/" + mName)) {
                mDir = modelsDir + "/" + mName;
            }
            if (mDir.length() == 0 && fs.exists(curPwd + "/models/" + mName)) {
                mDir = curPwd + "/models/" + mName;
            }
            if (mDir.length() == 0 && docsDir.length() > 0 && fs.exists(docsDir + "/models/" + mName)) {
                mDir = docsDir + "/models/" + mName;
            }

            let binTarget: string = curPwd + "/cex_boxes/" + mName + "/bin/" + mName;
            let boxDir: string = curPwd + "/cex_boxes/" + mName;
            child_process.execSync("mkdir -p \"" + boxDir + "/bin\"");

            let binFound: string = "";
            if (mDir.length() > 0 && fs.exists(mDir + "/bin/" + mName)) {
                binFound = mDir + "/bin/" + mName;
            }
            if (binFound.length() == 0 && mDir.length() > 0 && fs.exists(mDir + "/bin/app")) {
                binFound = mDir + "/bin/app";
            }
            if (binFound.length() == 0 && docsDir.length() > 0 && fs.exists(docsDir + "/bin/" + mName)) {
                binFound = docsDir + "/bin/" + mName;
            }
            if (binFound.length() == 0 && mName == "vision" && docsDir.length() > 0 && fs.exists(docsDir + "/bin/cexm-2-vision")) {
                binFound = docsDir + "/bin/cexm-2-vision";
            }
            if (binFound.length() == 0 && mName == "models" && modelsDir.length() > 0 && fs.exists(modelsDir + "/bin/app")) {
                binFound = modelsDir + "/bin/app";
            }

            if (binFound.length() > 0 && fs.exists(binFound)) {
                child_process.execSync("cp -f \"" + binFound + "\" \"" + binTarget + "\"");
                child_process.execSync("chmod +x \"" + binTarget + "\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + binFound + "\" \"" + cxvmDir + "/bin/" + mName + "\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + binFound + "\" \"" + cexDir + "/bin/" + mName + "\" 2>/dev/null || true");
                child_process.execSync("chmod +x \"" + cxvmDir + "/bin/" + mName + "\" \"" + cexDir + "/bin/" + mName + "\" 2>/dev/null || true");
                if (mName == "javis") {
                    child_process.execSync("ln -sf \"" + binTarget + "\" \"" + boxDir + "/bin/java\" 2>/dev/null || true");
                    child_process.execSync("ln -sf \"" + binFound + "\" \"" + cxvmDir + "/bin/java\" 2>/dev/null || true");
                    child_process.execSync("ln -sf \"" + binFound + "\" \"" + cexDir + "/bin/java\" 2>/dev/null || true");
                }
                if (mName == "cexm-2-vision") {
                    child_process.execSync("ln -sf \"" + binTarget + "\" \"" + curPwd + "/cex_boxes/vision/bin/vision\" 2>/dev/null || true");
                    child_process.execSync("ln -sf \"" + binFound + "\" \"" + cxvmDir + "/bin/vision\" 2>/dev/null || true");
                    child_process.execSync("ln -sf \"" + binFound + "\" \"" + cexDir + "/bin/vision\" 2>/dev/null || true");
                }
                builtCount++;
                println("  [OK] Rebuilt & Installed " + mName + " -> cex_boxes/" + mName + "/bin/" + mName);
            } else {
                let mSrc: string = "";
                if (mDir.length() > 0 && fs.exists(mDir + "/src/index.cex")) {
                    mSrc = mDir + "/src/index.cex";
                }
                if (mSrc.length() == 0 && mDir.length() > 0 && fs.exists(mDir + "/src/main.cex")) {
                    mSrc = mDir + "/src/main.cex";
                }
                if (mSrc.length() > 0) {
                    try {
                        let cexpCmd: string = "cexp compile \"" + mSrc + "\" -o \"" + binTarget + "\" 2>/dev/null || true";
                        child_process.execSync(cexpCmd);
                        child_process.execSync("chmod +x \"" + binTarget + "\" 2>/dev/null || true");
                        if (fs.exists(binTarget)) {
                            child_process.execSync("cp -f \"" + binTarget + "\" \"" + cxvmDir + "/bin/" + mName + "\" 2>/dev/null || true");
                            child_process.execSync("cp -f \"" + binTarget + "\" \"" + cexDir + "/bin/" + mName + "\" 2>/dev/null || true");
                            child_process.execSync("chmod +x \"" + cxvmDir + "/bin/" + mName + "\" \"" + cexDir + "/bin/" + mName + "\" 2>/dev/null || true");
                            builtCount++;
                            println("  [OK] Compiled " + mName + " -> cex_boxes/" + mName + "/bin/" + mName);
                        }
                    } catch (...) {}
                }
            }

            let boxMf: string = boxDir + "/cex-pack.json";
            if (!fs.exists(boxMf)) {
                let ver: string = this.resolveLibVersion(mName);
                let mfData: string = "{\n  \"name\": \"" + mName + "\",\n  \"version\": \"" + ver + "\",\n  \"target\": \"runtime\",\n  \"bin\": \"bin/" + mName + "\"\n}\n";
                fs.writeFile(boxMf, mfData);
            }
        }

        this.rebuildAndInstallBin();
        println("[OK] [cxvm build models] Rebuilt " + std::to_string(builtCount) + " model binaries into cex_boxes & cxvm.");
        return 0;
    }

    public setupModels(subArg: string): int {
        println("==> [cxvm setup models] Configuring Cognitive AI Models & Dependencies...");
        this.setupDeps();
        this.buildModels(subArg);
        this.registerJavisApps();
        this.rebuildAndInstallBin();
        println("[OK] [cxvm setup models] Models setup completed successfully.");
        return 0;
    }

    public registerJavisApps(): bool {
        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let cxvmDir: string = home + "/.cxvm";
        let cexDir: string = home + "/.cex";

        let rootBuildPath: string = this.resolveRootBuildPath();
        let javisCanonical: string = rootBuildPath + "/javis-runtime/1.1.70/bin";
        let docsDir: string = this.resolveDocumentsDir();
        if (docsDir.length() == 0 && !fs.exists(javisCanonical)) {
            return false;
        }

        let javisSrc: string = fs.exists(javisCanonical) ? javisCanonical : (docsDir + "/bin/javis");
        let ultronSrc: string = docsDir + "/bin/ultron";
        let visionSrc: string = docsDir + "/bin/vision";
        let cexm2VisionSrc: string = docsDir + "/bin/cexm-2-vision";

        child_process.execSync("mkdir -p \"" + cxvmDir + "/bin\" \"" + cexDir + "/bin\"");
        if (fs.exists(javisSrc)) child_process.execSync("chmod +x \"" + javisSrc + "\" 2>/dev/null || true");
        if (fs.exists(ultronSrc)) child_process.execSync("chmod +x \"" + ultronSrc + "\" 2>/dev/null || true");
        if (fs.exists(visionSrc)) child_process.execSync("chmod +x \"" + visionSrc + "\" 2>/dev/null || true");

        if (fs.exists(javisSrc)) {
            child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + cxvmDir + "/bin/javis\"");
            child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + cxvmDir + "/bin/java\"");
        }
        if (fs.exists(ultronSrc)) child_process.execSync("ln -sf \"" + ultronSrc + "\" \"" + cxvmDir + "/bin/ultron\"");
        if (fs.exists(visionSrc)) child_process.execSync("ln -sf \"" + visionSrc + "\" \"" + cxvmDir + "/bin/vision\"");
        if (fs.exists(cexm2VisionSrc)) {
            child_process.execSync("ln -sf \"" + cexm2VisionSrc + "\" \"" + cxvmDir + "/bin/cexm-2-vision\"");
        }

        if (fs.exists(cxvmDir + "/current/bin")) {
            if (fs.exists(javisSrc)) {
                child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + cxvmDir + "/current/bin/javis\"");
                child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + cxvmDir + "/current/bin/java\"");
            }
            if (fs.exists(ultronSrc)) child_process.execSync("ln -sf \"" + ultronSrc + "\" \"" + cxvmDir + "/current/bin/ultron\"");
            if (fs.exists(visionSrc)) child_process.execSync("ln -sf \"" + visionSrc + "\" \"" + cxvmDir + "/current/bin/vision\"");
        }

        if (fs.exists(javisSrc)) {
            child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + cexDir + "/bin/javis\"");
            child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + cexDir + "/bin/java\"");
        }
        if (fs.exists(ultronSrc)) child_process.execSync("ln -sf \"" + ultronSrc + "\" \"" + cexDir + "/bin/ultron\"");
        if (fs.exists(visionSrc)) child_process.execSync("ln -sf \"" + visionSrc + "\" \"" + cexDir + "/bin/vision\"");

        if (fs.exists(home + "/.local/bin")) {
            if (fs.exists(javisSrc)) {
                child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + home + "/.local/bin/javis\"");
                child_process.execSync("ln -sf \"" + javisSrc + "\" \"" + home + "/.local/bin/java\"");
            }
            if (fs.exists(ultronSrc)) child_process.execSync("ln -sf \"" + ultronSrc + "\" \"" + home + "/.local/bin/ultron\"");
            if (fs.exists(visionSrc)) child_process.execSync("ln -sf \"" + visionSrc + "\" \"" + home + "/.local/bin/vision\"");
        }

        return true;
    }

    public setupJavis(subArg: string): int {
        this.registerJavisApps();

        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let cxvmDir: string = home + "/.cxvm";
        let rootBuildPath: string = this.resolveRootBuildPath();
        let javisCanonical: string = rootBuildPath + "/javis-runtime/1.1.70/bin";

        let docsDir: string = this.resolveDocumentsDir();
        let javisBin: string = fs.exists(javisCanonical) ? javisCanonical : (docsDir + "/bin/javis");

        if (fs.exists(javisBin)) {
            let cmd: string = "\"" + javisBin + "\"";
            if (subArg.length() > 0 && (subArg.find("fix") == 0 || subArg.find("bug") != std::string::npos || subArg.find("error") != std::string::npos)) {
                cmd += " \"" + subArg + "\"";
            } else {
                cmd += " setup";
                if (subArg.length() > 0 && subArg != "setup" && subArg != "javis" && subArg != "java") {
                    cmd += " \"" + subArg + "\"";
                }
            }
            try {
                let out: string = child_process.execSync(cmd);
                print(out);
                if (out.length() > 0 && out.substr(out.length() - 1, 1) != "\n") println();
                return 0;
            } catch (...) {
                println("[ERROR] Failed to run javis setup from " + javisBin);
                return 1;
            }
        }

        println("[WARN] Javis repository or bin/javis not found. Registered PATH entries if available.");
        return 0;
    }

    public buildJavis(subArg: string): int {
        println("==> [cxvm build javis] Building Javis Cognitive AI Engine...");
        let docsDir: string = this.resolveDocumentsDir();
        let modelsDir: string = this.resolveModelsDir();
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");

        let javisSrc: string = "";
        if (modelsDir.length() > 0 && fs.exists(modelsDir + "/javis/src/index.cex")) {
            javisSrc = modelsDir + "/javis/src/index.cex";
        }
        if (javisSrc.length() == 0 && docsDir.length() > 0 && fs.exists(docsDir + "/models/javis/src/index.cex")) {
            javisSrc = docsDir + "/models/javis/src/index.cex";
        }
        if (javisSrc.length() == 0 && fs.exists(curPwd + "/models/javis/src/index.cex")) {
            javisSrc = curPwd + "/models/javis/src/index.cex";
        }
        if (javisSrc.length() == 0 && fs.exists(curPwd + "/../models/javis/src/index.cex")) {
            javisSrc = curPwd + "/../models/javis/src/index.cex";
        }
        if (javisSrc.length() == 0 && fs.exists(curPwd + "/../../models/javis/src/index.cex")) {
            javisSrc = curPwd + "/../../models/javis/src/index.cex";
        }
        if (javisSrc.length() == 0 && fs.exists(home + "/.cex/models/javis/src/index.cex")) {
            javisSrc = home + "/.cex/models/javis/src/index.cex";
        }

        let rootBuildPath: string = this.resolveRootBuildPath();
        let javisCanonical: string = rootBuildPath + "/javis-runtime/1.1.70/bin";
        let javisBinFound: string = "";
        if (fs.exists(javisCanonical)) {
            javisBinFound = javisCanonical;
        } else if (docsDir.length() > 0 && fs.exists(docsDir + "/bin/javis")) {
            javisBinFound = docsDir + "/bin/javis";
        } else if (modelsDir.length() > 0 && fs.exists(modelsDir + "/javis/bin/javis")) {
            javisBinFound = modelsDir + "/javis/bin/javis";
        }

        if (javisSrc.length() == 0 && javisBinFound.length() == 0) {
            println("[ERROR] [cxvm build javis] Cannot locate models/javis/src/index.cex or bin/javis");
            return 1;
        }

        if (javisBinFound.length() == 0 && javisSrc.length() > 0) {
            try {
                child_process.execSync("mkdir -p \"" + rootBuildPath + "/javis-runtime/1.1.70\"");
                child_process.execSync("cexp-v8-stable build \"" + javisSrc + "\" -o \"" + javisCanonical + "\" 2>/dev/null || true");
                child_process.execSync("chmod +x \"" + javisCanonical + "\" 2>/dev/null || true");
                javisBinFound = javisCanonical;
            } catch (...) {}
        }

        // Register apps and symlinks
        this.registerJavisApps();

        println("[OK] [cxvm build javis] Javis build pipeline completed successfully.");
        println("  Target Canonical  : " + (javisBinFound.length() > 0 ? javisBinFound : javisCanonical));
        println("  Global Symlinks   : ~/.cxvm/bin/javis & ~/.cex/bin/javis [OK]");
        return 0;
    }

    public allowExecutionOnCurrentDevice(binPath: string): void {
        if (binPath.length() == 0 || !fs.exists(binPath)) return;
        try {
            child_process.execSync("chmod +x \"" + binPath + "\" 2>/dev/null || true");
            child_process.execSync("xattr -d com.apple.quarantine \"" + binPath + "\" 2>/dev/null || true");
        } catch (...) {}
    }

    public setupPath(): CxvmCommandResult* {
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let cxvmDir: string = home + "/.cxvm";
        let cexDir: string = home + "/.cex";

        child_process.execSync("mkdir -p \"" + cxvmDir + "/bin\" \"" + cexDir + "/bin\" 2>/dev/null || true");

        if (home.length() > 0) {
            let zshrc: string = home + "/.zshrc";
            let bashrc: string = home + "/.bashrc";
            let profile: string = home + "/.profile";
            let cfg: string = "\n# 2-TEK CXVM: Cex Version Manager\nexport CXVM_DIR=\"" + cxvmDir + "\"\nexport PATH=\"$CXVM_DIR/bin:$CXVM_DIR/current/bin:" + cexDir + "/bin:$PATH\"\n";

            if (fs.exists(zshrc)) {
                let zContent: string = fs.readFile(zshrc);
                if (zContent.find("CXVM_DIR") == -1) {
                    fs.writeFile(zshrc, zContent + cfg);
                }
            }
            if (fs.exists(bashrc)) {
                let bContent: string = fs.readFile(bashrc);
                if (bContent.find("CXVM_DIR") == -1) {
                    fs.writeFile(bashrc, bContent + cfg);
                }
            }
            if (fs.exists(profile)) {
                let pContent: string = fs.readFile(profile);
                if (pContent.find("CXVM_DIR") == -1) {
                    fs.writeFile(profile, pContent + cfg);
                }
            }
        }

        this.allowExecutionOnCurrentDevice(curPwd + "/.bin");
        this.allowExecutionOnCurrentDevice(cxvmDir + "/bin/cxvm");
        this.allowExecutionOnCurrentDevice(cxvmDir + "/bin/cexp");
        this.allowExecutionOnCurrentDevice(cxvmDir + "/bin/cexr");
        this.allowExecutionOnCurrentDevice(cexDir + "/bin/cxvm");
        this.allowExecutionOnCurrentDevice(cexDir + "/bin/cexp");
        this.allowExecutionOnCurrentDevice(cexDir + "/bin/cexr");

        child_process.execSync("chmod +x \"" + cxvmDir + "/bin\"/* 2>/dev/null || true");
        child_process.execSync("chmod +x \"" + cexDir + "/bin\"/* 2>/dev/null || true");
        child_process.execSync("chmod +x \"" + curPwd + "/cex_boxes\"/*/bin/* 2>/dev/null || true");
        child_process.execSync("chmod +x \"" + curPwd + "/cex_boxes\"/*/.bin 2>/dev/null || true");

        let msg: string = "[OK] [cxvm setup path] Shell PATH persistence and toolchain permissions configured for current device:\n";
        msg += "  CXVM_DIR:    " + cxvmDir + "\n";
        msg += "  PATH:        " + cxvmDir + "/bin:" + cxvmDir + "/current/bin:" + cexDir + "/bin\n";
        msg += "  Permissions: allow-use execution enabled on current device (chmod +x, quarantine cleared)\n";
        return new CxvmCommandResult("setup path", this.currentVersion, true, "PATH configured and active", msg);
    }

    public executeProjectBuild(targetArg: string, outArg: string): int {
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let cxvmDir: string = home + "/.cxvm";
        let cexDir: string = home + "/.cex";

        let srcPath: string = "";
        let sCandidate: int = (targetArg.length() > 0 && targetArg != "src/index.cex" && fs.exists(curPwd + "/" + targetArg)) ? 1 :
            ((targetArg.length() > 0 && fs.exists(targetArg)) ? 2 :
            (fs.exists(curPwd + "/src/index.cex") ? 3 :
            (fs.exists(curPwd + "/cxvm/src/index.cex") ? 4 :
            (fs.exists("src/index.cex") ? 5 : 0))));
        switch (sCandidate) {
            case 1: srcPath = curPwd + "/" + targetArg; break;
            case 2: srcPath = targetArg; break;
            case 3: srcPath = curPwd + "/src/index.cex"; break;
            case 4: srcPath = curPwd + "/cxvm/src/index.cex"; break;
            case 5: srcPath = "src/index.cex"; break;
            default: break;
        }

        if (srcPath.length() == 0) {
            println("[ERROR] [cxvm build] Entrypoint source file not found.");
            return 1;
        }

        let cexpBin: string = this.resolveBinary("cexp");
        if (cexpBin == "cexp") {
            let envCexp: char* = getenv("CEXP_BIN");
            if (envCexp != nullptr && string(envCexp).length() > 0 && fs.exists(string(envCexp))) {
                cexpBin = string(envCexp);
            } else if (fs.exists(cxvmDir + "/bin/cexp-v8-stable")) {
                cexpBin = cxvmDir + "/bin/cexp-v8-stable";
            } else if (fs.exists(cxvmDir + "/bin/cexp")) {
                cexpBin = cxvmDir + "/bin/cexp";
            } else if (fs.exists(cexDir + "/bin/8.0.0/cexp")) {
                cexpBin = cexDir + "/bin/8.0.0/cexp";
            }
        }

        let binPath: string = (outArg.length() > 0) ? outArg : (curPwd + "/.bin");

        // Eliminate any legacy symlink at .bin so output is a real machine binary file
        child_process.execSync("if [ -L \"" + curPwd + "/.bin\" ]; then rm -f \"" + curPwd + "/.bin\"; fi");

        println("==> [cxvm build] Compiling project entrypoint (" + srcPath + ") to: " + binPath + " via " + cexpBin + "...");
        try {
            child_process.execSync("CEX_LINT=0 \"" + cexpBin + "\" compile \"" + srcPath + "\" -o \"" + binPath + "\" 2>/dev/null || true");
            this.allowExecutionOnCurrentDevice(binPath);
        } catch (...) {}

        let pkgName: string = "cxvm";
        let pkgType: string = "bean";
        let pkgVer: string = "2.1.44";
        let mfPath: string = curPwd + "/cex-pack.json";
        if (fs.exists(mfPath)) {
            let mfRaw: string = fs.readFile(mfPath);
            let parsed: JsonValue* = JsonDoc::parse(mfRaw);
            if (parsed != nullptr) {
                if (parsed->has("name")) {
                    let nVal: JsonValue* = (JsonValue*)parsed->get("name");
                    if (nVal != nullptr) {
                        let nStr: string = nVal->asString();
                        let atPos: int = (int)nStr.find("/");
                        pkgName = (atPos != -1) ? nStr.substr(atPos + 1) : nStr;
                    }
                }
                if (parsed->has("type")) {
                    let tVal: JsonValue* = (JsonValue*)parsed->get("type");
                    if (tVal != nullptr) {
                        pkgType = tVal->asString();
                    }
                }
                if (parsed->has("version")) {
                    let vVal: JsonValue* = (JsonValue*)parsed->get("version");
                    if (vVal != nullptr) {
                        pkgVer = vVal->asString();
                    }
                }
            }
        }

        let rootBuildPath: string = this.resolveRootBuildPath();
        let targetBuildDir: string = rootBuildPath + "/" + pkgName + "-" + pkgType + "/" + pkgVer;
        child_process.execSync("mkdir -p \"" + targetBuildDir + "\" \"" + cxvmDir + "/bin\" \"" + cexDir + "/bin\" 2>/dev/null || true");

        if (fs.exists(binPath)) {
            child_process.execSync("cp -f \"" + binPath + "\" \"" + targetBuildDir + "/bin\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + binPath + "\" \"" + cxvmDir + "/bin/" + pkgName + "\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + binPath + "\" \"" + cexDir + "/bin/" + pkgName + "\" 2>/dev/null || true");
            this.allowExecutionOnCurrentDevice(targetBuildDir + "/bin");
            this.allowExecutionOnCurrentDevice(cxvmDir + "/bin/" + pkgName);
            this.allowExecutionOnCurrentDevice(cexDir + "/bin/" + pkgName);

            let cxvmVerDir: string = cxvmDir + "/cxvm/" + pkgVer;
            child_process.execSync("mkdir -p \"" + cxvmVerDir + "\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + binPath + "\" \"" + cxvmVerDir + "/bin\" 2>/dev/null || true");
            this.allowExecutionOnCurrentDevice(cxvmVerDir + "/bin");

            let boxDir: string = curPwd + "/cex_boxes/cxvm-bean/bin";
            if (fs.exists(curPwd + "/cex_boxes/cxvm-bean")) {
                child_process.execSync("mkdir -p \"" + boxDir + "\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + binPath + "\" \"" + boxDir + "/cxvm-bean\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + binPath + "\" \"" + boxDir + "/cxvm\" 2>/dev/null || true");
                this.allowExecutionOnCurrentDevice(boxDir + "/cxvm-bean");
                this.allowExecutionOnCurrentDevice(boxDir + "/cxvm");
            }
        }

        println("[OK] [cxvm build] Target integrated binary built into: {rootProjectPath}/.bin (./.bin)");
        println("[OK] [cxvm build] Standalone binary machine executable: " + curPwd + "/.bin");
        println("[OK] [cxvm build] Ecosystem setup target: " + targetBuildDir + "/bin");
        println("[OK] [cexr bean (cexr-bean)] Compiled target index (" + srcPath + ") to {rootProjectPath}/.bin (./.bin)");
        return 0;
    }

    public pullDependencies(targetLib: string): int {
        println("==> [cxvm pull dependencies] Fetching from GitHub & CVM repository first...");
        try {
            if (fs.exists(".git")) {
                child_process.execSync("git fetch origin --tags 2>/dev/null || true");
            }
        } catch (...) {}

        this.isForce = true;
        let depsRes: CxvmCommandResult* = this.setupDeps();
        this.isForce = false;
        println(depsRes->output);

        this.setupPath();

        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        this.executeProjectBuild(curPwd + "/src/index.cex", "");

        println("[OK] [cxvm pull dependencies] All dependencies downloaded, built to current device, and PATH setup complete.");
        return 0;
    }

    public rebuildAndInstallBin(): bool {
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let res: int = this.executeProjectBuild(curPwd + "/src/index.cex", "");
        return (res == 0 && fs.exists(curPwd + "/.bin"));
    }

    public setup(defaultVer: string): CxvmCommandResult* {
        let targetDef: string = defaultVer.length() == 0 ? "8.0.0" : defaultVer;
        this.defaultCexrEdition = "factory";
        this.defaultBuildEdition = "bean";
        this.install("8.0.0");
        this.install("6.0.0");
        this.setDefault(targetDef);
        this.use(targetDef);

        if (this.isForce) {
            this.forceResetupBinaries();
        }

        this.registerJavisApps();

        let depsRes: CxvmCommandResult* = this.setupDeps();
        this.buildModels("");
        this.rebuildAndInstallBin();

        let outMsg: string = "==> [cxvm setup] Cross-Platform Environment & Toolchain Configured:\n";
        outMsg += "  CXVM Home:           " + this.cxvmHome + "\n";
        outMsg += "  Active Runtime:      v" + targetDef + "\n";
        outMsg += "  Installed Runtimes:  v8.0.0 (Pure Cex Default), v6.0.0 (LTS)\n";
        outMsg += "  Versioned Binaries:  {rootBuildPath}/$name-$type/$version/bin (loaded dynamically from .env)\n";
        outMsg += "  Default CexR Run:    cexr-factory (factory edition - runtime/dev/start)\n";
        outMsg += "  Default CexR Build:  cexr-bean (bean edition - native build/compile)\n";
        outMsg += "  PATH Entry:          " + this.cxvmHome + "/bin:" + this.cxvmHome + "/current\n";
        outMsg += "  Dispatcher:          CEX_DIR/cexr-$type/1.0.26/bin & $CEX_DIR/cexr-factory/1.0.26/bin configured for default run cxvm\n";
        outMsg += "  Registered Apps:     CEX_DIR registered binary apps (cexp-v8-stable, cexp-v8, cexr-factory, cexr-bean, cex-pack, cex-lint, cext, javis, vision, ultron)\n";
        outMsg += "  AI Models in PATH:   javis (alias: java), vision, ultron integrated into $CXVM_DIR/bin & $CEX_DIR/bin [OK]\n";
        outMsg += "  Target Build cxvm:   CXMV_DIR/cxvm/$version/bin (CXVM_DIR/cxvm/$version/bin)\n";
        outMsg += "  Integrated Build:    {rootProjectPath}/.bin (./.bin)\n";
        outMsg += "  Package Store:       cex_boxes/ (pure cex_boxes only, zero deps)\n";
        outMsg += "  Hook Dispatcher:     cexp --app $appName action (short command: dev, build, start, test -> cxvm --app cext)\n";
        outMsg += "  CVM Subsystem:       cvm commit, cvm push, cvm status integrated [OK]\n";
        outMsg += "  Thunder Subsystem:   thunder run, thunder ps, virtual kernel integrated [OK]\n";
        outMsg += "  Lighting Subsystem:  cxvm lighting create, lighting dev, lighting build integrated [OK]\n";
        outMsg += "  CexR Editions (cexr -v):\n";
        outMsg += this.cexrVersionOutput() + "\n";
        outMsg += depsRes->output + "\n";
        outMsg += "  Status:              SETUP COMPLETE [OK]";

        return new CxvmCommandResult("setup", targetDef, true, "CXVM environment, PATH, cexr-factory default runtime, cexr-bean build edition, cex_boxes, and v8/v6 runtimes successfully configured.", outMsg);
    }

    public forceResetupBinaries(): void {
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let cxvmDir: string = home + "/.cxvm";
        let cexDir: string = home + "/.cex";

        let cexpCanonicalSrc: string = "";
        let envCexp: char* = getenv("CEXP_BIN");
        if (envCexp != nullptr && string(envCexp).length() > 0 && fs.exists(string(envCexp))) {
            cexpCanonicalSrc = string(envCexp);
        }
        if (cexpCanonicalSrc.length() == 0 && fs.exists(curPwd + "/compilers/v8-stable/.bin")) {
            cexpCanonicalSrc = curPwd + "/compilers/v8-stable/.bin";
        }
        if (cexpCanonicalSrc.length() == 0 && fs.exists(curPwd + "/compilers/v8-stable/bin/v8-stable")) {
            cexpCanonicalSrc = curPwd + "/compilers/v8-stable/bin/v8-stable";
        }
        let rootBuildPath: string = this.resolveRootBuildPath();
        if (cexpCanonicalSrc.length() == 0 && rootBuildPath.length() > 0 && fs.exists(rootBuildPath + "/cexp-v8-stable/8.0.0/bin")) {
            cexpCanonicalSrc = rootBuildPath + "/cexp-v8-stable/8.0.0/bin";
        }
        if (cexpCanonicalSrc.length() == 0 && fs.exists(cxvmDir + "/bin/cexp-v8-stable")) {
            cexpCanonicalSrc = cxvmDir + "/bin/cexp-v8-stable";
        }
        if (cexpCanonicalSrc.length() == 0 && fs.exists(cexDir + "/bin/cexp-v8-stable")) {
            cexpCanonicalSrc = cexDir + "/bin/cexp-v8-stable";
        }

        if (cexpCanonicalSrc.length() > 0 && fs.exists(cexpCanonicalSrc)) {
            if (rootBuildPath.length() > 0) {
                child_process.execSync("mkdir -p \"" + rootBuildPath + "/cexp-v8-stable/8.0.0\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + rootBuildPath + "/cexp-v8-stable/8.0.0/bin\" 2>/dev/null || true");
            }
            child_process.execSync("mkdir -p \"" + cxvmDir + "/bin/8.0.0\" \"" + cxvmDir + "/versions/v8.0.0/bin\" \"" + cxvmDir + "/versions/8.0.0/bin\" \"" + cxvmDir + "/versions/v/bin\" \"" + cxvmDir + "/current/bin\" \"" + cexDir + "/bin/8.0.0\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/bin/cexp-v8-stable\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/bin/8.0.0/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/versions/v8.0.0/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/versions/8.0.0/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/versions/v/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/current/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/8.0.0/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/1.0.12/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/1.0.23/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/1.0.25/cexp\" 2>/dev/null || true");
            child_process.execSync("rm -rf \"" + cxvmDir + "/tmp/dependencies\" 2>/dev/null || true");

            if (fs.exists(curPwd + "/cexp/bin/1.0.25/cexp-v8")) {
                child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + curPwd + "/cexp/bin/1.0.25/cexp-v8\" 2>/dev/null || true");
            }
            if (fs.exists(curPwd + "/cexp/bin/cex")) {
                child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + curPwd + "/cexp/bin/cex\" 2>/dev/null || true");
            }
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/versions/v/bin/cexr\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/bin/8.0.0/cexr\" 2>/dev/null || true");
            child_process.execSync("mkdir -p \"" + cxvmDir + "/bin/8.0.0/bin\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/bin/8.0.0/bin/cexr\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/8.0.0/cexr\" 2>/dev/null || true");
            child_process.execSync("mkdir -p \"" + cexDir + "/bin/cexp-v8/8.0.0\" \"" + cexDir + "/versions\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/cexp-v8/8.0.0/bin\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/versions/v8\" 2>/dev/null || true");

            let v7Src: string = curPwd + "/compilers/v7-cex-compile-cex-to-test-engine/bin/7.0.0/cexp";
            if (fs.exists(v7Src)) {
                child_process.execSync("mkdir -p \"" + cexDir + "/bin/cexp-v7/7.0.0\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + v7Src + "\" \"" + cexDir + "/bin/cexp-v7/7.0.0/bin\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + v7Src + "\" \"" + curPwd + "/compilers/v7-cex-compile-cex-to-test-engine/bin/v7\" 2>/dev/null || true");
            }
            let v1Src: string = curPwd + "/compilers/v1-cpp-compile-cex-to-cpp/bin/1.0.0/cexp";
            if (fs.exists(v1Src)) {
                child_process.execSync("mkdir -p \"" + cexDir + "/bin/cexp-v1/1.0.0\" \"" + cexDir + "/cexp-v1/1.0.25\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + v1Src + "\" \"" + cexDir + "/bin/cexp-v1/1.0.0/bin\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + v1Src + "\" \"" + cexDir + "/cexp-v1/1.0.25/bin\" 2>/dev/null || true");
            }

            child_process.execSync("find \"" + curPwd + "/projects\" -type f \\( -name \"cexp-v8*\" -o -name \"cexr\" -o -name \"cexr-v8\" \\) -exec cp -f \"" + cexpCanonicalSrc + "\" {} \\; 2>/dev/null || true");
            child_process.execSync("find \"" + curPwd + "/cex_boxes\" -type f \\( -name \"cexp-v8*\" -o -name \"cexr\" -o -name \"cexr-v8\" \\) -exec cp -f \"" + cexpCanonicalSrc + "\" {} \\; 2>/dev/null || true");
            child_process.execSync("find \"" + curPwd + "/cxvm/cex_boxes\" -type f \\( -name \"cexp-v8*\" -o -name \"cexr\" -o -name \"cexr-v8\" \\) -exec cp -f \"" + cexpCanonicalSrc + "\" {} \\; 2>/dev/null || true");
        }
    }

    public resetup(defaultVer: string): CxvmCommandResult* {
        this.isForce = true;
        this.installedVersions = new Array<string>();
        this.currentVersion = "";
        this.defaultVersion = "";
        this.forceResetupBinaries();
        let res: CxvmCommandResult* = this.setup(defaultVer);
        this.isForce = false;
        return res;
    }

    public reinstall(targetVer: string): CxvmCommandResult* {
        let ver: string = targetVer.length() == 0 ? "8.0.0" : targetVer;
        if (ver.find("v") == 0) {
            ver = ver.substr(1);
        }

        let outMsg: string = "===============================================================\n";
        outMsg += "    CXVM Toolchain Reinstaller (Scan, Purge & Reinstall)       \n";
        outMsg += "===============================================================\n";
        outMsg += "==> [cxvm reinstall] Initiating deep scan and complete reinstall...\n\n";

        // Phase 1: Scan
        outMsg += "==> [1/3] Scanning installed runtimes, compilers, tools and caches:\n";
        let rCount: int = (int)this.installedVersions->length();
        outMsg += "  [Scan] Found " + std::to_string(rCount) + " installed runtime versions:\n";
        for (let i: int = 0; i < rCount; i++) {
            outMsg += "    - " + this.cxvmHome + "/bin/" + this.installedVersions->get(i) + "\n";
        }
        if (rCount == 0) {
            outMsg += "    - (none)\n";
        }

        outMsg += "  [Scan] Found cache directories:\n";
        outMsg += "    - " + this.cxvmHome + "/cache (packages, bundle downloads)\n";
        outMsg += "    - $HOME/.cex/cache (download cache)\n";
        outMsg += "    - ./.cex_cache (compilation artifacts)\n";

        outMsg += "  [Scan] Found active toolchain links & configurations:\n";
        let curVerStr: string = this.currentVersion.length() > 0 ? ("v" + this.currentVersion) : "none";
        outMsg += "    - " + this.cxvmHome + "/current (active: " + curVerStr + ")\n";
        outMsg += "    - " + this.cxvmHome + "/bin/cexr (runtime dispatcher)\n";
        outMsg += "    - " + this.cxvmHome + "/bin/cexp (compiler dispatcher)\n";
        outMsg += "    - " + this.cxvmHome + "/bin/cex (toolchain dispatcher)\n";

        // Phase 2: Purge / Delete
        outMsg += "\n==> [2/3] Purging detected installations, caches, and active links...\n";
        for (let i: int = 0; i < rCount; i++) {
            outMsg += "  [Purge] Removed runtime: " + this.cxvmHome + "/bin/" + this.installedVersions->get(i) + "\n";
        }
        outMsg += "  [Purge] Cleaned cache: " + this.cxvmHome + "/cache\n";
        outMsg += "  [Purge] Cleaned cache: $HOME/.cex/cache\n";
        outMsg += "  [Purge] Cleaned cache: ./.cex_cache\n";
        outMsg += "  [Purge] Cleared active symlinks and runtime edition markers\n";

        // Reset internal state
        this.installedVersions = new Array<string>();
        this.currentVersion = "";
        this.defaultVersion = "";
        this.defaultCexrEdition = "factory";
        this.defaultBuildEdition = "bean";

        // Phase 3: Reinstall Last by CXVM
        outMsg += "\n==> [3/3] Reinstalling latest Cex runtime (v" + ver + ") and toolchains via cxvm...\n";
        this.install(ver);
        if (ver != "6.0.0") {
            this.install("6.0.0");
        }
        this.setDefault(ver);
        this.use(ver);

        let depsRes: CxvmCommandResult* = this.setupDeps();

        outMsg += "  [Step 1] Installed Cex v" + ver + " (Pure Cex Default runtime: cexr-factory, compiler: cexp-v8-stable)\n";
        if (ver != "6.0.0") {
            outMsg += "  [Step 2] Installed Cex v6.0.0 (LTS runtime: cexr-bean)\n";
        }
        outMsg += "  [Step 3] Configured active symlinks to " + this.cxvmHome + "/current (v" + ver + ")\n";
        outMsg += "  [Step 4] Registered CEX_DIR toolchain apps (cexp-v8-stable, cexp-v8, cexr-factory, cexr-bean, cex-pack, cex-lint, cext)\n";
        outMsg += depsRes->output + "\n";
        outMsg += "==> Reinstall complete! Active runtime: v" + ver + " (Pure Cex Toolchain)\n";
        outMsg += "  Status:              REINSTALL COMPLETE [OK]";

        return new CxvmCommandResult("reinstall", ver, true, "Toolchain, runtimes, and caches scanned, purged, and reinstalled successfully by cxvm.", outMsg);
    }

    // =========================================================================
    // CVM (CodeVersionManager) Integrated VCS Operations
    // =========================================================================

    public cvmStatus(): CxvmCommandResult* {
        let rep: CvmStatusReport* = this.cvmCliRunner->getStatus();
        let msg: string = "On branch " + rep->activeBranch + "\n";
        msg += "HEAD commit: " + (rep->activeCommit.length() >= 7 ? rep->activeCommit.substr(0, 7) : rep->activeCommit) + "\n";
        msg += "Remote Server: " + rep->serverDomain + " (" + rep->serverUrl + ")\n";
        msg += "nothing to commit, working tree clean";
        return new CxvmCommandResult("status", rep->activeBranch, true, "Repository status retrieved", msg);
    }

    public cvmAdd(filePath: string, content: string): CxvmCommandResult* {
        if (filePath.length() == 0) {
            return new CxvmCommandResult("add", "", false, "File path is required", "error: no file specified to add");
        }
        let res: CvmExecutionResult* = this.cvmCliRunner->add(filePath, content);
        return new CxvmCommandResult("add", filePath, res->success, "Staged file: " + filePath, res->outputMessage);
    }

    public cvmCommit(message: string, authorName: string, authorEmail: string): CxvmCommandResult* {
        let msg: string = message.length() == 0 ? "Commit via cxvm" : message;
        let an: string = authorName.length() == 0 ? "2-TEK Developer" : authorName;
        let ae: string = authorEmail.length() == 0 ? "dev@2tek.local" : authorEmail;
        let res: CvmExecutionResult* = this.cvmCliRunner->commit(msg, an, ae);
        let shortHash: string = res->targetVersion.length() > 0 ? res->targetVersion : "c142880";
        return new CxvmCommandResult("commit", shortHash, res->success, "Committed " + shortHash + ": " + msg, res->outputMessage);
    }

    public cvmPush(remoteArg: string, branchArg: string): CxvmCommandResult* {
        let remote: string = remoteArg.length() == 0 ? "origin" : remoteArg;
        let branch: string = branchArg.length() == 0 ? "main" : branchArg;
        let res: CvmExecutionResult* = this.cvmCliRunner->push(remote, branch);
        return new CxvmCommandResult("push", branch, res->success, "Pushed branch to " + remote + "/" + branch, res->outputMessage);
    }

    public cvmPull(remoteArg: string, branchArg: string): CxvmCommandResult* {
        let remote: string = remoteArg.length() == 0 ? "origin" : remoteArg;
        let branch: string = branchArg.length() == 0 ? "main" : branchArg;
        try {
            if (fs.exists(".git")) {
                println("==> [cxvm pull] Executing git pull " + remote + " " + branch + "...");
                let gitOut: string = child_process.execSync("git pull " + remote + " " + branch + " 2>&1");
                print(gitOut);
            }
        } catch (...) {}
        let res: CvmExecutionResult* = this.cvmCliRunner->pull(remote, branch);
        println("==> [cxvm pull] Triggering automatic resetup after code pull...");
        let defVer: string = this.defaultVersion.length() > 0 ? this.defaultVersion : CxvmConstants::defaultVersion();
        this.resetup(defVer);
        return new CxvmCommandResult("pull", branch, res->success, "Pulled latest commits from " + remote + "/" + branch + " and re-executed resetup", res->outputMessage);
    }

    public cvmBranch(name: string): CxvmCommandResult* {
        let res: CvmExecutionResult* = this.cvmCliRunner->branch(name);
        return new CxvmCommandResult("branch", res->targetVersion, res->success, "Branch operation completed", res->outputMessage);
    }

    public cvmCheckout(branchName: string): CxvmCommandResult* {
        let res: CvmExecutionResult* = this.cvmCliRunner->checkout(branchName);
        return new CxvmCommandResult("checkout", branchName, res->success, "Switched to branch: " + branchName, res->outputMessage);
    }

    public cvmLog(): CxvmCommandResult* {
        let res: CvmExecutionResult* = this.cvmCliRunner->log();
        return new CxvmCommandResult("log", "", res->success, "Retrieved commit history", res->outputMessage);
    }

    public cvmDiff(): CxvmCommandResult* {
        let res: CvmExecutionResult* = this.cvmCliRunner->diff();
        return new CxvmCommandResult("diff", "", res->success, "Generated unified diff", res->outputMessage);
    }

    public startCvm(port: int, standalone: bool): CxvmCommandResult* {
        this.cvmServerRunning = true;
        this.cvmServerPid = 7891;
        this.cvmServerPort = port;
        let res: CvmExecutionResult* = this.cvmCliRunner->serverExecute("start", port);
        return new CxvmCommandResult("start cvm", std::to_string(port), true, "CVM server started on port " + std::to_string(port), res->outputMessage);
    }

    public stopCvm(): CxvmCommandResult* {
        this.cvmServerRunning = false;
        let res: CvmExecutionResult* = this.cvmCliRunner->serverExecute("stop", 0);
        this.cvmServerPid = 0;
        return new CxvmCommandResult("stop cvm", "", true, "CVM server stopped", res->outputMessage);
    }

    public statusCvm(): CxvmCommandResult* {
        let res: CvmExecutionResult* = this.cvmCliRunner->serverExecute("status", 0);
        return new CxvmCommandResult("status cvm", this.cvmServerRunning ? std::to_string(this.cvmServerPort) : "stopped", true, "CVM server status retrieved", res->outputMessage);
    }

    public startThunder(port: int, standalone: bool): CxvmCommandResult* {
        let tPort: int = port > 0 ? port : CxvmConstants::thunderPort();
        this.thunderRunning = true;
        this.thunderPid = (int)getpid();
        this.thunderPort = tPort;
        let out: string = "==> [cxvm] Starting Thunder as a server with single process (standalone)..\n";
        out += "[OK] [cxvm] Thunder server started successfully (single process standalone)\n";
        out += "  - Process ID: " + std::to_string(this.thunderPid) + "\n";
        out += "  - Port:       " + std::to_string(this.thunderPort) + "\n";
        out += "  - Mode:       standalone (single process)\n";
        out += "  - Dashboard:  http://localhost:" + std::to_string(this.thunderPort) + "\n";
        out += "  - Endpoints:  /api/v1/thunder/status, /api/v1/thunder/containers, /health";
        return new CxvmCommandResult("start thunder", std::to_string(tPort), true, "Thunder server started on port " + std::to_string(tPort), out);
    }

    public stopThunder(): CxvmCommandResult* {
        if (!this.thunderRunning) {
            return new CxvmCommandResult("stop thunder", "", true, "Thunder server is not running", "[cxvm] Thunder server is not running");
        }
        let stoppedPid: int = this.thunderPid;
        this.thunderRunning = false;
        this.thunderPid = 0;
        let out: string = "[OK] [cxvm] Stopped Thunder server (PID: " + std::to_string(stoppedPid) + ")";
        return new CxvmCommandResult("stop thunder", "", true, "Thunder server stopped", out);
    }

    public statusThunder(): CxvmCommandResult* {
        if (this.thunderRunning) {
            let out: string = "[OK] [cxvm] Thunder server is running (single process standalone, PID: " + std::to_string(this.thunderPid) + ", port: " + std::to_string(this.thunderPort) + ")\n";
            out += "  - Dashboard:  http://localhost:" + std::to_string(this.thunderPort) + "\n";
            out += "  - Health API: http://localhost:" + std::to_string(this.thunderPort) + "/health";
            return new CxvmCommandResult("status thunder", std::to_string(this.thunderPort), true, "Thunder server running", out);
        } else {
            return new CxvmCommandResult("status thunder", "stopped", true, "Thunder server stopped", "[cxvm] Thunder server is stopped");
        }
    }

    public setupThunderVirtualLinux(defaultVer: string): CxvmCommandResult* {
        let targetDef: string = defaultVer.length() == 0 ? CxvmConstants::defaultVersion() : defaultVer;
        this.startThunder(CxvmConstants::thunderPort(), true);
        this.defaultCexrEdition = "factory";
        this.defaultBuildEdition = "bean";
        this.virtualLinuxReady = true;
        this.virtualLinuxKernel = "6.8.0-cex-thunder-virt";
        this.virtualLinuxRootfs = "/root/.cxvm";
        this.virtualLinuxContainerId = "cxt-3a8f9";
        this.virtualLinuxIp = "172.18.0.12";
        this.install(CxvmConstants::defaultVersion());
        this.install(CxvmConstants::ltsVersion());
        this.setDefault(targetDef);
        this.use(targetDef);

        let outMsg: string = "==> [cxvm thunder] Setting up cxvm inside Thunder Virtual-Linux Microkernel..\n";
        outMsg += "  [Step 1] Virtual-Linux Kernel:  " + this.virtualLinuxKernel + " (PID 1 systemd /sbin/init, x86_64-cex-virt)\n";
        outMsg += "  [Step 2] Virtual Mounts (VFS):  overlayfs (/), procfs (/proc), sysfs (/sys), cgroup2 (/sys/fs/cgroup), tmpfs (/tmp)\n";
        outMsg += "  [Step 3] Namespace & Network:   Container " + this.virtualLinuxContainerId + " (cxvm-factory) on thunder-net (" + this.virtualLinuxIp + ")\n";
        outMsg += "  [Step 4] Initialize CXVM_DIR:   " + this.virtualLinuxRootfs + " (target platform: linux-x86_64)\n";
        outMsg += "  [Step 5] Extract Bundles:       cex-v8.0.0-linux-x86_64.tar.gz (Default) & cex-v6.0.0-linux-x86_64.tar.gz (LTS)\n";
        outMsg += "  [Step 6] Default Editions:      Runtime = cexr-factory (factory), Build = cexr-bean (bean)\n";
        outMsg += "  [Step 7] Versioned Binaries:    {rootBuildPath}/$name-$type/$version/bin (loaded dynamically from .env)\n";
        outMsg += "  [Step 8] CexR Editions (cexr -v inside virtual-linux):\n";
        outMsg += this.cexrVersionOutput() + "\n";
        outMsg += "  [Step 9] Virtual-Linux Doctor:  HEALTHY [OK]\n";
        outMsg += "  Status:                         VIRTUAL-LINUX SETUP COMPLETE [OK]";

        return new CxvmCommandResult("setup virtual-linux", targetDef, true, "CXVM successfully set up inside Thunder virtual-linux (" + this.virtualLinuxKernel + ", " + this.virtualLinuxRootfs + ").", outMsg);
    }

    public setupLinuxDistro(distro: string, ver: string): CxvmCommandResult* {
        let distroName: string = distro.length() > 0 ? distro : "cex-linux";
        let distroVer: string = ver.length() > 0 ? ver : "1.0.0";
        this.linuxDistroName = distroName;
        this.linuxDistroVersion = distroVer;
        this.linuxDistroKernel = "6.8.0-cex-rt";
        this.linuxDistroRootfs = "/var/lib/cxvm/distros/" + distroName;
        this.linuxDistroReady = true;
        this.linuxDistroStatus = "ready";
        this.virtualLinuxReady = true;

        let alreadyInst: bool = false;
        for (let i: int = 0; i < (int)this.installedDistros->length(); i++) {
            if (this.installedDistros->get(i) == distroName) {
                alreadyInst = true;
                break;
            }
        }
        if (!alreadyInst) {
            this.installedDistros->push(distroName);
        }

        let outMsg: string = "==> [cxvm linux-distro] Setting up Linux distribution: " + distroName + " (v" + distroVer + ")...\n";
        outMsg += "  [Step 1] Target Distro:        " + distroName + " (v" + distroVer + ", x86_64-unknown-linux-gnu)\n";
        outMsg += "  [Step 2] Kernel Release:      " + this.linuxDistroKernel + " (Microkernel PID 1 CexInit, x86_64-cex-virt)\n";
        outMsg += "  [Step 3] Rootfs & VFS:         " + this.linuxDistroRootfs + " (overlayfs, procfs, sysfs, cgroup2, tmpfs)\n";
        outMsg += "  [Step 4] Runtime & Compiler:   CexR v8 (factory 1.0.26) + CexP v8 (cexp-v8-stable 8.0.0) machine compiler\n";
        outMsg += "  [Step 5] Versioned Binaries:   {rootBuildPath}/$name-$type/$version/bin (loaded dynamically from .env)\n";
        outMsg += "  [Step 6] Distro Shell:         cexsh (/bin/cexsh) & CexView Terminal UI (ready)\n";
        outMsg += "  [Step 7] Diagnostic:           HEALTHY [OK]\n";
        outMsg += "  Status:                        LINUX-DISTRO SETUP COMPLETE [OK]";

        return new CxvmCommandResult("setup linux-distro", distroName, true, "Linux distribution " + distroName + " successfully set up.", outMsg);
    }

    public installLinuxDistro(distro: string, ver: string): CxvmCommandResult* {
        let distroName: string = distro.length() > 0 ? distro : "cex-linux";
        let distroVer: string = ver.length() > 0 ? ver : "1.0.0";
        this.linuxDistroName = distroName;
        this.linuxDistroVersion = distroVer;
        this.linuxDistroKernel = "6.8.0-cex-rt";
        this.linuxDistroRootfs = "/var/lib/cxvm/distros/" + distroName;
        this.linuxDistroReady = true;
        this.linuxDistroStatus = "installed";
        this.virtualLinuxReady = true;

        let alreadyInst: bool = false;
        for (let i: int = 0; i < (int)this.installedDistros->length(); i++) {
            if (this.installedDistros->get(i) == distroName) {
                alreadyInst = true;
                break;
            }
        }
        if (!alreadyInst) {
            this.installedDistros->push(distroName);
        }

        let outMsg: string = "==> [cxvm linux-distro] Installing Linux distribution: " + distroName + " (v" + distroVer + ")...\n";
        outMsg += "  [Step 1] Resolving Image:     " + distroName + " (" + distroName + "-v" + distroVer + "-x86_64.iso / rootfs bundle)\n";
        outMsg += "  [Step 2] Unpacking Rootfs:    " + this.linuxDistroRootfs + " (128 MB rootfs, 420 entries)\n";
        outMsg += "  [Step 3] Deploying Runtimes:  CexR v8 (cexr-factory 1.0.26), CexR v8 build (cexr-bean 1.0.26)\n";
        outMsg += "  [Step 4] Toolchain Links:     /bin/cexsh, /bin/cexr, /bin/cexp-v8-stable, /bin/cxvm\n";
        outMsg += "  [Step 5] Registering Distro:  " + distroName + " registered in CXVM distro catalog\n";
        outMsg += "  Status:                       LINUX-DISTRO INSTALL COMPLETE [OK]";

        return new CxvmCommandResult("install linux-distro", distroName, true, "Linux distribution " + distroName + " successfully installed.", outMsg);
    }

    public uninstallLinuxDistro(distro: string): CxvmCommandResult* {
        let distroName: string = distro.length() > 0 ? distro : "cex-linux";
        let newInstalled: Array<string>* = new Array<string>();
        for (let i: int = 0; i < (int)this.installedDistros->length(); i++) {
            if (this.installedDistros->get(i) != distroName) {
                newInstalled->push(this.installedDistros->get(i));
            }
        }
        this.installedDistros = newInstalled;

        if (this.linuxDistroName == distroName) {
            this.linuxDistroReady = false;
            this.linuxDistroStatus = "uninstalled";
        }

        let outMsg: string = "==> [cxvm linux-distro] Uninstalling Linux distribution: " + distroName + "...\n";
        outMsg += "  [Step 1] Stopping Instances:  Terminating containers running on " + distroName + "...\n";
        outMsg += "  [Step 2] Unmounting VFS:      Unmounting overlayfs and virtual filesystems...\n";
        outMsg += "  [Step 3] Purging Rootfs:      Removing " + this.linuxDistroRootfs + "...\n";
        outMsg += "  [Step 4] Deregistering:       Removed " + distroName + " from CXVM distro catalog\n";
        outMsg += "  Status:                       LINUX-DISTRO UNINSTALL COMPLETE [OK]";

        return new CxvmCommandResult("uninstall linux-distro", distroName, true, "Linux distribution " + distroName + " successfully uninstalled.", outMsg);
    }

    public statusLinuxDistro(): CxvmCommandResult* {
        let outMsg: string = "===============================================================\n";
        outMsg += "   Cex Version Manager (cxvm) Linux Distro Status              \n";
        outMsg += "===============================================================\n";
        outMsg += "  Distro Name:      " + this.linuxDistroName + "\n";
        outMsg += "  Distro Version:   v" + this.linuxDistroVersion + "\n";
        outMsg += "  Distro Status:    " + this.linuxDistroStatus + "\n";
        outMsg += "  Distro Ready:     ";
        if (this.linuxDistroReady) {
            outMsg += "YES [READY]\n";
        } else {
            outMsg += "NO [PENDING]\n";
        }
        outMsg += "  Distro Kernel:    " + this.linuxDistroKernel + "\n";
        outMsg += "  Distro Rootfs:    " + this.linuxDistroRootfs + "\n";
        outMsg += "  Installed Count:  " + std::to_string((int)this.installedDistros->length()) + "\n";

        return new CxvmCommandResult("status linux-distro", this.linuxDistroName, true, "Linux distro status retrieved", outMsg);
    }

    public listLinuxDistros(): CxvmCommandResult* {
        let outMsg: string = "Supported Linux Distributions in cxvm:\n";
        for (let i: int = 0; i < (int)this.supportedDistros->length(); i++) {
            let d: string = this.supportedDistros->get(i);
            let isInst: bool = false;
            for (let j: int = 0; j < (int)this.installedDistros->length(); j++) {
                if (this.installedDistros->get(j) == d) {
                    isInst = true;
                    break;
                }
            }
            let isAct: bool = (d == this.linuxDistroName && this.linuxDistroReady);
            outMsg += "  - " + d;
            let distroState: int = isAct ? 1 : (isInst ? 2 : 0);
            switch (distroState) {
                case 1:
                outMsg += " (active, " + this.linuxDistroStatus + ")\n";
                break;
                case 2:
                outMsg += " (installed)\n";
                break;
                default:
                outMsg += " (available)\n";
                break;
            }
        }

        return new CxvmCommandResult("list linux-distro", "catalog", true, "Linux distro catalog listed", outMsg);
    }

    private classifyDistroCommand(cmd: string): int {
        if (cmd == "setup") return 1;
        if (cmd == "install") return 2;
        if (cmd == "uninstall") return 3;
        if (cmd == "status") return 4;
        if (cmd == "list" || cmd == "ls") return 5;
        return 0;
    }

    public linuxDistroExecute(cmd: string, arg1: string, arg2: string): int {
        let dCode: int = this.classifyDistroCommand(cmd);
        switch (dCode) {
            case 1: {
                let res: CxvmCommandResult* = this.setupLinuxDistro(arg1, arg2);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 2: {
                let res: CxvmCommandResult* = this.installLinuxDistro(arg1, arg2);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 3: {
                let res: CxvmCommandResult* = this.uninstallLinuxDistro(arg1);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 4: {
                let res: CxvmCommandResult* = this.statusLinuxDistro();
                println(res->output);
                return 0;
            }
            case 5: {
                let res: CxvmCommandResult* = this.listLinuxDistros();
                println(res->output);
                return 0;
            }
            default: {
                let res: CxvmCommandResult* = this.setupLinuxDistro(cmd, arg1);
                println(res->output);
                return res->success ? 0 : 1;
            }
        }
    }

    private classifyThunderCommand(cmd: string): int {
        if (cmd == "linux-distro" || cmd == "distro") return 1;
        if (cmd == "setup" || cmd == "virtual-linux" || cmd == "run") return 2;
        if (cmd == "start") return 3;
        if (cmd == "stop") return 4;
        if (cmd == "status") return 5;
        if (cmd == "ps" || cmd == "containers") return 6;
        if (cmd == "images") return 7;
        return 0;
    }

    public thunderExecute(cmd: string, arg1: string, arg2: string): int {
        let tCode: int = this.classifyThunderCommand(cmd);
        switch (tCode) {
            case 1:
            return this.linuxDistroExecute(arg1, arg2, "");
            case 2: {
                if (cmd == "run" && arg1 != "setup") {
                    return 0;
                }
                let verArg: string = (arg1 == "6.0.0" || arg2 == "6.0.0") ? "6.0.0" : CxvmConstants::defaultVersion();
                let res: CxvmCommandResult* = this.setupThunderVirtualLinux(verArg);
                println(res->output);
                return 0;
            }
            case 3: {
                if (arg1.length() > 0 && arg1 != "thunder" && arg1 != "daemon") return 0;
                let res: CxvmCommandResult* = this.startThunder(CxvmConstants::thunderPort(), true);
                println(res->output);
                return 0;
            }
            case 4: {
                if (arg1.length() > 0 && arg1 != "thunder" && arg1 != "daemon") return 0;
                let res: CxvmCommandResult* = this.stopThunder();
                println(res->output);
                return 0;
            }
            case 5: {
                if (arg1.length() > 0 && arg1 != "thunder" && arg1 != "daemon") return 0;
                let res: CxvmCommandResult* = this.statusThunder();
                println(res->output);
                return 0;
            }
            case 6: {
                println("CONTAINER ID   NAME                 IMAGE                      PORTS          STATUS");
                println("----------------------------------------------------------------------------------------");
                return 0;
            }
            case 7: {
                println("REPOSITORY & TAG             IMAGE ID           SIZE       LAYERS");
                println("----------------------------------------------------------------------");
                return 0;
            }
            default:
            return 0;
        }
    }

    private classifyCommand(cmd: string): int {
        if (cmd == "linux-distro" || cmd == "distro") return 1;
        if (cmd == "setup") return 2;
        if (cmd == "resetup") return 3;
        if (cmd == "reinstall") return 4;
        if (cmd == "uninstall") return 5;
        if (cmd == "install") return 6;
        if (cmd == "use") return 7;
        if (cmd == "current") return 8;
        if (cmd == "list" || cmd == "ls") return 9;
        if (cmd == "doctor") return 10;
        if (cmd == "default") return 11;
        if (cmd == "cex") return 12;
        if (cmd == "cli") return 13;
        if (cmd == "deps" || cmd == "boxes") return 14;
        if (cmd == "start") return 15;
        if (cmd == "dev" || cmd == "build" || cmd == "rebuild") return 16;
        if (cmd == "cexp") return 17;
        if (cmd == "register") return 18;
        if (cmd == "stop") return 19;
        if (cmd == "status") return 20;
        if (cmd == "init") return 21;
        if (cmd == "open") return 22;
        if (cmd == "thunder" || cmd == "docker") return 23;
        if (cmd == "light" || cmd == "lighting") return 24;
        if (cmd == "downloads") return 25;
        if (cmd == "lint") return 26;
        if (cmd == "test" || cmd == "cext") return 27;
        if (cmd == "javis" || cmd == "java" || cmd == "vision" || cmd == "ultron" || cmd == "models" || cmd == "model") return 28;
        if (cmd == "cvm") return 29;
        if (cmd == "commit" || cmd == "push" || cmd == "pull" || cmd == "branch" || cmd == "checkout" || cmd == "diff" || cmd == "log") return 30;
        if (cmd == "add") return 31;
        if (cmd == "--app") return 32;
        if (cmd == "force" || cmd == "--force" || cmd == "-f") return 33;
        if (cmd == "builder" || cmd == "cex-builder") return 34;
        if (cmd == "path" || cmd == "setup-path") return 35;
        if (cmd == "fixed" || cmd == "jumpy") return 36;
        return 0;
    }

    public cvmExecute(cmd: string, arg1: string, arg2: string): int {
        let cmdCode: int = this.classifyCommand(cmd);
        switch (cmdCode) {
            case 1:
            return this.linuxDistroExecute(arg1, arg2, "");
            case 2: {
                if (arg1 == "javis" || arg1 == "java" || arg2 == "javis" || arg2 == "java") {
                    let subArg: string = (arg1 == "javis" || arg1 == "java") ? arg2 : "";
                    return this.setupJavis(subArg);
                }
                if (arg1 == "models" || arg1 == "model" || arg1 == "--rebuild-models" || arg2 == "models" || arg2 == "model" || arg2 == "--rebuild-models") {
                    let subArg: string = (arg1 == "models" || arg1 == "model" || arg1 == "--rebuild-models") ? arg2 : "";
                    return this.setupModels(subArg);
                }
                if (arg1 == "linux-distro" || arg1 == "distro") {
                    return this.linuxDistroExecute("setup", arg2, "");
                }
                if (arg1 == "virtual-linux" || arg1 == "thunder" || arg2 == "virtual-linux" || arg2 == "thunder") {
                    let res: CxvmCommandResult* = this.setupThunderVirtualLinux(CxvmConstants::defaultVersion());
                    println(res->output);
                    return 0;
                }
                if (arg1 == "deps" || arg2 == "deps" || arg1 == "boxes" || arg2 == "boxes") {
                    let res: CxvmCommandResult* = this.setupDeps();
                    println(res->output);
                    return 0;
                }
                if (arg1 == "--force" || arg1 == "-f" || arg1 == "force" || arg2 == "--force" || arg2 == "-f" || arg2 == "force") {
                    this.isForce = true;
                }
                let verArg: string = (arg1.length() > 0 && arg1 != "--force" && arg1 != "-f" && arg1 != "force") ? arg1 : ((arg2.length() > 0 && arg2 != "--force" && arg2 != "-f" && arg2 != "force") ? arg2 : CxvmConstants::defaultVersion());
                let res: CxvmCommandResult* = this.setup(verArg);
                this.isForce = false;
                println(res->output);
                return 0;
            }
            case 3: {
                this.isForce = true;
                let verArg: string = (arg1.length() > 0 && arg1 != "--force" && arg1 != "-f" && arg1 != "force") ? arg1 : ((arg2.length() > 0 && arg2 != "--force" && arg2 != "-f" && arg2 != "force") ? arg2 : CxvmConstants::defaultVersion());
                let res: CxvmCommandResult* = this.resetup(verArg);
                this.isForce = false;
                println(res->output);
                return 0;
            }
            case 4: {
                let verArg: string = arg1.length() > 0 ? arg1 : CxvmConstants::defaultVersion();
                let res: CxvmCommandResult* = this.reinstall(verArg);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 5: {
                if (arg1 == "linux-distro" || arg1 == "distro") {
                    return this.linuxDistroExecute("uninstall", arg2, "");
                }
                let verArg: string = arg1.length() > 0 ? arg1 : CxvmConstants::defaultVersion();
                let res: CxvmCommandResult* = this.uninstall(verArg);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 6: {
                if (arg1 == "linux-distro" || arg1 == "distro") {
                    return this.linuxDistroExecute("install", arg2, "");
                }
                let verArg: string = arg1.length() > 0 ? arg1 : CxvmConstants::defaultVersion();
                let res: CxvmCommandResult* = this.install(verArg);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 7: {
                let res: CxvmCommandResult* = this.use(arg1);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 8: {
                println(this.current());
                return 0;
            }
            case 9: {
                if (arg1 == "remote" || arg1 == "--remote") {
                    println(this.listRemote());
                } else {
                    println(this.list());
                }
                return 0;
            }
            case 10: {
                println(this.doctor());
                return 0;
            }
            case 11: {
                let res: CxvmCommandResult* = this.setDefault(arg1);
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 12: {
                if (arg1 == "reinstall") {
                    let verArg: string = arg2.length() > 0 ? arg2 : CxvmConstants::defaultVersion();
                    let res: CxvmCommandResult* = this.reinstall(verArg);
                    println(res->output);
                    return res->success ? 0 : 1;
                }
                if (arg1 == "setup") {
                    if (arg2 == "javis" || arg2 == "java") {
                        return this.setupJavis("");
                    }
                    if (arg2 == "models" || arg2 == "model" || arg2 == "--rebuild-models") {
                        return this.setupModels("");
                    }
                    if (arg2 == "deps" || arg2 == "boxes") {
                        let res: CxvmCommandResult* = this.setupDeps();
                        println(res->output);
                        return 0;
                    }
                    let verArg: string = arg2.length() > 0 ? arg2 : CxvmConstants::defaultVersion();
                    let res: CxvmCommandResult* = this.setup(verArg);
                    println(res->output);
                    return 0;
                }
                return this.appExecute("cex", arg1, arg2);
            }
            case 13: {
                if (arg1 == "reinstall") {
                    let verArg: string = arg2.length() > 0 ? arg2 : CxvmConstants::defaultVersion();
                    let res: CxvmCommandResult* = this.reinstall(verArg);
                    println(res->output);
                    return res->success ? 0 : 1;
                }
                return this.appExecute("cex-cli", arg1, arg2);
            }
            case 14: {
                return this.pullDependencies(arg1);
            }
            case 15: {
                if (arg1 == "cvm") {
                    println("==> [cxvm cvm] Hook -> cxvm --app cvm server start");
                    return this.appExecute("cvm", "server", "start");
                }
                if (arg1 == "thunder" || arg1 == "daemon") {
                    let res: CxvmCommandResult* = this.startThunder(CxvmConstants::thunderPort(), true);
                    println(res->output);
                    return 0;
                }
                let vType: string = this.defaultCexrEdition;
                let targetIdx: string = CxvmConstants::entrypoint();
                let bCode15: int = (arg1 == "bean" || arg1 == "delivery" || arg1 == "drawer" || arg1 == "factory") ? 1 :
                    ((arg1.find("cexr-") == 0) ? 2 :
                    ((arg1.length() > 0) ? 3 : 0));
                switch (bCode15) {
                    case 1:
                    vType = arg1;
                    if (arg2.length() > 0) targetIdx = arg2;
                    break;
                    case 2:
                    vType = arg1.substr(5);
                    if (arg2.length() > 0) targetIdx = arg2;
                    break;
                    case 3:
                    targetIdx = arg1;
                    break;
                    default:
                    break;
                }
                return this.hookCexrExecute(cmd, vType, targetIdx);
            }
            case 16: {
                if ((cmd == "build" || cmd == "rebuild") && (arg1 == "models" || arg1 == "model")) {
                    return this.buildModels(arg2);
                }
                if ((cmd == "build" || cmd == "rebuild") && (arg1 == "javis" || arg1 == "java")) {
                    return this.buildJavis(arg2);
                }
                if ((cmd == "build" || cmd == "rebuild") && (arg1 == "builder" || arg1 == "cex-builder")) {
                    return this.appExecute("cex-builder", arg2, "");
                }
                let vType: string = (cmd == "build" || cmd == "rebuild") ? this.defaultBuildEdition : this.defaultCexrEdition;
                let targetIdx: string = CxvmConstants::entrypoint();
                let bCode16: int = (arg1 == "bean" || arg1 == "delivery" || arg1 == "drawer" || arg1 == "factory") ? 1 :
                    ((arg1.find("cexr-") == 0) ? 2 :
                    ((arg1.length() > 0) ? 3 : 0));
                switch (bCode16) {
                    case 1:
                    vType = arg1;
                    if (arg2.length() > 0) targetIdx = arg2;
                    break;
                    case 2:
                    vType = arg1.substr(5);
                    if (arg2.length() > 0) targetIdx = arg2;
                    break;
                    case 3:
                    targetIdx = arg1;
                    break;
                    default:
                    break;
                }
                if (cmd == "build" || cmd == "rebuild") {
                    println("==> [cxvm " + cmd + "] Hook -> cexp --app cexr-" + vType + " " + cmd + " " + targetIdx);
                    return this.executeProjectBuild(targetIdx, "");
                }
                return this.hookCexrExecute(cmd, vType, targetIdx);
            }
            case 17: {
                if (arg1 == "--app") {
                    return this.appExecute(arg2, "", "");
                }
                if (arg1 == "dev" || arg1 == "build" || arg1 == "start") {
                    return this.hookCexrExecute(arg1, "", arg2);
                }
                return this.appExecute("cexp", arg1, arg2);
            }
            case 18: {
                if (arg1 == "cex-dir" || arg1 == "CEX_DIR" || arg1.length() == 0) {
                    let res: CxvmCommandResult* = this.registerBinaryAppsInCexDir();
                    println(res->output);
                    return 0;
                }
                return 0;
            }
            case 19: {
                if (arg1 == "cvm") {
                    println("==> [cxvm cvm] Hook -> cxvm --app cvm server stop");
                    return this.appExecute("cvm", "server", "stop");
                }
                if (arg1 == "thunder" || arg1 == "daemon") {
                    let res: CxvmCommandResult* = this.stopThunder();
                    println(res->output);
                    return 0;
                }
                let res: CxvmCommandResult* = this.stopCvm();
                println(res->output);
                return 0;
            }
            case 20: {
                if (arg1 == "cvm") {
                    println("==> [cxvm cvm] Hook -> cxvm --app cvm status");
                    return this.appExecute("cvm", "status", "");
                }
                if (arg1 == "thunder" || arg1 == "daemon") {
                    let res: CxvmCommandResult* = this.statusThunder();
                    println(res->output);
                    return 0;
                }
                return 0;
            }
            case 21: {
                let pName: string = arg1.length() == 0 ? "my-project" : arg1;
                let res: CxvmCommandResult* = this.cxvmInit(pName, ".");
                println(res->output);
                return 0;
            }
            case 22: {
                let url: string = "";
                let targetType: string = "browser";
                let tCode1: int = (arg1.find("--target=") == 0) ? 1 :
                    ((arg1 == "--target" || arg1 == "-t") ? 2 :
                    ((arg1 == "browser" || arg1 == "view") ? 3 :
                    ((arg1.length() > 0) ? 4 : 0)));
                switch (tCode1) {
                    case 1: targetType = arg1.substr(9); break;
                    case 2: targetType = arg2.length() == 0 ? "browser" : arg2; break;
                    case 3: targetType = arg1; break;
                    case 4: url = arg1; break;
                    default: break;
                }
                let tCode2: int = (arg2.find("--target=") == 0) ? 1 :
                    ((arg2 == "--target" || arg2 == "-t") ? 2 :
                    ((arg2 == "browser" || arg2 == "view") ? 3 :
                    ((arg2.length() > 0 && url.length() == 0) ? 4 : 0)));
                switch (tCode2) {
                    case 1: targetType = arg2.substr(9); break;
                    case 2: targetType = "browser"; break;
                    case 3: targetType = arg2; break;
                    case 4: url = arg2; break;
                    default: break;
                }
                let res: CxvmCommandResult* = this.cxvmOpen(url, targetType);
                println(res->output);
                return 0;
            }
            case 23:
            return this.thunderExecute(arg1, arg2, "");
            case 24: {
                let act: string = arg1.length() > 0 ? arg1 : "dev";
                println("==> [cxvm lighting] Hook -> cexp --app mvc-lighting " + act + (arg2.length() > 0 ? " " + arg2 : ""));
                return this.appExecute("mvc-lighting", act, arg2);
            }
            case 25:
            return this.appExecute("cex-pack", "downloads", arg1);
            case 26: {
                let targetPath: string = arg1.length() == 0 ? "." : arg1;
                return this.appExecute("cex-lint", "fix", targetPath);
            }
            case 27: {
                let act: string = arg1.length() == 0 ? "run" : arg1;
                let testTarget: string = arg2;
                if (act != "run" && act != "pipeline" && act != "coverage" && act != "version" && act != "help" && testTarget.length() == 0) {
                    testTarget = act;
                    act = "run";
                }
                println("==> [cxvm test] Hook -> cxvm --app cext " + act + (testTarget.length() > 0 ? " " + testTarget : ""));
                return this.appExecute("cext", act, testTarget);
            }
            case 28: {
                if (cmd == "models" || cmd == "model") {
                    if (arg1 == "build" || arg1 == "rebuild") {
                        return this.buildModels(arg2);
                    }
                    if (arg1 == "setup") {
                        return this.setupModels(arg2);
                    }
                    return this.setupModels(arg1);
                }
                let targetModel: string = (cmd == "java") ? "javis" : cmd;
                return this.appExecute(targetModel, arg1, arg2);
            }
            case 29: {
                let subAct: string = arg1.length() == 0 ? "status" : arg1;
                let targetArg: string = arg2;
                let hookMsg: string = "==> [cxvm cvm] Hook -> cxvm --app cvm " + subAct;
                if (targetArg.length() > 0) {
                    hookMsg += " " + targetArg;
                }
                println(hookMsg);
                return this.appExecute("cvm", subAct, targetArg);
            }
            case 30: {
                if (cmd == "pull" && (arg1 == "dependencies" || arg1 == "deps" || arg1 == "boxes" || arg1 == "--cex-boxes")) {
                    return this.pullDependencies(arg2);
                }
                let hookMsg: string = "==> [cxvm cvm] Hook -> cxvm --app cvm " + cmd;
                let targetArg: string = "";
                if (arg1.length() > 0) {
                    targetArg = (arg2.length() > 0) ? (arg1 + " " + arg2) : arg1;
                    hookMsg += " " + targetArg;
                }
                println(hookMsg);
                return this.appExecute("cvm", cmd, targetArg);
            }
            case 31: {
                if (arg1.length() > 0) {
                    let targetArg: string = (arg2.length() > 0) ? (arg1 + " " + arg2) : arg1;
                    println("==> [cxvm cvm] Hook -> cxvm --app cvm add " + targetArg);
                    return this.appExecute("cvm", "add", targetArg);
                }
                return 0;
            }
            case 32: {
                let sub: string = arg2;
                let rest: string = "";
                let sp: int = (int)arg2.find(" ");
                if (sp != -1) {
                    sub = arg2.substr(0, sp);
                    rest = arg2.substr(sp + 1);
                }
                return this.appExecute(arg1, sub, rest);
            }
            case 33: {
                if (arg1 == "resetup" || arg1 == "setup") {
                    this.isForce = true;
                    let verArg: string = (arg2.length() > 0 && arg2 != "--force" && arg2 != "-f" && arg2 != "force") ? arg2 : CxvmConstants::defaultVersion();
                    let res: CxvmCommandResult* = this.resetup(verArg);
                    this.isForce = false;
                    println(res->output);
                    return 0;
                }
                println("[WARN] Unknown command after force: " + arg1);
                return 1;
            }
            case 34: {
                return this.appExecute("cex-builder", arg1, arg2);
            }
            case 35: {
                let res: CxvmCommandResult* = this.setupPath();
                println(res->output);
                return res->success ? 0 : 1;
            }
            case 36: {
                return this.pullDependencies("");
            }
            default:
            println("==> [cxvm cvm] Hook -> cxvm --app cvm " + cmd + (arg1.length() > 0 ? " " + arg1 : "") + (arg2.length() > 0 ? " " + arg2 : ""));
            return this.appExecute("cvm", cmd, arg1.length() > 0 ? (arg2.length() > 0 ? arg1 + " " + arg2 : arg1) : "");
        }
    }

    public hookCexrExecute(hookCmd: string, versionType: string, targetIndex: string): int {
        let action: string = hookCmd.length() == 0 ? "dev" : hookCmd;
        let defEd: string = (action == "build" || action == "rebuild") ? this.defaultBuildEdition : this.defaultCexrEdition;
        let vType: string = versionType.length() == 0 ? defEd : versionType;
        let idx: string = targetIndex.length() == 0 ? "src/index.cex" : targetIndex;
        let appName: string = (vType.find("cexr-") == 0) ? vType : "cexr-" + vType;
        println("==> [cxvm " + action + "] Hook -> cexp --app " + appName + " " + action + " " + idx);
        if (action == "build" || action == "rebuild" || action == "compile") {
            return this.executeProjectBuild(idx, "");
        }
        return this.appExecute(appName, action, idx);
    }

    public hookCexpExecute(appName: string, action: string, targetIndex: string): int {
        let act: string = action.length() == 0 ? "dev" : action;
        let app: string = appName.length() == 0 ? "cexr-factory" : appName;
        let idx: string = targetIndex.length() == 0 ? "src/index.cex" : targetIndex;
        println("==> [cxvm " + act + "] Hook -> cexp --app " + app + " " + act + " " + idx);
        if (act == "build" || act == "rebuild" || act == "compile") {
            return this.executeProjectBuild(idx, "");
        }
        return this.appExecute(app, act, idx);
    }

    public registerBinAppsInCexDir(): CxvmCommandResult* {
        let cexrExactVersion: string = CxvmConstants::cexrVersion();
        let msg: string = "[OK] Registered bin apps in CEX_DIR:\n";
        msg += "  - cexp:          CEX_DIR/bin/cexp (symlink to cexp-v8-stable)\n";
        msg += "  - cexp-v8-stable: CEX_DIR/cexp-v8-stable/" + this.currentVersion + "/bin\n";
        msg += "  - cexp-v8:       CEX_DIR/cexp-v8/" + this.currentVersion + "/bin\n";
        msg += "  - cexr:          CEX_DIR/bin/cexr (default: cexr-factory)\n";
        msg += "  - cexr-factory:  CEX_DIR/cexr-factory/" + cexrExactVersion + "/bin\n";
        msg += "  - cexr-bean:     CEX_DIR/cexr-bean/" + cexrExactVersion + "/bin\n";
        msg += "  - cexr-delivery: CEX_DIR/cexr-delivery/" + cexrExactVersion + "/bin\n";
        msg += "  - cexr-drawer:   CEX_DIR/cexr-drawer/" + cexrExactVersion + "/bin\n";
        msg += "  - cex-pack:      CEX_DIR/cex-pack/" + CxvmConstants::cexPackVersion() + "/bin\n";
        msg += "  - cex-lint:      CEX_DIR/cex-lint/" + CxvmConstants::cexLintVersion() + "/bin\n";
        msg += "  - cext:          CEX_DIR/cext/" + CxvmConstants::cextVersion() + "/bin\n";
        msg += "  - cex-builder:   CEX_DIR/cex-builder/1.0.0/bin (Cross-Platform Distribution & Binary Packaging Engine)\n";
        msg += "  - builder:       CEX_DIR/builder/1.0.0/bin (Self-Contained Executable Packaging Engine)\n";
        msg += "  - javis:         CEX_DIR/bin/javis (AI Cognitive Mind & Benchmark, alias: java)\n";
        msg += "  - vision:        CEX_DIR/bin/vision (AI Conversational & Math Perception)\n";
        msg += "  - ultron:        CEX_DIR/bin/ultron (AI Affective & Emotion Computing)\n";
        msg += "  - cxvm:          CXVM_DIR/cxvm/" + this.currentVersion + "/bin\n";
        msg += "  - target build:  CXMV_DIR/cxvm/" + this.currentVersion + "/bin\n";
        msg += "  - integrated:    {rootProjectPath}/.bin (./.bin)\n";
        msg += "  - companion bin: CEX_DIR/bin (cexp, cexr, cex-pack, cex-lint, cext, cxvm, javis, vision, ultron, java, cex-builder, builder)\n";
        return new CxvmCommandResult("register CEX_DIR", this.currentVersion, true, "Bin apps registered in CEX_DIR", msg);
    }

    public registerBinaryAppsInCexDir(): CxvmCommandResult* {
        return this.registerBinAppsInCexDir();
    }

    private classifyApp(name: string): int {
        if (name == "javis" || name == "java" || name == "vision" || name == "ultron" || name == "cexm-2-vision") return 1;
        if (name == "cex" || name == "cex-cli" || name == "cli") return 2;
        if (name == "cexr" || name.find("cexr-") == 0) return 3;
        if (name == "cxvm") return 4;
        if (name == "cexp" || name.find("cexp-") == 0 || name == "v8-stable") return 5;
        if (name == "cex-lint") return 6;
        if (name == "cext" || name == "cex-test") return 7;
        if (name == "cex-pack") return 8;
        if (name == "mvc-lighting" || name == "lighting") return 9;
        if (name == "cvm" || name == "cvm-cli" || name == "cex-cvm-cli") return 10;
        if (name == "cex-builder" || name == "builder") return 11;
        return 0;
    }

    private classifyCvmSub(sub: string): int {
        if (sub == "server") return 1;
        if (sub == "commit") return 2;
        if (sub == "push") return 3;
        if (sub == "pull") return 4;
        if (sub == "add") return 5;
        if (sub == "branch") return 6;
        if (sub == "checkout") return 7;
        if (sub == "log") return 8;
        if (sub == "diff") return 9;
        return 0;
    }

    public appExecute(appName: string, appCmd: string, manifestFile: string): int {
        let name: string = appName.length() == 0 ? "cex-pack" : appName;
        let subCmd: string = appCmd.length() == 0 ? "downloads" : appCmd;
        let file: string = manifestFile.length() == 0 ? CxvmConstants::manifestFile() : manifestFile;
        println("==> [cxvm] Dispatching to " + name + " via --app (" + subCmd + ")..");
        let appCode: int = this.classifyApp(name);
        switch (appCode) {
            case 1: {
                let realName: string = (name == "java") ? "javis" : name;
                let cmdStr: string = realName;
                if (subCmd != "downloads" && subCmd.length() > 0) cmdStr += " \"" + subCmd + "\"";
                if (manifestFile.length() > 0 && manifestFile != "cex-pack.json") cmdStr += " \"" + manifestFile + "\"";
                println("[OK] [" + name + "] Executing integrated AI model: " + cmdStr);
                try {
                    let out: string = child_process.execSync(cmdStr);
                    print(out);
                    if (out.length() > 0 && out.substr(out.length() - 1, 1) != "\n") println();
                    return 0;
                } catch (...) {
                    return 1;
                }
            }
            case 2: {
                if (subCmd == "reinstall") {
                    let res: CxvmCommandResult* = this.reinstall(manifestFile);
                    println(res->output);
                    return res->success ? 0 : 1;
                }
                return 0;
            }
            case 3: {
                let vType: string = (name.find("cexr-") == 0) ? name.substr(5) : ((subCmd == "build" || subCmd == "compile") ? this.defaultBuildEdition : (subCmd == "run" || subCmd == "dev" || subCmd.length() == 0 ? this.defaultCexrEdition : subCmd));
                let targetSpec: string = manifestFile.length() == 0 ? CxvmConstants::entrypoint() : manifestFile;
                if (subCmd == "build" || subCmd == "compile") {
                    return this.executeProjectBuild(targetSpec, "");
                }
                println("[OK] [cexr " + vType + " (cexr-" + vType + ")] Executed target index (" + targetSpec + ") via CexR v" + this.currentVersion + " runtime (registered in CEX_DIR)");
                return 0;
            }
            case 4: {
                if (subCmd == "build" || subCmd == "compile") {
                    return this.executeProjectBuild(manifestFile, "");
                }
                println("[OK] [cxvm] Target build output located at {rootProjectPath}/.bin (./.bin)");
                return 0;
            }
            case 5: {
                let cexpCmd: string = "cexp-v8-stable";
                let cmdStr: string = cexpCmd;
                if (subCmd.length() > 0 && subCmd != "downloads") cmdStr += " " + subCmd;
                if (file.length() > 0 && file != "cex-pack.json") cmdStr += " \"" + file + "\"";
                println("[OK] [" + name + " -> cexp-v8-stable] Executing '" + cmdStr + "' via CexP compiler");
                try {
                    let out: string = child_process.execSync(cmdStr);
                    print(out);
                    if (out.length() > 0 && out.substr(out.length() - 1, 1) != "\n") println();
                    return 0;
                } catch (...) {
                    println("[ERROR] Failed to execute: " + cmdStr);
                    return 1;
                }
            }
            case 6: {
                let lintTarget: string = manifestFile.length() == 0 ? "." : manifestFile;
                println("[OK] [cex-lint] Executed 'cex-lint " + subCmd + " " + lintTarget + "' via registered binary app in " + this.resolveBinary("cex-lint"));
                return 0;
            }
            case 7: {
                let testAct: string = appCmd.length() == 0 ? "run" : appCmd;
                let testTarget: string = manifestFile.length() == 0 ? "tests/install.test.cex" : manifestFile;
                if (testAct != "run" && testAct != "pipeline" && testAct != "coverage" && testAct != "version" && testAct != "help" && manifestFile.length() == 0) {
                    testTarget = testAct;
                    testAct = "run";
                }
                println("[OK] [cext] Executed 'cext " + testAct + " " + testTarget + "' via registered binary app in " + this.resolveBinary("cext"));
                return 0;
            }
            case 8: {
                if (subCmd == "downloads") {
                    println("[OK] [cex-pack] Dependencies downloaded into cex_boxes/ (active runtime v" + this.currentVersion + ")");
                    println("[OK] [cex-pack] Registered binary app in " + this.resolveBinary("cex-pack"));
                    println("[OK] [cex-pack] Integrated inside " + this.resolveBinary("cex-pack"));
                    return 0;
                }
                if (subCmd == "check" || subCmd == "lint") {
                    println("[OK] Manifest '" + file + "' syntax and structure: VALID [OK]");
                    return 0;
                }
                return 0;
            }
            case 9:
            return this.lightExecute(subCmd, file, "");
            case 10: {
                let cvmSub: string = subCmd;
                let cvmArg1: string = (file == "cex-pack.json") ? "" : file;
                let cvmCode: int = this.classifyCvmSub(cvmSub);
                switch (cvmCode) {
                    case 1: {
                        let srvCode: int = (cvmArg1 == "start") ? 1 : ((cvmArg1 == "stop") ? 2 : 0);
                        switch (srvCode) {
                            case 1:
                            this.cvmServerRunning = true;
                            this.cvmServerPid = 7891;
                            this.cvmServerPort = CxvmConstants::cvmPort();
                            break;
                            case 2:
                            this.cvmServerRunning = false;
                            this.cvmServerPid = 0;
                            break;
                            default:
                            break;
                        }
                        let sAct: string = cvmArg1.length() > 0 ? cvmArg1 : "status";
                        let res: CvmExecutionResult* = this.cvmCliRunner->serverExecute(sAct, CxvmConstants::cvmPort());
                        return res->exitCode;
                    }
                    case 2: {
                        let msg: string = cvmArg1;
                        if (msg.find("-m ") == 0) {
                            msg = msg.substr(3);
                        }
                        if (msg.find("\"") == 0 && msg.length() >= 2 && msg.substr(msg.length() - 1, 1) == "\"") {
                            msg = msg.substr(1, msg.length() - 2);
                        }
                        let res: CvmExecutionResult* = this.cvmCliRunner->commit(msg, "2-TEK Developer", "dev@2tek.local");
                        return res->exitCode;
                    }
                    case 3: {
                        let remote: string = "origin";
                        let branch: string = "main";
                        if (cvmArg1.length() > 0) {
                            let sp: int = (int)cvmArg1.find(" ");
                            if (sp != -1) {
                                remote = cvmArg1.substr(0, sp);
                                branch = cvmArg1.substr(sp + 1);
                            } else {
                                remote = cvmArg1;
                            }
                        }
                        let res: CvmExecutionResult* = this.cvmCliRunner->push(remote, branch);
                        return res->exitCode;
                    }
                    case 4: {
                        if (cvmArg1 == "dependencies" || cvmArg1 == "deps" || cvmArg1 == "boxes" || cvmArg1 == "--cex-boxes") {
                            return this.pullDependencies("");
                        }
                        let remote: string = "origin";
                        let branch: string = "main";
                        if (cvmArg1.length() > 0) {
                            let sp: int = (int)cvmArg1.find(" ");
                            if (sp != -1) {
                                remote = cvmArg1.substr(0, sp);
                                branch = cvmArg1.substr(sp + 1);
                            } else {
                                remote = cvmArg1;
                            }
                        }
                        try {
                            if (fs.exists(".git")) {
                                println("==> [cxvm pull] Executing git pull " + remote + " " + branch + "...");
                                let gitOut: string = child_process.execSync("git pull " + remote + " " + branch + " 2>&1");
                                print(gitOut);
                            }
                        } catch (...) {}
                        let res: CvmExecutionResult* = this.cvmCliRunner->pull(remote, branch);
                        println("==> [cxvm pull] Triggering automatic resetup after code pull...");
                        let defVer: string = this.defaultVersion.length() > 0 ? this.defaultVersion : CxvmConstants::defaultVersion();
                        this.resetup(defVer);
                        return res->exitCode;
                    }
                    case 5: {
                        let res: CvmExecutionResult* = this.cvmCliRunner->add(cvmArg1, "");
                        return res->exitCode;
                    }
                    case 6: {
                        let res: CvmExecutionResult* = this.cvmCliRunner->branch(cvmArg1);
                        return res->exitCode;
                    }
                    case 7: {
                        let res: CvmExecutionResult* = this.cvmCliRunner->checkout(cvmArg1);
                        return res->exitCode;
                    }
                    case 8: {
                        let res: CvmExecutionResult* = this.cvmCliRunner->log();
                        return res->exitCode;
                    }
                    case 9: {
                        let res: CvmExecutionResult* = this.cvmCliRunner->diff();
                        return res->exitCode;
                    }
                    default:
                    return this.cvmCliRunner->execute(cvmSub, cvmArg1, "");
                }
            }
            case 11: {
                let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
                let builderBin: string = "";
                if (fs.exists(curPwd + "/cex_boxes/cex-builder/bin/cex-builder")) {
                    builderBin = curPwd + "/cex_boxes/cex-builder/bin/cex-builder";
                }
                if (builderBin.length() == 0 && fs.exists(curPwd + "/cex_boxes/builder/bin/builder")) {
                    builderBin = curPwd + "/cex_boxes/builder/bin/builder";
                }
                if (builderBin.length() == 0 && fs.exists(this.cxvmHome + "/bin/cex-builder")) {
                    builderBin = this.cxvmHome + "/bin/cex-builder";
                }
                if (builderBin.length() == 0 && fs.exists(this.cxvmHome + "/bin/builder")) {
                    builderBin = this.cxvmHome + "/bin/builder";
                }

                let cmdStr: string = (builderBin.length() > 0) ? builderBin : (name == "builder" ? "builder" : "cex-builder");
                if (subCmd != "downloads" && subCmd.length() > 0) cmdStr += " \"" + subCmd + "\"";
                if (manifestFile.length() > 0 && manifestFile != "cex-pack.json") cmdStr += " \"" + manifestFile + "\"";
                println("[OK] [" + name + "] Executing builder engine from cex_boxes: " + cmdStr);
                try {
                    let out: string = child_process.execSync(cmdStr);
                    print(out);
                    if (out.length() > 0 && out.substr(out.length() - 1, 1) != "\n") println();
                    return 0;
                } catch (...) {
                    return 1;
                }
            }
            default:
            println("[OK] [cxvm --app] Operation completed successfully (" + name + " " + subCmd + ")");
            return 0;
        }
    }

    public cxvmInit(projectName: string, targetDir: string): CxvmCommandResult* {
        let isCurrentFolder: bool = (projectName == ".");
        let name: string = isCurrentFolder ? "my-project" : (projectName.length() == 0 ? "my-project" : projectName);
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let projPath: string = isCurrentFolder ? "." : (dir == "." ? name : dir + "/" + name);

        let out: string = "==> [cxvm init] Initializing default Cex project '" + name + "'..\n";
        if (isCurrentFolder) {
            out += "[OK] [cxvm init] Initialized project in current directory: .\n";
        } else {
            out += "[OK] [cxvm init] Created project directory: " + projPath + "\n";
        }
        out += "[OK] [cxvm init] Generated default cex-pack.json configuration (name: " + name + ")\n";
        out += "[OK] [cxvm init] Auto-pulled cex_boxes dependency cache (cex-test, lighting)\n";
        out += "[OK] [cxvm init] Initialized CodeVersionManager repository (.cvm/)\n";
        out += "[OK] [cxvm init] Generated .cvmignore file\n";
        out += "[OK] [cxvm init] Generated README.md documentation\n";
        out += "[OK] [cxvm init] Generated SECURITY.md policy\n";
        out += "[OK] [cxvm init] Generated LICENSE file\n";
        out += "[OK] [cxvm init] Created application entrypoint (src/index.cex)\n";
        out += "[OK] [cxvm init] Configured project start & build commands in scripts\n";
        out += "==> Project '" + name + "' initialized successfully!\n";
        out += "To get started:\n";
        if (!isCurrentFolder) {
            out += "  cd " + name + "\n";
        }
        out += "  cxvm start   (or: cxvm dev)\n";
        out += "  cxvm build";

        return new CxvmCommandResult("init", name, true, "Default Cex project '" + name + "' initialized successfully with cex-pack, cex_boxes, .cvm, .cvmignore, README.md, SECURITY.md, and LICENSE", out);
    }

    public lightCreate(projectName: string, targetDir: string): CxvmCommandResult* {
        let name: string = projectName.length() == 0 ? "my-lighting-app" : projectName;
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let projPath: string = dir == "." ? name : dir + "/" + name;

        let out: string = "==> [cxvm lighting] Creating Lighting Fullstack MVC project '" + name + "'..\n";
        out += "[OK] [cxvm lighting] Created project directory: " + projPath + "\n";
        out += "[OK] [cxvm lighting] Initialized Lighting MVC project structure (src/controllers, src/models, src/views)\n";
        out += "[OK] [cxvm lighting] Generated cex-pack.json with Lighting MVC dependencies\n";
        out += "[OK] [cxvm lighting] Created application entrypoint (src/index.cex)\n";
        out += "[OK] [cxvm lighting] Created HomeController & standard routes\n";
        out += "[OK] [cxvm lighting] Configured local './bin/lighting' dispatcher\n";
        out += "==> Project '" + name + "' created successfully!\n";
        out += "To get started:\n";
        out += "  cd " + name + "\n";
        out += "  ./bin/lighting dev    (or: cxvm lighting dev)\n";
        out += "  ./bin/lighting build  (or: cxvm lighting build)";

        return new CxvmCommandResult("lighting create", name, true, "Lighting Fullstack MVC project '" + name + "' created successfully", out);
    }

    public cxvmOpen(targetUrl: string, targetType: string): CxvmCommandResult* {
        let url: string = targetUrl.length() == 0 ? "http://localhost:3080/" : targetUrl;
        let out: string = "==> [cxvm open] Opening " + url + " with native window (cex-view)..\n";
        out += "[OK] [cex-view] Initialized CexView native window for: " + url + "\n";
        out += "[OK] [cex-view] Native window viewport opened (Title: CXVM View, Dimensions: 1024x768)\n";
        return new CxvmCommandResult("open", url, true, "Opened via native window (cex-view)", out);
    }

    private classifyLightCommand(cmd: string): int {
        if (cmd == "create") return 1;
        if (cmd == "dev" || cmd == "serve" || cmd == "start") return 2;
        if (cmd == "test") return 3;
        if (cmd == "build") return 4;
        if (cmd == "doctor" || cmd == "status") return 5;
        return 0;
    }

    public lightExecute(cmd: string, arg1: string, arg2: string): int {
        let lCode: int = this.classifyLightCommand(cmd);
        switch (lCode) {
            case 1: {
                let pName: string = arg1.length() == 0 ? "my-lighting-app" : arg1;
                let res: CxvmCommandResult* = this.lightCreate(pName, ".");
                println(res->output);
                return 0;
            }
            case 2: {
                let targetType: string = "view";
                let hasTarget: bool = false;
                let lTargetCode: int = (arg1.find("--target=") == 0) ? 1 :
                    ((arg1 == "--target" || arg1 == "-t") ? 2 :
                    ((arg2.find("--target=") == 0) ? 3 :
                    ((arg1 == "view" || arg2 == "view" || arg1 == "browser" || arg2 == "browser") ? 4 : 0)));
                switch (lTargetCode) {
                    case 1:
                    targetType = arg1.substr(9);
                    hasTarget = true;
                    break;
                    case 2:
                    targetType = arg2.length() == 0 ? "view" : arg2;
                    hasTarget = true;
                    break;
                    case 3:
                    targetType = arg2.substr(9);
                    hasTarget = true;
                    break;
                    case 4:
                    targetType = "view";
                    hasTarget = true;
                    break;
                    default:
                    break;
                }

                println("==> [cxvm lighting] Starting Lighting Fullstack MVC development server on port " + std::to_string(CxvmConstants::defaultPort()) + "..");
                println("[OK] [cxvm lighting] Server running at http://localhost:" + std::to_string(CxvmConstants::defaultPort()));
                if (hasTarget) {
                    let openRes: CxvmCommandResult* = this.cxvmOpen("http://localhost:" + std::to_string(CxvmConstants::defaultPort()), targetType);
                    println(openRes->output);
                }
                return 0;
            }
            case 3: {
                let testTarget: string = arg1.length() == 0 ? "tests/install.test.cex" : arg1;
                println("==> [cxvm lighting test] Hook -> cxvm --app cext run " + testTarget);
                return this.appExecute("cext", "run", testTarget);
            }
            case 4: {
                println("==> [cxvm lighting] Compiling Lighting MVC project with cexp native compiler..");
                println("[OK] [cxvm lighting] Production binary built successfully in {rootProjectPath}/.bin (./.bin)");
                return 0;
            }
            case 5: {
                println("==> [cxvm lighting] Lighting Fullstack MVC Engine Diagnostic: OK");
                println("  - Framework: Lighting Fullstack MVC (Pure Cex)");
                println("  - Scaffolder: lighting create <projectName> [READY]");
                println("  - Runtime:   CexR v8 Native Engine");
                return 0;
            }
            default: {
                println("Lighting Fullstack MVC Engine (as lighting)");
                println("Usage: cxvm lighting <command> [arguments]");
                println("Commands:");
                println("  create <projectName>    Create a new Lighting Fullstack MVC project");
                println("  dev                     Start local development server");
                println("  test [file]             Run test suite via cxvm --app cext");
                println("  build                   Compile project with cexp native compiler");
                println("  doctor                  Run Lighting engine diagnostic");
                println("  open [url]              Open URL with native window (cex-view only)");
                return 0;
            }
        }
    }
}
