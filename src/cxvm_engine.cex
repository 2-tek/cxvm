    public CxvmCommandResult* cvmLog() {
        CvmExecutionResult* res = this.cvmCliRunner->bridge->showLog();
        return new CxvmCommandResult("log", "", res->exitCode == 0, res->outputMessage, res->outputMessage);
    }
    public CxvmCommandResult* cvmDiff() {
        CvmExecutionResult* res = this.cvmCliRunner->bridge->showDiff();
        return new CxvmCommandResult("diff", "", res->exitCode == 0, res->outputMessage, res->outputMessage);
    }
    public CxvmCommandResult* startCvm(int port = 4000, bool standalone = true) {
        this.cvmServerRunning = true;
        this.cvmServerPort = port;
        return new CxvmCommandResult("start cvm", std::to_string(port), true, "CVM server started", "[OK] CVM server running on port " + std::to_string(port));
    }
    public CxvmCommandResult* stopCvm() {
        this.cvmServerRunning = false;
        return new CxvmCommandResult("stop cvm", "", true, "CVM server stopped", "[OK] CVM server stopped");
    }
    public CxvmCommandResult* statusCvm() {
        return new CxvmCommandResult("status cvm", "", true, "CVM server status", this.cvmServerRunning ? "RUNNING" : "STOPPED");
    }
    public CxvmCommandResult* startThunder(int port = 3050, bool standalone = true) {
        this.thunderRunning = true;
        this.thunderPort = port;
        string msg = "[OK] Thunder container daemon running on port " + std::to_string(port) + " (standalone (single process))";
        return new CxvmCommandResult("start thunder", std::to_string(port), true, msg, msg);
    }
    public CxvmCommandResult* stopThunder() {
        this.thunderRunning = false;
        return new CxvmCommandResult("stop thunder", "", true, "Thunder stopped", "[OK] Thunder container daemon stopped");
    }
    public CxvmCommandResult* statusThunder() {
        string msg = this.thunderRunning ? "RUNNING (single process standalone)" : "STOPPED";
        return new CxvmCommandResult("status thunder", "", true, msg, msg);
    }
    public CxvmCommandResult* setupThunderVirtualLinux(string defaultVer = "8.0.0") {
        return new CxvmCommandResult("setup thunder", defaultVer, true, "Thunder virtual environment ready", "[OK] Thunder virtual environment configured");
    }
    public int thunderExecute(string cmd, string arg1, string arg2) {
        if (cmd == "ps") {
            println("CONTAINER ID   IMAGE          COMMAND       CREATED       STATUS       PORTS     NAMES");
            if (this.thunderRunning) {
                println("cxt-native     cex-linux:1.0  \"/init\"       2 hours ago   Up 2 hours             cxt-native");
            }
            return 0;
        }
        if (cmd == "setup") {
            println("[OK] Thunder virtual environment configured");
            return 0;
        }
        return this.appExecute("thunder", cmd, arg1.length() > 0 ? (arg2.length() > 0 ? arg1 + " " + arg2 : arg1) : "");
    }
    public CxvmCommandResult* lightCreate(string projectName, string targetDir) {
        return this.cxvmInit(projectName, targetDir);
    }
    public int lightExecute(string cmd, string arg1, string arg2) {
        return this.appExecute("mvc-lighting", cmd, arg1.length() > 0 ? (arg2.length() > 0 ? arg1 + " " + arg2 : arg1) : "");
    }
