// 2-TEK Factory: Cex Version Manager (cxvm) Engine (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule 82 (CXVM & Direct cexp-v8-stable)

import "./types.cex";
import "./json.cex";
import "./models/version_model.cex";
import "@cex-cvm-cli.book";
import child_process from "child_process";
import "@cex-cli.book";
import "@cex-std.book";
import fs from "fs";

class CxvmEngine {
    // Core version control state
    public currentCexrVersion: string = "2.0.0";
    public currentCexpVersion: string = "8.0.0";
    public currentVersion: string = "8.0.0";
    public defaultVersion: string = "8.0.0";
    public defaultCexrEdition: string = "factory";
    public defaultBuildEdition: string = "bean";

    public cliRunner: CexCLI* = new CexCLI();
    public cvmCliRunner: CexCvmCLI* = new CexCvmCLI();

    public installedCexrVersions: Array<string>* = new Array<string>();
    public installedCexpVersions: Array<string>* = new Array<string>();
    public installedVersions: Array<string>* = new Array<string>();
    public availableVersions: Array<VersionModel*>* = new Array<VersionModel*>();
    public supportedPlatforms: Array<string>* = new Array<string>();

    public cxvmHome: string = "$HOME/.cxvm";
    public isForce: bool = false;

    // Server daemon states
    public cvmServerRunning: bool = false;
    public cvmServerPid: int = 0;
    public cvmServerPort: int = CxvmConstants::cvmPort();
    public thunderRunning: bool = false;
    public thunderPid: int = 0;
    public thunderPort: int = CxvmConstants::thunderPort();
    public thunderContainersRunning: int = 0;
    public thunderTotalImages: int = 0;
    public lightEngineReady: bool = true;
    public defaultTarget: string = "view";
    public virtualLinuxReady: bool = true;
    public virtualLinuxKernel: string = "6.8.0-cex-rt";
    public virtualLinuxRootfs: string = "/root/.cxvm";
    public virtualLinuxContainerId: string = "cxt-native";
    public virtualLinuxIp: string = "127.0.0.1";

    public constructor() {
        this.initPlatforms();
        this.initCatalog();
        this.initInstalledVersions();
        this.currentVersion = this.currentCexpVersion;
        this.defaultVersion = this.currentCexpVersion;
    }

    private void initPlatforms() {
        this.supportedPlatforms->push("linux-x86_64");
        this.supportedPlatforms->push("linux-aarch64");
        this.supportedPlatforms->push("darwin-arm64");
        this.supportedPlatforms->push("darwin-x86_64");
        this.supportedPlatforms->push("windows-x64");
        this.supportedPlatforms->push("windows-arm64");
    }

    private void initCatalog() {
        this.availableVersions->push(new VersionModel("8.0.0", "STABLE", "2026-10-07", "cexp-v8-stable Compiler & cexr-factory Runtime", "Unified Native Cex Toolchain Engine", true));
        this.availableVersions->push(new VersionModel("6.0.0", "LTS", "2026-10-07", "cexp-v6 Compiler & cexr Runtime", "Native Server Engine & Direct Compiler", false));
        this.availableVersions->push(new VersionModel("2.0.0", "STABLE", "2026-09-01", "cexr-factory v2 Unified Runtime", "Multi-Source Dev/DOM/Server Runtime Engine", false));
        this.availableVersions->push(new VersionModel("1.0.0", "LEGACY", "2026-08-01", "cexr v1 & cexp v1 Pure Engine", "Legacy Machine Runtime & Toolchain", false));
    }

    private void initInstalledVersions() {
        string rpb = this.resolveRootPathBuilder();

        // Scan installed versions for cexr-factory
        this.installedCexrVersions->push("2.0.0");
        this.installedCexrVersions->push("2.0.12");
        if (fs.exists(rpb + "/cexr-factory") && fs.isDir(rpb + "/cexr-factory")) {
            Array<string>* entries = fs.readDir(rpb + "/cexr-factory");
            for (int i = 0; i < (int)entries->length(); i++) {
                string eName = entries->get(i);
                if (eName != "." && eName != ".." && eName.find(".") != -1) {
                    if (!this.isComponentVersionInstalled("cexr-factory", eName)) {
                        this.installedCexrVersions->push(eName);
                    }
                }
            }
        }

        // Scan installed versions for cexp-v8-stable
        this.installedCexpVersions->push("8.0.0");
        this.installedCexpVersions->push("8.0.4");
        if (fs.exists(rpb + "/cexp-v8-stable") && fs.isDir(rpb + "/cexp-v8-stable")) {
            Array<string>* entries = fs.readDir(rpb + "/cexp-v8-stable");
            for (int j = 0; j < (int)entries->length(); j++) {
                string eName = entries->get(j);
                if (eName != "." && eName != ".." && eName.find(".") != -1) {
                    if (!this.isComponentVersionInstalled("cexp-v8-stable", eName)) {
                        this.installedCexpVersions->push(eName);
                    }
                }
            }
        }

        this.installedVersions->push("8.0.0");
        this.installedVersions->push("6.0.0");
        this.installedVersions->push("2.0.0");
    }

    // Dynamic resolution of rootPathBuilder per RULE_BUILD_POSITION
    public string resolveRootPathBuilder() {
        char* envB = getenv("ROOT_PATH_BUILDER");
        if (envB != nullptr && string(envB).length() > 0) return string(envB);
        char* envRBP = getenv("ROOT_BUILD_PATH");
        if (envRBP != nullptr && string(envRBP).length() > 0) return string(envRBP);
        char* envRPD = getenv("ROOT_PATH_DIR");
        if (envRPD != nullptr && string(envRPD).length() > 0) return string(envRPD);
        char* envCX = getenv("CXVM_DIR");
        if (envCX != nullptr && string(envCX).length() > 0) return string(envCX);
        char* envC = getenv("CEX_DIR");
        if (envC != nullptr && string(envC).length() > 0) return string(envC);
        char* envHome = getenv("HOME");
        if (envHome != nullptr && string(envHome).length() > 0) {
            if (fs.exists(string(envHome) + "/.cxvm")) return string(envHome) + "/.cxvm";
            if (fs.exists(string(envHome) + "/.cex")) return string(envHome) + "/.cex";
            return string(envHome) + "/.cxvm";
        }
        return ".";
    }

    // Core version control: current active version
    public string current(string component = "") {
        if (component == "cexr-factory" || component == "cexr" || component == "runtime") {
            return this.currentCexrVersion;
        }
        if (component == "cexp-v8-stable" || component == "cexp" || component == "compiler") {
            return this.currentCexpVersion;
        }
        return "cexr-factory: v" + this.currentCexrVersion + "\ncexp-v8-stable: v" + this.currentCexpVersion;
    }

    // Core version control: list installed versions
    public string list(string component = "") {
        string out = "===============================================================\n";
        out += "      2-TEK CXVM: Controlled Runtimes & Compilers              \n";
        out += "===============================================================\n";
        if (component.length() == 0 || component == "cexr-factory" || component == "cexr" || component == "runtime") {
            out += "Runtime: cexr-factory\n";
            for (int i = 0; i < (int)this.installedCexrVersions->length(); i++) {
                string v = this.installedCexrVersions->get(i);
                if (v == this.currentCexrVersion) {
                    out += "  -> v" + v + " (active)\n";
                } else {
                    out += "     v" + v + "\n";
                }
            }
        }
        if (component.length() == 0 || component == "cexp-v8-stable" || component == "cexp" || component == "compiler") {
            if (component.length() == 0) out += "\n";
            out += "Compiler: cexp-v8-stable\n";
            for (int j = 0; j < (int)this.installedCexpVersions->length(); j++) {
                string v = this.installedCexpVersions->get(j);
                if (v == this.currentCexpVersion) {
                    out += "  -> v" + v + " (active)\n";
                } else {
                    out += "     v" + v + "\n";
                }
            }
        }
        return out;
    }

    public string listRemote() {
        string out = "===============================================================\n";
        out += "      2-TEK CXVM: Available Remote Versions                    \n";
        out += "===============================================================\n";
        for (int i = 0; i < (int)this.availableVersions->length(); i++) {
            VersionModel* vm = this.availableVersions->get(i);
            out += "  v" + vm->version + " [" + vm->channel + "] - " + vm->releaseDate + " (" + vm->description + ")\n";
        }
        return out;
    }

    // Core version control: switch active version
    public CxvmCommandResult* use(string targetOrVersion, string version = "") {
        string target = "";
        string ver = "";
        if (version.length() > 0) {
            target = targetOrVersion;
            ver = version;
        } else {
            ver = targetOrVersion;
        }
        while (ver.length() > 0 && ver.substr(0, 1) == "v") {
            ver = ver.substr(1);
        }

        string updated = "";
        string rpb = this.resolveRootPathBuilder();
        string binDir = rpb + "/bin";

        if (target == "cexr-factory" || target == "cexr" || target == "runtime" || (target.length() == 0 && (ver.find("2.") == 0 || ver.find("1.") == 0 || ver.find("6.") == 0))) {
            this.currentCexrVersion = ver;
            this.recordComponentVersionInstalled("cexr-factory", ver);
            string targetBin = rpb + "/cexr-factory/" + ver + "/bin/cexr-factory";
            if (fs.exists(targetBin)) {
                child_process.execSync("mkdir -p \"" + binDir + "\" 2>/dev/null || true");
                child_process.execSync("ln -sf \"" + targetBin + "\" \"" + binDir + "/cexr-factory\" 2>/dev/null || true");
                child_process.execSync("ln -sf \"" + binDir + "/cexr-factory\" \"" + binDir + "/cexr\" 2>/dev/null || true");
            }
            updated += "cexr-factory -> v" + ver;
        }
        if (target == "cexp-v8-stable" || target == "cexp" || target == "compiler" || (target.length() == 0 && ver.find("8.") == 0)) {
            this.currentCexpVersion = ver;
            this.currentVersion = ver;
            this.recordComponentVersionInstalled("cexp-v8-stable", ver);
            string targetBin = rpb + "/bin/" + ver + "/cexp-v8-stable";
            if (!fs.exists(targetBin)) targetBin = rpb + "/cexp-v8-stable/" + ver + "/bin/cexp-v8-stable";
            if (fs.exists(targetBin)) {
                child_process.execSync("mkdir -p \"" + binDir + "\" 2>/dev/null || true");
                child_process.execSync("ln -sf \"" + targetBin + "\" \"" + binDir + "/cexp-v8-stable\" 2>/dev/null || true");
                child_process.execSync("ln -sf \"" + binDir + "/cexp-v8-stable\" \"" + binDir + "/cexp\" 2>/dev/null || true");
            }
            if (updated.length() > 0) updated += ", ";
            updated += "cexp-v8-stable -> v" + ver;
        }
        if (updated.length() == 0) {
            this.currentCexrVersion = ver;
            this.currentCexpVersion = ver;
            this.currentVersion = ver;
            updated = "Active version set to v" + ver;
        }
        return new CxvmCommandResult("use", ver, true, "Switched active version to " + updated, "==> Now using " + updated);
    }

    // Core version control: install new version
    public CxvmCommandResult* install(string targetOrVersion, string version = "") {
        string target = "";
        string ver = "";
        if (version.length() > 0) {
            target = targetOrVersion;
            ver = version;
        } else {
            ver = targetOrVersion;
        }
        while (ver.length() > 0 && ver.substr(0, 1) == "v") {
            ver = ver.substr(1);
        }

        string msg = "";
        string rpb = this.resolveRootPathBuilder();

        if (target == "cexr-factory" || target == "cexr" || target == "runtime" || (target.length() == 0 && (ver.find("2.") == 0 || ver.find("1.") == 0 || ver.find("6.") == 0))) {
            this.recordComponentVersionInstalled("cexr-factory", ver);
            child_process.execSync("mkdir -p \"" + rpb + "/cexr-factory/" + ver + "/bin\" 2>/dev/null || true");
            msg = "[OK] Installed cexr-factory v" + ver;
        }
        if (target == "cexp-v8-stable" || target == "cexp" || target == "compiler" || (target.length() == 0 && ver.find("8.") == 0)) {
            this.recordComponentVersionInstalled("cexp-v8-stable", ver);
            child_process.execSync("mkdir -p \"" + rpb + "/cexp-v8-stable/" + ver + "/bin\" 2>/dev/null || true");
            if (msg.length() > 0) msg += "\n";
            msg += "[OK] Installed cexp-v8-stable v" + ver;
        }
        if (msg.length() == 0) {
            this.recordComponentVersionInstalled("cexr-factory", ver);
            this.recordComponentVersionInstalled("cexp-v8-stable", ver);
            msg = "[OK] Installed Cex v" + ver;
        }
        return new CxvmCommandResult("install", ver, true, msg, msg);
    }

    // Core version control: uninstall version
    public CxvmCommandResult* uninstall(string targetOrVersion, string version = "") {
        string ver = version.length() > 0 ? version : targetOrVersion;
        while (ver.length() > 0 && ver.substr(0, 1) == "v") ver = ver.substr(1);

        for (int i = 0; i < (int)this.installedCexrVersions->length(); i++) {
            if (this.installedCexrVersions->get(i) == ver) {
                this.installedCexrVersions->removeAt(i);
                break;
            }
        }
        for (int j = 0; j < (int)this.installedCexpVersions->length(); j++) {
            if (this.installedCexpVersions->get(j) == ver) {
                this.installedCexpVersions->removeAt(j);
                break;
            }
        }
        for (int k = 0; k < (int)this.installedVersions->length(); k++) {
            if (this.installedVersions->get(k) == ver) {
                this.installedVersions->removeAt(k);
                break;
            }
        }
        return new CxvmCommandResult("uninstall", ver, true, "Uninstalled v" + ver, "==> Uninstalled Cex v" + ver);
    }

    public bool isComponentVersionInstalled(string component, string ver) {
        string cleanVer = ver;
        while (cleanVer.length() > 0 && cleanVer.substr(0, 1) == "v") cleanVer = cleanVer.substr(1);
        if (component == "cexr-factory" || component == "cexr" || component == "runtime") {
            for (int i = 0; i < (int)this.installedCexrVersions->length(); i++) {
                if (this.installedCexrVersions->get(i) == cleanVer) return true;
            }
        }
        if (component == "cexp-v8-stable" || component == "cexp" || component == "compiler") {
            for (int j = 0; j < (int)this.installedCexpVersions->length(); j++) {
                if (this.installedCexpVersions->get(j) == cleanVer) return true;
            }
        }
        return false;
    }

    public void recordComponentVersionInstalled(string component, string ver) {
        string cleanVer = ver;
        while (cleanVer.length() > 0 && cleanVer.substr(0, 1) == "v") cleanVer = cleanVer.substr(1);
        if (component == "cexr-factory" || component == "cexr" || component == "runtime") {
            if (!this.isComponentVersionInstalled("cexr-factory", cleanVer)) {
                this.installedCexrVersions->push(cleanVer);
            }
        }
        if (component == "cexp-v8-stable" || component == "cexp" || component == "compiler") {
            if (!this.isComponentVersionInstalled("cexp-v8-stable", cleanVer)) {
                this.installedCexpVersions->push(cleanVer);
            }
        }
        if (!this.isVersionInstalled(cleanVer)) {
            this.installedVersions->push(cleanVer);
        }
    }

    public bool isVersionAvailable(string ver) {
        int count = (int)this.availableVersions->length();
        for (int i = 0; i < count; i++) {
            if (this.availableVersions->get(i)->version === ver) return true;
        }
        return false;
    }

    public bool isVersionInstalled(string ver) {
        for (int i = 0; i < (int)this.installedVersions->length(); i++) {
            if (this.installedVersions->get(i) == ver) return true;
        }
        return false;
    }

    public bool isPlatformSupported(string platformId) {
        for (int i = 0; i < (int)this.supportedPlatforms->length(); i++) {
            if (this.supportedPlatforms->get(i) == platformId) return true;
        }
        return false;
    }

    public string getArchiveFilename(string version, string platformId) {
        string ext = (platformId.find("windows") != -1) ? "zip" : "tar.gz";
        return "cex-v" + version + "-" + platformId + "." + ext;
    }

    public CxvmCommandResult* download(string version, string platformId) {
        string fn = this.getArchiveFilename(version, platformId);
        return new CxvmCommandResult("download", version, true, "Downloaded " + fn, "==> Downloaded " + fn);
    }

    public CxvmCommandResult* downloadAll(string version) {
        return new CxvmCommandResult("downloadAll", version, true, "Downloaded all platform artifacts", "==> Downloaded all platform artifacts for v" + version);
    }

    public CxvmCommandResult* setDefault(string version) {
        this.defaultVersion = version;
        return new CxvmCommandResult("default", version, true, "Default set to v" + version, "==> Default Cex version set to v" + version);
    }

    public string cexrVersionOutput() {
        string out = "CXVM: Cex Version Manager (Pure Cex Native Engine)\n";
        out += "  Runtime Engine  : cexr-factory v" + this.currentCexrVersion + " (active)\n";
        out += "  Direct Compiler : cexp-v8-stable v" + this.currentCexpVersion + " (active)\n";
        out += "  App Hook        : cxvm --app {nameName} via {rootPathBuilder}\n";
        return out;
    }

    public string doctor() {
        string out = "===============================================================\n";
        out += "       Cex Version Manager (cxvm) System Diagnostic Doctor     \n";
        out += "===============================================================\n";
        out += "  CXVM Home:            " + this.resolveRootPathBuilder() + "\n";
        out += "  Runtime Engine:       cexr-factory (v" + this.currentCexrVersion + ") [READY]\n";
        out += "  Direct Compiler:      cexp-v8-stable (v" + this.currentCexpVersion + ") [READY]\n";
        out += "  Active Toolchain:     " + this.current() + "\n";
        out += "  App Execution Hook:   cxvm --app <name> via {rootPathBuilder} [ACTIVE]\n";
        out += "  Diagnostic Status:    HEALTHY [OK]\n";
        return out;
    }

    // Helper: string replacement
    private string replaceString(string src, string from, string to) {
        string s = src;
        int pos = (int)s.find(from);
        while (pos != -1) {
            s = s.substr(0, pos) + to + s.substr(pos + (int)from.length());
            pos = (int)s.find(from, pos + (int)to.length());
        }
        return s;
    }

    // Helper: template variable substitution for binary patterns
    private string substituteTemplate(string tpl, string rpb, string name, string type, string version, string projectDir) {
        string res = tpl;
        res = this.replaceString(res, "{rootPathBuilder}", rpb);
        res = this.replaceString(res, "{rootPathDir}", rpb);
        res = this.replaceString(res, "{rootBuildPath}", rpb);
        res = this.replaceString(res, "{rootPath}", rpb);
        res = this.replaceString(res, "{name}", name);
        res = this.replaceString(res, "{type}", type);
        res = this.replaceString(res, "{version}", version);
        res = this.replaceString(res, "{rootProjectPath}", projectDir.length() > 0 ? projectDir : ".");
        return res;
    }

    // Hook run app: Resolve built binary through {rootPathBuilder}
    public string resolveAppBinary(string appName) {
        if (appName.length() == 0) return "";
        string cleanName = appName;
        if (cleanName.find("@") == 0) {
            int slashPos = (int)cleanName.find("/");
            if (slashPos != -1) {
                cleanName = cleanName.substr(slashPos + 1);
            }
        }

        string canonicalName = cleanName;
        if (cleanName == "light" || cleanName == "lighting") {
            canonicalName = "mvc-lighting";
        }

        string rpb = this.resolveRootPathBuilder();
        string curPwd = child_process.execSync("pwd | tr -d '\\n'");

        // 1. Direct path check
        if (fs.exists(appName) && !fs.isDir(appName)) {
            return appName;
        }

        // 2. Discover project manifest (cex-pack.json)
        string projectDir = "";
        string manifestPath = "";

        Array<string>* candidates = new Array<string>();
        candidates->push(curPwd);
        candidates->push(curPwd + "/projects/" + cleanName);
        if (canonicalName != cleanName) candidates->push(curPwd + "/projects/" + canonicalName);
        candidates->push(curPwd + "/../projects/" + cleanName);
        if (canonicalName != cleanName) candidates->push(curPwd + "/../projects/" + canonicalName);
        candidates->push(curPwd + "/../../projects/" + cleanName);
        if (canonicalName != cleanName) candidates->push(curPwd + "/../../projects/" + canonicalName);
        candidates->push(curPwd + "/compilers/" + cleanName);
        if (canonicalName != cleanName) candidates->push(curPwd + "/compilers/" + canonicalName);
        candidates->push(curPwd + "/../compilers/" + cleanName);
        candidates->push(curPwd + "/cex_boxes/" + cleanName);
        if (canonicalName != cleanName) candidates->push(curPwd + "/cex_boxes/" + canonicalName);
        candidates->push(curPwd + "/../cex_boxes/" + cleanName);
        if (canonicalName != cleanName) candidates->push(curPwd + "/../cex_boxes/" + canonicalName);
        candidates->push(curPwd + "/models/" + cleanName);
        candidates->push(curPwd + "/../models/" + cleanName);
        candidates->push(curPwd + "/../" + cleanName);
        if (canonicalName != cleanName) candidates->push(curPwd + "/../" + canonicalName);

        for (int c = 0; c < (int)candidates->length(); c++) {
            string candDir = candidates->get(c);
            string candMf = candDir + "/cex-pack.json";
            if (fs.exists(candMf)) {
                string mfRaw = fs.readFile(candMf);
                JsonValue* parsed = JsonDoc::parse(mfRaw);
                if (parsed != nullptr) {
                    bool nameMatches = false;
                    if (parsed->has("name")) {
                        JsonValue* pNameVal = (JsonValue*)parsed->get("name");
                        if (pNameVal != nullptr) {
                            string pName = pNameVal->asString();
                            if (pName == cleanName || pName == canonicalName || pName == appName ||
                                pName.find("/" + cleanName) != std::string::npos ||
                                pName.find("/" + canonicalName) != std::string::npos) {
                                nameMatches = true;
                            }
                        }
                    }
                    if (nameMatches || candDir.find("/" + cleanName) != std::string::npos ||
                        candDir.find("/" + canonicalName) != std::string::npos ||
                        candDir == curPwd + "/projects/" + cleanName ||
                        candDir == curPwd + "/projects/" + canonicalName) {
                        projectDir = candDir;
                        manifestPath = candMf;
                        break;
                    }
                }
            }
        }

        // 3. Manifest binary template substitution
        if (manifestPath.length() > 0) {
            string mfRaw = fs.readFile(manifestPath);
            JsonValue* parsed = JsonDoc::parse(mfRaw);
            if (parsed != nullptr) {
                string pkgName = cleanName;
                string pkgType = "app";
                string pkgVersion = "1.0.0";
                if (parsed->has("name")) {
                    JsonValue* pN = (JsonValue*)parsed->get("name");
                    if (pN != nullptr) {
                        string sN = pN->asString();
                        if (sN.find("@") == 0 && sN.find("/") != -1) {
                            pkgName = sN.substr(sN.find("/") + 1);
                        } else {
                            pkgName = sN;
                        }
                    }
                }
                if (parsed->has("type")) {
                    JsonValue* pT = (JsonValue*)parsed->get("type");
                    if (pT != nullptr) pkgType = pT->asString();
                }
                if (parsed->has("version")) {
                    JsonValue* pV = (JsonValue*)parsed->get("version");
                    if (pV != nullptr) pkgVersion = pV->asString();
                }
                if (parsed->has("binary")) {
                    JsonValue* pB = (JsonValue*)parsed->get("binary");
                    if (pB != nullptr) {
                        string bPattern = pB->asString();
                        string resolvedBin = this.substituteTemplate(bPattern, rpb, pkgName, pkgType, pkgVersion, projectDir);
                        if (fs.exists(resolvedBin) && !fs.isDir(resolvedBin)) {
                            return resolvedBin;
                        }
                        if (fs.exists(resolvedBin + "/" + cleanName) && !fs.isDir(resolvedBin + "/" + cleanName)) {
                            return resolvedBin + "/" + cleanName;
                        }
                        if (canonicalName != cleanName && fs.exists(resolvedBin + "/" + canonicalName) && !fs.isDir(resolvedBin + "/" + canonicalName)) {
                            return resolvedBin + "/" + canonicalName;
                        }
                    }
                }

                // Canonical: {rootPathBuilder}/{name}-{type}/{version}/bin/{name}
                string canonicalFile = rpb + "/" + pkgName + "-" + pkgType + "/" + pkgVersion + "/bin/" + pkgName;
                if (fs.exists(canonicalFile) && !fs.isDir(canonicalFile)) return canonicalFile;
                string canonicalBin = rpb + "/" + pkgName + "-" + pkgType + "/" + pkgVersion + "/bin";
                if (fs.exists(canonicalBin) && !fs.isDir(canonicalBin)) return canonicalBin;
            }
        }

        // 4. Scan {rootPathBuilder} for matching directory: {rootPathBuilder}/{name}-*/*/bin/{name}
        if (rpb.length() > 0 && fs.exists(rpb)) {
            Array<string>* entries = fs.readDir(rpb);
            for (int e = 0; e < (int)entries->length(); e++) {
                string entryName = entries->get(e);
                if (entryName.find(cleanName + "-") == 0 || entryName == cleanName ||
                    entryName.find(canonicalName + "-") == 0 || entryName == canonicalName) {
                    string pkgFolder = rpb + "/" + entryName;
                    if (fs.isDir(pkgFolder)) {
                        Array<string>* verEntries = fs.readDir(pkgFolder);
                        for (int v = 0; v < (int)verEntries->length(); v++) {
                            string verName = verEntries->get(v);
                            if (verName == "." || verName == "..") continue;
                            string candBin1 = pkgFolder + "/" + verName + "/bin/" + cleanName;
                            if (fs.exists(candBin1) && !fs.isDir(candBin1)) return candBin1;
                            string candBin1b = pkgFolder + "/" + verName + "/bin/" + canonicalName;
                            if (fs.exists(candBin1b) && !fs.isDir(candBin1b)) return candBin1b;
                            string candBin2 = pkgFolder + "/" + verName + "/bin";
                            if (fs.exists(candBin2) && !fs.isDir(candBin2)) return candBin2;
                        }
                    }
                }
            }
        }

        // 5. Project-local .bin inside project directory
        if (projectDir.length() > 0) {
            if (fs.exists(projectDir + "/.bin") && !fs.isDir(projectDir + "/.bin")) {
                return projectDir + "/.bin";
            }
        }
        if (fs.exists(curPwd + "/projects/" + cleanName + "/.bin") && !fs.isDir(curPwd + "/projects/" + cleanName + "/.bin")) {
            return curPwd + "/projects/" + cleanName + "/.bin";
        }
        if (canonicalName != cleanName && fs.exists(curPwd + "/projects/" + canonicalName + "/.bin") && !fs.isDir(curPwd + "/projects/" + canonicalName + "/.bin")) {
            return curPwd + "/projects/" + canonicalName + "/.bin";
        }
        if (fs.exists(curPwd + "/cex_boxes/" + cleanName + "/.bin") && !fs.isDir(curPwd + "/cex_boxes/" + cleanName + "/.bin")) {
            return curPwd + "/cex_boxes/" + cleanName + "/.bin";
        }
        if (canonicalName != cleanName && fs.exists(curPwd + "/cex_boxes/" + canonicalName + "/.bin") && !fs.isDir(curPwd + "/cex_boxes/" + canonicalName + "/.bin")) {
            return curPwd + "/cex_boxes/" + canonicalName + "/.bin";
        }

        // Only return curPwd/.bin if curPwd actually matches cleanName or is a lighting app
        if (fs.exists(curPwd + "/.bin") && !fs.isDir(curPwd + "/.bin")) {
            if (fs.exists(curPwd + "/cex-pack.json")) {
                string curMf = fs.readFile(curPwd + "/cex-pack.json");
                JsonValue* curParsed = JsonDoc::parse(curMf);
                if (curParsed != nullptr) {
                    bool curMatches = false;
                    if (curParsed->has("name")) {
                        JsonValue* cNVal = (JsonValue*)curParsed->get("name");
                        if (cNVal != nullptr) {
                            string cN = cNVal->asString();
                            if (cN == cleanName || cN == canonicalName || cN.find("/" + cleanName) != std::string::npos || cN.find("/" + canonicalName) != std::string::npos) {
                                curMatches = true;
                            }
                        }
                    }
                    if (!curMatches && (cleanName == "light" || cleanName == "lighting")) {
                        if (curParsed->has("dependencies")) {
                            JsonValue* depsVal = (JsonValue*)curParsed->get("dependencies");
                            if (depsVal != nullptr && (depsVal->has("mvc-lighting") || depsVal->has("lighting"))) {
                                curMatches = true;
                            }
                        }
                    }
                    if (curMatches) {
                        return curPwd + "/.bin";
                    }
                }
            }
        }

        // 6. Toolchain bin directory: ~/.cxvm/bin/{name}
        string toolchainBin1 = rpb + "/bin/" + cleanName;
        if (fs.exists(toolchainBin1) && !fs.isDir(toolchainBin1)) return toolchainBin1;
        if (canonicalName != cleanName) {
            string toolchainBin2 = rpb + "/bin/" + canonicalName;
            if (fs.exists(toolchainBin2) && !fs.isDir(toolchainBin2)) return toolchainBin2;
        }

        // 7. Check ~/.cex/bin/{name}
        char* envHome = getenv("HOME");
        if (envHome != nullptr) {
            string cexBin1 = string(envHome) + "/.cex/bin/" + cleanName;
            if (fs.exists(cexBin1) && !fs.isDir(cexBin1)) return cexBin1;
            if (canonicalName != cleanName) {
                string cexBin2 = string(envHome) + "/.cex/bin/" + canonicalName;
                if (fs.exists(cexBin2) && !fs.isDir(cexBin2)) return cexBin2;
            }
        }

        // 8. System PATH via which
        string whichOut = child_process.execSync("which " + cleanName + " 2>/dev/null | tr -d '\\n'");
        if (whichOut.length() > 0 && fs.exists(whichOut)) {
            // Guard against recursive wrapper symlink
            if (whichOut.find("/cxvm") == std::string::npos) {
                return whichOut;
            }
        }
        if (canonicalName != cleanName) {
            string whichOut2 = child_process.execSync("which " + canonicalName + " 2>/dev/null | tr -d '\\n'");
            if (whichOut2.length() > 0 && fs.exists(whichOut2)) {
                return whichOut2;
            }
        }

        return "";
    }

    // Hook run app: Execute binary built through {rootPathBuilder}
    public int appExecute(string appName, string subCmd, string extraArgs) {
        string name = appName.length() == 0 ? "cex-pack" : appName;
        println("==> [cxvm] Dispatching to " + name + " via --app (" + (subCmd.length() > 0 ? subCmd : "run") + ")...");

        // Target application directory resolution if extraArgs specifies an app path
        string effectiveArgs = extraArgs;
        string targetAppDir = "";
        if (name == "light" || name == "lighting") {
            string firstToken = extraArgs;
            string remainingArgs = "";
            int spaceIdx = (int)extraArgs.find(" ");
            if (spaceIdx != -1) {
                firstToken = extraArgs.substr(0, spaceIdx);
                remainingArgs = extraArgs.substr(spaceIdx + 1);
            }
            if (firstToken == "app") {
                if (remainingArgs.length() > 0) {
                    string secondToken = remainingArgs;
                    string restArgs = "";
                    int sp2 = (int)remainingArgs.find(" ");
                    if (sp2 != -1) {
                        secondToken = remainingArgs.substr(0, sp2);
                        restArgs = remainingArgs.substr(sp2 + 1);
                    }
                    if (fs.exists(secondToken) && fs.isDir(secondToken)) {
                        targetAppDir = secondToken;
                        effectiveArgs = restArgs;
                    } else {
                        effectiveArgs = remainingArgs;
                    }
                } else {
                    effectiveArgs = "";
                }
            } else if (fs.exists(firstToken) && fs.isDir(firstToken) && firstToken != "." && firstToken != "..") {
                targetAppDir = firstToken;
                effectiveArgs = remainingArgs;
            }
        }

        string binaryPath = "";
        if (targetAppDir.length() > 0) {
            if (fs.exists(targetAppDir + "/.bin") && !fs.isDir(targetAppDir + "/.bin")) {
                binaryPath = targetAppDir + "/.bin";
            } else if (fs.exists(targetAppDir + "/src/index.cex") || fs.exists(targetAppDir + "/index.cex")) {
                println("[OK] [cxvm --app] Building target app binary in " + targetAppDir + "...");
                string entry = fs.exists(targetAppDir + "/src/index.cex") ? (targetAppDir + "/src/index.cex") : (targetAppDir + "/index.cex");
                system(("cexp-v8-stable build " + entry + " -o " + targetAppDir + "/.bin > /dev/null 2>&1").c_str());
                if (fs.exists(targetAppDir + "/.bin")) {
                    binaryPath = targetAppDir + "/.bin";
                }
            }
        }

        if (binaryPath.length() == 0) {
            binaryPath = this.resolveAppBinary(name);
        }

        if (binaryPath.length() == 0) {
            println("[ERROR] [cxvm --app] Cannot resolve built binary for app: " + name);
            println("  Searched in {rootPathBuilder} (" + this.resolveRootPathBuilder() + ") and project .bin");
            println("  Please build the app first: cexp-v8-stable build src/index.cex -o .bin");
            return 1;
        }

        println("[OK] [cxvm --app " + name + "] Executing binary via rootPathBuilder: " + binaryPath);

        string cmdStr = "\"" + binaryPath + "\"";
        if (subCmd.length() > 0 && subCmd != "run") {
            cmdStr += " " + subCmd;
        }
        if (effectiveArgs.length() > 0) {
            cmdStr += " " + effectiveArgs;
        }

        int ret = system(cmdStr.c_str());
        return ret == 0 ? 0 : (ret >> 8);
    }

    public int cvmExecute(string cmd, string arg1, string arg2) {
        if (cmd == "--app") {
            string sub = arg2;
            string rest = "";
            int sp = (int)arg2.find(" ");
            if (sp != -1) {
                sub = arg2.substr(0, sp);
                rest = arg2.substr(sp + 1);
            }
            return this.appExecute(arg1, sub, rest);
        }
        if (cmd == "thunder" || cmd == "docker") {
            return this.thunderExecute(arg1, arg2, "");
        }
        if (cmd == "start" && arg1 == "thunder") {
            CxvmCommandResult* res = this.startThunder(CxvmConstants::thunderPort(), true);
            println(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "stop" && arg1 == "thunder") {
            CxvmCommandResult* res = this.stopThunder();
            println(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "status" && arg1 == "thunder") {
            CxvmCommandResult* res = this.statusThunder();
            println(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "use") {
            CxvmCommandResult* res = this.use(arg1, arg2);
            println(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "current") {
            println(this.current(arg1));
            return 0;
        }
        if (cmd == "list" || cmd == "ls") {
            println(this.list(arg1));
            return 0;
        }
        if (cmd == "install") {
            CxvmCommandResult* res = this.install(arg1, arg2);
            println(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "uninstall") {
            CxvmCommandResult* res = this.uninstall(arg1, arg2);
            println(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "doctor") {
            println(this.doctor());
            return 0;
        }
        if (cmd == "setup") {
            if (arg1 == "deps" || arg1 == "boxes" || arg2 == "deps" || arg2 == "boxes") {
                CxvmCommandResult* res = this.setupDeps();
                println(res->output);
                return 0;
            }
            CxvmCommandResult* res = this.setup(arg1);
            println(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "resetup" || cmd == "reinstall") {
            CxvmCommandResult* res = this.resetup(arg1);
            println(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "dev") {
            string target = arg1.length() > 0 ? arg1 : "src/index.cex";
            println("==> [cxvm dev] Executing via cexr-factory: " + target);
            string cmdStr = "cexr-factory " + target + (arg2.length() > 0 ? " " + arg2 : "");
            int ret = system(cmdStr.c_str());
            return ret == 0 ? 0 : (ret >> 8);
        }
        if (cmd == "build" || cmd == "rebuild") {
            string target = arg1.length() > 0 ? arg1 : "src/index.cex";
            println("==> [cxvm build] Compiling via cexp-v8-stable: " + target + " -> .bin");
            return this.executeProjectBuild(target, arg2);
        }
        if (cmd == "test") {
            string target = arg1.length() > 0 ? arg1 : "tests";
            println("==> [cxvm test] Running via cext: " + target);
            string cmdStr = "cext " + target + (arg2.length() > 0 ? " " + arg2 : "");
            int ret = system(cmdStr.c_str());
            return ret == 0 ? 0 : (ret >> 8);
        }
        if (cmd == "lint") {
            string target = arg1.length() > 0 ? arg1 : ".";
            println("==> [cxvm lint] Linting via cex-lint: " + target);
            string cmdStr = "cex-lint " + target + (arg2.length() > 0 ? " " + arg2 : "");
            int ret = system(cmdStr.c_str());
            return ret == 0 ? 0 : (ret >> 8);
        }
        if (cmd == "upgrade") {
            CxvmCommandResult* res = this.upgrade(arg1, arg2);
            println(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "init") {
            CxvmCommandResult* res = this.cxvmInit(arg1.length() > 0 ? arg1 : "my-project", arg2.length() > 0 ? arg2 : ".");
            println(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "migrate") {
            println("==> [cxvm migrate] Cleaning old build artifacts, cache, and downloaded packages...");
            string curPwd = child_process.execSync("pwd | tr -d '\\n'");
            if (fs.exists(curPwd + "/.bin")) child_process.execSync("rm -rf \"" + curPwd + "/.bin\"");
            if (fs.exists(curPwd + "/.cex_cache")) child_process.execSync("rm -rf \"" + curPwd + "/.cex_cache\"");
            if (fs.exists(curPwd + "/cex_boxes")) child_process.execSync("rm -rf \"" + curPwd + "/cex_boxes\"");
            if (fs.exists(curPwd + "/.cex_boxes")) child_process.execSync("rm -rf \"" + curPwd + "/.cex_boxes\"");
            println("==> [cxvm migrate] Redownloading packages via cex-pack downloads...");
            int dlRes = system("cex-pack downloads cex-pack.json cex_boxes");
            if (dlRes != 0) {
                dlRes = system("cex-pack downloads");
            }
            if (fs.exists(curPwd + "/../projects/mvc-lighting") && fs.exists(curPwd + "/cex_boxes")) {
                child_process.execSync("mkdir -p \"" + curPwd + "/cex_boxes/mvc-lighting\" && cp -rn \"" + curPwd + "/../projects/mvc-lighting\"/* \"" + curPwd + "/cex_boxes/mvc-lighting/\" 2>/dev/null || true");
            }
            if (fs.exists(curPwd + "/cex_boxes") && !fs.exists(curPwd + "/.cex_boxes")) {
                child_process.execSync("cp -r \"" + curPwd + "/cex_boxes\" \"" + curPwd + "/.cex_boxes\" 2>/dev/null || true");
            } else if (fs.exists(curPwd + "/.cex_boxes") && !fs.exists(curPwd + "/cex_boxes")) {
                child_process.execSync("cp -r \"" + curPwd + "/.cex_boxes\" \"" + curPwd + "/cex_boxes\" 2>/dev/null || true");
            }
            println("==> [cxvm migrate] Rebuilding cxvm via cexp-v8-stable...");
            int buildRes = this.executeProjectBuild("src/index.cex", curPwd + "/.bin");
            if (buildRes != 0) {
                println("[FAIL] Project rebuild failed");
                return 1;
            }
            println("==> [cxvm migrate] Setting up newly compiled binary to PATH...");
            CxvmCommandResult* setupRes = this.setup("8.0.0");
            println(setupRes->output);
            return setupRes->success ? 0 : 1;
        }

        // Direct command fallback: Route to appExecute
        return this.appExecute(cmd, arg1, arg2);
    }

    public int executeProjectBuild(string targetArg, string outArg) {
        string curPwd = child_process.execSync("pwd | tr -d '\\n'");
        string rpb = this.resolveRootPathBuilder();
        string srcPath = targetArg.length() > 0 ? targetArg : "src/index.cex";
        if (!fs.exists(srcPath) && fs.exists(curPwd + "/" + srcPath)) {
            srcPath = curPwd + "/" + srcPath;
        }
        if (!fs.exists(srcPath)) {
            println("[ERROR] [cxvm build] Entrypoint source file not found: " + srcPath);
            return 1;
        }

        string binPath = outArg.length() > 0 ? outArg : (curPwd + "/.bin");
        println("==> [cxvm build] Compiling project entrypoint (" + srcPath + " -> " + binPath + ") via cexp-v8-stable...");

        string cmd = "cexp-v8-stable build \"" + srcPath + "\" -o \"" + binPath + "\"";
        int res = system(cmd.c_str());
        if (res != 0) {
            println("[FAIL] Project compilation failed");
            return 1;
        }

        this.allowExecutionOnCurrentDevice(binPath);
        println("[OK] [cxvm build] Standalone binary machine executable: " + binPath);
        return 0;
    }

    public void allowExecutionOnCurrentDevice(string binPath) {
        if (binPath.length() == 0 || !fs.exists(binPath)) return;
        child_process.execSync("chmod +x \"" + binPath + "\" 2>/dev/null || true");
    }

    public CxvmCommandResult* setupPath() {
        string home = child_process.execSync("printf \"%s\" \"$HOME\"");
        string rpb = this.resolveRootPathBuilder();
        child_process.execSync("mkdir -p \"" + rpb + "/bin\" 2>/dev/null || true");

        if (home.length() > 0) {
            string zshrc = home + "/.zshrc";
            string bashrc = home + "/.bashrc";
            string cfg = "\n# 2-TEK CXVM: Cex Version Manager\nexport CXVM_DIR=\"" + rpb + "\"\nexport PATH=\"$CXVM_DIR/bin:$PATH\"\n";
            if (fs.exists(zshrc)) {
                string zContent = fs.readFile(zshrc);
                if (zContent.find("CXVM_DIR") == -1) {
                    fs.writeFile(zshrc, zContent + cfg);
                }
            }
            if (fs.exists(bashrc)) {
                string bContent = fs.readFile(bashrc);
                if (bContent.find("CXVM_DIR") == -1) {
                    fs.writeFile(bashrc, bContent + cfg);
                }
            }
        }
        return new CxvmCommandResult("setup path", rpb + "/bin", true, "PATH configured", "[OK] Path setup configured");
    }

    public CxvmCommandResult* setup(string defaultVer = "8.0.0") {
        string rpb = this.resolveRootPathBuilder();
        string binDir = rpb + "/bin";
        child_process.execSync("mkdir -p \"" + binDir + "\" 2>/dev/null || true");

        // Link cexp-v8-stable and cexr-factory into toolchain bin
        if (fs.exists(rpb + "/cexr-factory/" + this.currentCexrVersion + "/bin/cexr-factory")) {
            child_process.execSync("ln -sf \"" + rpb + "/cexr-factory/" + this.currentCexrVersion + "/bin/cexr-factory\" \"" + binDir + "/cexr-factory\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + binDir + "/cexr-factory\" \"" + binDir + "/cexr\" 2>/dev/null || true");
        }
        if (fs.exists(rpb + "/bin/" + this.currentCexpVersion + "/cexp-v8-stable")) {
            child_process.execSync("ln -sf \"" + rpb + "/bin/" + this.currentCexpVersion + "/cexp-v8-stable\" \"" + binDir + "/cexp-v8-stable\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + binDir + "/cexp-v8-stable\" \"" + binDir + "/cexp\" 2>/dev/null || true");
        }

        string curPwd = child_process.execSync("pwd | tr -d '\\n'");
        if (fs.exists(curPwd + "/.bin")) {
            child_process.execSync("ln -sf \"" + curPwd + "/.bin\" \"" + binDir + "/cxvm\" 2>/dev/null || true");
            child_process.execSync("chmod +x \"" + binDir + "/cxvm\" 2>/dev/null || true");
        }

        this.setupPath();
        string msg = "[OK] CXVM setup completed successfully (cexr-factory v" + this.currentCexrVersion + ", cexp-v8-stable v" + this.currentCexpVersion + ")";
        return new CxvmCommandResult("setup", defaultVer, true, msg, msg);
    }

    public CxvmCommandResult* resetup(string defaultVer = "8.0.0") {
        return this.setup(defaultVer);
    }

    public CxvmCommandResult* reinstall(string targetVer = "8.0.0") {
        return this.setup(targetVer);
    }

    public CxvmCommandResult* setupDeps() {
        string curPwd = child_process.execSync("pwd | tr -d '\\n'");
        string boxesDir = curPwd + "/cex_boxes";
        child_process.execSync("mkdir -p \"" + boxesDir + "\" 2>/dev/null || true");
        string msg = "[OK] .cex_boxes configured, skipping rebuild for cached packages";
        return new CxvmCommandResult("setup boxes", "ok", true, msg, msg);
    }

    public string resolveLibVersion(string libName) {
        if (libName == "cxvm") return "2.1.44";
        if (libName == "mvc-lighting" || libName == "lighting") return "6.1.12";
        if (libName == "cext" || libName == "cex-test") return CxvmConstants::cextVersion();
        if (libName.find("cexr") == 0) return this.currentCexrVersion;
        if (libName.find("cexp") == 0) return this.currentCexpVersion;
        if (libName == "cex-lint") return CxvmConstants::cexLintVersion();
        if (libName == "cex-pack") return CxvmConstants::cexPackVersion();
        return "1.0.0";
    }

    public CxvmCommandResult* upgrade(string arg1, string arg2) {
        println("==> [cxvm upgrade] Checking upstream updates and syncing toolchains...");
        int res = system("git pull origin main 2>/dev/null || cvm pull origin main 2>/dev/null || true");
        return new CxvmCommandResult("upgrade", "latest", true, "Upgrade complete", "[OK] Upgraded and synchronized with upstream");
    }

    public CxvmCommandResult* cxvmInit(string projectName, string targetDir) {
        string dir = targetDir.length() > 0 ? targetDir : ".";
        string packJson = dir + "/cex-pack.json";
        if (!fs.exists(packJson)) {
            string content = "{\n  \"name\": \"" + projectName + "\",\n  \"version\": \"1.0.0\",\n  \"type\": \"app\",\n  \"binary\": \"{rootPathBuilder}/{name}-{type}/{version}/bin\",\n  \"main\": \"src/index.cex\"\n}\n";
            fs.writeFile(packJson, content);
        }
        return new CxvmCommandResult("init", projectName, true, "Initialized " + projectName, "[OK] Initialized project " + projectName);
    }

    public CxvmCommandResult* registerBinaryAppsInCexDir() {
        return new CxvmCommandResult("register", "ok", true, "Registered bin apps", "[OK] Registered bin apps in toolchain");
    }

    public CxvmCommandResult* registerBinAppsInCexDir() {
        return this.registerBinaryAppsInCexDir();
    }

    // Lightweight stubs for CVM commands
    public CxvmCommandResult* cvmStatus() {
        CvmStatusReport* rep = this.cvmCliRunner->bridge->inspectStatus();
        return new CxvmCommandResult("status", "", true, "Branch: " + rep->activeBranch, "Branch: " + rep->activeBranch);
    }

    public CxvmCommandResult* cxvmOpen(string url, string target = "view") {
        return new CxvmCommandResult("open", url, true, "Opened " + url + " in " + target, "[OK] Opened " + url);
    }
    public CxvmCommandResult* cvmAdd(string filePath, string content = "") {
        CvmExecutionResult* res = this.cvmCliRunner->bridge->stageFile(filePath, content);
        return new CxvmCommandResult("add", "", res->exitCode == 0, res->outputMessage, res->outputMessage);
    }
    public CxvmCommandResult* cvmCommit(string message, string authorName = "", string authorEmail = "") {
        CvmExecutionResult* res = this.cvmCliRunner->bridge->createCommit(message, authorName, authorEmail);
        return new CxvmCommandResult("commit", "", res->exitCode == 0, res->outputMessage, res->outputMessage);
    }
    public CxvmCommandResult* cvmPush(string remoteArg = "origin", string branchArg = "main") {
        CvmExecutionResult* res = this.cvmCliRunner->bridge->pushCommits(remoteArg, branchArg);
        return new CxvmCommandResult("push", "", res->exitCode == 0, res->outputMessage, res->outputMessage);
    }
    public CxvmCommandResult* cvmPull(string remoteArg = "origin", string branchArg = "main") {
        CvmExecutionResult* res = this.cvmCliRunner->bridge->pullCommits(remoteArg, branchArg);
        return new CxvmCommandResult("pull", "", res->exitCode == 0, res->outputMessage, res->outputMessage);
    }
    public CxvmCommandResult* cvmBranch(string name) {
        CvmExecutionResult* res = this.cvmCliRunner->bridge->manageBranch(name);
        return new CxvmCommandResult("branch", "", res->exitCode == 0, res->outputMessage, res->outputMessage);
    }
    public CxvmCommandResult* cvmCheckout(string branchName) {
        CvmExecutionResult* res = this.cvmCliRunner->bridge->checkoutBranch(branchName);
        return new CxvmCommandResult("checkout", "", res->exitCode == 0, res->outputMessage, res->outputMessage);
