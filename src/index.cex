// 2-TEK Factory: Package Entrypoint & CLI Runner (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule 82 (CXVM & Direct cexp-v8-stable)

import "./types.cex";
import "./models/platform_model.cex";
import "./models/version_model.cex";
import "./models/artifact_model.cex";
import "./models/package_catalog.cex";
import "./cxvm_engine.cex";
import "./app.cex";
import "@cex-cli.book";
import "@cex-std.book";

int classifyCliCommand(string cmd) {
    if (cmd == "-v" || cmd == "--version" || cmd == "version") return 1;
    if (cmd == "-h" || cmd == "--help" || cmd == "help") return 2;
    return 0;
}

int main(int argc, char** argv) {
    if (argc > 1) {
        string cmd = std::string(argv[1]);
        int cmdCode = classifyCliCommand(cmd);
        switch (cmdCode) {
            case 1: {
                TerminalUI::renderHeader("CXVM v2.1.43", "Pure Cex Native Engine: cexr-factory + cexp-v8-stable");
                CxvmEngine* cxvm = new CxvmEngine();
                println(cxvm->cexrVersionOutput());
                return 0;
            }
            case 2: {
                TerminalUI::renderHeader("2-TEK CXVM: Cex Version Manager", "Cross-platform runtime & compiler manager (cexr-factory, cexp-v8-stable)");
                println("Usage: cxvm <command> [arguments] [options]");
                println("Commands: install, uninstall, use, current, list, doctor, setup, resetup, dev, build, rebuild, test, lint, --app <name>, upgrade, init, migrate");
                println("  --app <name> [args]  Hook and run application binary built through {rootPathBuilder}");
                println("  upgrade [options]    Auto pull and build libraries with last version in git | cvm");
                return 0;
            }
            default:
            break;
        }
        string arg1 = (argc > 2) ? std::string(argv[2]) : "";
        string arg2 = "";
        for (int i = 3; i < argc; i++) {
            if (arg2.length() > 0) arg2 += " ";
            arg2 += std::string(argv[i]);
        }
        CxvmEngine* cxvm = new CxvmEngine();
        return cxvm->cvmExecute(cmd, arg1, arg2);
    }

    TerminalUI::renderHeader("2-TEK CXVM: Cex Version Manager", "Cross-Platform Runtime & Version Manager Engine (cexr-factory + cexp-v8-stable)");
    CxvmEngine* cxvm = new CxvmEngine();
    println(cxvm->doctor());
    return 0;
}
