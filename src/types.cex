// 2-TEK Factory: Cross-Platform Types & Data Structures (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "./lighting_mvc.cex";

class PlatformArch {
    public string id;
    public string os;
    public string arch;
    public string targetTriple;
    public string compiler;
    public string archiveFormat;
    public string displayName;

    public constructor(string id, string os, string arch, string triple, string compiler, string fmt, string name) {
        this.id = id;
        this.os = os;
        this.arch = arch;
        this.targetTriple = triple;
        this.compiler = compiler;
        this.archiveFormat = fmt;
        this.displayName = name;
    }

    public string getArchiveFilename(string version) {
        return "cex-v" + version + "-" + this.id + "." + this.archiveFormat;
    }
}

class RuntimeVersion {
    public string version;
    public string channel;
    public string releaseDate;
    public string minCpp;
    public string description;
    public bool isDefault;

    public constructor(string ver, string chan, string date, string cpp, string desc, bool isDef) {
        this.version = ver;
        this.channel = chan;
        this.releaseDate = date;
        this.minCpp = cpp;
        this.description = desc;
        this.isDefault = isDef;
    }
}

class DistArtifact {
    public string filename;
    public string version;
    public string platform;
    public string arch;
    public int sizeBytes;
    public string sha256;
    public string downloadUrl;
    public bool isBuilt = false;

    public constructor(string fname, string ver, string plat, string arch, int size, string hash, string url) {
        this.filename = fname;
        this.version = ver;
        this.platform = plat;
        this.arch = arch;
        this.sizeBytes = size;
        this.sha256 = hash;
        this.downloadUrl = url;
    }
}

class CxvmCommandResult {
    public string action;
    public string version;
    public bool success;
    public string message;
    public string output;

    public constructor(string action, string ver, bool ok, string msg, string out) {
        this.action = action;
        this.version = ver;
        this.success = ok;
        this.message = msg;
        this.output = out;
    }
}

class FactoryStats {
    public int totalVersions = 0;
    public int supportedPlatforms = 0;
    public int totalArtifacts = 0;
    public string downloadsDirectory = "cxvm/downloads";
    public string lastBuildTimestamp = "2026-10-07T00:00:00Z";

    public constructor() {}
}

