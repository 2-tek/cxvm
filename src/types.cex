// 2-TEK Factory: Cross-Platform Types & Data Structures (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "./lighting_mvc.cex";

class PlatformArch {
    public id: string;
    public os: string;
    public arch: string;
    public targetTriple: string;
    public compiler: string;
    public archiveFormat: string;
    public displayName: string;

    public constructor(id: string, os: string, arch: string, triple: string, compiler: string, fmt: string, name: string) {
        this.id = id;
        this.os = os;
        this.arch = arch;
        this.targetTriple = triple;
        this.compiler = compiler;
        this.archiveFormat = fmt;
        this.displayName = name;
    }

    public getArchiveFilename(version: string): string {
        return "cex-v" + version + "-" + this.id + "." + this.archiveFormat;
    }
}

class RuntimeVersion {
    public version: string;
    public channel: string;
    public releaseDate: string;
    public minCpp: string;
    public description: string;
    public isDefault: bool;

    public constructor(ver: string, chan: string, date: string, cpp: string, desc: string, isDef: bool) {
        this.version = ver;
        this.channel = chan;
        this.releaseDate = date;
        this.minCpp = cpp;
        this.description = desc;
        this.isDefault = isDef;
    }
}

class DistArtifact {
    public filename: string;
    public version: string;
    public platform: string;
    public arch: string;
    public sizeBytes: int;
    public sha256: string;
    public downloadUrl: string;
    public isBuilt: bool = false;

    public constructor(fname: string, ver: string, plat: string, arch: string, size: int, hash: string, url: string) {
        this.filename = fname;
        this.version = ver;
        this.platform = plat;
        this.arch = arch;
        this.sizeBytes = size;
        this.sha256 = hash;
        this.downloadUrl = url;
    }
}

class CxvmCommandResult {
    public action: string;
    public version: string;
    public success: bool;
    public message: string;
    public output: string;

    public constructor(action: string, ver: string, ok: bool, msg: string, out: string) {
        this.action = action;
        this.version = ver;
        this.success = ok;
        this.message = msg;
        this.output = out;
    }
}

class FactoryStats {
    public totalVersions: int = 0;
    public supportedPlatforms: int = 0;
    public totalArtifacts: int = 0;
    public downloadsDirectory: string = "cxvm/downloads";
    public lastBuildTimestamp: string = "2026-10-07T00:00:00Z";

    public constructor() {}
}

class CxvmConstants {
    public static defaultVersion(): string { return "8.0.0"; }
    public static ltsVersion(): string { return "6.0.0"; }
    public static cxvmVersion(): string { return "2.0.0"; }
    public static cexrVersion(): string { return "1.0.26"; }
    public static cextVersion(): string { return "1.0.14"; }
    public static cexLintVersion(): string { return "1.0.8"; }
    public static cexPackVersion(): string { return "1.0.5"; }
    public static defaultPort(): int { return 3080; }
    public static cvmPort(): int { return 4000; }
    public static thunderPort(): int { return 3050; }
    public static cvmDomain(): string { return "cvm.2-tek.com"; }
    public static cvmApi(): string { return "https://cvm.2-tek.com/api/v1"; }
    public static boxesDir(): string { return "cex_boxes"; }
    public static entrypoint(): string { return "src/index.cex"; }
    public static manifestFile(): string { return "cex-pack.json"; }
}
