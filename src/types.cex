// 2-TEK Factory: Cross-Platform Types & Data Structures (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "./lighting_mvc.cex";

class PlatformArch {
    public id: string;
    public os: string;
    public arch: string;
    public targetTriple: string;
    public compiler: string;
    public archiveFormat: string;
    public displayName: string;

    public constructor(string id, string os, string arch, string triple, string compiler, string fmt, string name) {
        this.id = id;
        this.os = os;
        this.arch = arch;
        this.targetTriple = triple;
        this.compiler = compiler;
        this.archiveFormat = fmt;
        this.displayName = name;
    }

    public string getArchiveFilename(string version) {
        return "cex-v" + version + "-" + this.id + "." + this.archiveFormat;
    }
}

class RuntimeVersion {
    public version: string;
    public channel: string;
    public releaseDate: string;
    public minCpp: string;
    public description: string;
    public isDefault: bool;

    public constructor(string ver, string chan, string date, string cpp, string desc, bool isDef) {
        this.version = ver;
        this.channel = chan;
        this.releaseDate = date;
        this.minCpp = cpp;
        this.description = desc;
        this.isDefault = isDef;
    }
}

class DistArtifact {
    public filename: string;
    public version: string;
    public platform: string;
    public arch: string;
    public sizeBytes: int;
    public sha256: string;
    public downloadUrl: string;
    public isBuilt: bool = false;

    public constructor(string fname, string ver, string plat, string arch, int size, string hash, string url) {
        this.filename = fname;
        this.version = ver;
        this.platform = plat;
        this.arch = arch;
        this.sizeBytes = size;
        this.sha256 = hash;
        this.downloadUrl = url;
    }
}

class CxvmCommandResult {
    public action: string;
    public version: string;
    public success: bool;
    public message: string;
    public output: string;

    public constructor(string action, string ver, bool ok, string msg, string out) {
        this.action = action;
        this.version = ver;
        this.success = ok;
        this.message = msg;
        this.output = out;
    }
}

class FactoryStats {
    public totalVersions: int = 0;
    public supportedPlatforms: int = 0;
    public totalArtifacts: int = 0;
    public downloadsDirectory: string = "cxvm/downloads";
    public lastBuildTimestamp: string = "2026-10-07T00:00:00Z";

    public constructor() {}
}

class CxvmConstants {
    static public string defaultVersion() { return "8.0.0"; }
    static public string ltsVersion() { return "6.0.0"; }
    static public string cxvmVersion() { return "2.0.0"; }
    static public string cexrVersion() { return "2.0.0"; }
    static public string cextVersion() { return "2.0.0"; }
    static public string cexLintVersion() { return "2.0.0"; }
    static public string cexPackVersion() { return "2.0.0"; }
    static public int defaultPort() { return 3080; }
    static public int cvmPort() { return 4000; }
    static public int thunderPort() { return 3050; }
    static public string cvmDomain() { return "cvm.2-tek.com"; }
    static public string cvmApi() { return "https://cvm.2-tek.com/api/v1"; }
    static public string boxesDir() { return "cex_boxes"; }
    static public string entrypoint() { return "src/index.cex"; }
    static public string manifestFile() { return "cex-pack.json"; }
}
