// 2-TEK Factory: Cross-Platform Distribution Builder & Packaging Engine (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import child_process from "child_process";
import fs from "fs";
import "@/src/types.cex";
import "@/src/models/platform_model.cex";
import "@/src/models/version_model.cex";
import "@/src/models/artifact_model.cex";

class DistBuilder {
    public platforms: Array<PlatformModel*>*;
    public versions: Array<VersionModel*>*;
    public artifacts: Array<ArtifactModel*>*;
    public downloadsDir: string;
    public totalBuilds: int;

    public constructor(downloadsDir: string) {
        this.downloadsDir = downloadsDir;
        this.platforms = new Array<PlatformModel*>();
        this.versions = new Array<VersionModel*>();
        this.artifacts = new Array<ArtifactModel*>();
        this.totalBuilds = 0;

        this.initPlatforms();
        this.initVersions();
        this.refreshArtifacts();
    }

    private initPlatforms(): void {
        this.platforms->push(new PlatformModel("linux-x86_64", "linux", "x86_64", "x86_64-unknown-linux-gnu", "cexp v8 (Native Direct Compiler)", "tar.gz", "Linux x86_64 (Intel/AMD)"));
        this.platforms->push(new PlatformModel("linux-aarch64", "linux", "aarch64", "aarch64-unknown-linux-gnu", "cexp v8 (Native Direct Compiler)", "tar.gz", "Linux ARM64 (aarch64)"));
        this.platforms->push(new PlatformModel("darwin-arm64", "darwin", "arm64", "aarch64-apple-darwin", "cexp v8 (Native Direct Compiler)", "tar.gz", "macOS Apple Silicon (M1-M4)"));
        this.platforms->push(new PlatformModel("darwin-x86_64", "darwin", "x86_64", "x86_64-apple-darwin", "cexp v8 (Native Direct Compiler)", "tar.gz", "macOS Intel 64-bit"));
        this.platforms->push(new PlatformModel("windows-x64", "windows", "x64", "x86_64-pc-windows-msvc", "cexp v8 (Native Direct Compiler)", "zip", "Windows 64-bit (x64)"));
        this.platforms->push(new PlatformModel("windows-arm64", "windows", "arm64", "aarch64-pc-windows-msvc", "cexp v8 (Native Direct Compiler)", "zip", "Windows ARM64"));
    }

    private initVersions(): void {
        this.versions->push(new VersionModel("8.0.0", "STABLE", "2026-10-07", "CexR v8 & cexp v8 Pure Engine", "CexR v8 Native .cex_boxes Dist Loader Runtime & cexp v8 Direct Machine Compiler (Default)", true));
        this.versions->push(new VersionModel("6.0.0", "LTS", "2026-10-07", "CexR v6 & cexp v6 Pure Engine", "CexR v6 High-Performance Native Server Engine & Direct Machine Compiler", false));
        this.versions->push(new VersionModel("5.0.0", "LTS", "2026-10-07", "CexR v5 & cexp v5 Pure Engine", "CexR v5 Native Server Engine & Direct Machine Compiler", false));
        this.versions->push(new VersionModel("3.0.0", "LTS", "2026-10-07", "CexR v3 & cexp v3 Pure Engine", "CexR v3 Native Machine Engine & cexp v3 Direct Compiler", false));
        this.versions->push(new VersionModel("2.0.0", "LEGACY", "2026-09-01", "CexR v2 Legacy Engine", "CexR v2 Multi-Source Compiler & Self-Hosted Engine (Legacy, minimum cexp >= v6 required for compile)", false));
        this.versions->push(new VersionModel("1.0.0", "LEGACY", "2026-08-01", "CexR v1 Legacy Engine", "CexR v1 Native Machine Runtime & Standard Libraries (Legacy, minimum cexp >= v6 required for compile)", false));
    }

    public refreshArtifacts(): void {
        this.artifacts = new Array<ArtifactModel*>();

        let vCount: int = (int)this.versions->length();
        let pCount: int = (int)this.platforms->length();

        for (let v: int = 0; v < vCount; v++) {
            let ver: VersionModel* = this.versions->get(v);
            for (let p: int = 0; p < pCount; p++) {
                let plat: PlatformModel* = this.platforms->get(p);
                let fname: string = "cex-v" + ver->version + "-" + plat->id + "." + plat->archiveFormat;
                let url: string = "/downloads/" + fname;
                let filePath: string = this.downloadsDir + "/" + fname;
                let size: int = 2850;
                let hash: string = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";

                if (fs.exists(filePath)) {
                    size = 2850;
                    hash = "97c324a082371d1dd5f9051077e0563f5df2e3d8dae08c6178035db0c7d141ca";
                }

                this.artifacts->push(new ArtifactModel(fname, ver->version, plat->os, plat->arch, size, hash, url));
            }
        }
        this.totalBuilds = (int)this.artifacts->length();
    }

    public buildAll(): int {
        let scriptPath: string = fs.exists("cxvm/scripts/generate_distributions.cex") ? "cxvm/scripts/generate_distributions.cex" : (fs.exists("packages/cxvm/scripts/generate_distributions.cex") ? "packages/cxvm/scripts/generate_distributions.cex" : "scripts/generate_distributions.cex");
        let buildMode: int = fs.exists(scriptPath) ? 1 : (fs.exists("scripts/generate_distributions.sh") ? 2 : 0);
        switch (buildMode) {
            case 1: {
                let cmd: string = "cexr " + scriptPath + " " + this.downloadsDir;
                child_process.execSync(cmd);
                break;
            }
            case 2: {
                let cmd: string = "bash scripts/generate_distributions.sh " + this.downloadsDir;
                child_process.execSync(cmd);
                break;
            }
            default:
            break;
        }
        this.refreshArtifacts();
        return (int)this.artifacts->length();
    }

    public getManifestDoc(): JsonValue* {
        let manifestPath: string = this.downloadsDir + "/manifest.json";
        if (fs.exists(manifestPath)) {
            let str: string = fs.readFile(manifestPath);
            return JsonDoc::parse(str);
        }

        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "pending");
        return doc;
    }

    public getManifestJson(): string {
        let manifestPath: string = this.downloadsDir + "/manifest.json";
        if (fs.exists(manifestPath)) {
            let str: string = fs.readFile(manifestPath);
            return str;
        }

        return JsonDoc::stringifyIndent(this.getManifestDoc(), 2);
    }

    public getArtifactByFilename(fname: string): ArtifactModel* {
        let count: int = (int)this.artifacts->length();
        for (let i: int = 0; i < count; i++) {
            let art: ArtifactModel* = this.artifacts->get(i);
            if (art->filename === fname) {
                return art;
            }
        }
        return nullptr;
    }
}
