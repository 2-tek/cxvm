    public apiThunderServerStart(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let res: CxvmCommandResult* = cxvm->startThunder(3050, true);
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "SUCCESS");
        JsonDoc::setStr(doc, "service", "thunder-daemon");
        JsonDoc::setStr(doc, "mode", "standalone (single process)");
