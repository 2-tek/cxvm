    public HttpResponse* apiStatus(HttpRequest* req, int port, PackageCatalog* builder, CxvmEngine* cxvm) {
        let doc: JsonValue* = JsonDocHelper::obj();
        JsonDocHelper::setStr(doc, "status", "ACTIVE");
        JsonDocHelper::setStr(doc, "service", "2-TEK Cex Factory");
        JsonDocHelper::setStr(doc, "framework", "Lighting MVC");
        JsonDocHelper::setNum(doc, "port", port);
        JsonDocHelper::setNum(doc, "totalPlatforms", (int)builder->platforms->length());
        JsonDocHelper::setNum(doc, "totalVersions", (int)builder->versions->length());
        JsonDocHelper::setNum(doc, "totalArtifacts", (int)builder->artifacts->length());
        JsonDocHelper::setStr(doc, "currentActiveVersion", cxvm->current());
        JsonDocHelper::setStr(doc, "crossPlatformSupport", "Linux (x86_64, aarch64), macOS (arm64, x86_64), Windows (x64, arm64)");
        return this.json(doc);
    }

    public HttpResponse* apiVersions(HttpRequest* req, Array<VersionModel*>* versions) {
        let count: int = (int)versions->length();
        let doc: JsonValue* = JsonDocHelper::obj();
        let arr: JsonValue* = JsonDocHelper::arr();
        for (let i: int = 0; i < count; i++) {
            JsonDocHelper::pushVal(arr, versions->get(i)->toJsonValue());
        }
        JsonDocHelper::setNum(doc, "total", count);
        JsonDocHelper::setVal(doc, "versions", arr);
        return this.json(doc);
    }

    public HttpResponse* apiPlatforms(HttpRequest* req, Array<PlatformModel*>* platforms) {
        let count: int = (int)platforms->length();
