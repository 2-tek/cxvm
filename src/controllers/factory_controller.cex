    public apiRacerStatus(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "SUCCESS");
        JsonDoc::setStr(doc, "engine", "CexRacer");
        JsonDoc::setStr(doc, "clockIso", Clock::nowIso());
        JsonDoc::setNum(doc, "clockEpochMs", (int)Clock::nowMs());
        JsonDoc::setNum(doc, "queuesCount", 8);
        JsonDoc::setStr(doc, "thunderSupervisor", "ACTIVE");
        JsonDoc::setNum(doc, "watchdogIntervalMs", 1800000);
        return this.json(doc);
    }

    public apiRacerQueues(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "SUCCESS");
        let qArr: JsonValue* = JsonDoc::arr();
        auto stats = cxvm->racer->scheduler->getAllStats();
        for (const auto& s : stats) {
            let item: JsonValue* = JsonDoc::obj();
            JsonDoc::setStr(item, "name", s->name);
            JsonDoc::setNum(item, "concurrency", s->concurrency);
            JsonDoc::setNum(item, "pendingCount", s->pendingCount);
            JsonDoc::setNum(item, "runningCount", s->runningCount);
            JsonDoc::setNum(item, "completedCount", s->completedCount);
            qArr->push(item);
        }
        JsonDoc::setVal(doc, "queues", qArr);
        return this.json(doc);
    }

    public apiRacerTasks(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "SUCCESS");
        auto stats = cxvm->racer->scheduler->getAllStats();
        let pending: int = 0;
        let running: int = 0;
        let completed: int = 0;
        for (const auto& s : stats) {
            pending += s->pendingCount;
            running += s->runningCount;
            completed += s->completedCount;
        }
        JsonDoc::setNum(doc, "totalScheduled", pending);
        JsonDoc::setNum(doc, "totalRunning", running);
        JsonDoc::setNum(doc, "totalCompleted", completed);
        return this.json(doc);
    }

    public apiRacerSchedule(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let name: string = req->getParam("name");
        let interval: string = req->getParam("interval");
        let cmd: string = req->getParam("command");
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDoc::parse(req->body);
            if (parsed != nullptr) {
                if (parsed->has("name")) name = parsed->get("name")->asString();
                if (parsed->has("interval")) interval = parsed->get("interval")->asString();
                if (parsed->has("command")) cmd = parsed->get("command")->asString();
            }
        }
        if (name.length() == 0) name = "scheduled-task";
        if (interval.length() == 0) interval = "30m";
        if (cmd.length() == 0) cmd = "cxvm status";

        cxvm->racer->scheduleCommand(name, "default", cmd, interval, RACER_PRIORITY_NORMAL, true);
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "SUCCESS");
        JsonDoc::setStr(doc, "name", name);
        JsonDoc::setStr(doc, "interval", interval);
        return this.json(doc);
    }

    public apiRacerRun(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let cmd: string = req->getParam("command");
        let queueName: string = req->getParam("queue");
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDoc::parse(req->body);
            if (parsed != nullptr) {
                if (parsed->has("command")) cmd = parsed->get("command")->asString();
                if (parsed->has("queue")) queueName = parsed->get("queue")->asString();
            }
        }
        if (cmd.length() == 0) cmd = "echo 'racer test'";
        if (queueName.length() == 0) queueName = "default";

        let res: int = cxvm->racer->runCommand(queueName, cmd, RACER_PRIORITY_NORMAL);
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", res == 0 ? "SUCCESS" : "ERROR");
        JsonDoc::setNum(doc, "exitCode", res);
        JsonDoc::setStr(doc, "queue", queueName);
        return this.json(doc);
    }

    public apiBuildCexp(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let versions: string = req->getParam("versions");
        if (versions.length() == 0 && req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDoc::parse(req->body);
            if (parsed != nullptr && parsed->has("versions")) {
                versions = parsed->get("versions")->asString();
            }
        }
        if (versions.length() == 0) {
            versions = "all";
        }
        let res: CxvmCommandResult* = cxvm->buildCexpVersions(versions);
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", res->success ? "SUCCESS" : "ERROR");
        JsonDoc::setStr(doc, "cliEngine", "@cex-cli v" + cxvm->cexCli->getConfig()->version);
        JsonDoc::setStr(doc, "target", "cexp");
        JsonDoc::setStr(doc, "versions", versions);
        JsonDoc::setStr(doc, "message", res->message);
        JsonDoc::setStr(doc, "output", res->output);
        return this.json(doc);
    }

