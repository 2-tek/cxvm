        JsonDoc::setStr(doc, "framework", "Lighting Fullstack MVC (Pure Cex)");

        let arr: JsonValue* = JsonDoc::arr();
        JsonDoc::pushStr(arr, "create");
        JsonDoc::pushStr(arr, "dev");
        JsonDoc::pushStr(arr, "build");
        JsonDoc::pushStr(arr, "doctor");
        JsonDoc::setVal(doc, "commands", arr);

        JsonDoc::setStr(doc, "version", "8.0.0");
        return this.json(doc);
    }

    public apiLightCreate(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let projectName: string = "my-lighting-app";
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDoc::parse(req->body);
            if (parsed != nullptr && parsed->has("projectName")) {
                projectName = parsed->get("projectName")->asString();
            }
        }
        let res: CxvmCommandResult* = cxvm->lightCreate(projectName, ".");
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "SUCCESS");
        JsonDoc::setStr(doc, "projectName", projectName);
        JsonDoc::setStr(doc, "framework", "Lighting Fullstack MVC");
        JsonDoc::setStr(doc, "message", res->message);
        return this.json(doc);
    }
}
