        JsonDoc::setNum(doc, "totalEvents", cxvm->runners->getMetrics()->totalEvents);
        JsonDoc::setNum(doc, "dispatchedEvents", cxvm->runners->getMetrics()->dispatchedEvents);
        JsonDoc::setNum(doc, "filteredEvents", cxvm->runners->getMetrics()->filteredEvents);
        JsonDoc::setNum(doc, "throttledEvents", cxvm->runners->getMetrics()->throttledEvents);
        JsonDoc::setNum(doc, "completedPipelines", cxvm->runners->getMetrics()->completedPipelines);
        JsonDoc::setNum(doc, "averageLatencyMs", (int)cxvm->runners->getMetrics()->getAverageLatencyMs());
        return this.json(doc);
    }

    public apiRunnersMetrics(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let m: RunnerMetrics* = cxvm->runners->getMetrics();
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setNum(doc, "totalEvents", m->totalEvents);
        JsonDoc::setNum(doc, "dispatchedEvents", m->dispatchedEvents);
        JsonDoc::setNum(doc, "filteredEvents", m->filteredEvents);
        JsonDoc::setNum(doc, "throttledEvents", m->throttledEvents);
        JsonDoc::setNum(doc, "completedPipelines", m->completedPipelines);
        return this.json(doc);
    }

    public apiRunnersDispatch(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let target: string = req->getParam("target");
        let eventName: string = req->getParam("event");
        let payload: string = req->getParam("payload");

        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDoc::parse(req->body);
            if (parsed != nullptr) {
                if (parsed->has("target")) target = parsed->get("target")->asString();
                if (parsed->has("event")) eventName = parsed->get("event")->asString();
                if (parsed->has("payload")) payload = parsed->get("payload")->asString();
            }
        }
        if (target.length() == 0) target = "cxvm";
        if (eventName.length() == 0) eventName = "build";

        let dispatched: int = cxvm->runners->dispatchToTarget(target, eventName, payload);
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "SUCCESS");
        JsonDoc::setStr(doc, "target", target);
        JsonDoc::setStr(doc, "event", eventName);
        JsonDoc::setNum(doc, "dispatchedPipelines", dispatched);
        return this.json(doc);
    }

