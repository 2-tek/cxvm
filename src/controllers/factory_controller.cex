        JsonDoc::setStr(doc, "target", "cexr");
        JsonDoc::setStr(doc, "versions", versions);
        JsonDoc::setStr(doc, "message", res->message);
        JsonDoc::setStr(doc, "output", res->output);
        return this.json(doc);
    }

    public apiBuildToolchain(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let versions: string = req->getParam("versions");
        if (versions.length() == 0 && req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDoc::parse(req->body);
            if (parsed != nullptr && parsed->has("versions")) {
                versions = parsed->get("versions")->asString();
            }
        }
        if (versions.length() == 0) {
            versions = "all";
        }
        let res: CxvmCommandResult* = cxvm->buildToolchainVersions(versions);
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", res->success ? "SUCCESS" : "ERROR");
        JsonDoc::setStr(doc, "cliEngine", "@cex-cli v" + cxvm->cexCli->getConfig()->version);
        JsonDoc::setStr(doc, "target", "toolchain");
        JsonDoc::setStr(doc, "versions", versions);
        JsonDoc::setStr(doc, "message", res->message);
        JsonDoc::setStr(doc, "output", res->output);
        return this.json(doc);
    }

    public apiCexrRun(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let target: string = req->getParam("target");
        let options: string = req->getParam("options");
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDoc::parse(req->body);
            if (parsed != nullptr) {
                if (target.length() == 0 && parsed->has("target")) {
                    target = parsed->get("target")->asString();
                }
                if (options.length() == 0 && parsed->has("options")) {
                    options = parsed->get("options")->asString();
                }
            }
        }
        if (options.length() == 0) {
            options = "--dry-run";
        }
        let res: CxvmCommandResult* = cxvm->runCexrThroughRacerAndPipeline(target, options);
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", res->success ? "SUCCESS" : "ERROR");
        JsonDoc::setBool(doc, "success", res->success);
        JsonDoc::setStr(doc, "app", "cexr");
        JsonDoc::setStr(doc, "engine", "cex-racers+cex-pipelines");
        JsonDoc::setStr(doc, "runtimeEngine", "cexr");
        JsonDoc::setStr(doc, "scheduler", "cex-racers");
        JsonDoc::setStr(doc, "pipeline", "cex-pipelines");
        JsonDoc::setStr(doc, "target", res->version);
        JsonDoc::setStr(doc, "message", res->message);
        JsonDoc::setStr(doc, "output", res->output);
        return this.json(doc);
    }

    private extractRawJsonStr(raw: string, key: string): string {
        let pat: string = "\"" + key + "\"";
        let pos: int = (int)raw.find(pat);
        if (pos == -1) return "";
        let colon: int = (int)raw.find(":", pos + (int)pat.length());
        if (colon == -1) return "";
        let q1: int = (int)raw.find("\"", colon + 1);
        if (q1 == -1) return "";
        let q2: int = (int)raw.find("\"", q1 + 1);
        if (q2 == -1) return "";
        return raw.substr(q1 + 1, q2 - q1 - 1);
    }

    public apiSuggest(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let inputText: string = req->getParam("text");
        if (inputText.length() == 0) inputText = req->getParam("q");
        if (inputText.length() == 0) inputText = req->getParam("query");
        if (inputText.length() == 0) inputText = req->getParam("input");
        if (inputText.length() == 0) inputText = req->getParam("prefix");
        if (inputText.length() == 0) inputText = req->getParam("id");

        let kindFilter: string = req->getParam("kind");
        if (kindFilter.length() == 0) kindFilter = req->getParam("type");

        let contextCode: string = req->getParam("code");
        if (contextCode.length() == 0) contextCode = req->getParam("context");

        if (req->body.length() > 0) {
            if (req->body.find("{") != -1) {
                if (inputText.length() == 0) inputText = this.extractRawJsonStr(req->body, "text");
                if (inputText.length() == 0) inputText = this.extractRawJsonStr(req->body, "q");
                if (inputText.length() == 0) inputText = this.extractRawJsonStr(req->body, "query");
                if (inputText.length() == 0) inputText = this.extractRawJsonStr(req->body, "input");
                if (inputText.length() == 0) inputText = this.extractRawJsonStr(req->body, "prefix");
                if (kindFilter.length() == 0) kindFilter = this.extractRawJsonStr(req->body, "kind");
                if (kindFilter.length() == 0) kindFilter = this.extractRawJsonStr(req->body, "type");
                if (contextCode.length() == 0) contextCode = this.extractRawJsonStr(req->body, "code");
                if (contextCode.length() == 0) contextCode = this.extractRawJsonStr(req->body, "context");

                if (inputText.length() == 0) {
                    let parsed: JsonValue* = JsonDoc::parse(req->body);
                    if (parsed != nullptr) {
                        if (inputText.length() == 0 && parsed->has("text")) inputText = parsed->get("text")->asString();
                        if (inputText.length() == 0 && parsed->has("q")) inputText = parsed->get("q")->asString();
                        if (inputText.length() == 0 && parsed->has("query")) inputText = parsed->get("query")->asString();
                        if (inputText.length() == 0 && parsed->has("input")) inputText = parsed->get("input")->asString();
                        if (inputText.length() == 0 && parsed->has("prefix")) inputText = parsed->get("prefix")->asString();
                    }
                }
            }
            if (inputText.length() == 0 && req->body.find("{") == -1) {
                inputText = req->body;
            }
        }

        let res: SuggestionResult* = cxvm->suggestResult(inputText, kindFilter, contextCode);
        return this.json(res->toJsonValue());
    }

