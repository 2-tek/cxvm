// 2-TEK Factory: Lighting MVC Controller for Cross-Platform Platform & API (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import fs from "fs";
import "../lighting_mvc.cex";
import "../types.cex";
import "../models/platform_model.cex";
import "../models/version_model.cex";
import "../models/artifact_model.cex";
import "../builder/dist_builder.cex";
import "../cxvm/cxvm_engine.cex";
import "../views/factory_views.cex";

class FactoryController extends BaseController {
    public constructor() {
        super();
    }

    public index(req: HttpRequest*, port: int, versions: Array<VersionModel*>*, platforms: Array<PlatformModel*>*, artifacts: Array<ArtifactModel*>*, activeVer: string): HttpResponse* {
        let pageHtml: string = FactoryViews::renderDashboard(port, versions, platforms, artifacts, activeVer);
        return this.html(pageHtml);
    }

    public downloadsHtml(req: HttpRequest*, port: int, artifacts: Array<ArtifactModel*>*): HttpResponse* {
        let pageHtml: string = FactoryViews::renderDownloads(port, artifacts);
        return this.html(pageHtml);
    }

    public cxvmDocs(req: HttpRequest*, port: int): HttpResponse* {
        let pageHtml: string = FactoryViews::renderCxvmDocs(port);
        return this.html(pageHtml);
    }

    public setupHtml(req: HttpRequest*, port: int, cxvm: CxvmEngine*): HttpResponse* {
        let doctorOut: string = cxvm->doctor();
        let pageHtml: string = FactoryViews::renderSetupWindow(port, cxvm->current(), cxvm->defaultVersion, doctorOut);
        return this.html(pageHtml);
    }

    public apiStatus(req: HttpRequest*, port: int, builder: DistBuilder*, cxvm: CxvmEngine*): HttpResponse* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "ACTIVE");
        JsonDoc::setStr(doc, "service", "2-TEK Cex Factory");
        JsonDoc::setStr(doc, "framework", "Lighting MVC");
        JsonDoc::setNum(doc, "port", port);
        JsonDoc::setNum(doc, "totalPlatforms", (int)builder->platforms->length());
        JsonDoc::setNum(doc, "totalVersions", (int)builder->versions->length());
        JsonDoc::setNum(doc, "totalArtifacts", (int)builder->artifacts->length());
        JsonDoc::setStr(doc, "currentActiveVersion", cxvm->current());
        JsonDoc::setStr(doc, "crossPlatformSupport", "Linux (x86_64, aarch64), macOS (arm64, x86_64), Windows (x64, arm64)");
        return this.json(doc);
    }

    public apiVersions(req: HttpRequest*, versions: Array<VersionModel*>*): HttpResponse* {
        let count: int = (int)versions->length();
        let doc: JsonValue* = JsonDoc::obj();
        let arr: JsonValue* = JsonDoc::arr();
        for (let i: int = 0; i < count; i++) {
            JsonDoc::pushVal(arr, versions->get(i)->toJsonValue());
        }
        JsonDoc::setNum(doc, "total", count);
        JsonDoc::setVal(doc, "versions", arr);
        return this.json(doc);
    }

    public apiPlatforms(req: HttpRequest*, platforms: Array<PlatformModel*>*): HttpResponse* {
        let count: int = (int)platforms->length();
        let doc: JsonValue* = JsonDoc::obj();
        let arr: JsonValue* = JsonDoc::arr();
        for (let i: int = 0; i < count; i++) {
            JsonDoc::pushVal(arr, platforms->get(i)->toJsonValue());
        }
        JsonDoc::setVal(doc, "platforms", arr);
        JsonDoc::setNum(doc, "total", count);
        return this.json(doc);
    }

    public apiDownloads(req: HttpRequest*, artifacts: Array<ArtifactModel*>*): HttpResponse* {
        let count: int = (int)artifacts->length();
        let doc: JsonValue* = JsonDoc::obj();
        let arr: JsonValue* = JsonDoc::arr();
        for (let i: int = 0; i < count; i++) {
            JsonDoc::pushVal(arr, artifacts->get(i)->toJsonValue());
        }
        JsonDoc::setVal(doc, "artifacts", arr);
        JsonDoc::setNum(doc, "total", count);
        return this.json(doc);
    }

    public apiManifest(req: HttpRequest*, builder: DistBuilder*): HttpResponse* {
        return this.json(builder->getManifestDoc());
    }

    public apiBuild(req: HttpRequest*, builder: DistBuilder*): HttpResponse* {
        let count: int = builder->buildAll();
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "message", "All cross-platform distribution archives generated in Factory/downloads/");
        JsonDoc::setStr(doc, "status", "SUCCESS");
        JsonDoc::setNum(doc, "totalPackagesBuilt", count);
        return this.json(doc);
    }

    public serveInstallSh(req: HttpRequest*, port: int, downloadsDir: string): HttpResponse* {
        let filePath: string = downloadsDir + "/install.sh";
        if (fs.exists(filePath)) {
            let content: string = fs.readFile(filePath);
            return HttpResponse::ok(content, "text/x-shellscript");
        }
        let pStr: string = std::to_string(port);
        let script: string = "#!/usr/bin/env bash\n";
        script += "# 2-TEK Cex Factory: Cross-Platform Quick Installer\n";
        script += "set -e\n";
        script += "CXVM_DIR=\"${CXVM_DIR:-$HOME/.cxvm}\"\n";
        script += "FACTORY_URL=\"${CEX_FACTORY_URL:-https://raw.githubusercontent.com/2-tek/cxvm/main}\"\n";
        script += "DEFAULT_VER=\"8.0.0\"\n";
        script += "echo \"==> Bootstrapping cxvm from $FACTORY_URL...\"\n";
        script += "mkdir -p \"$CXVM_DIR/bin\" \"$CXVM_DIR/versions\" \"$CXVM_DIR/cache\"\n";
        script += "curl -fsSL \"$FACTORY_URL/downloads/cxvm\" -o \"$CXVM_DIR/bin/cxvm\" 2>/dev/null || true\n";
        script += "chmod +x \"$CXVM_DIR/bin/cxvm\" 2>/dev/null || true\n";
        script += "if [ -f \"$CXVM_DIR/bin/cxvm\" ]; then\n";
        script += "  source \"$CXVM_DIR/bin/cxvm\"\n";
        script += "  cxvm install \"$DEFAULT_VER\"\n";
        script += "  cxvm use \"$DEFAULT_VER\"\n";
        script += "fi\n";
        script += "echo \"✓ Cex Toolchain setup complete! Run 'cxvm --help'\"\n";
        return HttpResponse::ok(script, "text/x-shellscript");
    }

    public serveInstallPs1(req: HttpRequest*, port: int, downloadsDir: string): HttpResponse* {
        let filePath: string = downloadsDir + "/install.ps1";
        if (fs.exists(filePath)) {
            let content: string = fs.readFile(filePath);
            return HttpResponse::ok(content, "text/plain");
        }
        let pStr: string = std::to_string(port);
        let script: string = "# 2-TEK Cex Factory: Windows PowerShell Quick Installer\n";
        script += "$ErrorActionPreference = \"Stop\"\n";
        script += "$cxvmDir = Join-Path $HOME \".cxvm\"\n";
        script += "$factoryUrl = if ($env:CEX_FACTORY_URL) { $env:CEX_FACTORY_URL } else { \"https://raw.githubusercontent.com/2-tek/cxvm/main\" }\n";
        script += "$defaultVersion = \"8.0.0\"\n";
        script += "Write-Host \"==> Installing Cex cxvm toolchain...\" -ForegroundColor Cyan\n";
        script += "New-Item -ItemType Directory -Force -Path (Join-Path $cxvmDir \"bin\") | Out-Null\n";
        script += "New-Item -ItemType Directory -Force -Path (Join-Path $cxvmDir \"versions\") | Out-Null\n";
        script += "Write-Host \"✓ Cex Toolchain setup complete!\" -ForegroundColor Green\n";
        return HttpResponse::ok(script, "text/plain");
    }

    public serveCxvm(req: HttpRequest*, downloadsDir: string): HttpResponse* {
        let filePath: string = downloadsDir + "/cxvm";
        if (fs.exists(filePath)) {
            let content: string = fs.readFile(filePath);
            return HttpResponse::ok(content, "text/x-shellscript");
        }
        let script: string = "#!/usr/bin/env bash\n";
        script += "# cxvm: Cex Version Manager\n";
        script += "echo \"cxvm v8.0.0 (Cex Version Manager)\"\n";
        return HttpResponse::ok(script, "text/x-shellscript");
    }

    public serveCxvmPs1(req: HttpRequest*, downloadsDir: string): HttpResponse* {
        let filePath: string = downloadsDir + "/cxvm.ps1";
        if (fs.exists(filePath)) {
            let content: string = fs.readFile(filePath);
            return HttpResponse::ok(content, "text/plain");
        }
        return HttpResponse::notFound("cxvm.ps1 not found");
    }

    public serveCxvmCmd(req: HttpRequest*, downloadsDir: string): HttpResponse* {
        let filePath: string = downloadsDir + "/cxvm.cmd";
        if (fs.exists(filePath)) {
            let content: string = fs.readFile(filePath);
            return HttpResponse::ok(content, "text/plain");
        }
        return HttpResponse::notFound("cxvm.cmd not found");
    }

    public downloadFile(req: HttpRequest*, downloadsDir: string): HttpResponse* {
        let filename: string = req->getParam("id");
        if (filename.length() == 0 || filename.find("..") != -1) {
            return HttpResponse::badRequest("Invalid download artifact filename");
        }
        let fullPath: string = downloadsDir + "/" + filename;
        if (!fs.exists(fullPath)) {
            return HttpResponse::notFound("Artifact not found: " + filename);
        }
        let content: string = fs.readFile(fullPath);
        let cType: string = "application/octet-stream";
        if (filename.find(".tar.gz") != -1) {
            cType = "application/gzip";
        } else if (filename.find(".zip") != -1) {
            cType = "application/zip";
        } else if (filename.find(".sh") != -1 || filename === "cxvm") {
            cType = "text/x-shellscript";
        } else if (filename.find(".ps1") != -1) {
            cType = "text/plain";
        } else if (filename.find(".cmd") != -1 || filename.find(".bat") != -1) {
            cType = "text/plain";
        } else if (filename.find(".json") != -1) {
            cType = "application/json";
        }
        return HttpResponse::ok(content, cType);
    }

    public serveSetupSh(req: HttpRequest*, port: int, downloadsDir: string): HttpResponse* {
        let filePath: string = downloadsDir + "/setup.sh";
        if (fs.exists(filePath)) {
            let content: string = fs.readFile(filePath);
            return HttpResponse::ok(content, "text/x-shellscript");
        }
        if (fs.exists("scripts/setup.sh")) {
            let content: string = fs.readFile("scripts/setup.sh");
            return HttpResponse::ok(content, "text/x-shellscript");
        }
        return HttpResponse::notFound("setup.sh not found");
    }

    public serveSetupPs1(req: HttpRequest*, port: int, downloadsDir: string): HttpResponse* {
        let filePath: string = downloadsDir + "/setup.ps1";
        if (fs.exists(filePath)) {
            let content: string = fs.readFile(filePath);
            return HttpResponse::ok(content, "text/plain");
        }
        if (fs.exists("scripts/setup.ps1")) {
            let content: string = fs.readFile("scripts/setup.ps1");
            return HttpResponse::ok(content, "text/plain");
        }
        return HttpResponse::notFound("setup.ps1 not found");
    }

    public apiSetupGet(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "ACTIVE");
        JsonDoc::setStr(doc, "cxvmHome", cxvm->cxvmHome);
        JsonDoc::setStr(doc, "currentActive", cxvm->current());
        JsonDoc::setStr(doc, "defaultVersion", "v" + cxvm->defaultVersion);

        let arr: JsonValue* = JsonDoc::arr();
        let count: int = (int)cxvm->installedVersions->length();
        for (let i: int = 0; i < count; i++) {
            JsonDoc::pushStr(arr, "v" + cxvm->installedVersions->get(i));
        }
        JsonDoc::setVal(doc, "installedVersions", arr);

        let disp: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(disp, "cexr", "./bin/cexr (v8 default, v6 supported)");
        JsonDoc::setStr(disp, "cex", "./bin/cex");
        JsonDoc::setVal(doc, "dispatchers", disp);

        JsonDoc::setStr(doc, "toolchain", "Pure Cex Native Engine (zero C++ dependency; powered by cexr + cexp)");
        return this.json(doc);
    }

    public apiSetupPost(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let res: CxvmCommandResult* = cxvm->setup("8.0.0");
        let statStr: string = res->success ? "SUCCESS" : "ERROR";
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", statStr);
        JsonDoc::setStr(doc, "message", res->message);
        JsonDoc::setStr(doc, "activeVersion", cxvm->current());
        JsonDoc::setStr(doc, "defaultVersion", "v" + cxvm->defaultVersion);
        return this.json(doc);
    }

