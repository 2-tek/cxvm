    public apiRunnersStatus(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "SUCCESS");
        JsonDoc::setStr(doc, "engine", "CexRunners");
