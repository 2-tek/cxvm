    public apiStatus(req: HttpRequest*, port: int, builder: DistBuilder*, cxvm: CxvmEngine*): HttpResponse* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "ACTIVE");
        JsonDoc::setStr(doc, "service", "2-TEK Cex Factory");
        JsonDoc::setStr(doc, "framework", "Lighting MVC");
        JsonDoc::setNum(doc, "port", port);
        JsonDoc::setNum(doc, "totalPlatforms", (int)builder->platforms->length());
        JsonDoc::setNum(doc, "totalVersions", (int)builder->versions->length());
        JsonDoc::setNum(doc, "totalArtifacts", (int)builder->artifacts->length());
        JsonDoc::setStr(doc, "currentActiveVersion", cxvm->current());
        JsonDoc::setStr(doc, "crossPlatformSupport", "Linux (x86_64, aarch64), macOS (arm64, x86_64), Windows (x64, arm64)");
        return this.json(doc);
    }

    public apiVersions(req: HttpRequest*, versions: Array<VersionModel*>*): HttpResponse* {
        let count: int = (int)versions->length();
        let doc: JsonValue* = JsonDoc::obj();
        let arr: JsonValue* = JsonDoc::arr();
        for (let i: int = 0; i < count; i++) {
            JsonDoc::pushVal(arr, versions->get(i)->toJsonValue());
        }
        JsonDoc::setNum(doc, "total", count);
        JsonDoc::setVal(doc, "versions", arr);
        return this.json(doc);
    }

