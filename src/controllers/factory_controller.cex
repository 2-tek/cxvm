    public apiAppsRun(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let appName: string = req->getParam("app");
        if (appName.length() == 0) appName = req->getParam("appName");
        if (appName.length() == 0) appName = req->getParam("name");
        let subCmd: string = req->getParam("cmd");
        if (subCmd.length() == 0) subCmd = req->getParam("subCmd");
        let subArg: string = req->getParam("arg");
        if (subArg.length() == 0) subArg = req->getParam("subArg");
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            if (appName.length() == 0) appName = this.extractRawJsonStr(req->body, "app");
            if (appName.length() == 0) appName = this.extractRawJsonStr(req->body, "appName");
            if (appName.length() == 0) appName = this.extractRawJsonStr(req->body, "name");
            if (subCmd.length() == 0) subCmd = this.extractRawJsonStr(req->body, "cmd");
            if (subCmd.length() == 0) subCmd = this.extractRawJsonStr(req->body, "subCmd");
            if (subArg.length() == 0) subArg = this.extractRawJsonStr(req->body, "arg");
            if (subArg.length() == 0) subArg = this.extractRawJsonStr(req->body, "subArg");
        }
        if (appName.length() == 0) appName = cxvm->detectAppName(".");

        let res: CxvmCommandResult* = cxvm->runInstalledApp(appName, subCmd, subArg);
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", res->success ? "SUCCESS" : "ERROR");
        JsonDoc::setBool(doc, "success", res->success);
        JsonDoc::setStr(doc, "app", appName);
        JsonDoc::setStr(doc, "command", subCmd);
        JsonDoc::setStr(doc, "arguments", subArg);
        JsonDoc::setStr(doc, "message", res->message);
        JsonDoc::setStr(doc, "output", res->output);
        return this.json(doc);
    }
