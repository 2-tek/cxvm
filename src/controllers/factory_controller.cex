    }

    private int getFileTypeCode(string filename) {
        if (filename.find(".tar.gz") != -1) return 1;
        if (filename.find(".zip") != -1) return 2;
        if (filename.find(".sh") != -1 || filename === "cxvm") return 3;
        if (filename.find(".ps1") != -1) return 4;
        if (filename.find(".cmd") != -1 || filename.find(".bat") != -1) return 5;
        if (filename.find(".json") != -1) return 6;
        return 0;
    }

    public HttpResponse* downloadFile(HttpRequest* req, string downloadsDir) {
        let filename: string = req->getParam("id");
        if (filename.length() == 0 || filename.find("..") != -1) {
            return HttpResponse::badRequest("Invalid download artifact filename");
        }
        let fullPath: string = downloadsDir + "/" + filename;
        if (!fs.exists(fullPath)) {
            return HttpResponse::notFound("Artifact not found: " + filename);
        }
        let content: string = fs.readFile(fullPath);
        let cType: string = "application/octet-stream";
        let typeCode: int = this.getFileTypeCode(filename);
        switch (typeCode) {
            case 1:
            cType = "application/gzip";
            break;
            case 2:
            cType = "application/zip";
            break;
            case 3:
            cType = "text/x-shellscript";
            break;
            case 4:
            case 5:
            cType = "text/plain";
            break;
            case 6:
            cType = "application/json";
            break;
            default:
            cType = "application/octet-stream";
            break;
        }
        return HttpResponse::ok(content, cType);
    }

    public HttpResponse* serveSetupCex(HttpRequest* req, int port, string downloadsDir) {
        let filePath: string = downloadsDir + "/setup.cex";
        if (fs.exists(filePath)) {
            let content: string = fs.readFile(filePath);
            return HttpResponse::ok(content, "text/plain");
        }
        if (fs.exists("dist/setup.cex")) {
            let content: string = fs.readFile("dist/setup.cex");
            return HttpResponse::ok(content, "text/plain");
        }
        if (fs.exists("setup.cex")) {
            let content: string = fs.readFile("setup.cex");
            return HttpResponse::ok(content, "text/plain");
        }
        return HttpResponse::notFound("setup.cex not found");
    }

    public HttpResponse* serveSetupSh(HttpRequest* req, int port, string downloadsDir) {
        let filePath: string = downloadsDir + "/setup.sh";
        if (fs.exists(filePath)) {
            let content: string = fs.readFile(filePath);
            return HttpResponse::ok(content, "text/x-shellscript");
        }
        if (fs.exists("scripts/setup.sh")) {
            let content: string = fs.readFile("scripts/setup.sh");
            return HttpResponse::ok(content, "text/x-shellscript");
        }
        if (fs.exists("dist/setup.sh")) {
            let content: string = fs.readFile("dist/setup.sh");
            return HttpResponse::ok(content, "text/x-shellscript");
        }
        if (fs.exists("setup.sh")) {
            let content: string = fs.readFile("setup.sh");
            return HttpResponse::ok(content, "text/x-shellscript");
        }
        return HttpResponse::notFound("setup.sh not found");
    }

