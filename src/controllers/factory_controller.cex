    public HttpResponse* apiOpen(HttpRequest* req, CxvmEngine* cxvm) {
        let url: string = "http://localhost:3080/";
        let target: string = "browser";
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDocHelper::parse(req->body);
            if (parsed != nullptr) {
                if (parsed->has("url")) {
                    url = parsed->get("url")->asString();
                }
                if (parsed->has("target")) {
                    target = parsed->get("target")->asString();
                }
            }
        }
        let res: CxvmCommandResult* = cxvm->cxvmOpen(url, target);
        let doc: JsonValue* = JsonDocHelper::obj();
        JsonDocHelper::setStr(doc, "status", res->success ? "SUCCESS" : "ERROR");
        JsonDocHelper::setStr(doc, "target", target);
        JsonDocHelper::setStr(doc, "url", url);
        JsonDocHelper::setStr(doc, "engine", "cex-view");
        JsonDocHelper::setStr(doc, "message", res->message);
        return this.json(doc);
    }

    public HttpResponse* apiTarget(HttpRequest* req, CxvmEngine* cxvm) {
        let doc: JsonValue* = JsonDocHelper::obj();
        JsonDocHelper::setStr(doc, "defaultTarget", cxvm->defaultTarget);
        let arr: JsonValue* = JsonDocHelper::arr();
        JsonDocHelper::pushStr(arr, "view");
        JsonDocHelper::setVal(doc, "supportedTargets", arr);
        let engines: JsonValue* = JsonDocHelper::obj();
        JsonDocHelper::setStr(engines, "view", "cex-view (native desktop window engine, cex-view only)");
        JsonDocHelper::setVal(doc, "engines", engines);
        return this.json(doc);
    }

    public HttpResponse* apiReinstall(HttpRequest* req, CxvmEngine* cxvm) {
        let ver: string = "8.0.0";
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDocHelper::parse(req->body);
            if (parsed != nullptr && parsed->has("version")) {
                ver = parsed->get("version")->asString();
            }
        }
        let res: CxvmCommandResult* = cxvm->reinstall(ver);
        let doc: JsonValue* = JsonDocHelper::obj();
        JsonDocHelper::setStr(doc, "status", res->success ? "SUCCESS" : "ERROR");
        JsonDocHelper::setStr(doc, "command", "reinstall");
        JsonDocHelper::setStr(doc, "version", res->version);
        JsonDocHelper::setStr(doc, "activeVersion", cxvm->currentVersion);
        JsonDocHelper::setStr(doc, "message", res->message);
        JsonDocHelper::setStr(doc, "output", res->output);
        return this.json(doc);
    }
