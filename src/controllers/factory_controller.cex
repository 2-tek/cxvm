        let arr: JsonValue* = JsonDocHelper::arr();
        for (let i: int = 0; i < count; i++) {
            JsonDocHelper::pushVal(arr, platforms->get(i)->toJsonValue());
        }
        JsonDocHelper::setVal(doc, "platforms", arr);
        JsonDocHelper::setNum(doc, "total", count);
        return this.json(doc);
    }

    public HttpResponse* apiDownloads(HttpRequest* req, Array<ArtifactModel*>* artifacts) {
