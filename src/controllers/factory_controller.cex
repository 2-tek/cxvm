    public HttpResponse* apiThunderVirtualLinuxSetup(HttpRequest* req, CxvmEngine* cxvm) {
        let ver: string = "8.0.0";
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDocHelper::parse(req->body);
            if (parsed != nullptr && parsed->has("version")) {
                ver = parsed->get("version")->asString();
            }
        }
        let res: CxvmCommandResult* = cxvm->setupThunderVirtualLinux(ver);
        let doc: JsonValue* = JsonDocHelper::obj();
        JsonDocHelper::setStr(doc, "status", res->success ? "SUCCESS" : "ERROR");
        JsonDocHelper::setStr(doc, "environment", "virtual-linux");
        JsonDocHelper::setStr(doc, "engine", "ThunderEngine");
        JsonDocHelper::setBool(doc, "virtualLinuxReady", cxvm->virtualLinuxReady);
        JsonDocHelper::setStr(doc, "kernel", cxvm->virtualLinuxKernel);
        JsonDocHelper::setStr(doc, "platform", "linux-x86_64");
        JsonDocHelper::setStr(doc, "cxvmDir", cxvm->virtualLinuxRootfs);
        JsonDocHelper::setStr(doc, "containerId", cxvm->virtualLinuxContainerId);
        JsonDocHelper::setStr(doc, "network", "thunder-net (" + cxvm->virtualLinuxIp + ")");
        JsonDocHelper::setStr(doc, "rootfs", "overlayfs");
        JsonDocHelper::setStr(doc, "cgroups", "v2");
        JsonDocHelper::setStr(doc, "activeVersion", cxvm->current());
        JsonDocHelper::setStr(doc, "defaultVersion", "v" + cxvm->defaultVersion);
        JsonDocHelper::setStr(doc, "defaultCexrRuntime", "cexr-factory");
        JsonDocHelper::setStr(doc, "defaultCexrBuild", "cexr-bean");
        JsonDocHelper::setStr(doc, "message", res->message);
        return this.json(doc);
    }

