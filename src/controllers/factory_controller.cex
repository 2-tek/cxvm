    public apiUpgrade(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let deps: string = "";
        let doRebuild: bool = false;
        let qPos: int = (req->path.find("cex-boxes=") != -1) ? 1 : ((req->path.find("boxes=") != -1) ? 2 : ((req->path.find("dependencies=") != -1) ? 3 : ((req->path.find("deps=") != -1) ? 4 : 0)));
        switch (qPos) {
            case 1: {
                let dPos: int = (int)req->path.find("cex-boxes=");
                deps = req->path.substr(dPos + 10);
                break;
            }
            case 2: {
                let dPos: int = (int)req->path.find("boxes=");
                deps = req->path.substr(dPos + 6);
                break;
            }
            case 3: {
                let dPos: int = (int)req->path.find("dependencies=");
                deps = req->path.substr(dPos + 13);
                break;
            }
            case 4: {
                let dPos: int = (int)req->path.find("deps=");
                deps = req->path.substr(dPos + 5);
                break;
            }
            default:
            break;
        }
        if (deps.length() > 0) {
            let ampPos: int = (int)deps.find("&");
            if (ampPos != -1) deps = deps.substr(0, ampPos);
        }
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDoc::parse(req->body);
            if (parsed != nullptr) {
                let depKeyCode: int = parsed->has("cex-boxes") ? 1 : (parsed->has("boxes") ? 2 : (parsed->has("dependencies") ? 3 : (parsed->has("deps") ? 4 : 0)));
                switch (depKeyCode) {
                    case 1:
                    deps = parsed->get("cex-boxes")->asString();
                    break;
                    case 2:
                    deps = parsed->get("boxes")->asString();
                    break;
                    case 3:
                    deps = parsed->get("dependencies")->asString();
                    break;
                    case 4:
                    deps = parsed->get("deps")->asString();
                    break;
                    default:
                    break;
                }
                if (parsed->has("rebuild")) {
                    doRebuild = parsed->get("rebuild")->asBool();
                }
            }
        }
        if (deps.length() > 0 || req->path.find("--cex-boxes") != -1 || req->path.find("--boxes") != -1 || req->path.find("--dependencies") != -1 || req->path.find("--deps") != -1) {
            let res: CxvmCommandResult* = cxvm->upgradeDependencies(deps, doRebuild);
            let doc: JsonValue* = JsonDoc::obj();
            JsonDoc::setBool(doc, "success", res->success);
            JsonDoc::setStr(doc, "cex-boxes", deps);
            JsonDoc::setStr(doc, "dependencies", deps);
            JsonDoc::setStr(doc, "message", res->message);
            JsonDoc::setStr(doc, "output", res->output);
            return this.json(doc);
        }
        let res: CxvmCommandResult* = cxvm->upgrade("latest");
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setBool(doc, "success", res->success);
        JsonDoc::setStr(doc, "version", res->version);
        JsonDoc::setStr(doc, "message", res->message);
        JsonDoc::setStr(doc, "output", res->output);
        return this.json(doc);
    }

    public apiPullDependencies(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let isUpgrade: bool = false;
        let isClean: bool = false;
        let pkg: string = "";

        if (req->path.find("upgrade=true") != -1 || req->path.find("upgrade=1") != -1) {
            isUpgrade = true;
        }
        if (req->path.find("clean=true") != -1 || req->path.find("clean=1") != -1) {
            isClean = true;
        }
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDoc::parse(req->body);
            if (parsed != nullptr) {
                if (parsed->has("upgrade")) {
                    isUpgrade = parsed->get("upgrade")->asBool();
                }
                if (parsed->has("clean")) {
                    isClean = parsed->get("clean")->asBool();
                }
                if (parsed->has("package")) {
                    pkg = parsed->get("package")->asString();
                }
            }
        }

        let res: CxvmCommandResult* = cxvm->pullDependencies("cex-pack.json", isUpgrade, isClean, pkg);
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "SUCCESS");
        JsonDoc::setBool(doc, "success", res->success);
        JsonDoc::setStr(doc, "cacheDir", cxvm->getDependenciesDir());
        JsonDoc::setBool(doc, "upgrade", isUpgrade);
        JsonDoc::setBool(doc, "clean", isClean);
        JsonDoc::setStr(doc, "message", res->message);
        JsonDoc::setStr(doc, "output", res->output);
        return this.json(doc);
    }

    public serveInstallSh(req: HttpRequest*, port: int, downloadsDir: string): HttpResponse* {
        let filePath: string = downloadsDir + "/install.sh";
        if (fs.exists(filePath)) {
            let content: string = fs.readFile(filePath);
            return HttpResponse::ok(content, "text/x-shellscript");
        }
        let pStr: string = to_string(port);
        let script: string = "#!/usr/bin/env bash\n";
        script += "# 2-TEK Cex Factory: Cross-Platform Quick Installer\n";
        script += "set -e\n";
        script += "CXVM_DIR=\"${CXVM_DIR:-$HOME/.cxvm}\"\n";
        script += "FACTORY_URL=\"${CEX_FACTORY_URL:-https://raw.githubusercontent.com/2-tek/cxvm/main}\"\n";
        script += "DEFAULT_VER=\"8.0.0\"\n";
        script += "echo \"==> Bootstrapping cxvm from $FACTORY_URL...\"\n";
        script += "mkdir -p \"$CXVM_DIR/bin\" \"$CXVM_DIR/versions\" \"$CXVM_DIR/cache\"\n";
        script += "curl -fsSL \"$FACTORY_URL/downloads/cxvm\" -o \"$CXVM_DIR/bin/cxvm\" 2>/dev/null || true\n";
        script += "chmod +x \"$CXVM_DIR/bin/cxvm\" 2>/dev/null || true\n";
        script += "if [ -f \"$CXVM_DIR/bin/cxvm\" ]; then\n";
        script += "  source \"$CXVM_DIR/bin/cxvm\"\n";
        script += "  cxvm install \"$DEFAULT_VER\"\n";
        script += "  cxvm use \"$DEFAULT_VER\"\n";
        script += "fi\n";
        script += "echo \"[OK] Cex Toolchain setup complete! Run 'cxvm --help'\"\n";
        return HttpResponse::ok(script, "text/x-shellscript");
    }

    public serveInstallPs1(req: HttpRequest*, port: int, downloadsDir: string): HttpResponse* {
        let filePath: string = downloadsDir + "/install.ps1";
        if (fs.exists(filePath)) {
            let content: string = fs.readFile(filePath);
            return HttpResponse::ok(content, "text/plain");
        }
        let pStr: string = to_string(port);
        let script: string = "# 2-TEK Cex Factory: Windows PowerShell Quick Installer\n";
        script += "$ErrorActionPreference = \"Stop\"\n";
        script += "$cxvmDir = Join-Path $HOME \".cxvm\"\n";
        script += "$factoryUrl = if ($env:CEX_FACTORY_URL) { $env:CEX_FACTORY_URL } else { \"https://raw.githubusercontent.com/2-tek/cxvm/main\" }\n";
        script += "$defaultVersion = \"8.0.0\"\n";
        script += "Write-Host \"==> Installing Cex cxvm toolchain...\" -ForegroundColor Cyan\n";
        script += "New-Item -ItemType Directory -Force -Path (Join-Path $cxvmDir \"bin\") | Out-Null\n";
        script += "New-Item -ItemType Directory -Force -Path (Join-Path $cxvmDir \"versions\") | Out-Null\n";
        script += "Write-Host \"[OK] Cex Toolchain setup complete!\" -ForegroundColor Green\n";
        return HttpResponse::ok(script, "text/plain");
    }

