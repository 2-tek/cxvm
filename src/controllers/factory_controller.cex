    public HttpResponse* apiLinuxDistroInstall(HttpRequest* req, CxvmEngine* cxvm) {
        let name: string = "cex-linux";
        let ver: string = "1.0.0";
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDocHelper::parse(req->body);
            if (parsed != nullptr && parsed->has("name")) {
                name = parsed->get("name")->asString();
            }
            if (parsed != nullptr && parsed->has("version")) {
                ver = parsed->get("version")->asString();
            }
        }
        let res: CxvmCommandResult* = cxvm->installLinuxDistro(name, ver);
        let doc: JsonValue* = JsonDocHelper::obj();
        JsonDocHelper::setStr(doc, "status", res->success ? "SUCCESS" : "ERROR");
        JsonDocHelper::setStr(doc, "command", "install");
        JsonDocHelper::setStr(doc, "distro", cxvm->linuxDistroName);
        JsonDocHelper::setStr(doc, "version", cxvm->linuxDistroVersion);
        JsonDocHelper::setStr(doc, "kernel", cxvm->linuxDistroKernel);
        JsonDocHelper::setStr(doc, "rootfs", cxvm->linuxDistroRootfs);
        JsonDocHelper::setStr(doc, "distroStatus", cxvm->linuxDistroStatus);
        JsonDocHelper::setBool(doc, "distroReady", cxvm->linuxDistroReady);
        JsonDocHelper::setStr(doc, "message", res->message);
        return this.json(doc);
    }

