    public HttpResponse* apiSetupGet(HttpRequest* req, CxvmEngine* cxvm) {
        let doc: JsonValue* = JsonDocHelper::obj();
        JsonDocHelper::setStr(doc, "status", "ACTIVE");
        JsonDocHelper::setStr(doc, "cxvmHome", cxvm->cxvmHome);
        JsonDocHelper::setStr(doc, "currentActive", cxvm->current());
        JsonDocHelper::setStr(doc, "defaultVersion", "v" + cxvm->defaultVersion);
        JsonDocHelper::setStr(doc, "defaultCexrRuntime", "cexr-factory");
        JsonDocHelper::setStr(doc, "defaultCexrBuild", "cexr-bean");
        JsonDocHelper::setStr(doc, "cexrVersionCommand", "cexr -v");

        let arr: JsonValue* = JsonDocHelper::arr();
        let count: int = (int)cxvm->installedVersions->length();
        for (let i: int = 0; i < count; i++) {
            JsonDocHelper::pushStr(arr, "v" + cxvm->installedVersions->get(i));
        }
        JsonDocHelper::setVal(doc, "installedVersions", arr);

        let disp: JsonValue* = JsonDocHelper::obj();
        JsonDocHelper::setStr(disp, "cexr", "./bin/cexr (v8 default: cexr-factory for run, cexr-bean for build)");
        JsonDocHelper::setStr(disp, "cex", "./bin/cex");
        JsonDocHelper::setStr(disp, "cexrFactory", "./bin/cexr-factory");
        JsonDocHelper::setStr(disp, "cexrBean", "./bin/cexr-bean");
        JsonDocHelper::setStr(disp, "cexrDelivery", "./bin/cexr-delivery");
        JsonDocHelper::setStr(disp, "cexrDrawer", "./bin/cexr-drawer");
        JsonDocHelper::setVal(doc, "dispatchers", disp);

        JsonDocHelper::setStr(doc, "toolchain", "Pure Cex Native Engine (zero C++ dependency; powered by cexr + cexp)");
        return this.json(doc);
    }

