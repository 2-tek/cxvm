    public apiSetupGet(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "ACTIVE");
        JsonDoc::setStr(doc, "cxvmHome", cxvm->cxvmHome);
        JsonDoc::setStr(doc, "currentActive", cxvm->current());
        JsonDoc::setStr(doc, "defaultVersion", "v" + cxvm->defaultVersion);

        let arr: JsonValue* = JsonDoc::arr();
        let count: int = (int)cxvm->installedVersions->length();
        for (let i: int = 0; i < count; i++) {
            JsonDoc::pushStr(arr, "v" + cxvm->installedVersions->get(i));
        }
        JsonDoc::setVal(doc, "installedVersions", arr);

        let disp: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(disp, "cexr", "./bin/cexr (v8 default, v6 supported)");
        JsonDoc::setStr(disp, "cex", "./bin/cex");
        JsonDoc::setVal(doc, "dispatchers", disp);

        JsonDoc::setStr(doc, "toolchain", "Pure Cex Native Engine (zero C++ dependency; powered by cexr + cexp)");
        return this.json(doc);
    }

