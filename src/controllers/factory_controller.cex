    public apiMultiStart(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let services: string = req->getParam("services");
        let isDaemon: bool = true;
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDoc::parse(req->body);
            if (parsed != nullptr) {
                if (parsed->has("services")) services = parsed->get("services")->asString();
                if (parsed->has("daemon")) isDaemon = parsed->get("daemon")->asBool();
            }
        }
        let res: CxvmCommandResult* = cxvm->multiStart(services, isDaemon);
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", res->success ? "SUCCESS" : "ERROR");
        JsonDoc::setStr(doc, "services", services);
        JsonDoc::setBool(doc, "daemon", isDaemon);
        JsonDoc::setStr(doc, "message", res->message);
        JsonDoc::setStr(doc, "output", res->output);
        return this.json(doc);
    }

    public apiProcessList(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", "SUCCESS");
        JsonDoc::setNum(doc, "count", (int)cxvm->processes->length());
        let listArr: JsonValue* = JsonDoc::arr();
        for (let i: int = 0; i < (int)cxvm->processes->length(); i++) {
            let p: ProcessRecord* = cxvm->processes->get(i);
            let item: JsonValue* = JsonDoc::obj();
            JsonDoc::setStr(item, "name", p->name);
            JsonDoc::setNum(item, "pid", p->pid);
            JsonDoc::setStr(item, "status", p->status);
            JsonDoc::setNum(item, "port", p->port);
            JsonDoc::setBool(item, "isDaemon", p->isDaemon);
            JsonDoc::setStr(item, "command", p->command);
            listArr->push(item);
        }
        JsonDoc::setVal(doc, "processes", listArr);
        return this.json(doc);
    }

    public apiProcessStart(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let name: string = req->getParam("name");
        let cmd: string = req->getParam("command");
        let isDaemon: bool = true;
        if (req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDoc::parse(req->body);
            if (parsed != nullptr) {
                if (parsed->has("name")) name = parsed->get("name")->asString();
                if (parsed->has("command")) cmd = parsed->get("command")->asString();
                if (parsed->has("daemon")) isDaemon = parsed->get("daemon")->asBool();
            }
        }
        let res: CxvmCommandResult* = cxvm->startProcess(name, cmd, 0, isDaemon);
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", res->success ? "SUCCESS" : "ERROR");
        JsonDoc::setStr(doc, "name", name);
        JsonDoc::setStr(doc, "message", res->message);
        return this.json(doc);
    }

    public apiProcessStop(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let name: string = req->getParam("name");
        if (name.length() == 0 && req->body.length() > 0 && req->body.find("{") != -1) {
            let parsed: JsonValue* = JsonDoc::parse(req->body);
            if (parsed != nullptr && parsed->has("name")) {
                name = parsed->get("name")->asString();
