    public HttpResponse* apiLinuxDistroList(HttpRequest* req, CxvmEngine* cxvm) {
        let doc: JsonValue* = JsonDocHelper::obj();
        JsonDocHelper::setStr(doc, "status", "SUCCESS");
        let arr: JsonValue* = JsonDocHelper::arr();
        for (let i: int = 0; i < (int)cxvm->supportedDistros->length(); i++) {
            JsonDocHelper::pushStr(arr, cxvm->supportedDistros->get(i));
        }
        JsonDocHelper::setVal(doc, "supported", arr);
        let instArr: JsonValue* = JsonDocHelper::arr();
        for (let i: int = 0; i < (int)cxvm->installedDistros->length(); i++) {
            JsonDocHelper::pushStr(instArr, cxvm->installedDistros->get(i));
        }
        JsonDocHelper::setVal(doc, "installed", instArr);
        return this.json(doc);
    }

