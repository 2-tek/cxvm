    public apiThunderLinuxSim(req: HttpRequest*, cxvm: CxvmEngine*): HttpResponse* {
        let instanceName: string = req->getParam("instance");
        if (instanceName.length() == 0) instanceName = req->getParam("instanceName");
        let projectName: string = req->getParam("project");
        if (projectName.length() == 0) projectName = req->getParam("projectName");

        if (req->body.length() > 0 && req->body.find("{") != -1) {
            if (instanceName.length() == 0) instanceName = this.extractRawJsonStr(req->body, "instance");
            if (instanceName.length() == 0) instanceName = this.extractRawJsonStr(req->body, "instanceName");
            if (projectName.length() == 0) projectName = this.extractRawJsonStr(req->body, "project");
            if (projectName.length() == 0) projectName = this.extractRawJsonStr(req->body, "projectName");
        }
        if (instanceName.length() == 0) instanceName = "thunder-linux-sim";
        if (projectName.length() == 0) projectName = "example-linux-app";

        let res: CxvmCommandResult* = cxvm->simulateLinuxInThunder(instanceName, projectName);
        let simRoot: string = cxvm->getThunderLinuxSimRoot(instanceName);
        let doc: JsonValue* = JsonDoc::obj();
        JsonDoc::setStr(doc, "status", res->success ? "SUCCESS" : "ERROR");
        JsonDoc::setBool(doc, "success", res->success);
        JsonDoc::setStr(doc, "engine", "ThunderEngine");
        JsonDoc::setStr(doc, "instanceId", "cxt-linux-sim");
        JsonDoc::setStr(doc, "instanceName", instanceName);
        JsonDoc::setStr(doc, "projectName", projectName);
        JsonDoc::setStr(doc, "kernel", "6.8.0-cex-thunder-virt");
        JsonDoc::setStr(doc, "platform", "linux-x86_64");
        JsonDoc::setStr(doc, "rootfs", simRoot);
        JsonDoc::setStr(doc, "cxvmBinary", simRoot + "/root/.cxvm/bin/cxvm");
        JsonDoc::setStr(doc, "exampleBinary", simRoot + "/app/" + projectName + "/bin/" + projectName);
        JsonDoc::setStr(doc, "message", res->message);
        JsonDoc::setStr(doc, "output", res->output);
        return this.json(doc);
    }

