import json from "json";

using JsonValue = cex::json_lib::Value;

class Json {
    public JsonValue* inner = nullptr;

    public constructor() {
        this.inner = new JsonValue();
        this.inner->type = cex::json_lib::JsonType::Object;
    }

    public constructor(JsonValue* val) {
        this.inner = val != nullptr ? val : new JsonValue();
    }

    static public JsonValue* obj() {
        JsonValue* v = new JsonValue();
        v->type = cex::json_lib::JsonType::Object;
        return v;
    }

    static public JsonValue* arr() {
        JsonValue* v = new JsonValue();
        v->type = cex::json_lib::JsonType::Array;
        return v;
    }

    static public JsonValue* nullVal() {
        return new JsonValue(nullptr);
    }

    static public JsonValue* str(string s) {
        return new JsonValue(s);
    }

    static public JsonValue* num(double n) {
        return new JsonValue(n);
    }

    static public JsonValue* integer(int n) {
        return new JsonValue(n);
    }

    static public JsonValue* boolean(bool b) {
        return new JsonValue(b);
    }

    static public string stringify(JsonValue* v) {
        if (v == nullptr) return "null";
        return JSON::stringify(v);
    }

    static public string stringify(JsonValue* v, int indent) {
        if (v == nullptr) return "null";
        return JSON::stringify(v, indent);
    }

    static public string stringify(Json* j) {
        if (j == nullptr || j->inner == nullptr) return "null";
        return JSON::stringify(j->inner);
    }

    static public string pretty(JsonValue* v) {
        if (v == nullptr) return "null";
        return JSON::stringify(v, 2);
    }

    static public JsonValue* parse(string raw) {
        try {
            return (JsonValue*)JSON::parse(raw);
        } catch (const Error& error) {
            return nullptr;
        }
    }

    static public JsonValue* set(JsonValue* obj, string key, JsonValue* val) {
        if (obj != nullptr) obj->set(key, val);
        return obj;
    }

    static public JsonValue* setString(JsonValue* obj, string key, string val) {
        if (obj != nullptr) obj->set(key, new JsonValue(val));
        return obj;
    }

    static public JsonValue* setInt(JsonValue* obj, string key, int val) {
        if (obj != nullptr) obj->set(key, new JsonValue(val));
        return obj;
    }

    static public JsonValue* setBool(JsonValue* obj, string key, bool val) {
        if (obj != nullptr) obj->set(key, new JsonValue(val));
        return obj;
    }

    static public JsonValue* setDouble(JsonValue* obj, string key, double val) {
        if (obj != nullptr) obj->set(key, new JsonValue(val));
        return obj;
    }

    static public JsonValue* push(JsonValue* arr, JsonValue* val) {
        if (arr != nullptr) arr->push(val);
        return arr;
    }

    static public JsonValue* pushString(JsonValue* arr, string val) {
        if (arr != nullptr) arr->push(new JsonValue(val));
        return arr;
    }

    static public string getString(JsonValue* v, string key, string defVal) {
        if (v == nullptr || !v->has(key)) return defVal;
        JsonValue* item = (JsonValue*)v->get(key);
        return item != nullptr ? item->asString(defVal) : defVal;
    }

    static public int getInt(JsonValue* v, string key, int defVal) {
        if (v == nullptr || !v->has(key)) return defVal;
        JsonValue* item = (JsonValue*)v->get(key);
        return item != nullptr ? item->asInt(defVal) : defVal;
    }

    static public bool getBool(JsonValue* v, string key, bool defVal) {
        if (v == nullptr || !v->has(key)) return defVal;
        JsonValue* item = (JsonValue*)v->get(key);
        return item != nullptr ? item->asBool(defVal) : defVal;
    }

    public Json* setString(string key, string val) {
        if (this.inner != nullptr) this.inner->set(key, new JsonValue(val));
        return this;
    }

    public Json* setInt(string key, int val) {
        if (this.inner != nullptr) this.inner->set(key, new JsonValue(val));
        return this;
    }

    public Json* setBool(string key, bool val) {
        if (this.inner != nullptr) this.inner->set(key, new JsonValue(val));
        return this;
    }

    public string getString(string key, string defVal = "") {
        if (this.inner == nullptr) return defVal;
        JsonValue* it = (JsonValue*)this.inner->get(key);
        return it != nullptr ? it->asString(defVal) : defVal;
    }

    public int getInt(string key, int defVal = 0) {
        if (this.inner == nullptr) return defVal;
        JsonValue* it = (JsonValue*)this.inner->get(key);
        return it != nullptr ? it->asInt(defVal) : defVal;
    }

    public bool getBool(string key, bool defVal = false) {
        if (this.inner == nullptr) return defVal;
        JsonValue* it = (JsonValue*)this.inner->get(key);
        return it != nullptr ? it->asBool(defVal) : defVal;
    }

    public string stringify() {
        return Json::stringify(this);
    }
}
