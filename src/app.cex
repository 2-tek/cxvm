// 2-TEK Factory: Application Kernel & Lighting MVC Dispatcher (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "@/src/lighting_mvc.cex";
import "@/src/types.cex";
import "@/src/models/platform_model.cex";
import "@/src/models/version_model.cex";
import "@/src/models/artifact_model.cex";
import "@/src/builder/dist_builder.cex";
import "@/src/cxvm/cxvm_engine.cex";
import "@/src/controllers/factory_controller.cex";

class FactoryApp {
    public appName: string;
    public port: int;
    public isRunning: bool;
    public downloadsDir: string;
    public router: LightingRouter*;
    public controller: FactoryController*;
    public builder: DistBuilder*;
    public cxvm: CxvmEngine*;

    public constructor(port: int) {
        this.appName = "2-TEK cxvm Engine";
        this.port = port;
        this.isRunning = false;
        this.downloadsDir = fs.exists("dist") ? "dist" : (fs.exists("cxvm/downloads") ? "cxvm/downloads" : (fs.exists("packages/cxvm/downloads") ? "packages/cxvm/downloads" : (fs.exists("downloads") ? "downloads" : "dist")));

        this.router = new LightingRouter();
        this.controller = new FactoryController();
        this.builder = new DistBuilder(this.downloadsDir);
        this.cxvm = new CxvmEngine();

        // Initialize default runtime with CexR v8 (.cex_boxes Dist Loader Engine)
        this.cxvm->install("8.0.0");
        this.cxvm->use("8.0.0");
        this.cxvm->setDefault("8.0.0");

        this.setupRoutes();
    }

    private setupRoutes(): void {
        // SSR HTML Routes
        this.router->get("/", "factory.index");
        this.router->get("/downloads", "factory.downloads");
        this.router->get("/cxvm", "factory.cxvmDocs");
        this.router->get("/setup", "factory.setup");

        // Shell & PowerShell Installers & Cross-Platform Downloads
        this.router->get("/install.sh", "factory.installSh");
        this.router->get("/install.ps1", "factory.installPs1");
        this.router->get("/setup.sh", "factory.setupSh");
        this.router->get("/setup.ps1", "factory.setupPs1");
        this.router->get("/cxvm.sh", "factory.cxvmScript");
        this.router->get("/cxvm.ps1", "factory.cxvmPs1");
        this.router->get("/cxvm.cmd", "factory.cxvmCmd");
        this.router->get("/downloads/:id", "factory.downloadFile");

        // REST JSON API Routes
        this.router->get("/api/v1/status", "factory.status");
        this.router->get("/api/v1/versions", "factory.versions");
        this.router->get("/api/v1/platforms", "factory.platforms");
        this.router->get("/api/v1/downloads", "factory.downloadsApi");
        this.router->get("/api/v1/manifest", "factory.manifest");
        this.router->get("/api/v1/setup", "factory.apiSetupGet");
        this.router->post("/api/v1/setup", "factory.apiSetupPost");
        this.router->post("/api/v1/build", "factory.build");
        this.router->get("/api/v1/cvm/status", "factory.apiCvmStatus");
        this.router->post("/api/v1/cvm/commit", "factory.apiCvmCommit");
        this.router->post("/api/v1/cvm/push", "factory.apiCvmPush");
        this.router->post("/api/v1/cvm/server/start", "factory.apiCvmServerStart");
        this.router->get("/api/v1/cvm/server/status", "factory.apiCvmServerStatus");
        this.router->post("/api/v1/cvm/server/stop", "factory.apiCvmServerStop");
        this.router->post("/api/v1/server/start", "factory.apiServerStart");
        this.router->get("/api/v1/server/status", "factory.apiServerStatus");
        this.router->post("/api/v1/server/stop", "factory.apiServerStop");
        this.router->get("/api/v1/thunder/status", "factory.apiThunderStatus");
        this.router->post("/api/v1/thunder/server/start", "factory.apiThunderServerStart");
        this.router->get("/api/v1/thunder/server/status", "factory.apiThunderServerStatus");
        this.router->post("/api/v1/thunder/server/stop", "factory.apiThunderServerStop");
        this.router->get("/api/v1/thunder/containers", "factory.apiThunderContainers");
        this.router->get("/api/v1/thunder/images", "factory.apiThunderImages");
        this.router->get("/api/v1/light/status", "factory.apiLightStatus");
        this.router->post("/api/v1/light/create", "factory.apiLightCreate");
        this.router->get("/api/v1/upgrade", "factory.apiUpgrade");
        this.router->post("/api/v1/upgrade", "factory.apiUpgrade");
        this.router->get("/api/v1/dependencies/pull", "factory.apiPullDependencies");
        this.router->post("/api/v1/dependencies/pull", "factory.apiPullDependencies");
        this.router->get("/api/v1/hooks/scan", "factory.apiHooksScan");
        this.router->post("/api/v1/hooks/install", "factory.apiHooksInstall");

        // CexRunners & Multi Orchestration
        this.router->get("/api/v1/runners/status", "factory.apiRunnersStatus");
        this.router->get("/api/v1/runners/metrics", "factory.apiRunnersMetrics");
        this.router->post("/api/v1/runners/dispatch", "factory.apiRunnersDispatch");
        this.router->post("/api/v1/multi/build", "factory.apiMultiBuild");
        this.router->post("/api/v1/multi/start", "factory.apiMultiStart");

        // Process Supervisor
        this.router->get("/api/v1/process/list", "factory.apiProcessList");
        this.router->post("/api/v1/process/start", "factory.apiProcessStart");
        this.router->post("/api/v1/process/stop", "factory.apiProcessStop");
        this.router->get("/api/v1/process/status", "factory.apiProcessStatus");

        // CexRacer Multi-Queue & Scheduler
        this.router->get("/api/v1/racer/status", "factory.apiRacerStatus");
        this.router->get("/api/v1/racer/queues", "factory.apiRacerQueues");
        this.router->get("/api/v1/racer/tasks", "factory.apiRacerTasks");
        this.router->post("/api/v1/racer/schedule", "factory.apiRacerSchedule");
        this.router->post("/api/v1/racer/run", "factory.apiRacerRun");
    }

    public start(): void {
        this.isRunning = true;
    }

    public stop(): void {
        this.isRunning = false;
    }

    public handleRequest(req: HttpRequest*): HttpResponse* {
        // 1. Logger Middleware
        LightingMiddleware::runLogger(req);

        // 2. Auth Middleware
        let authRes: MiddlewareResult* = LightingMiddleware::runAuth(req);
        if (!authRes->proceed) {
            return authRes->errorResponse;
        }

        // 3. Router Matching
        let route: RouteEntry* = this.router->findRoute(req);
        if (route === nullptr) {
            return HttpResponse::notFound("No Factory route matched for: " + req->method + " " + req->path);
        }

        // 4. Controller Dispatch
        if (route->handlerId === "factory.index") {
            return this.controller->index(req, this.port, this.builder->versions, this.builder->platforms, this.builder->artifacts, this.cxvm->current());
        }

        if (route->handlerId === "factory.downloads") {
            return this.controller->downloadsHtml(req, this.port, this.builder->artifacts);
        }

        if (route->handlerId === "factory.cxvmDocs") {
            return this.controller->cxvmDocs(req, this.port);
        }

        if (route->handlerId === "factory.setup") {
            return this.controller->setupHtml(req, this.port, this.cxvm);
        }

        if (route->handlerId === "factory.installSh") {
            return this.controller->serveInstallSh(req, this.port, this.downloadsDir);
        }

        if (route->handlerId === "factory.installPs1") {
            return this.controller->serveInstallPs1(req, this.port, this.downloadsDir);
        }

        if (route->handlerId === "factory.setupSh") {
            return this.controller->serveSetupSh(req, this.port, this.downloadsDir);
        }

        if (route->handlerId === "factory.setupPs1") {
            return this.controller->serveSetupPs1(req, this.port, this.downloadsDir);
        }

        if (route->handlerId === "factory.cxvmScript") {
            return this.controller->serveCxvm(req, this.downloadsDir);
        }

        if (route->handlerId === "factory.cxvmPs1") {
            return this.controller->serveCxvmPs1(req, this.downloadsDir);
        }

        if (route->handlerId === "factory.cxvmCmd") {
            return this.controller->serveCxvmCmd(req, this.downloadsDir);
        }

        if (route->handlerId === "factory.downloadFile") {
            return this.controller->downloadFile(req, this.downloadsDir);
        }

        if (route->handlerId === "factory.status") {
            return this.controller->apiStatus(req, this.port, this.builder, this.cxvm);
        }

        if (route->handlerId === "factory.versions") {
            return this.controller->apiVersions(req, this.builder->versions);
        }

        if (route->handlerId === "factory.platforms") {
            return this.controller->apiPlatforms(req, this.builder->platforms);
        }

        if (route->handlerId === "factory.downloadsApi") {
            return this.controller->apiDownloads(req, this.builder->artifacts);
        }

        if (route->handlerId === "factory.manifest") {
            return this.controller->apiManifest(req, this.builder);
        }

        if (route->handlerId === "factory.apiSetupGet") {
            return this.controller->apiSetupGet(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiSetupPost") {
            return this.controller->apiSetupPost(req, this.cxvm);
        }

        if (route->handlerId === "factory.build") {
            return this.controller->apiBuild(req, this.builder);
        }

        if (route->handlerId === "factory.apiUpgrade") {
            return this.controller->apiUpgrade(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiPullDependencies") {
            return this.controller->apiPullDependencies(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiCvmStatus") {
            return this.controller->apiCvmStatus(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiCvmCommit") {
            return this.controller->apiCvmCommit(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiCvmPush") {
            return this.controller->apiCvmPush(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiCvmServerStart") {
            return this.controller->apiCvmServerStart(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiCvmServerStatus") {
            return this.controller->apiCvmServerStatus(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiCvmServerStop") {
            return this.controller->apiCvmServerStop(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiServerStart") {
            return this.controller->apiServerStart(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiServerStatus") {
            return this.controller->apiServerStatus(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiServerStop") {
            return this.controller->apiServerStop(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiThunderStatus") {
            return this.controller->apiThunderStatus(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiThunderServerStart") {
            return this.controller->apiThunderServerStart(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiThunderServerStatus") {
            return this.controller->apiThunderServerStatus(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiThunderServerStop") {
            return this.controller->apiThunderServerStop(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiThunderContainers") {
            return this.controller->apiThunderContainers(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiThunderImages") {
            return this.controller->apiThunderImages(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiLightStatus") {
            return this.controller->apiLightStatus(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiLightCreate") {
            return this.controller->apiLightCreate(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiHooksScan") {
            return this.controller->apiHooksScan(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiHooksInstall") {
            return this.controller->apiHooksInstall(req, this.cxvm);
        }

        // CexRunners & Multi Orchestration
        if (route->handlerId === "factory.apiRunnersStatus") {
            return this.controller->apiRunnersStatus(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiRunnersMetrics") {
            return this.controller->apiRunnersMetrics(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiRunnersDispatch") {
            return this.controller->apiRunnersDispatch(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiMultiBuild") {
            return this.controller->apiMultiBuild(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiMultiStart") {
            return this.controller->apiMultiStart(req, this.cxvm);
        }

        // Process Supervisor
        if (route->handlerId === "factory.apiProcessList") {
            return this.controller->apiProcessList(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiProcessStart") {
            return this.controller->apiProcessStart(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiProcessStop") {
            return this.controller->apiProcessStop(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiProcessStatus") {
            return this.controller->apiProcessStatus(req, this.cxvm);
        }

        // CexRacer Multi-Queue & Scheduler
        if (route->handlerId === "factory.apiRacerStatus") {
            return this.controller->apiRacerStatus(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiRacerQueues") {
            return this.controller->apiRacerQueues(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiRacerTasks") {
            return this.controller->apiRacerTasks(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiRacerSchedule") {
            return this.controller->apiRacerSchedule(req, this.cxvm);
        }

        if (route->handlerId === "factory.apiRacerRun") {
            return this.controller->apiRacerRun(req, this.cxvm);
        }

        return HttpResponse::notFound("Handler not implemented: " + route->handlerId);
    }

    public simulateRequest(method: string, path: string, body: string, cType: string): HttpResponse* {
        let req: HttpRequest* = new HttpRequest(method, path, body, cType);
        return this.handleRequest(req);
    }

    public displayRoutes(): void {
        println("+---------------------------------------------------------------+");
        println("|             2-TEK Cex Factory Route Registry Table            |");
        println("+---------------------------------------------------------------+");
        println("  METHOD  ROUTE PATTERN               HANDLER ACTION");
        println("  -------------------------------------------------------------");
        let count: int = this.router->getRouteCount();
        for (let i: int = 0; i < count; i++) {
            let r: RouteEntry* = this.router->routes->get(i);
            print("  "); print(r->method);
            for (let s: int = (int)r->method.length(); s < 8; s++) print(" ");
            print(r->pattern);
            for (let s: int = (int)r->pattern.length(); s < 28; s++) print(" ");
            println(r->handlerId);
        }
        println("-----------------------------------------------------------------");
    }
}
