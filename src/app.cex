// 2-TEK Factory: Application Kernel & Lighting MVC Dispatcher (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "./lighting_mvc.cex";
import "./types.cex";
import "./models/platform_model.cex";
import "./models/version_model.cex";
import "./models/artifact_model.cex";
import "./dist_builder.cex";
import "./cxvm_engine.cex";
import "./controllers/factory_controller.cex";
import "@cex-cli/src/terminal.cex";
import "@cex-cli/src/cli.cex";
import "@cex-service/src/app.cex";
import "@cex-service/src/middleware.cex";
import "@cex-service/src/response.cex";
import "@cex-service/src/request.cex";
import "@cex-service/src/ssr.cex";
import "@cex-std/src/filesystem.cex";
import "@cex-std/src/chrono.cex";

class FactoryApp {
    public appName: string = "2-TEK cxvm Engine";
    public port: int;
    public isRunning: bool = false;
    public downloadsDir: string = StdFilesystem::exists("dist") ? "dist" : (StdFilesystem::exists("cxvm/downloads") ? "cxvm/downloads" : (StdFilesystem::exists("downloads") ? "downloads" : "dist"));
    public service: PerfectApp* = new PerfectApp();
    public router: LightingRouter* = new LightingRouter();
    public controller: FactoryController* = new FactoryController();
    public builder: DistBuilder*;
    public cxvm: CxvmEngine* = new CxvmEngine();

    public constructor(port: int) {
        this.port = port;

        this.service->use(new TimingMiddleware());
        this.service->use(new CorsMiddleware("*"));
        this.service->use(new LoggerMiddleware());

        this.builder = new DistBuilder(this.downloadsDir);

        // Initialize default runtime with CexR v8 (.cex_boxes Dist Loader Engine)
        let defVer: string = CxvmConstants::defaultVersion();
        this.cxvm->install(defVer);
        this.cxvm->use(defVer);
        this.cxvm->setDefault(defVer);

        this.setupRoutes();
    }

    private setupRoutes(): void {
        // SSR HTML Routes
        this.router->get("/", "factory.index");
        this.router->get("/downloads", "factory.downloads");
        this.router->get("/cxvm", "factory.cxvmDocs");
        this.router->get("/setup", "factory.setup");

        // Shell & PowerShell Installers & Cross-Platform Downloads
        this.router->get("/install.sh", "factory.installSh");
        this.router->get("/install.ps1", "factory.installPs1");
        this.router->get("/setup.cex", "factory.setupCex");
        this.router->get("/setup.sh", "factory.setupSh");
        this.router->get("/setup.ps1", "factory.setupPs1");
        this.router->get("/cxvm.sh", "factory.cxvmScript");
        this.router->get("/cxvm.ps1", "factory.cxvmPs1");
        this.router->get("/cxvm.cmd", "factory.cxvmCmd");
        this.router->get("/downloads/:id", "factory.downloadFile");

        // REST JSON API Routes
        this.router->get("/api/v1/status", "factory.status");
        this.router->get("/api/v1/versions", "factory.versions");
        this.router->get("/api/v1/platforms", "factory.platforms");
        this.router->get("/api/v1/downloads", "factory.downloadsApi");
        this.router->get("/api/v1/manifest", "factory.manifest");
        this.router->get("/api/v1/setup", "factory.apiSetupGet");
        this.router->post("/api/v1/setup", "factory.apiSetupPost");
        this.router->post("/api/v1/build", "factory.build");
        this.router->get("/api/v1/cvm/status", "factory.apiCvmStatus");
        this.router->post("/api/v1/cvm/commit", "factory.apiCvmCommit");
        this.router->post("/api/v1/cvm/push", "factory.apiCvmPush");
        this.router->post("/api/v1/cvm/server/start", "factory.apiCvmServerStart");
        this.router->get("/api/v1/cvm/server/status", "factory.apiCvmServerStatus");
        this.router->post("/api/v1/cvm/server/stop", "factory.apiCvmServerStop");
        this.router->get("/api/v1/thunder/status", "factory.apiThunderStatus");
        this.router->post("/api/v1/thunder/server/start", "factory.apiThunderServerStart");
        this.router->get("/api/v1/thunder/server/status", "factory.apiThunderServerStatus");
        this.router->post("/api/v1/thunder/server/stop", "factory.apiThunderServerStop");
        this.router->get("/api/v1/thunder/containers", "factory.apiThunderContainers");
        this.router->get("/api/v1/thunder/images", "factory.apiThunderImages");
        this.router->post("/api/v1/thunder/virtual-linux/setup", "factory.apiThunderVirtualLinuxSetup");
        this.router->get("/api/v1/thunder/virtual-linux", "factory.apiThunderVirtualLinuxStatus");
        this.router->post("/api/v1/linux-distro/install", "factory.apiLinuxDistroInstall");
        this.router->post("/api/v1/linux-distro/uninstall", "factory.apiLinuxDistroUninstall");
        this.router->post("/api/v1/linux-distro/setup", "factory.apiLinuxDistroSetup");
        this.router->get("/api/v1/linux-distro/status", "factory.apiLinuxDistroStatus");
        this.router->get("/api/v1/linux-distro/list", "factory.apiLinuxDistroList");
        this.router->get("/api/v1/light/status", "factory.apiLightStatus");
        this.router->post("/api/v1/light/create", "factory.apiLightCreate");
        this.router->post("/api/v1/open", "factory.apiOpen");
        this.router->get("/api/v1/target", "factory.apiTarget");
        this.router->post("/api/v1/reinstall", "factory.apiReinstall");

        // Register SSR Pages on Cex-Service (cex-s)
        let dashDoc: SSRDocument* = new SSRDocument("FactoryDashboard", "2-TEK Cex Factory", "<h1>2-TEK Cex Factory</h1>", "{\"status\": \"ACTIVE\"}");
        this.service->page("/", dashDoc);
        let downDoc: SSRDocument* = new SSRDocument("FactoryDownloads", "2-TEK Cex Downloads", "<h1>Downloads Directory</h1>", "{\"total\": 36}");
        this.service->page("/downloads", downDoc);
        let cxvmDoc: SSRDocument* = new SSRDocument("CxvmDocs", "CXVM Documentation", "<h1>CXVM Version Manager</h1>", "{\"version\": \"2.0.0\"}");
        this.service->page("/cxvm", cxvmDoc);
        let setupDoc: SSRDocument* = new SSRDocument("SetupWindow", "CXVM Setup", "<h1>Setup Window</h1>", "{\"status\": \"HEALTHY\"}");
        this.service->page("/setup", setupDoc);

        // Register REST API Endpoints on Cex-Service (cex-s)
        this.service->api("GET", "/api/v1/status", "Factory Status API", "{\"status\": \"ACTIVE\", \"service\": \"2-TEK Cex Factory\", \"framework\": \"Lighting MVC + CexService\"}");
        this.service->api("GET", "/api/v1/versions", "Versions Catalog", "{\"total\": 6}");
        this.service->api("GET", "/api/v1/platforms", "Supported Architectures", "{\"total\": 6}");
        this.service->api("GET", "/api/v1/downloads", "Downloads Catalog", "{\"total\": 36}");
        this.service->api("GET", "/api/v1/manifest", "Release Manifest", "{\"name\": \"cxvm\"}");
        this.service->api("GET", "/api/v1/setup", "Setup State", "{\"status\": \"ACTIVE\"}");
        this.service->api("POST", "/api/v1/setup", "Save Setup", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/build", "Build Archives", "{\"status\": \"SUCCESS\"}");
        this.service->api("GET", "/api/v1/cvm/status", "CVM Status", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/cvm/commit", "CVM Commit", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/cvm/push", "CVM Push", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/cvm/server/start", "Start CVM Server", "{\"status\": \"SUCCESS\"}");
        this.service->api("GET", "/api/v1/cvm/server/status", "CVM Server Status", "{\"status\": \"RUNNING\"}");
        this.service->api("POST", "/api/v1/cvm/server/stop", "Stop CVM Server", "{\"status\": \"SUCCESS\"}");
        this.service->api("GET", "/api/v1/thunder/status", "Thunder Status", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/thunder/server/start", "Start Thunder Server", "{\"status\": \"SUCCESS\"}");
        this.service->api("GET", "/api/v1/thunder/server/status", "Thunder Server Status", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/thunder/server/stop", "Stop Thunder Server", "{\"status\": \"SUCCESS\"}");
        this.service->api("GET", "/api/v1/thunder/containers", "Thunder Containers", "{\"status\": \"SUCCESS\"}");
        this.service->api("GET", "/api/v1/thunder/images", "Thunder Images", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/thunder/virtual-linux/setup", "Virtual Linux Setup", "{\"status\": \"SUCCESS\"}");
        this.service->api("GET", "/api/v1/thunder/virtual-linux", "Virtual Linux Status", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/linux-distro/install", "Install Linux Distro", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/linux-distro/uninstall", "Uninstall Linux Distro", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/linux-distro/setup", "Setup Linux Distro", "{\"status\": \"SUCCESS\"}");
        this.service->api("GET", "/api/v1/linux-distro/status", "Linux Distro Status", "{\"status\": \"SUCCESS\"}");
        this.service->api("GET", "/api/v1/linux-distro/list", "List Linux Distros", "{\"status\": \"SUCCESS\"}");
        this.service->api("GET", "/api/v1/light/status", "Lighting Engine Status", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/light/create", "Create Lighting Project", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/open", "Open Target", "{\"status\": \"SUCCESS\"}");
        this.service->api("GET", "/api/v1/target", "Get Target", "{\"status\": \"SUCCESS\"}");
        this.service->api("POST", "/api/v1/reinstall", "Reinstall Subsystem", "{\"status\": \"SUCCESS\"}");
    }

    public start(): void {
        this.isRunning = true;
    }

    public stop(): void {
        this.isRunning = false;
    }

    private getHandlerCode(handlerId: string): int {
        if (handlerId === "factory.index") return 1;
        if (handlerId === "factory.downloads") return 2;
        if (handlerId === "factory.cxvmDocs") return 3;
        if (handlerId === "factory.setup") return 4;
        if (handlerId === "factory.installSh") return 5;
        if (handlerId === "factory.installPs1") return 6;
        if (handlerId === "factory.setupCex") return 7;
        if (handlerId === "factory.setupSh") return 8;
        if (handlerId === "factory.setupPs1") return 9;
        if (handlerId === "factory.cxvmScript") return 10;
        if (handlerId === "factory.cxvmPs1") return 11;
        if (handlerId === "factory.cxvmCmd") return 12;
        if (handlerId === "factory.downloadFile") return 13;
        if (handlerId === "factory.status") return 14;
        if (handlerId === "factory.versions") return 15;
        if (handlerId === "factory.platforms") return 16;
        if (handlerId === "factory.downloadsApi") return 17;
        if (handlerId === "factory.manifest") return 18;
        if (handlerId === "factory.apiSetupGet") return 19;
        if (handlerId === "factory.apiSetupPost") return 20;
        if (handlerId === "factory.build") return 21;
        if (handlerId === "factory.apiCvmStatus") return 22;
        if (handlerId === "factory.apiCvmCommit") return 23;
        if (handlerId === "factory.apiCvmPush") return 24;
        if (handlerId === "factory.apiCvmServerStart") return 25;
        if (handlerId === "factory.apiCvmServerStatus") return 26;
        if (handlerId === "factory.apiCvmServerStop") return 27;
        if (handlerId === "factory.apiThunderStatus") return 28;
        if (handlerId === "factory.apiThunderServerStart") return 29;
        if (handlerId === "factory.apiThunderServerStatus") return 30;
        if (handlerId === "factory.apiThunderServerStop") return 31;
        if (handlerId === "factory.apiThunderContainers") return 32;
        if (handlerId === "factory.apiThunderImages") return 33;
        if (handlerId === "factory.apiThunderVirtualLinuxSetup") return 34;
        if (handlerId === "factory.apiThunderVirtualLinuxStatus") return 35;
        if (handlerId === "factory.apiLinuxDistroInstall") return 36;
        if (handlerId === "factory.apiLinuxDistroUninstall") return 37;
        if (handlerId === "factory.apiLinuxDistroSetup") return 38;
        if (handlerId === "factory.apiLinuxDistroStatus") return 39;
        if (handlerId === "factory.apiLinuxDistroList") return 40;
        if (handlerId === "factory.apiLightStatus") return 41;
        if (handlerId === "factory.apiLightCreate") return 42;
        if (handlerId === "factory.apiOpen") return 43;
        if (handlerId === "factory.apiTarget") return 44;
        if (handlerId === "factory.apiReinstall") return 45;
        return 0;
    }

    public handleRequest(req: HttpRequest*): HttpResponse* {
        // 1. Logger Middleware
        LightingMiddleware::runLogger(req);

        // 2. Auth Middleware
        let authRes: MiddlewareResult* = LightingMiddleware::runAuth(req);
        if (!authRes->proceed) {
            return authRes->errorResponse;
        }

        // 3. Router Matching
        let route: LightingRouteEntry* = this.router->findRoute(req);
        if (route === nullptr) {
            return HttpResponse::notFound("No Factory route matched for: " + req->method + " " + req->path);
        }

        // 4. Controller Dispatch via switch-case
        let handlerCode: int = this.getHandlerCode(route->handlerId);
        switch (handlerCode) {
            case 1:
            return this.controller->index(req, this.port, this.builder->versions, this.builder->platforms, this.builder->artifacts, this.cxvm->current());
            case 2:
            return this.controller->downloadsHtml(req, this.port, this.builder->artifacts);
            case 3:
            return this.controller->cxvmDocs(req, this.port);
            case 4:
            return this.controller->setupHtml(req, this.port, this.cxvm);
            case 5:
            return this.controller->serveInstallSh(req, this.port, this.downloadsDir);
            case 6:
            return this.controller->serveInstallPs1(req, this.port, this.downloadsDir);
            case 7:
            return this.controller->serveSetupCex(req, this.port, this.downloadsDir);
            case 8:
            return this.controller->serveSetupSh(req, this.port, this.downloadsDir);
            case 9:
            return this.controller->serveSetupPs1(req, this.port, this.downloadsDir);
            case 10:
            return this.controller->serveCxvm(req, this.downloadsDir);
            case 11:
            return this.controller->serveCxvmPs1(req, this.downloadsDir);
            case 12:
            return this.controller->serveCxvmCmd(req, this.downloadsDir);
            case 13:
            return this.controller->downloadFile(req, this.downloadsDir);
            case 14:
            return this.controller->apiStatus(req, this.port, this.builder, this.cxvm);
            case 15:
            return this.controller->apiVersions(req, this.builder->versions);
            case 16:
            return this.controller->apiPlatforms(req, this.builder->platforms);
            case 17:
            return this.controller->apiDownloads(req, this.builder->artifacts);
            case 18:
            return this.controller->apiManifest(req, this.builder);
            case 19:
            return this.controller->apiSetupGet(req, this.cxvm);
            case 20:
            return this.controller->apiSetupPost(req, this.cxvm);
            case 21:
            return this.controller->apiBuild(req, this.builder);
            case 22:
            return this.controller->apiCvmStatus(req, this.cxvm);
            case 23:
            return this.controller->apiCvmCommit(req, this.cxvm);
            case 24:
            return this.controller->apiCvmPush(req, this.cxvm);
            case 25:
            return this.controller->apiCvmServerStart(req, this.cxvm);
            case 26:
            return this.controller->apiCvmServerStatus(req, this.cxvm);
            case 27:
            return this.controller->apiCvmServerStop(req, this.cxvm);
            case 28:
            return this.controller->apiThunderStatus(req, this.cxvm);
            case 29:
            return this.controller->apiThunderServerStart(req, this.cxvm);
            case 30:
            return this.controller->apiThunderServerStatus(req, this.cxvm);
            case 31:
            return this.controller->apiThunderServerStop(req, this.cxvm);
            case 32:
            return this.controller->apiThunderContainers(req, this.cxvm);
            case 33:
            return this.controller->apiThunderImages(req, this.cxvm);
            case 34:
            return this.controller->apiThunderVirtualLinuxSetup(req, this.cxvm);
            case 35:
            return this.controller->apiThunderVirtualLinuxStatus(req, this.cxvm);
            case 36:
            return this.controller->apiLinuxDistroInstall(req, this.cxvm);
            case 37:
            return this.controller->apiLinuxDistroUninstall(req, this.cxvm);
            case 38:
            return this.controller->apiLinuxDistroSetup(req, this.cxvm);
            case 39:
            return this.controller->apiLinuxDistroStatus(req, this.cxvm);
            case 40:
            return this.controller->apiLinuxDistroList(req, this.cxvm);
            case 41:
            return this.controller->apiLightStatus(req, this.cxvm);
            case 42:
            return this.controller->apiLightCreate(req, this.cxvm);
            case 43:
            return this.controller->apiOpen(req, this.cxvm);
            case 44:
            return this.controller->apiTarget(req, this.cxvm);
            case 45:
            return this.controller->apiReinstall(req, this.cxvm);
            default:
            return HttpResponse::notFound("Handler not implemented: " + route->handlerId);
        }
    }

    public simulateRequest(method: string, path: string, body: string, cType: string): HttpResponse* {
        let req: HttpRequest* = new HttpRequest(method, path, body, cType);
        return this.handleRequest(req);
    }

    public simulateServiceRequest(method: string, path: string, body: string): PerfectResponse* {
        return this.service->simulateRequest(method, path, body);
    }

    public listen(port: int, host: string = "127.0.0.1"): bool {
        return this.service->listen(port, host);
    }

    public displayRoutes(): void {
        TerminalUI::renderHeader("2-TEK Cex Factory Route Registry", "Powered by cex-s (CexService) & Lighting Fullstack MVC");
        println("  METHOD  ROUTE PATTERN               HANDLER ACTION");
        println("  -------------------------------------------------------------");
        let count: int = this.router->getRouteCount();
        for (let i: int = 0; i < count; i++) {
            let r: LightingRouteEntry* = this.router->routes->get(i);
            print("  "); print(r->method);
            for (let s: int = (int)r->method.length(); s < 8; s++) print(" ");
            print(r->pattern);
            for (let s: int = (int)r->pattern.length(); s < 28; s++) print(" ");
            println(r->handlerId);
        }
        println("-------------------------------------------------------------");
    }
}
