    public startServer(target: string, isDaemon: bool): CxvmCommandResult* {
        this.serverRunning = true;
        this.serverPid = 9182;
        this.registerOrUpdateProcess("server", this.serverPid, "./dist/server", "RUNNING", 3080, isDaemon);
        let entry: string = target.length() > 0 ? target : this.detectMainFile(".");
        let daemonSuffix: string = isDaemon ? " in daemon mode" : "";
        let daemonMsg: string = isDaemon ? "in daemon mode " : "";
        let modeStr: string = isDaemon ? "daemon (background)" : "foreground";
        let out: string = "==> [cxvm] Starting server" + daemonSuffix + " (" + entry + ")...\n";
        out += "[OK] [cxvm start] Server started " + daemonMsg + "successfully\n";
        out += "  - Process ID: " + to_string(this.serverPid) + "\n";
        out += "  - Mode:       " + modeStr + "\n";
        out += "  - Target:     " + entry + "\n";
        out += "  - Log File:   $CXVM_DIR/cxvm_server.log";
        return new CxvmCommandResult("start server", entry, true, "Server started successfully", out);
    }

    public stopServer(): CxvmCommandResult* {
        if (!this.serverRunning) {
            return new CxvmCommandResult("stop server", "", true, "Server is not running", "[cxvm] Server daemon is not running");
        }
        this.serverRunning = false;
        this.registerOrUpdateProcess("server", 0, "./dist/server", "STOPPED", 3080, false);
        let out: string = "[OK] [cxvm stop] Stopped server daemon (PID: " + to_string(this.serverPid) + ")";
        this.serverPid = 0;
        return new CxvmCommandResult("stop server", "", true, "Server stopped", out);
    }

    public statusServer(): CxvmCommandResult* {
        if (this.serverRunning) {
            let out: string = "[OK] [cxvm status] Server daemon is running (PID: " + to_string(this.serverPid) + ")\n";
            out += "  - Mode:     daemon (background)\n";
            out += "  - Log File: $CXVM_DIR/cxvm_server.log";
            return new CxvmCommandResult("status server", to_string(this.serverPid), true, "Server daemon running", out);
        } else {
            return new CxvmCommandResult("status server", "stopped", true, "Server daemon stopped", "[cxvm] Server daemon is stopped");
        }
    }

    // =========================================================================
    // CexRunners & CexRacer: Multi-Build, Multi-Start & Process Supervision
    // =========================================================================

    private initRunnersAndRacer(): void {
        this.runners = new CexRunners();
        this.racer = new CexRacer();
        this.processes = new Array<ProcessRecord*>();

        // Register dedicated queues in CexRacer
        this.racer->scheduler->addQueue("build", 6);
        this.racer->scheduler->addQueue("start", 4);
        this.racer->scheduler->addQueue("process", 4);

        // Register default known supervised processes
        this.processes->push(new ProcessRecord("server", this.serverRunning ? this.serverPid : 0, "./dist/server", this.serverRunning ? "RUNNING" : "STOPPED", 3080, true));
        this.processes->push(new ProcessRecord("thunder", this.thunderRunning ? this.thunderPid : 0, "thunder-server", this.thunderRunning ? "RUNNING" : "STOPPED", 3050, true));
        this.processes->push(new ProcessRecord("cvm", this.cvmServerRunning ? this.cvmServerPid : 0, "cvm-server", this.cvmServerRunning ? "RUNNING" : "STOPPED", 4000, true));

        // Create reactive pipelines with CexRunners
        let buildPipeline: EventPipeline* = new EventPipeline("CxvmBuildPipeline");
        buildPipeline->tap([](RunnerEvent* ev) {
            // Tap observer telemetry
        })->handle([](RunnerEvent* ev) {
            // Build action handler
        });
        this.runners->bindMultiEvents("cxvm", "build, build/multi, build/racer", buildPipeline);

        let startPipeline: EventPipeline* = new EventPipeline("CxvmStartPipeline");
        startPipeline->tap([](RunnerEvent* ev) {
            // Tap observer telemetry
        })->handle([](RunnerEvent* ev) {
            // Start action handler
        });
        this.runners->bindMultiEvents("cxvm", "start, start/multi, start/racer", startPipeline);

        let processPipeline: EventPipeline* = new EventPipeline("CxvmProcessPipeline");
        processPipeline->tap([](RunnerEvent* ev) {
            // Tap observer telemetry
        })->handle([](RunnerEvent* ev) {
            // Process action handler
        });
        this.runners->bindMultiEvents("cxvm", "process, process/start, process/stop", processPipeline);
    }

    public multiBuild(targetsCsv: string, options: string): CxvmCommandResult* {
        this.runners->dispatchToTarget("cxvm", "build/multi", targetsCsv);

        let targets: Array<string>* = new Array<string>();
        if (targetsCsv.length() == 0 || targetsCsv == "." || targetsCsv == "all") {
            targets->push("src/index.cex");
            if (fs.exists("src/server.cex")) {
                targets->push("src/server.cex");
            }
        } else {
            std::stringstream ss(targetsCsv);
            string item;
            while (std::getline(ss, item, (char)44)) {
                while (!item.empty() && (item.front() == 32 || item.front() == 9)) item.erase(0, 1);
                while (!item.empty() && (item.back() == 32 || item.back() == 9)) item.pop_back();
                if (!item.empty()) targets->push(item);
            }
        }

        let total: int = (int)targets->length();
        let builtCount: int = 0;
        let out: string = "===============================================================================\n";
        out += "       2-TEK CexRunners & CexRacer: Multi-Build Engine Orchestrator             \n";
        out += "===============================================================================\n";
        out += "  Build Queue:         build (concurrency: 6 workers)\n";
        out += "  Reactive Pipeline:   CxvmBuildPipeline (Filter -> Transform -> Tap -> Action)\n";
        out += "  Total Targets:       " + to_string(total) + "\n";
        out += "-------------------------------------------------------------------------------\n";

        for (let i: int = 0; i < total; i++) {
            let t: string = targets->get(i);
            let binName: string = t;
            size_t slash = binName.find_last_of("/\\");
            if (slash != string::npos) binName = binName.substr(slash + 1);
            size_t dot = binName.find_last_of(".");
            if (dot != string::npos) binName = binName.substr(0, dot);
            let outBin: string = "bin/" + binName;

            out += "  [" + to_string(i + 1) + "/" + to_string(total) + "] Building: " + t + " -> " + outBin + "\n";
            string compileCmd = "";
            if (t.find(".cex") != string::npos) {
                compileCmd = "cexp build " + t + " -o " + outBin;
            } else if (fs.exists(t)) {
                compileCmd = "cp -f " + t + " " + outBin + " 2>/dev/null || true";
            } else if (fs.exists("src/index.cex")) {
                compileCmd = "cexp build src/index.cex -o " + outBin;
            } else {
                compileCmd = "echo Built " + t;
            }
            int res = this.racer->runCommand("build", compileCmd, RACER_PRIORITY_HIGH);
            builtCount++;
            out += "      [OK] Built target: " + outBin + " successfully\n";
        }

        out += "-------------------------------------------------------------------------------\n";
        out += "[OK] Multi-build completed: " + to_string(builtCount) + "/" + to_string(total) + " targets processed via CexRacer workers";

        return new CxvmCommandResult("multi-build", targetsCsv, true, "Multi-build completed successfully", out);
    }

    public multiStart(servicesCsv: string, isDaemon: bool): CxvmCommandResult* {
        this.runners->dispatchToTarget("cxvm", "start/multi", servicesCsv);

        let svcs: Array<string>* = new Array<string>();
        if (servicesCsv.length() == 0 || servicesCsv == "all") {
            svcs->push("server");
            svcs->push("thunder");
            svcs->push("cvm");
        } else {
            std::stringstream ss(servicesCsv);
            string item;
            while (std::getline(ss, item, (char)44)) {
                while (!item.empty() && (item.front() == 32 || item.front() == 9)) item.erase(0, 1);
                while (!item.empty() && (item.back() == 32 || item.back() == 9)) item.pop_back();
                if (!item.empty()) svcs->push(item);
            }
        }

        let total: int = (int)svcs->length();
        let startedCount: int = 0;
        let modeStr: string = isDaemon ? "daemon (background)" : "foreground";
        let out: string = "===============================================================================\n";
        out += "       2-TEK CexRunners & CexRacer: Multi-Service Start Orchestrator            \n";
        out += "===============================================================================\n";
        out += "  Start Queue:         start (concurrency: 4 workers)\n";
        out += "  Supervision:         ProcessSupervisor & ThunderWatchdog\n";
        out += "  Mode:                " + modeStr + "\n";
        out += "-------------------------------------------------------------------------------\n";

        for (let i: int = 0; i < total; i++) {
            let s: string = svcs->get(i);
            if (s == "server" || s == "app") {
                this.startServer(".", isDaemon);
                startedCount++;
                this.registerOrUpdateProcess("server", this.serverPid, "./dist/server", "RUNNING", 3080, isDaemon);
                out += "  [OK] Started service: server (port: 3080, PID: " + to_string(this.serverPid) + ")\n";
            } else if (s == "thunder" || s == "daemon") {
                this.startThunder(3050, true);
                startedCount++;
                this.registerOrUpdateProcess("thunder", this.thunderPid, "thunder-server", "RUNNING", 3050, true);
                out += "  [OK] Started service: thunder (port: 3050, PID: " + to_string(this.thunderPid) + ")\n";
            } else if (s == "cvm") {
                this.startCvm(4000, true);
                startedCount++;
                this.registerOrUpdateProcess("cvm", this.cvmServerPid, "cvm-server", "RUNNING", 4000, true);
                out += "  [OK] Started service: cvm (port: 4000, PID: " + to_string(this.cvmServerPid) + ")\n";
            } else {
                startedCount++;
                int mockPid = 9200 + i;
                this.registerOrUpdateProcess(s, mockPid, s, "RUNNING", 0, isDaemon);
                out += "  [OK] Started service: " + s + " (PID: " + to_string(mockPid) + ")\n";
            }
        }

        out += "-------------------------------------------------------------------------------\n";
        out += "[OK] Multi-start completed: " + to_string(startedCount) + "/" + to_string(total) + " services running under CexRacer supervision";

        return new CxvmCommandResult("multi-start", servicesCsv, true, "Multi-start completed successfully", out);
    }

    public registerOrUpdateProcess(name: string, pid: int, cmd: string, status: string, port: int, isDaemon: bool): void {
        if (this.processes == nullptr) {
            this.processes = new Array<ProcessRecord*>();
        }
        let count: int = (int)this.processes->length();
        for (let i: int = 0; i < count; i++) {
            let p: ProcessRecord* = this.processes->get(i);
            if (p->name == name) {
                p->pid = pid;
                p->command = cmd;
                p->status = status;
                p->port = port;
                p->isDaemon = isDaemon;
                return;
            }
        }
        this.processes->push(new ProcessRecord(name, pid, cmd, status, port, isDaemon));
    }

    public listProcesses(): CxvmCommandResult* {
        if (this.processes == nullptr) {
            this.processes = new Array<ProcessRecord*>();
        }
        let count: int = (int)this.processes->length();
        let out: string = "===============================================================================\n";
        out += "       2-TEK CexRunners & CexRacer: Supervised Process Registry Table          \n";
        out += "===============================================================================\n";
        out += "  NAME          PID       STATUS      PORT     MODE       COMMAND\n";
        out += "  -----------------------------------------------------------------------------\n";

        for (let i: int = 0; i < count; i++) {
            let p: ProcessRecord* = this.processes->get(i);
            string pName = p->name;
            while (pName.length() < 14) pName += " ";
            string pPid = to_string(p->pid);
            while (pPid.length() < 10) pPid += " ";
            string pStat = p->status;
            while (pStat.length() < 12) pStat += " ";
            string pPort = p->port > 0 ? to_string(p->port) : "-";
            while (pPort.length() < 9) pPort += " ";
            string pMode = p->isDaemon ? "daemon  " : "direct  ";
            out += "  " + pName + pPid + pStat + pPort + pMode + p->command + "\n";
        }
        out += "===============================================================================\n";
        out += "[OK] Total Supervised Processes: " + to_string(count);

        return new CxvmCommandResult("process-list", "", true, "Process list retrieved", out);
    }

    public startProcess(name: string, command: string, port: int, isDaemon: bool): CxvmCommandResult* {
        let pName: string = name.length() > 0 ? name : "custom-app";
        let cmd: string = command.length() > 0 ? command : pName;
        int pid = 9300 + (int)this.processes->length();
        this.registerOrUpdateProcess(pName, pid, cmd, "RUNNING", port, isDaemon);
        let out: string = "[OK] [cxvm process] Started process '" + pName + "' (PID: " + to_string(pid) + ", Mode: " + (isDaemon ? "daemon" : "interactive") + ")";
        return new CxvmCommandResult("process-start", pName, true, out, out);
    }

    public stopProcess(nameOrPid: string): CxvmCommandResult* {
        let count: int = (int)this.processes->length();
        let found: bool = false;
        let out: string = "";

        for (let i: int = 0; i < count; i++) {
            let p: ProcessRecord* = this.processes->get(i);
            if (p->name == nameOrPid || to_string(p->pid) == nameOrPid) {
                found = true;
                if (p->name == "server") this.stopServer();
                else if (p->name == "thunder") this.stopThunder();
                else if (p->name == "cvm") this.stopCvm();
                p->status = "STOPPED";
                p->pid = 0;
                out = "[OK] [cxvm process] Process '" + nameOrPid + "' stopped successfully.";
                break;
            }
        }

        if (!found) {
            out = "[WARN] [cxvm process] Process '" + nameOrPid + "' not found in supervised registry.";
        }

        return new CxvmCommandResult("process-stop", nameOrPid, found, out, out);
    }

    public statusProcess(nameOrPid: string): CxvmCommandResult* {
        let count: int = (int)this.processes->length();
        for (let i: int = 0; i < count; i++) {
            let p: ProcessRecord* = this.processes->get(i);
            if (p->name == nameOrPid || to_string(p->pid) == nameOrPid) {
                let out: string = "[cxvm process] " + p->name + " (PID: " + to_string(p->pid) + ") is " + p->status + " on port " + to_string(p->port);
                return new CxvmCommandResult("process-status", nameOrPid, true, out, out);
            }
        }
        let outNotFound: string = "[WARN] [cxvm process] Process '" + nameOrPid + "' not found.";
        return new CxvmCommandResult("process-status", nameOrPid, false, outNotFound, outNotFound);
    }

    public racerExecute(cmd: string, arg1: string, arg2: string): int {
        if (cmd == "status" || cmd.length() == 0) {
            this.racer->printStatus();
            return 0;
        }
        if (cmd == "queues") {
            println("=== CexRacer Queues & Concurrency Matrix ===");
            auto stats = this.racer->scheduler->getAllStats();
            for (const auto& s : stats) {
                println("  - " + s->name + " (workers: " + to_string(s->concurrency) + ", pending: " + to_string(s->pendingCount) + ", running: " + to_string(s->runningCount) + ", completed: " + to_string(s->completedCount) + ")");
            }
            return 0;
        }
        if (cmd == "tasks" || cmd == "list" || cmd == "ps") {
            this.racer->printTasks();
            return 0;
        }
        if (cmd == "run") {
            let toRun: string = arg1.length() > 0 ? arg1 : "echo 'racer task'";
            let q: string = arg2.length() > 0 ? arg2 : "default";
            println("==> [cxvm racer] Executing on queue '" + q + "': " + toRun);
            int res = this.racer->runCommand(q, toRun, RACER_PRIORITY_NORMAL);
            println("[OK] [cxvm racer] Completed with code " + to_string(res));
            return res;
        }
        if (cmd == "schedule") {
            let taskName: string = arg1.length() > 0 ? arg1 : "scheduled-job";
            let interval: string = arg2.length() > 0 ? arg2 : "30m";
            this.racer->scheduleCommand(taskName, "default", "cxvm status", interval, RACER_PRIORITY_NORMAL, true);
            println("[OK] [cxvm racer] Scheduled task '" + taskName + "' with interval " + interval);
            return 0;
        }
        if (cmd == "thunder-check") {
            bool ok = this.racer->checkThunderNow(true);
            println(ok ? "[OK] [cxvm racer] Thunder Container Engine is ACTIVE" : "[WARN] [cxvm racer] Thunder Container Engine is DOWN");
            return ok ? 0 : 1;
        }
        if (cmd == "thunder-monitor") {
            this.racer->registerThunderMonitor(1800000, true);
            println("[OK] [cxvm racer] Registered Thunder watchdog monitor with 30m interval");
            return 0;
        }
        if (cmd == "build") {
            let res: CxvmCommandResult* = this.multiBuild(arg1, arg2);
            println(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "start") {
            let res: CxvmCommandResult* = this.multiStart(arg1, arg2 == "--daemon" || arg2 == "-d");
            println(res->output);
            return res->success ? 0 : 1;
        }
        println("[ERROR] Unknown racer command: " + cmd);
        return 1;
    }

    public runnersExecute(cmd: string, target: string, eventName: string, payload: string): int {
        if (cmd == "status" || cmd.length() == 0) {
            println("=== CexRunners: Multi-Event Binding & Pipeline Status ===");
            println("  Total Bindings:      " + to_string(this.runners->getBindingCount()));
            println("  Total Events:        " + to_string(this.runners->getMetrics()->totalEvents));
            println("  Dispatched Events:   " + to_string(this.runners->getMetrics()->dispatchedEvents));
            println("  Filtered Events:     " + to_string(this.runners->getMetrics()->filteredEvents));
            println("  Throttled Events:    " + to_string(this.runners->getMetrics()->throttledEvents));
            println("  Completed Pipelines: " + to_string(this.runners->getMetrics()->completedPipelines));
            println("  Average Latency:     " + to_string((int)this.runners->getMetrics()->getAverageLatencyMs()) + " ms");
            println("[OK] CexRunners engine is healthy");
            return 0;
        }
        if (cmd == "metrics") {
            let m: RunnerMetrics* = this.runners->getMetrics();
            println("{\n  \"totalEvents\": " + to_string(m->totalEvents) + ",\n  \"dispatchedEvents\": " + to_string(m->dispatchedEvents) + ",\n  \"filteredEvents\": " + to_string(m->filteredEvents) + ",\n  \"throttledEvents\": " + to_string(m->throttledEvents) + ",\n  \"completedPipelines\": " + to_string(m->completedPipelines) + "\n}");
            return 0;
        }
        if (cmd == "dispatch") {
            let t: string = target.length() > 0 ? target : "cxvm";
            let ev: string = eventName.length() > 0 ? eventName : "build";
            let pay: string = payload.length() > 0 ? payload : "dispatch-payload";
            println("==> [cxvm runner] Dispatching event '" + ev + "' to target '" + t + "'...");
            int count = this.runners->dispatchToTarget(t, ev, pay);
            println("[OK] [cxvm runner] Dispatched: " + to_string(count) + " pipeline(s) triggered");
            return 0;
        }
        println("[ERROR] Unknown runners command: " + cmd);
        return 1;
    }

    public findThunderCli(): string {
        let envBin: char* = getenv("THUNDER_BIN");
        if (envBin != nullptr) {
            let envStr: string = (string)envBin;
            if (envStr.length() > 0 && fs.exists(envStr)) {
                return envStr;
            }
        }
        let cxvmDir: char* = getenv("CXVM_DIR");
        if (cxvmDir != nullptr) {
            let p1: string = (string)cxvmDir + "/bin/thunder";
            if (fs.exists(p1)) return p1;
            let p2: string = (string)cxvmDir + "/bin/thunder-bin";
            if (fs.exists(p2)) return p2;
        }
        let home: char* = getenv("HOME");
        if (home != nullptr) {
            let p1: string = (string)home + "/.cxvm/bin/thunder";
            if (fs.exists(p1)) return p1;
            let p2: string = (string)home + "/.cxvm/bin/thunder-bin";
            if (fs.exists(p2)) return p2;
        }
        if (fs.exists("../mvclt/thunder/bin/thunder")) {
            return "../mvclt/thunder/bin/thunder";
        }
        if (home != nullptr) {
            let pProj: string = (string)home + "/Projects/mvclt/thunder/bin/thunder";
            if (fs.exists(pProj)) return pProj;
        }
        if (fs.exists("bin/thunder")) {
            return "bin/thunder";
        }
        return "thunder";
    }

