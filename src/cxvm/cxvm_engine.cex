        out += "[OK] [cxvm] Thunder server started successfully (single process standalone)\n";
        out += "  - Process ID: " + to_string(this.thunderPid) + "\n";
        out += "  - Port:       " + to_string(this.thunderPort) + "\n";
        out += "  - Mode:       standalone (single process)\n";
        out += "  - Dashboard:  http://localhost:" + to_string(this.thunderPort) + "\n";
        out += "  - Endpoints:  /api/v1/thunder/status, /api/v1/thunder/containers, /health";
        return new CxvmCommandResult("start thunder", to_string(port), true, "Thunder server started on port " + to_string(port), out);
    }

    public stopThunder(): CxvmCommandResult* {
        if (!this.thunderRunning) {
