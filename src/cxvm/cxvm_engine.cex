    public detectAppName(targetDir: string = "."): string {
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let manifestPath: string = dir + "/cex-pack.json";
        if (fs.exists(manifestPath)) {
            let content: string = fs.readFile(manifestPath);
            let posApp: int = (int)content.find("\"app-name\"");
            if (posApp != -1) {
                let colon: int = (int)content.find(":", posApp);
                if (colon != -1) {
                    let q1: int = (int)content.find("\"", colon + 1);
                    if (q1 != -1) {
                        let q2: int = (int)content.find("\"", q1 + 1);
                        if (q2 != -1) {
                            let aName: string = content.substr(q1 + 1, q2 - q1 - 1);
                            if (aName.length() > 0) return aName;
                        }
                    }
                }
            }
            let posName: int = (int)content.find("\"name\"");
            if (posName != -1) {
                let colon: int = (int)content.find(":", posName);
                if (colon != -1) {
                    let q1: int = (int)content.find("\"", colon + 1);
                    if (q1 != -1) {
                        let q2: int = (int)content.find("\"", q1 + 1);
                        if (q2 != -1) {
                            let pName: string = content.substr(q1 + 1, q2 - q1 - 1);
                            if (pName.length() > 0) return pName;
                        }
                    }
                }
            }
        }
        return "cxvm";
    }

    public resolveCexrAppTarget(appOrFile: string, targetDir: string = "."): string {
        let clean: string = appOrFile;
        while (!clean.empty() && (clean.front() == 34 || clean.front() == 39)) clean.erase(0, 1);
        while (!clean.empty() && (clean.back() == 34 || clean.back() == 39)) clean.pop_back();

        if (clean.length() == 0 || clean == "--dry-run") {
            return this.detectMainFile(targetDir);
        }
        if (clean.find(".cex") != string::npos || fs.exists(clean)) {
            return clean;
        }

        // Check installed app binary in ./bin/$version/$appName
        let installedBin: string = this.findInstalledAppInBin(clean, this.currentVersion);
        if (installedBin.length() > 0) {
            return installedBin;
        }

        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let appName: string = this.detectAppName(dir);
        if (clean == appName || clean == "cxvm" || clean == "app") {
            return this.detectMainFile(dir);
        }

        if (fs.exists(dir + "/.cex_boxes/" + clean + "/src/index.cex")) {
            return dir + "/.cex_boxes/" + clean + "/src/index.cex";
        }
        if (fs.exists(dir + "/.cex_boxes/" + clean + "/bin/" + clean)) {
            return dir + "/.cex_boxes/" + clean + "/bin/" + clean;
        }

        return this.detectMainFile(dir);
    }

    public getBinVersionDir(version: string = ""): string {
        let v: string = version.length() == 0 ? this.currentVersion : version;
        if (v.length() == 0) v = "8.0.0";
        if (v.substr(0, 1) == "v") v = v.substr(1);
        return "bin/" + v;
    }

    public findInstalledAppInBin(appName: string, version: string = ""): string {
        let cleanApp: string = appName;
        while (!cleanApp.empty() && (cleanApp.front() == 34 || cleanApp.front() == 39)) cleanApp.erase(0, 1);
        while (!cleanApp.empty() && (cleanApp.back() == 34 || cleanApp.back() == 39)) cleanApp.pop_back();
        if (cleanApp.substr(0, 1) == "@") {
            cleanApp = cleanApp.substr(1);
        }
        let slashPos: int = (int)cleanApp.find("/");
        if (slashPos != -1) {
            cleanApp = cleanApp.substr(slashPos + 1);
        }
        if (cleanApp.length() == 0) return "";

        let v: string = version.length() == 0 ? this.currentVersion : version;
        if (v.length() == 0) v = "8.0.0";
        if (v.substr(0, 1) == "v") v = v.substr(1);

        // 1. Direct versioned path: bin/$version/$appName (e.g. bin/8.0.0/cxvm)
        let p1: string = "bin/" + v + "/" + cleanApp;
        if (fs.exists(p1)) return p1;

        // 2. Prefixed versioned path: bin/v$version/$appName (e.g. bin/v8.0.0/cxvm)
        let p2: string = "bin/v" + v + "/" + cleanApp;
        if (fs.exists(p2)) return p2;

        // 3. Short major version paths (bin/v8/..., bin/v6/...)
        let dotPos: int = (int)v.find(".");
        let major: string = dotPos != -1 ? v.substr(0, dotPos) : v;
        let p3: string = "bin/v" + major + "/" + cleanApp;
        if (fs.exists(p3)) return p3;
        let p3b: string = "bin/" + major + "/" + cleanApp;
        if (fs.exists(p3b)) return p3b;

        // 4. Default version fallbacks (bin/8.0.0/..., bin/6.0.0/...)
        if (fs.exists("bin/8.0.0/" + cleanApp)) return "bin/8.0.0/" + cleanApp;
        if (fs.exists("bin/v8.0.0/" + cleanApp)) return "bin/v8.0.0/" + cleanApp;
        if (fs.exists("bin/6.0.0/" + cleanApp)) return "bin/6.0.0/" + cleanApp;
        if (fs.exists("bin/v6.0.0/" + cleanApp)) return "bin/v6.0.0/" + cleanApp;

        // 5. Unversioned bin/$appName
        let p4: string = "bin/" + cleanApp;
        if (fs.exists(p4)) return p4;

        // 6. Installed in $CXVM_DIR/versions/v$version/bin/$appName
        let homeEnv: char* = getenv("HOME");
        let homeStr: string = homeEnv != nullptr ? string(homeEnv) : "";
        let cxvmDir: string = this.cxvmHome;
        if (cxvmDir.find("$HOME") != -1 && homeStr.length() > 0) {
            let hPos: int = (int)cxvmDir.find("$HOME");
            cxvmDir = cxvmDir.substr(0, hPos) + homeStr + cxvmDir.substr(hPos + 5);
        }
        let p5: string = cxvmDir + "/versions/v" + v + "/bin/" + cleanApp;
        if (fs.exists(p5)) return p5;
        let p6: string = cxvmDir + "/bin/" + cleanApp;
        if (fs.exists(p6)) return p6;

        return "";
    }

    public installAppToBinVersion(appName: string, version: string = "", sourceEntry: string = ""): CxvmCommandResult* {
        let cleanApp: string = appName;
        while (!cleanApp.empty() && (cleanApp.front() == 34 || cleanApp.front() == 39)) cleanApp.erase(0, 1);
        while (!cleanApp.empty() && (cleanApp.back() == 34 || cleanApp.back() == 39)) cleanApp.pop_back();
        if (cleanApp.substr(0, 1) == "@") cleanApp = cleanApp.substr(1);
        let sPos: int = (int)cleanApp.find("/");
        if (sPos != -1) cleanApp = cleanApp.substr(sPos + 1);
        if (cleanApp.length() == 0) cleanApp = "app";

        let v: string = version.length() == 0 ? this.currentVersion : version;
        if (v.length() == 0) v = "8.0.0";
        if (v.substr(0, 1) == "v") v = v.substr(1);

        let vDir: string = "bin/" + v;
        system(("mkdir -p \"" + vDir + "\" bin").c_str());
        if (!fs.exists("bin/.gitkeep")) {
            fs.writeFile("bin/.gitkeep", "# Keep ./bin/ tracked in Git with default toolchains & apps\n");
        }
        if (!fs.exists(vDir + "/.gitkeep")) {
            fs.writeFile(vDir + "/.gitkeep", "# Installed apps for version " + v + "\n");
        }

        let targetBin: string = vDir + "/" + cleanApp;
        let rootBin: string = "bin/" + cleanApp;

        let entry: string = sourceEntry.length() > 0 ? sourceEntry : "";
        if (entry.length() == 0) {
            let srcChoice: int = (cleanApp == "cxvm" || cleanApp == this.detectAppName(".")) ? 1
                : (fs.exists(".cex_boxes/" + cleanApp + "/src/index.cex") ? 2
                : (fs.exists(".cex_boxes/" + cleanApp + "/bin/" + cleanApp) ? 3 : 0));
            switch (srcChoice) {
                case 1:
                entry = this.detectMainFile(".");
                break;
                case 2:
                entry = ".cex_boxes/" + cleanApp + "/src/index.cex";
                break;
                case 3:
                entry = ".cex_boxes/" + cleanApp + "/bin/" + cleanApp;
                break;
                default:
                entry = this.detectMainFile(".");
                break;
            }
        }

        // Create executable launcher in bin/$version/$appName
        let launcher: string = "#!/usr/bin/env bash\n";
        launcher += "# 2-TEK CXVM Installed App Launcher: " + cleanApp + " (v" + v + ")\n";
        launcher += "set -e\n";
        launcher += "SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n";
        launcher += "PROJ_ROOT=\"$(cd \"$SCRIPT_DIR/../..\" && pwd)\"\n";
        launcher += "RUNNER=\"$PROJ_ROOT/bin/cexr\"\n";
        launcher += "if [ ! -f \"$RUNNER\" ]; then RUNNER=\"cexr\"; fi\n";
        launcher += "TARGET=\"$PROJ_ROOT/" + entry + "\"\n";
        launcher += "if [ -f \"$TARGET\" ]; then\n";
        launcher += "  exec \"$RUNNER\" \"$TARGET\" \"$@\"\n";
        launcher += "else\n";
        launcher += "  exec \"$RUNNER\" \"$@\"\n";
        launcher += "fi\n";

        fs.writeFile(targetBin, launcher);
        system(("chmod +x \"" + targetBin + "\" 2>/dev/null || true").c_str());

        // Also ensure bin/$cleanApp points or mirrors it
        if (!fs.exists(rootBin) || cleanApp == "cxvm") {
            fs.writeFile(rootBin, launcher);
            system(("chmod +x \"" + rootBin + "\" 2>/dev/null || true").c_str());
        }

        // Also mirror into bin/v$version/$cleanApp and bin/v8/$cleanApp for convenience
        system(("mkdir -p bin/v" + v + " bin/v8 bin/v6 2>/dev/null || true").c_str());
        system(("cp -f \"" + targetBin + "\" \"bin/v" + v + "/" + cleanApp + "\" 2>/dev/null || true").c_str());
        system(("chmod +x \"bin/v" + v + "/" + cleanApp + "\" 2>/dev/null || true").c_str());

        let outMsg: string = "==> [cxvm --app] Installed app '" + cleanApp + "' in ./" + targetBin + " [OK]\n";
        outMsg += "  - Version:       v" + v + "\n";
        outMsg += "  - Binary Path:   " + targetBin + "\n";
        outMsg += "  - Entrypoint:    " + entry + "\n";
        outMsg += "  - Invocation:    cxvm --app " + cleanApp + " [...args]";

        return new CxvmCommandResult("install-app", cleanApp, true, "Installed app in " + targetBin, outMsg);
    }

    public runInstalledApp(appName: string, subCmd: string, subArg: string): CxvmCommandResult* {
        let cleanApp: string = appName;
        while (!cleanApp.empty() && (cleanApp.front() == 34 || cleanApp.front() == 39)) cleanApp.erase(0, 1);
        while (!cleanApp.empty() && (cleanApp.back() == 34 || cleanApp.back() == 39)) cleanApp.pop_back();

        let appBin: string = this.findInstalledAppInBin(cleanApp, this.currentVersion);
        if (appBin.length() == 0) {
            this.installAppToBinVersion(cleanApp, this.currentVersion, "");
            appBin = this.findInstalledAppInBin(cleanApp, this.currentVersion);
        }

        let fullCmd: string = appBin;
        if (subCmd.length() > 0) fullCmd += " " + subCmd;
        if (subArg.length() > 0) fullCmd += " " + subArg;

        this.runners->dispatchToTarget(cleanApp, "app/run", fullCmd);
        this.registerOrUpdateProcess(cleanApp, 9600, fullCmd, "RUNNING", 0, false);

        Log::info("==> [cxvm --app " + cleanApp + "] Executing installed app in ./" + appBin + ": " + fullCmd);

        let exitCode: int = 0;
        let isDryRun: bool = (subCmd == "--dry-run" || subArg == "--dry-run" || fullCmd.find("--dry-run") != string::npos);
        if (!isDryRun && fs.exists(appBin)) {
            exitCode = system(fullCmd.c_str());
        }

        this.registerOrUpdateProcess(cleanApp, 0, fullCmd, exitCode == 0 ? "COMPLETED" : "FAILED", 0, false);

        let outMsg: string = "[OK] [cxvm --app " + cleanApp + "] Executed installed app from " + appBin;
        if (exitCode != 0 && !isDryRun) {
            outMsg = "[FAIL] [cxvm --app " + cleanApp + "] App exited with code " + to_string(exitCode);
            return new CxvmCommandResult("app-run", cleanApp, false, "Execution failed", outMsg);
        }

        return new CxvmCommandResult("app-run", cleanApp, true, "Executed installed app successfully", outMsg);
    }

    public downloadAppsFromManifest(manifestPath: string = "cex-pack.json", version: string = ""): CxvmCommandResult* {
        let mPath: string = manifestPath.length() == 0 ? "cex-pack.json" : manifestPath;
        let v: string = version.length() == 0 ? this.currentVersion : version;
        if (v.length() == 0) v = "8.0.0";
        if (v.substr(0, 1) == "v") v = v.substr(1);

        let out: string = "==> [cxvm downloads] Downloading and installing apps from " + mPath + " into ./bin/" + v + "/...\n";
        let installedCount: int = 0;

        let appName: string = this.detectAppName(mPath.substr(0, mPath.find_last_of("/\\") != string::npos ? mPath.find_last_of("/\\") : 0));
        let mainFile: string = this.detectMainFile(mPath.substr(0, mPath.find_last_of("/\\") != string::npos ? mPath.find_last_of("/\\") : 0));

        // Install project's own app into bin/$version/$appName
        this.installAppToBinVersion(appName, v, mainFile);
        out += "  [OK] Installed primary app: " + appName + " -> ./bin/" + v + "/" + appName + "\n";
        installedCount++;

        // Install core toolchain apps into bin/$version/
        this.installAppToBinVersion("cxvm", v, "src/index.cex");
        this.installAppToBinVersion("cexr", v, "bin/cexr");
        this.installAppToBinVersion("cexp", v, "bin/cexp");
        installedCount += 3;

        // Parse dependencies and install runnable packages into bin/$version/$depName
        if (fs.exists(mPath)) {
            let content: string = fs.readFile(mPath);
            let deps: Array<string>* = this.parseDependencies(content);
            for (let i: int = 0; i < (int)deps->length(); i++) {
                let entry: string = deps->get(i);
                let atP: int = (int)entry.find("@", 1);
                let dName: string = atP != -1 ? entry.substr(0, atP) : entry;
                let cleanBase: string = dName;
                if (cleanBase.substr(0, 1) == "@") cleanBase = cleanBase.substr(1);
                let slPos: int = (int)cleanBase.find("/");
                if (slPos != -1) cleanBase = cleanBase.substr(slPos + 1);

                this.installAppToBinVersion(cleanBase, v, ".cex_boxes/" + cleanBase + "/src/index.cex");
                out += "  [OK] Installed app dependency: " + cleanBase + " -> ./bin/" + v + "/" + cleanBase + "\n";
                installedCount++;
            }
        }

        out += "[OK] [cxvm downloads] Downloaded and installed " + to_string(installedCount) + " apps from " + mPath + " into ./bin/" + v + "/";
        return new CxvmCommandResult("downloads-apps", mPath, true, "Downloaded and installed apps from manifest into ./bin/" + v + "/", out);
    }

    public fixProject(targetDir: string = "."): CxvmCommandResult* {
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let out: string = "===============================================================================\n";
        out += "       2-TEK CXVM: One-Step Project & Toolchain Auto-Fix (cxvm fix)             \n";
        out += "===============================================================================\n";
        out += "  Target Directory:    " + dir + "\n";
        out += "  Active Runtime:      " + this.current() + "\n";
        out += "  Fix Actions:         Lint Auto-Fix, .cex_boxes Repair, ./bin/.gitkeep Sync, App Install\n";
        out += "-------------------------------------------------------------------------------\n";

        // 1. Integrate ./bin/ default toolchains and .gitkeep
        let binRes: CxvmCommandResult* = this.integrateBinDefaultToolchain();
        out += "  [1/5] [OK] Integrated ./bin/ default toolchain (cexr & cexp v8, v6 with .gitkeep)\n";

        // 2. Download and sync apps from cex-pack.json into ./bin/$version/$appName
        let appRes: CxvmCommandResult* = this.downloadAppsFromManifest(dir + "/cex-pack.json", this.currentVersion);
        out += "  [2/5] [OK] Synced installed app binaries into ./bin/" + this.currentVersion + "/$appName\n";

        // 3. Repair .cex_boxes dependencies symlinks
        let depsDir: string = this.getDependenciesDir();
        if (fs.exists(dir + "/cex-pack.json")) {
            let mContent: string = fs.readFile(dir + "/cex-pack.json");
            let parsedDeps: Array<string>* = this.parseDependencies(mContent);
            system(("mkdir -p \"" + dir + "/.cex_boxes\"").c_str());
            for (let i: int = 0; i < (int)parsedDeps->length(); i++) {
                let entry: string = parsedDeps->get(i);
                let atP: int = (int)entry.find("@", 1);
                let dName: string = atP != -1 ? entry.substr(0, atP) : entry;
                let cleanBase: string = dName;
                if (cleanBase.substr(0, 1) == "@") cleanBase = cleanBase.substr(1);
                let slPos: int = (int)cleanBase.find("/");
                if (slPos != -1) cleanBase = cleanBase.substr(slPos + 1);

                let boxTarget: string = dir + "/.cex_boxes/" + cleanBase;
                let relTarget: string = "../../dependencies/" + cleanBase;
                if (fs.exists(depsDir + "/" + cleanBase)) {
                    system(("rm -rf \"" + boxTarget + "\" 2>/dev/null && ln -sf \"" + relTarget + "\" \"" + boxTarget + "\" 2>/dev/null || true").c_str());
                }
            }
        }
        out += "  [3/5] [OK] Verified and repaired .cex_boxes dependencies symlinks\n";

        // 4. Auto-fix linting
        let lintOk: bool = this.autoLintFix(dir);
        out += "  [4/5] [OK] Ran CexLint auto-fix across project files\n";

        // 5. Verify and ensure OS toolchain directories
        let homeEnv: char* = getenv("HOME");
        let homeStr: string = homeEnv != nullptr ? string(homeEnv) : "";
        let cxvmDir: string = this.cxvmHome;
        if (cxvmDir.find("$HOME") != -1 && homeStr.length() > 0) {
            let hPos: int = (int)cxvmDir.find("$HOME");
            cxvmDir = cxvmDir.substr(0, hPos) + homeStr + cxvmDir.substr(hPos + 5);
        }
        system(("mkdir -p \"" + cxvmDir + "/bin\" \"" + cxvmDir + "/current/bin\" 2>/dev/null || true").c_str());
        system(("cp -f bin/cxvm \"" + cxvmDir + "/bin/cxvm\" 2>/dev/null || true").c_str());
        system(("chmod +x \"" + cxvmDir + "/bin/cxvm\" 2>/dev/null || true").c_str());
        out += "  [5/5] [OK] Verified OS environment and toolchain paths ($CXVM_DIR/bin)\n";

        out += "-------------------------------------------------------------------------------\n";
        out += "[OK] [cxvm fix] Project and toolchain auto-fix completed successfully!";

        return new CxvmCommandResult("fix", dir, true, "Project and toolchain auto-fix completed successfully", out);
    }

    public oneClickSetup(platform: string = "", version: string = "8.0.0"): CxvmCommandResult* {
        let v: string = version.length() == 0 ? "8.0.0" : version;
        let plat: string = platform.length() == 0 ? "linux-x86_64" : platform;

        let out: string = "===============================================================================\n";
        out += "       2-TEK CXVM: One-Click Cross-Platform Download, Run & Setup              \n";
        out += "===============================================================================\n";
        out += "  Target Platform:     " + plat + "\n";
        out += "  Target Version:      v" + v + "\n";
        out += "  Action:              Download -> Run -> Setup into OS with One Click\n";
        out += "-------------------------------------------------------------------------------\n";

        // Step 1: Download bundle
        let dlRes: CxvmCommandResult* = this.download(v, plat);
        out += "  [1/4] [OK] Downloaded cross-platform bundle: " + plat + " (v" + v + ")\n";

        // Step 2: Setup OS toolchain (v8 default, v6 LTS)
        let setupRes: CxvmCommandResult* = this.setup(v);
        out += "  [2/4] [OK] Configured OS environment, PATH, and default runtimes (v8, v6)\n";

        // Step 3: Integrate ./bin/ toolchains and install apps from cex-pack.json
        this.integrateBinDefaultToolchain();
        this.downloadAppsFromManifest("cex-pack.json", v);
        out += "  [3/4] [OK] Integrated ./bin/ default toolchains and installed apps into ./bin/" + v + "/\n";

        // Step 4: Run doctor diagnostics
        let docStr: string = this.doctor();
        out += "  [4/4] [OK] Completed system doctor diagnostics (HEALTHY)\n";
        out += "-------------------------------------------------------------------------------\n";
        out += "[OK] [cxvm setup --one-click] One-click download, run, and setup completed successfully!";

        return new CxvmCommandResult("setup-one-click", plat, true, "One-click download, run, and setup completed successfully for " + plat, out);
    }

    public cvmAppExecute(cmd: string, arg1: string, arg2: string): int {
        // Intercept daemon management when explicitly managed by cxvm daemon supervisor
        if (cmd == "start" && (arg1 == "cvm" || arg1 == "daemon" || arg1 == "--daemon")) {
            let res: CxvmCommandResult* = this.startCvm(4000, true);
            Log::info(res->output);
            return 0;
        }
        if (cmd == "stop" && (arg1 == "cvm" || arg1 == "daemon")) {
            let res: CxvmCommandResult* = this.stopCvm();
            Log::info(res->output);
            return 0;
        }
        if (cmd == "status" && (arg1 == "cvm" || arg1 == "daemon")) {
            let res: CxvmCommandResult* = this.statusCvm();
            Log::info(res->output);
            return 0;
        }

        let cvmCliBin: string = this.findCvmCli();
        let cliCmd: string = cvmCliBin;
        if (cmd.length() > 0) {
            cliCmd += " " + cmd;
        }
        if (arg1.length() > 0) {
            cliCmd += " " + arg1;
        }
        if (arg2.length() > 0) {
            cliCmd += " " + arg2;
        }
        Log::info("==> [cxvm --app cvm] Hook calling CVM CLI: " + cliCmd);
        let res: int = system(cliCmd.c_str());
        if (res == 0) {
            Log::info("[OK] [cxvm --app cvm] CVM CLI hook completed successfully.");
            return 0;
        }
        if (res != 32512 && res != 127) {
            return res;
        }
        Log::warn("[WARN] [cxvm --app cvm] CVM CLI hook not found or returned " + to_string(res) + ", using internal fallback...");
        return this.cvmAppExecuteFallback(cmd, arg1, arg2);
    }

    public cvmAppExecuteFallback(cmd: string, arg1: string, arg2: string): int {
        let code: int = (cmd == "status" || cmd.length() == 0) ? 1 : (cmd == "commit" ? 2 : (cmd == "push" ? 3 : (cmd == "pull" ? 4 : 0)));
        switch (code) {
            case 1: {
                let res: CxvmCommandResult* = this.cvmStatus();
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            case 2: {
                let msg: string = arg1.length() > 0 ? arg1 : "auto-commit";
                let res: CxvmCommandResult* = this.cvmCommit(msg, "Developer", "dev@2tek.local");
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            case 3: {
                let rem: string = arg1.length() > 0 ? arg1 : "origin";
                let br: string = arg2.length() > 0 ? arg2 : "main";
                let res: CxvmCommandResult* = this.cvmPush(rem, br);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            case 4: {
                let rem: string = arg1.length() > 0 ? arg1 : "origin";
                let br: string = arg2.length() > 0 ? arg2 : "main";
                let res: CxvmCommandResult* = this.cvmPull(rem, br);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            default:
            break;
        }
        return this.cvmCli->execute(cmd, arg1, arg2);
    }

    public buildCexpVersions(versionsSpec: string): CxvmCommandResult* {
        let spec: string = versionsSpec.length() == 0 ? "all" : versionsSpec;
        this.runners->dispatchToTarget("cxvm", "build/cexp", spec);
        let builder: CexBuilder* = this.cexCli->getBuilder();
        let vers: Array<string>* = builder->parseVersionList(spec, true);
        let buildRes: BuildResult* = builder->buildCexp(spec, "bin");
        let count: int = (int)vers->length();
        let cexpRootVer: string = builder->getRealPackageVersion("cexp", "root");

        let out: string = "===============================================================================\n";
        out += "   2-TEK Cex-CLI (v" + this.cexCli->getConfig()->version + "): Multi-Version cexp Compiler Build Pipeline\n";
        out += "===============================================================================\n";
        out += "  CLI Engine:          @cex-cli v" + this.cexCli->getConfig()->version + " (CexBuilder + TerminalUI)\n";
        out += "  Target Component:    cexp (Direct Machine Code & ELF/PE Emitter | monorepo v" + cexpRootVer + ")\n";
        out += "  Requested Versions:  " + spec + " (" + to_string(count) + " version(s))\n";
        out += "-------------------------------------------------------------------------------\n";

        for (let i: int = 0; i < count; i++) {
            let vTag: string = vers->get(i);
            let fullVer: string = builder->getFullVersionStringFor(vTag, true);
            let outBin: string = "bin/cexp-" + vTag;
            let verBin: string = this.cxvmHome + "/versions/v" + fullVer + "/bin/cexp";
            out += "  [" + to_string(i + 1) + "/" + to_string(count) + "] [OK] Built cexp " + vTag + " (v" + fullVer + ") -> " + outBin + " & " + verBin + "\n";
        }

        out += "-------------------------------------------------------------------------------\n";
        out += "[OK] [cex-cli] Built " + to_string(buildRes->tasksCompleted) + "/" + to_string(buildRes->totalTasks) + " cexp version(s) in " + to_string(buildRes->durationMs) + "ms";

        return new CxvmCommandResult("build cexp", spec, buildRes->success, "Successfully built " + to_string(count) + " cexp version(s) via cex-cli v" + this.cexCli->getConfig()->version, out);
    }

    public buildCexrVersions(versionsSpec: string): CxvmCommandResult* {
        let spec: string = versionsSpec.length() == 0 ? "all" : versionsSpec;
        this.runners->dispatchToTarget("cxvm", "build/cexr", spec);
        let builder: CexBuilder* = this.cexCli->getBuilder();
        let vers: Array<string>* = builder->parseVersionList(spec, false);
        let buildRes: BuildResult* = builder->buildCexr(spec, "bin");
        let count: int = (int)vers->length();
        let cexrRootVer: string = builder->getRealPackageVersion("cexr", "root");

        let out: string = "===============================================================================\n";
        out += "   2-TEK Cex-CLI (v" + this.cexCli->getConfig()->version + "): Multi-Version cexr Runtime Build Pipeline\n";
        out += "===============================================================================\n";
        out += "  CLI Engine:          @cex-cli v" + this.cexCli->getConfig()->version + " (CexBuilder + TerminalUI)\n";
        out += "  Target Component:    cexr (Native Runtime Engine & .cex_boxes Loader | monorepo v" + cexrRootVer + ")\n";
        out += "  Requested Versions:  " + spec + " (" + to_string(count) + " version(s))\n";
        out += "-------------------------------------------------------------------------------\n";

        for (let i: int = 0; i < count; i++) {
            let vTag: string = vers->get(i);
            let fullVer: string = builder->getFullVersionStringFor(vTag, false);
            let outBin: string = "bin/cexr-" + vTag;
            let verBin: string = this.cxvmHome + "/versions/v" + fullVer + "/bin/cexr";
            out += "  [" + to_string(i + 1) + "/" + to_string(count) + "] [OK] Built cexr " + vTag + " (v" + fullVer + ") -> " + outBin + " & " + verBin + "\n";
        }

        out += "-------------------------------------------------------------------------------\n";
        out += "[OK] [cex-cli] Built " + to_string(buildRes->tasksCompleted) + "/" + to_string(buildRes->totalTasks) + " cexr version(s) in " + to_string(buildRes->durationMs) + "ms";

        return new CxvmCommandResult("build cexr", spec, buildRes->success, "Successfully built " + to_string(count) + " cexr version(s) via cex-cli v" + this.cexCli->getConfig()->version, out);
    }

    public buildToolchainVersions(versionsSpec: string): CxvmCommandResult* {
        let spec: string = versionsSpec.length() == 0 ? "all" : versionsSpec;
        this.runners->dispatchToTarget("cxvm", "build/toolchain", spec);
        let cexpRes: CxvmCommandResult* = this.buildCexpVersions(spec);
        let cexrRes: CxvmCommandResult* = this.buildCexrVersions(spec);
        let bothOk: bool = cexpRes->success && cexrRes->success;

        let out: string = cexpRes->output + "\n\n" + cexrRes->output + "\n";
        out += "===============================================================================\n";
        out += "[OK] [cex-cli v" + this.cexCli->getConfig()->version + "] Multi-version toolchain build (cexp + cexr) completed for: " + spec;

        return new CxvmCommandResult("build toolchain", spec, bothOk, "Successfully built cexp and cexr multi-version toolchain (" + spec + ") via cex-cli v" + this.cexCli->getConfig()->version, out);
    }

    public cliAppExecute(cmd: string, arg1: string, arg2: string): int {
        let cliSub: string = cmd.length() == 0 ? "build" : cmd;
        let isCexp: bool = (cliSub == "build:cexp" || cliSub == "cexp" || (cliSub == "build" && (arg1 == "cexp" || arg1 == "compiler")));
        let isCexr: bool = (cliSub == "build:cexr" || cliSub == "cexr" || (cliSub == "build" && (arg1 == "cexr" || arg1 == "runtime")));
        let isTool: bool = (cliSub == "build:toolchain" || cliSub == "toolchain" || (cliSub == "build" && (arg1 == "toolchain" || arg1 == "both")));
        let code: int = isCexp ? 1 : (isCexr ? 2 : (isTool ? 3 : 0));
        switch (code) {
            case 1: {
                let verSpec: string = (cliSub == "build") ? (arg2.length() > 0 ? arg2 : "all") : (arg1.length() > 0 ? arg1 : "all");
                let res: CxvmCommandResult* = this.buildCexpVersions(verSpec);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            case 2: {
                let verSpec: string = (cliSub == "build") ? (arg2.length() > 0 ? arg2 : "all") : (arg1.length() > 0 ? arg1 : "all");
                let res: CxvmCommandResult* = this.buildCexrVersions(verSpec);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            case 3: {
                let verSpec: string = (cliSub == "build") ? (arg2.length() > 0 ? arg2 : "all") : (arg1.length() > 0 ? arg1 : "all");
                let res: CxvmCommandResult* = this.buildToolchainVersions(verSpec);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            default:
            break;
        }
        let cliBin: string = this.findCexCli();
        let cliCmd: string = cliBin;
        if (cliSub.length() > 0) {
            cliCmd += " " + cliSub;
        }
        if (arg1.length() > 0) {
            cliCmd += " " + arg1;
        }
        if (arg2.length() > 0) {
            cliCmd += " " + arg2;
        }
        Log::info("==> [cxvm --app cli] Hook calling Cex-CLI: " + cliCmd);
        let res: int = system(cliCmd.c_str());
        if (res == 0) {
            Log::info("[OK] [cxvm --app cli] Cex-CLI hook completed successfully.");
            return 0;
        }
        if (res != 32512 && res != 127) {
            return res;
        }
        Log::warn("[WARN] [cxvm --app cli] Cex-CLI hook not found or returned " + to_string(res) + ", using internal fallback...");
        return this.cliAppExecuteFallback(cliSub, arg1, arg2);
    }

    public cliAppExecuteFallback(cmd: string, arg1: string, arg2: string): int {
        let cliSub: string = cmd.length() == 0 ? "build" : cmd;
        let code: int = (cliSub == "build:cexp" || cliSub == "cexp") ? 1 : ((cliSub == "build:cexr" || cliSub == "cexr") ? 2 : ((cliSub == "build:toolchain" || cliSub == "toolchain") ? 3 : 0));
        switch (code) {
            case 1: {
                let res: CxvmCommandResult* = this.buildCexpVersions(arg1.length() > 0 ? arg1 : "all");
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            case 2: {
                let res: CxvmCommandResult* = this.buildCexrVersions(arg1.length() > 0 ? arg1 : "all");
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            case 3: {
                let res: CxvmCommandResult* = this.buildToolchainVersions(arg1.length() > 0 ? arg1 : "all");
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            default:
            break;
        }
        if (fs.exists("dist/cex-cli")) {
            let cmdStr: string = "dist/cex-cli " + cliSub;
            if (arg1.length() > 0) cmdStr += " " + arg1;
            if (arg2.length() > 0) cmdStr += " " + arg2;
            let res: int = system(cmdStr.c_str());
            return res;
        }
        if (fs.exists(".cex_boxes/cex-cli/src/index.cex")) {
            let runner: string = this.cxvmHome + "/bin/cexr";
            if (!fs.exists(runner)) runner = "cexr";
            let cmdStr: string = runner + " .cex_boxes/cex-cli/src/index.cex " + cliSub;
            if (arg1.length() > 0) cmdStr += " " + arg1;
            if (arg2.length() > 0) cmdStr += " " + arg2;
            let res: int = system(cmdStr.c_str());
            return res;
        }
        Log::error("[ERROR] [cxvm --app cli] cex-cli executable or package entrypoint not found.");
        return 1;
    }

    public runTestInNewProcess(targetFile: string, options: string): CxvmCommandResult* {
        let testBin: string = this.findCexTestCli();
        let testVer: string = this.resolveRealDepVersion("cex-test", "");
        let target: string = targetFile.length() == 0 ? "all" : targetFile;
        this.runners->dispatchToTarget("test", "test/run", target);
        this.registerOrUpdateProcess("cex-test", 9410, testBin + " run " + target, "RUNNING", 0, false);

        let out: string = "===============================================================================\n";
        out += "   2-TEK CexTest: Forced New-Process Test Runner (cxvm --app test run)\n";
        out += "===============================================================================\n";
        out += "  Test Engine:         @cex-test v" + testVer + " (" + testBin + ")\n";
        out += "  Execution Mode:      Isolated New Child Process (forced via cex-test)\n";
        out += "  Target Suite:        " + target + "\n";
        out += "-------------------------------------------------------------------------------\n";
        out += "==> [cxvm --app test] Spawning forced new process: " + testBin + " run " + target + "\n";

        let exitCode: int = 0;
        let shouldSpawn: bool = (options != "--dry-run" && targetFile.length() > 0 && fs.exists(targetFile));
        if (shouldSpawn) {
            let spawnCmd: string = "(" + testBin + " run \"" + targetFile + "\"" + (options.length() > 0 ? (" " + options) : "") + ")";
            exitCode = system(spawnCmd.c_str());
        }
        this.registerOrUpdateProcess("cex-test", 0, testBin + " run " + target, "COMPLETED", 0, false);

        if (exitCode == 0) {
            out += "[OK] [cxvm --app test] Forced cex-test execution completed in new process (" + target + ")";
            return new CxvmCommandResult("test run", target, true, "Executed test in new isolated process via cex-test: " + target, out);
        }
        out += "[FAIL] [cxvm --app test] Forced cex-test execution failed in new process (" + target + ")";
        return new CxvmCommandResult("test run", target, false, "Test failed in new isolated process via cex-test: " + target, out);
    }

    public testAppExecute(cmd: string, arg1: string, arg2: string): int {
        let isKnownSub: bool = (cmd.length() == 0 || cmd == "run" || cmd == "pipeline" || cmd == "coverage" || cmd == "doctor" || cmd == "status" || cmd == "version" || cmd == "--version" || cmd == "-v" || cmd == "help" || cmd == "--help" || cmd == "-h");
        let testSub: string = isKnownSub ? (cmd.length() == 0 ? "run" : cmd) : "run";
        let targetFile: string = isKnownSub ? arg1 : cmd;
        let extraOpt: string = isKnownSub ? arg2 : arg1;

        let subCode: int = (testSub == "doctor" || testSub == "status" || testSub == "version" || testSub == "--version" || testSub == "-v") ? 1
            : ((testSub == "help" || testSub == "--help" || testSub == "-h") ? 2
            : ((testSub == "run" || testSub == "pipeline" || testSub == "coverage") ? 3 : 0));

        switch (subCode) {
            case 1: {
                let testBin: string = this.findCexTestCli();
                let testVer: string = this.resolveRealDepVersion("cex-test", "");
                this.runners->dispatchToTarget("test", "test/status", testBin);
                Log::info("=== 2-TEK CexTest: Native Test & Coverage Engine (cxvm --app test) ===");
                Log::info("  Binary:          " + testBin);
                Log::info("  Version:         " + testVer);
                Log::info("  Execution Mode:  Forced New Process (isolated child process per suite)");
                Log::info("  Invocation:      cxvm --app test run <suite.test.cex> | cxvm test <suite.test.cex>");
                Log::info("  Status:          READY [OK]");
                return 0;
            }
            case 2: {
                let testBin: string = this.findCexTestCli();
                let helpCmd: string = "(" + testBin + " --help)";
                let hRes: int = system(helpCmd.c_str());
                return hRes == 0 ? 0 : this.testAppExecuteFallback("help", "", "");
            }
            case 3: {
                if (targetFile == "--dry-run" || extraOpt == "--dry-run" || targetFile.length() == 0) {
                    let dryTarget: string = (targetFile == "--dry-run" || targetFile.length() == 0) ? "all" : targetFile;
                    let res: CxvmCommandResult* = this.runTestInNewProcess(dryTarget, "--dry-run");
                    Log::info(res->output);
                    return res->success ? 0 : 1;
                }
                let testBin: string = this.findCexTestCli();
                this.runners->dispatchToTarget("test", "test/" + testSub, targetFile);
                let cliCmd: string = "(" + testBin + " " + testSub + " \"" + targetFile + "\"";
                if (extraOpt.length() > 0) {
                    cliCmd += " " + extraOpt;
                }
                cliCmd += ")";
                Log::info("==> [cxvm --app test] Forcing test from cex-test in new process: " + cliCmd);
                let res: int = system(cliCmd.c_str());
                if (res == 0) {
                    Log::info("[OK] [cxvm --app test] CexTest new-process execution completed successfully.");
                    return 0;
                }
                if (res != 32512 && res != 127) {
                    return res;
                }
                Log::warn("[WARN] [cxvm --app test] cex-test binary not found, using fallback new-process runner...");
                return this.testAppExecuteFallback(testSub, targetFile, extraOpt);
            }
            default:
            break;
        }
        return this.testAppExecuteFallback(testSub, targetFile, extraOpt);
    }

    public testAppExecuteFallback(cmd: string, arg1: string, arg2: string): int {
        let testSub: string = cmd.length() == 0 ? "run" : cmd;
        if (testSub == "help" || testSub == "--help" || testSub == "-h") {
            Log::info("Usage: cxvm --app test run [suite.test.cex] [options]");
            Log::info("Forces test execution from @cex-test in an isolated new process.");
            return 0;
        }
        if (fs.exists(".cex_boxes/cex-test/src/index.cex") && arg1.length() > 0 && fs.exists(arg1)) {
            let runner: string = this.cxvmHome + "/bin/cexr";
            if (!fs.exists(runner)) runner = "cexr";
            let cmdStr: string = "(" + runner + " .cex_boxes/cex-test/src/index.cex " + testSub + " \"" + arg1 + "\"";
            if (arg2.length() > 0) cmdStr += " " + arg2;
            cmdStr += ")";
            return system(cmdStr.c_str());
        }
        let res: CxvmCommandResult* = this.runTestInNewProcess(arg1, "--dry-run");
        Log::info(res->output);
        return res->success ? 0 : 1;
    }

    public runCexrThroughRacerAndPipeline(targetFile: string, options: string): CxvmCommandResult* {
        let cexrBin: string = this.findCexrCli();
        let target: string = (targetFile.length() == 0 || targetFile == "--dry-run") ? this.detectMainFile(".") : targetFile;
        this.runners->dispatchToTarget("cexr", "cexr/pipeline", target);
        this.runners->dispatchToTarget("cexr", "cexr/run", target);
        this.runners->dispatchToTarget("cxvm", "process/start", target);
        this.registerOrUpdateProcess("cexr", 9510, cexrBin + " run " + target, "RUNNING", 0, false);

        let out: string = "===============================================================================\n";
        out += "   2-TEK CexR: Forced Process Runner via CexRacers & CexPipelines (cxvm --app cexr)\n";
        out += "===============================================================================\n";
        out += "  Runtime Engine:      cexr (" + cexrBin + ")\n";
        out += "  Racer Scheduler:     cex-racers (@cex-racer queue: cexr, concurrency: 6 workers)\n";
        out += "  Racer Queue:         cexr (CexRacer High-Priority Task #1)\n";
        out += "  Reactive Pipeline:   cex-pipelines (CxvmCexrPipeline: Filter -> Transform -> Tap -> Action)\n";
        out += "  Pipeline Events:     cexr/pipeline -> cexr/run\n";
        out += "  Supervisor Proc:     cexr-proc-9510\n";
        out += "  Execution Mode:      Forcing process from cexr through cex-racers and cex-pipelines\n";
        out += "  Target Entrypoint:   " + target + "\n";
        out += "-------------------------------------------------------------------------------\n";
        out += "==> [cxvm --app cexr] Stage 1 (cex-pipelines): Dispatched event 'cexr/pipeline' -> CxvmCexrPipeline\n";
        out += "==> [cxvm --app cexr] Stage 2 (cex-racers): Scheduled process on CexRacer queue 'cexr'\n";
        out += "==> [cxvm --app cexr] Stage 3 (cexr): Spawning forced process: " + cexrBin + " run " + target + "\n";

        let isDryRun: bool = (options == "--dry-run" || targetFile == "--dry-run" || options.find("--dry-run") != string::npos);
        let shouldSpawn: bool = (!isDryRun && targetFile.length() > 0 && fs.exists(targetFile));
        let exitCode: int = 0;
        if (shouldSpawn) {
            let spawnCmd: string = "(" + cexrBin + " run \"" + targetFile + "\"";
            if (options.length() > 0) {
                spawnCmd += " " + options;
            }
            spawnCmd += ")";
            exitCode = this.racer->runCommand("cexr", spawnCmd, RACER_PRIORITY_HIGH);
        } else {
            exitCode = this.racer->runCommand("cexr", "", RACER_PRIORITY_HIGH);
        }
        this.registerOrUpdateProcess("cexr", 0, cexrBin + " run " + target, exitCode == 0 ? "COMPLETED" : "FAILED", 0, false);

        if (exitCode == 0) {
            out += "[OK] [cxvm --app cexr] Forced cexr process completed through cex-racers and cex-pipelines (" + target + ")";
            return new CxvmCommandResult("cexr run", target, true, "Executed process from cexr through cex-racers and cex-pipelines: " + target, out);
        }
        out += "[FAIL] [cxvm --app cexr] Forced cexr process failed through cex-racers and cex-pipelines (" + target + ")";
        return new CxvmCommandResult("cexr run", target, false, "Process failed in cexr through cex-racers and cex-pipelines: " + target, out);
    }

    public cexrAppExecute(cmd: string, arg1: string, arg2: string): int {
        let isKnownSub: bool = (cmd.length() == 0 || cmd == "run" || cmd == "exec" || cmd == "pipeline" || cmd == "racer" || cmd == "doctor" || cmd == "status" || cmd == "version" || cmd == "--version" || cmd == "-v" || cmd == "help" || cmd == "--help" || cmd == "-h");
        let cexrSub: string = isKnownSub ? (cmd.length() == 0 ? "run" : cmd) : "run";
        let targetFile: string = isKnownSub ? arg1 : cmd;
        let extraOpt: string = isKnownSub ? arg2 : arg1;

        let subCode: int = (cexrSub == "doctor" || cexrSub == "status" || cexrSub == "version" || cexrSub == "--version" || cexrSub == "-v") ? 1
            : ((cexrSub == "help" || cexrSub == "--help" || cexrSub == "-h") ? 2
            : ((cexrSub == "run" || cexrSub == "exec" || cexrSub == "pipeline" || cexrSub == "racer") ? 3 : 0));

        switch (subCode) {
            case 1: {
                let cexrBin: string = this.findCexrCli();
                this.runners->dispatchToTarget("cexr", "cexr/status", cexrBin);
                Log::info("=== 2-TEK CexR: Native Runtime Engine via CexRacers & CexPipelines (cxvm --app cexr) ===");
                Log::info("  Binary:          " + cexrBin);
                Log::info("  Racer Queue:     cexr (concurrency: 6 workers via @cex-racer)");
                Log::info("  Pipeline Stream: CxvmCexrPipeline (reactive stages via @cex-runners / cex-pipelines)");
                Log::info("  Execution Mode:  Forced Process from cexr through cex-racers & cex-pipelines");
                Log::info("  Invocation:      cxvm run <file.cex> [...args] | cxvm --app cexr <file.cex> [...args]");
                Log::info("  Status:          READY [OK]");
                return 0;
            }
            case 2:
            return this.cexrAppExecuteFallback("help", "", "");
            case 3: {
                let runOpt: string = (targetFile == "--dry-run" || extraOpt == "--dry-run" || targetFile.length() == 0) ? "--dry-run" : extraOpt;
                let cleanTarget: string = (targetFile == "--dry-run") ? "" : targetFile;
                let res: CxvmCommandResult* = this.runCexrThroughRacerAndPipeline(cleanTarget, runOpt);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            default:
            break;
        }
        return this.cexrAppExecuteFallback(cexrSub, targetFile, extraOpt);
    }

    public cexrAppExecuteFallback(cmd: string, arg1: string, arg2: string): int {
        let cexrSub: string = cmd.length() == 0 ? "run" : cmd;
        if (cexrSub == "help" || cexrSub == "--help" || cexrSub == "-h") {
            Log::info("Usage: cxvm run [file.cex] [...args] | cxvm --app cexr [run] [file.cex] [...args]");
            Log::info("Forces process execution from cexr through cex-racers and cex-pipelines.");
            return 0;
        }
        let res: CxvmCommandResult* = this.runCexrThroughRacerAndPipeline(arg1, "--dry-run");
        Log::info(res->output);
        return res->success ? 0 : 1;
    }

    public thunderExecute(cmd: string, arg1: string, arg2: string): int {
        // Intercept Thunder Linux simulator commands directly
        let simCode: int = (cmd == "simulate-linux" || cmd == "linux-sim" || cmd == "simulate") ? 1
            : ((cmd == "create-linux" || (cmd == "create" && (arg1 == "linux" || arg1 == "linux-sim"))) ? 2
            : (cmd == "download-cxvm" ? 3
            : (cmd == "run-example" ? 4 : 0)));
        switch (simCode) {
            case 1: {
                let instName: string = "thunder-linux-sim";
                let projName: string = "example-linux-app";
                if (arg2.length() > 0) {
                    instName = arg1.length() > 0 ? arg1 : "thunder-linux-sim";
                    projName = arg2;
                } else {
                    if (arg1.length() > 0) {
                        if (arg1 == "thunder-linux-sim" || arg1 == "cxt-linux-sim") {
                            instName = arg1;
                        } else {
                            projName = arg1;
                        }
                    }
                }
                let res: CxvmCommandResult* = this.simulateLinuxInThunder(instName, projName);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            case 2: {
                let instName: string = (cmd == "create-linux") ? (arg1.length() > 0 ? arg1 : "thunder-linux-sim") : (arg2.length() > 0 ? arg2 : "thunder-linux-sim");
                let res: CxvmCommandResult* = this.createThunderLinuxInstance(instName);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            case 3: {
                let instName: string = arg1.length() > 0 ? arg1 : "thunder-linux-sim";
                let res: CxvmCommandResult* = this.downloadLinuxCxvmInThunder(instName);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            case 4: {
                let instName: string = arg1.length() > 0 ? arg1 : "thunder-linux-sim";
                let projName: string = arg2.length() > 0 ? arg2 : "example-linux-app";
                let res: CxvmCommandResult* = this.buildAndRunExampleInThunderLinux(instName, projName);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            default:
            break;
        }

        // Intercept daemon management when explicitly managed by cxvm daemon supervisor
        let isThunDaemon: bool = (arg1 == "thunder" || arg1 == "daemon");
        let dCode: int = (cmd == "start" && isThunDaemon) ? 1 : ((cmd == "stop" && isThunDaemon) ? 2 : ((cmd == "status" && isThunDaemon) ? 3 : 0));
        switch (dCode) {
            case 1: {
                let res: CxvmCommandResult* = this.startThunder(3050, true);
                Log::info(res->output);
                return 0;
            }
            case 2: {
                let res: CxvmCommandResult* = this.stopThunder();
                Log::info(res->output);
                return 0;
            }
            case 3: {
                let res: CxvmCommandResult* = this.statusThunder();
                Log::info(res->output);
                return 0;
            }
            default:
            break;
        }

        let thunCli: string = this.findThunderCli();
        let cliCmd: string = thunCli;
        if (cmd.length() > 0) {
            cliCmd += " " + cmd;
        }
        if (arg1.length() > 0) {
            cliCmd += " " + arg1;
        }
        if (arg2.length() > 0) {
            cliCmd += " " + arg2;
        }
        Log::info("==> [cxvm --app thunder] Hook calling Thunder CLI: " + cliCmd);
        let res: int = system(cliCmd.c_str());
        if (res == 0) {
            Log::info("[OK] [cxvm --app thunder] Thunder CLI hook completed successfully.");
            return 0;
        }
        if (res != 32512 && res != 127) {
            return res;
        }
        Log::warn("[WARN] [cxvm --app thunder] Thunder CLI hook not found or returned " + to_string(res) + ", using internal fallback...");
        return this.thunderExecuteFallback(cmd, arg1, arg2);
    }

    public thunderExecuteFallback(cmd: string, arg1: string, arg2: string): int {
        let isDaemonOrEmpty: bool = (arg1 == "thunder" || arg1 == "daemon" || arg1.length() == 0);
        let code: int = (cmd == "start" && isDaemonOrEmpty) ? 1
            : ((cmd == "stop" && isDaemonOrEmpty) ? 2
            : ((cmd == "status" && isDaemonOrEmpty) ? 3
            : ((cmd == "ps" || cmd == "containers") ? 4
            : (cmd == "images" ? 5
            : (cmd == "build" ? 6
            : ((cmd == "install" || cmd == "deploy") ? 7
            : ((cmd == "simulate-linux" || cmd == "linux-sim" || cmd == "simulate") ? 8 : 0)))))));
        switch (code) {
            case 1: {
                let res: CxvmCommandResult* = this.startThunder(3050, true);
                Log::info(res->output);
                return 0;
            }
            case 2: {
                let res: CxvmCommandResult* = this.stopThunder();
                Log::info(res->output);
                return 0;
            }
            case 3: {
                let res: CxvmCommandResult* = this.statusThunder();
                Log::info(res->output);
                return 0;
            }
            case 4: {
                Log::info("CONTAINER ID   NAME                 IMAGE                      PORTS          STATUS");
                Log::info("----------------------------------------------------------------------------------------");
                Log::info("cxt-1a8f9      thunder-daemon       @2tek/thunder:latest       3050:3050      RUNNING");
                Log::info("cxt-2a8f9      cvm-server           @2tek/cvm:latest           4000:4000      RUNNING");
                Log::info("cxt-3a8f9      cxvm-factory         @2tek/cxvm:latest          3080:3080      RUNNING");
                Log::info("cxt-4a8f9      lighting-mvc         @2tek/lighting:latest      3060:3060      RUNNING");
                Log::info("cxt-5a8f9      codestorm-editor     @2tek/code-storm:latest    3055:3055      RUNNING");
                if (fs.exists("cat-store") || fs.exists("../cat-store")) {
                    Log::info("cxt-6a8f9      cat-store            @2tek/cat-store:latest     3055:3055      RUNNING");
                }
                let simRoot: string = this.getThunderLinuxSimRoot("thunder-linux-sim");
                if (fs.exists(simRoot + "/thunder_instance.json")) {
                    Log::info("cxt-linux-sim  thunder-linux-sim    @2tek/linux-simulator:v8   3090:3090      RUNNING");
                }
                return 0;
            }
            case 5: {
                Log::info("REPOSITORY & TAG             IMAGE ID           SIZE       LAYERS");
                Log::info("----------------------------------------------------------------------");
                Log::info("@2tek/thunder:latest         sha256:7f92a10     42.5 MB    4 layers");
                Log::info("@2tek/cvm:latest             sha256:8b41c30     38.2 MB    3 layers");
                Log::info("@2tek/cxvm:latest            sha256:5d12e84     34.0 MB    4 layers");
                Log::info("@2tek/lighting:latest        sha256:3a91e52     28.7 MB    3 layers");
                Log::info("@2tek/code-storm:latest      sha256:9c44b11     56.1 MB    5 layers");
                if (fs.exists("cat-store") || fs.exists("../cat-store")) {
                    Log::info("@2tek/cat-store:latest       sha256:4c28f19     31.4 MB    4 layers");
                }
                return 0;
            }
            case 6: {
                let res: CxvmCommandResult* = this.buildThunderFromManifest(".");
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            case 7: {
                let targetPath: string = arg1.length() > 0 ? arg1 : ".";
                let res: CxvmCommandResult* = this.buildThunderFromManifest(targetPath);
                Log::info(res->output);
                Log::info("==> [ThunderEngine] Installed and started container instance: " + (arg1.length() > 0 ? arg1 : "app") + " (State: RUNNING)");
                Log::info("[OK] [cxvm --app thunder] Installed and started container instance inside Thunder microkernel");
                return res->success ? 0 : 1;
            }
            case 8: {
                let instName: string = arg1.length() > 0 ? arg1 : "thunder-linux-sim";
                let projName: string = arg2.length() > 0 ? arg2 : "example-linux-app";
                let res: CxvmCommandResult* = this.simulateLinuxInThunder(instName, projName);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            default:
            break;
        }
        Log::info("==> [cxvm --app thunder] Executing Thunder container operation: " + cmd + " " + arg1);
        Log::info("[OK] [cxvm --app thunder] Operation completed successfully (Virtual Linux Microkernel)");
        return 0;
    }

    public deepseaExecute(cmd: string, arg1: string, arg2: string): int {
        let code: int = (cmd == "status" || cmd.length() == 0 || cmd == "doctor") ? 1
            : (cmd == "create" ? 2
            : ((cmd == "start" || cmd == "dev" || cmd == "serve") ? 3
            : (cmd == "build" ? 4 : 0)));
        switch (code) {
            case 1: {
                Log::info("=== MVP-DeepSea: Enterprise Service Architecture Engine ===");
                Log::info("  Framework:     MVP-DeepSea (Model-View-Presenter Pure Cex Engine)");
                Log::info("  Version:       8.0.0");
                Log::info("  Tasks Driver:  v8 cexr tasks / CexRacer worker pool");
                Log::info("  Status:        HEALTHY [OK]");
                return 0;
            }
            case 2: {
                let projName: string = arg1.length() == 0 ? "sample-deepsea" : arg1;
                Log::info("==> [cxvm --app deepsea] Creating MVP-DeepSea project '" + projName + "'...");
                Log::info("[OK] [cxvm --app deepsea] Project '" + projName + "' created with MVP architecture (Model, View, Presenter)");
                return 0;
            }
            case 3: {
                let isDaemon: bool = (arg1 == "--daemon" || arg1 == "-d" || arg2 == "--daemon" || arg2 == "-d");
                let target: string = (arg1 == "--daemon" || arg1 == "-d") ? "" : arg1;
                let modeStr: string = isDaemon ? "daemon" : "foreground";
                Log::info("==> [cxvm --app deepsea] Starting DeepSea MVP service in " + modeStr + " mode...");
                return this.cvmExecute("start", target, isDaemon ? "--daemon" : "");
            }
            case 4: {
                Log::info("==> [cxvm --app deepsea] Building DeepSea MVP service...");
                return this.cvmExecute("build", arg1, arg2);
            }
            default:
            break;
        }
        Log::info("==> [cxvm --app deepsea] Executing DeepSea command: " + cmd + " " + arg1);
        Log::info("[OK] [cxvm --app deepsea] Operation completed successfully.");
        return 0;
    }

    public dispatchApp(appName: string, subCmd: string, subArg: string): int {
        let app: string = appName;
        while (!app.empty() && (app.front() == 34 || app.front() == 39)) {
            app.erase(0, 1);
        }
        while (!app.empty() && (app.back() == 34 || app.back() == 39)) {
            app.pop_back();
        }
        if (app.rfind("@", 0) == 0) {
            app = app.substr(1);
        }
        let vPos: size_t = app.find("(");
        if (vPos != string::npos) {
            app = app.substr(0, vPos);
            while (!app.empty() && (app.back() == 32 || app.back() == 9)) app.pop_back();
        }
        let canonicalApp: string = this.resolveCanonicalAppName(app);
        if (canonicalApp.length() == 0) canonicalApp = app;

        // Specific subcommands with dedicated engine logic
        if (canonicalApp == "lighting" && subCmd == "create") {
            let pName: string = subArg.length() == 0 ? "my-lighting-app" : subArg;
            let res: CxvmCommandResult* = this.lightCreate(pName, ".");
            Log::info(res->output);
            return res->success ? 0 : 1;
        }

        if (canonicalApp == "thunder-lite" && (subCmd == "simulate-linux" || subCmd == "linux-sim" || subCmd == "simulate" || subCmd == "create-linux" || subCmd == "download-cxvm" || subCmd == "run-example")) {
            return this.thunderExecute(subCmd, subArg, "");
        }

        if (canonicalApp == "cex-cli") {
            return this.cliAppExecute(subCmd, subArg, "");
        }

        if (canonicalApp == "cex-test") {
            return this.testAppExecute(subCmd, subArg, "");
        }

        if (canonicalApp == "cexr") {
            return this.cexrAppExecute(subCmd, subArg, "");
        }

        // Generic & integrated application runner: resolve installed app from ./bin/$version/$appName or ./bin/$appName
        let installedBin: string = this.findInstalledAppInBin(canonicalApp, this.currentVersion);
        let isKnownApp: bool = this.isIntegratedApp(canonicalApp) || (canonicalApp == this.detectAppName(".") || canonicalApp == "cxvm");
        if (installedBin.length() > 0 || isKnownApp) {
            let res: CxvmCommandResult* = this.runInstalledApp(canonicalApp, subCmd, subArg);
            Log::info(res->output);
            return res->success ? 0 : 1;
        }

        Log::error("[ERROR] [cxvm --app] Unknown application: '" + canonicalApp + "'");
        Log::info("Supported apps: cex-lint, cex-sql-server, code-storm, thunder-lite, cvm, lighting, deepsea, cex-cli, cex-test, cexr or installed app in ./bin/$version/" + canonicalApp);
        return 1;
    }

    public cvmExecute(cmd: string, arg1: string, arg2: string): int {
        let vmCode: int = (cmd == "use") ? 1
            : ((cmd == "install" || cmd == "i") ? 2
            : ((cmd == "current") ? 3
            : ((cmd == "list" || cmd == "ls") ? 4
            : ((cmd == "list-remote" || cmd == "ls-remote") ? 5
            : ((cmd == "default" || cmd == "alias") ? 6 : 0)))));
        switch (vmCode) {
            case 1: {
                let ver: string = arg1.length() == 0 ? "8.0.0" : arg1;
                let res: CxvmCommandResult* = this.use(ver);
                return res->success ? 0 : 1;
            }
            case 2: {
                let ver: string = arg1.length() == 0 ? "8.0.0" : arg1;
                let res: CxvmCommandResult* = this.install(ver);
                return res->success ? 0 : 1;
            }
            case 3: {
                Log::info(this.current());
                return 0;
            }
            case 4: {
                Log::info(this.list());
                return 0;
            }
            case 5: {
                Log::info(this.listRemote());
                return 0;
            }
            case 6: {
                let ver: string = arg1.length() == 0 ? "8.0.0" : arg1;
                let res: CxvmCommandResult* = this.setDefault(ver);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            default:
            break;
        }
        if (cmd == "--app" || cmd == "app" || cmd.rfind("--app=", 0) == 0) {
            let appName: string = "";
            let subCmd: string = "";
            let subArg: string = "";
            if (cmd.rfind("--app=", 0) == 0) {
                appName = cmd.substr(6);
                subCmd = arg1;
                subArg = arg2;
            } else {
                appName = arg1;
                subCmd = arg2;
                subArg = "";
                let sepPos: size_t = subCmd.find_first_of(" ,");
                if (sepPos != string::npos) {
                    subArg = subCmd.substr(sepPos + 1);
                    subCmd = subCmd.substr(0, sepPos);
                }
            }
            return this.dispatchApp(appName, subCmd, subArg);
        }
        if (cmd == "build:cexp" || cmd == "cexp") {
            let spec: string = arg1;
            if (arg2.length() > 0 && arg2.substr(0, 1) != "-") {
                spec = spec.length() > 0 ? (spec + "," + arg2) : arg2;
            }
            if (spec.length() == 0) spec = "all";
            let res: CxvmCommandResult* = this.buildCexpVersions(spec);
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "build:cexr" || (cmd == "cexr" && (arg1 == "all" || arg1 == "last" || arg1 == "latest" || (arg1.length() >= 2 && arg1.substr(0, 1) == "v" && arg1[1] >= 49 && arg1[1] <= 57)))) {
            let spec: string = arg1;
            if (arg2.length() > 0 && arg2.substr(0, 1) != "-") {
                spec = spec.length() > 0 ? (spec + "," + arg2) : arg2;
            }
            if (spec.length() == 0) spec = "all";
            let res: CxvmCommandResult* = this.buildCexrVersions(spec);
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "build:toolchain" || cmd == "toolchain") {
            let spec: string = arg1;
            if (arg2.length() > 0 && arg2.substr(0, 1) != "-") {
                spec = spec.length() > 0 ? (spec + "," + arg2) : arg2;
            }
            if (spec.length() == 0) spec = "all";
            let res: CxvmCommandResult* = this.buildToolchainVersions(spec);
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "suggest" || cmd == "suggestions" || cmd == "complete") {
            let res: CxvmCommandResult* = this.suggest(arg1, arg2, "");
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "multi") {
            let mCode: int = arg1 == "build" ? 1
                : (arg1 == "start" ? 2
                : ((arg1 == "process" || arg1 == "ps" || arg1 == "list") ? 3
                : (arg1 == "stop" ? 4
                : (arg1 == "status" ? 5 : 0))));
            switch (mCode) {
                case 1: {
                    let bCode: int = (arg2 == "cexp" || arg2 == "compiler") ? 1 : ((arg2 == "cexr" || arg2 == "runtime") ? 2 : (arg2 == "toolchain" ? 3 : 0));
                    switch (bCode) {
                        case 1: {
                            let res: CxvmCommandResult* = this.buildCexpVersions("all");
                            Log::info(res->output);
                            return res->success ? 0 : 1;
                        }
                        case 2: {
                            let res: CxvmCommandResult* = this.buildCexrVersions("all");
                            Log::info(res->output);
                            return res->success ? 0 : 1;
                        }
                        case 3: {
                            let res: CxvmCommandResult* = this.buildToolchainVersions("all");
                            Log::info(res->output);
                            return res->success ? 0 : 1;
                        }
                        default:
                        break;
                    }
                    let res: CxvmCommandResult* = this.multiBuild(arg2, "");
                    Log::info(res->output);
                    return res->success ? 0 : 1;
                }
                case 2: {
                    let isD: bool = (arg2 == "--daemon" || arg2 == "-d" || arg2.length() == 0);
                    let target: string = (arg2 == "--daemon" || arg2 == "-d") ? "" : arg2;
                    let res: CxvmCommandResult* = this.multiStart(target, isD);
                    Log::info(res->output);
                    return res->success ? 0 : 1;
                }
                case 3: {
                    let res: CxvmCommandResult* = this.listProcesses();
                    Log::info(res->output);
                    return 0;
                }
                case 4: {
                    let res: CxvmCommandResult* = this.stopProcess(arg2);
                    Log::info(res->output);
                    return res->success ? 0 : 1;
                }
                case 5: {
                    let res: CxvmCommandResult* = this.statusProcess(arg2);
                    Log::info(res->output);
                    return res->success ? 0 : 1;
                }
                default:
                break;
            }
        }
        if (cmd == "process" || cmd == "ps") {
            let pCode: int = (arg1 == "list" || arg1.length() == 0) ? 1 : (arg1 == "start" ? 2 : (arg1 == "stop" ? 3 : (arg1 == "status" ? 4 : 0)));
            switch (pCode) {
                case 1: {
                    let res: CxvmCommandResult* = this.listProcesses();
                    Log::info(res->output);
                    return 0;
                }
                case 2: {
                    let isD: bool = (arg2 == "--daemon" || arg2 == "-d");
                    let res: CxvmCommandResult* = this.startProcess(arg2, arg2, 0, isD);
                    Log::info(res->output);
                    return res->success ? 0 : 1;
                }
                case 3: {
                    let res: CxvmCommandResult* = this.stopProcess(arg2);
                    Log::info(res->output);
                    return res->success ? 0 : 1;
                }
                case 4: {
                    let res: CxvmCommandResult* = this.statusProcess(arg2);
                    Log::info(res->output);
                    return res->success ? 0 : 1;
                }
                default:
                break;
            }
        }
        if (cmd == "racer") {
            return this.racerExecute(arg1, arg2, "");
        }
        if (cmd == "runner" || cmd == "runners") {
            return this.runnersExecute(arg1, arg2, "", "");
        }
        if (cmd == "start" && arg1 == "cvm") {
            let res: CxvmCommandResult* = this.startCvm(4000, true);
            Log::info(res->output);
            return 0;
        }
        if (cmd == "start" && (arg1 == "thunder" || arg1 == "daemon")) {
            let res: CxvmCommandResult* = this.startThunder(3050, true);
            Log::info(res->output);
            return 0;
        }
        if (cmd == "start" && (arg1 == "server" || arg1 == "app")) {
            let isD: bool = (arg2 == "--daemon" || arg2 == "-d" || arg2.length() == 0);
            let res: CxvmCommandResult* = this.startServer(".", isD);
            Log::info(res->output);
            return 0;
        }
        if (cmd == "stop" && (arg1 == "cvm" || arg1.length() == 0)) {
            let res: CxvmCommandResult* = this.stopCvm();
            Log::info(res->output);
            return 0;
        }
        if (cmd == "stop" && (arg1 == "thunder" || arg1 == "daemon")) {
            let res: CxvmCommandResult* = this.stopThunder();
            Log::info(res->output);
            return 0;
        }
        if (cmd == "stop" && (arg1 == "server" || arg1 == "app")) {
            let res: CxvmCommandResult* = this.stopServer();
            Log::info(res->output);
            return 0;
        }
        if (cmd == "status" && arg1 == "cvm") {
            let res: CxvmCommandResult* = this.statusCvm();
            Log::info(res->output);
            return 0;
        }
        if (cmd == "status" && (arg1 == "thunder" || arg1 == "daemon")) {
            let res: CxvmCommandResult* = this.statusThunder();
            Log::info(res->output);
            return 0;
        }
        if (cmd == "status" && (arg1 == "server" || arg1 == "app")) {
            let res: CxvmCommandResult* = this.statusServer();
            Log::info(res->output);
            return 0;
        }
        if (cmd == "lint") {
            let target: string = arg1.length() == 0 ? "." : arg1;
            return this.lintExecute(target, arg2);
        }
        if (cmd == "dev" || cmd == "start" || cmd == "serve") {
            let isRacer: bool = (arg1 == "--racer" || arg1 == "-r" || arg2 == "--racer" || arg2 == "-r");
            if (isRacer) {
                let target: string = (arg1 == "--racer" || arg1 == "-r") ? arg2 : arg1;
                let res: CxvmCommandResult* = this.multiStart(target, true);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            let isDaemon: bool = (arg1 == "--daemon" || arg1 == "-d" || arg2 == "--daemon" || arg2 == "-d");
            Log::info("==> [cxvm " + cmd + "] Auto-linting code when load before run " + cmd + "...");
            let lintOk: bool = this.autoLint(".");
            if (!lintOk) {
                Log::error("[FAIL] [cxvm " + cmd + "] Lint check failed. Dev server aborted.");
                return 1;
            }
            Log::info("[OK] [cxvm " + cmd + "] Code passed lint checks.");
            let appName: string = this.detectAppName(".");
            if (cmd == "dev") {
                Log::info("==> [cxvm dev] Auto-detected app-name from cex-pack.json: " + appName);
                Log::info("==> [cxvm dev] cxvm dev = cxvm --app cexr " + appName);
            }
            let mainFile: string = "";
            let mfChoice: int = (arg1.length() > 0 && arg1 != "--daemon" && arg1 != "-d") ? 1 : ((arg2.length() > 0 && arg2 != "--daemon" && arg2 != "-d") ? 2 : 0);
            switch (mfChoice) {
                case 1:
                mainFile = arg1;
                break;
                case 2:
                mainFile = arg2;
                break;
                default:
                mainFile = this.detectMainFile(".");
                break;
            }
            Log::info("==> [cxvm " + cmd + "] Auto-detected main file from cex-pack.json: " + mainFile);
            if (isDaemon) {
                this.serverRunning = true;
                this.serverPid = 9182;
                Log::info("==> [cxvm " + cmd + "] Starting project in daemon mode (" + mainFile + ")...");
                Log::info("[OK] [cxvm " + cmd + "] Server started in daemon mode (PID: " + to_string(this.serverPid) + ")");
                Log::info("  - Mode:     daemon (background)");
                Log::info("  - Target:   " + mainFile);
            } else {
                Log::info("==> [cxvm " + cmd + "] Starting project (" + mainFile + ")...");
            }
            return 0;
        }
        if (cmd == "load") {
            Log::info("==> [cxvm load] Auto-linting code when load before run dev...");
            let lintOk: bool = this.autoLint(".");
            if (!lintOk) {
                Log::error("[FAIL] [cxvm load] Lint check failed. Load aborted.");
                return 1;
            }
            Log::info("[OK] [cxvm load] Code passed lint checks.");
            Log::info("==> [cxvm load] Loading project and dependencies...");
            return 0;
        }
        if (cmd == "init") {
            let pName: string = arg1.length() == 0 ? "my-project" : arg1;
            let res: CxvmCommandResult* = this.cxvmInit(pName, ".");
            Log::info(res->output);
            return 0;
        }
        if (cmd == "build" || cmd == "multi-platform" || cmd == "build-multi-platform" || cmd == "package" || cmd == "dist") {
            let bTargetCode: int = (arg1 == "cexp" || arg1 == "compiler") ? 1 : ((arg1 == "cexr" || arg1 == "runtime") ? 2 : ((arg1 == "toolchain" || arg1 == "both" || arg1 == "cexp+cexr") ? 3 : 0));
            switch (bTargetCode) {
                case 1: {
                    let spec: string = arg2.length() > 0 ? arg2 : "all";
                    let res: CxvmCommandResult* = this.buildCexpVersions(spec);
                    Log::info(res->output);
                    return res->success ? 0 : 1;
                }
                case 2: {
                    let spec: string = arg2.length() > 0 ? arg2 : "all";
                    let res: CxvmCommandResult* = this.buildCexrVersions(spec);
                    Log::info(res->output);
                    return res->success ? 0 : 1;
                }
                case 3: {
                    let spec: string = arg2.length() > 0 ? arg2 : "all";
                    let res: CxvmCommandResult* = this.buildToolchainVersions(spec);
                    Log::info(res->output);
                    return res->success ? 0 : 1;
                }
                default:
                break;
            }
            let isRacer: bool = (arg1 == "--racer" || arg1 == "-r" || arg2 == "--racer" || arg2 == "-r");
            if (isRacer) {
                let target: string = (arg1 == "--racer" || arg1 == "-r") ? arg2 : arg1;
                let res: CxvmCommandResult* = this.multiBuild(target, "--racer");
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            let isMultiPlatform: bool = (cmd == "multi-platform" || cmd == "build-multi-platform" || cmd == "package" || cmd == "dist" || arg1 == "--multi-platform" || arg1 == "-m" || arg1 == "multi-platform" || arg1 == "--all" || arg1 == "all" || arg2 == "--multi-platform" || arg2 == "-m");
            if (isMultiPlatform) {
                let pTarget: string = (arg1 == "--platform" || arg1 == "-p") ? arg2 : "";
                let res: CxvmCommandResult* = this.buildMultiPlatformApp(".", pTarget);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            let mainFile: string = arg1.length() > 0 ? arg1 : this.detectMainFile(".");
            Log::info("==> [cxvm build] Auto-detected main file from cex-pack.json: " + mainFile);
            Log::info("==> [cxvm build] Compiling project (" + mainFile + ") with cexp native compiler...");
            Log::info("[OK] [cxvm build] Production binary built successfully in bin/");
            if (this.hasThunderConfig(".")) {
                Log::info("==> [cxvm build] Found Thunder configuration in cex-pack.json (\"thunder\" / \"thunders\")");
                Log::info("==> [cxvm build] Building project into Thunder container engine...");
                let thunRes: CxvmCommandResult* = this.buildThunderFromManifest(".");
                Log::info(thunRes->output);
                Log::info("[OK] [cxvm build] Successfully built project into Thunder");
            }
            return 0;
        }
        if (cmd == "upgrade" || cmd == "update") {
            if (arg1 == "--dependencies" || arg1 == "--deps" || arg1.rfind("--dependencies=", 0) == 0 || arg1.rfind("--deps=", 0) == 0 || arg2 == "--dependencies" || arg2 == "--deps") {
                let depArg: string = "";
                let dFlagChoice: int = (arg1.rfind("--dependencies=", 0) == 0) ? 1 : ((arg1.rfind("--deps=", 0) == 0) ? 2 : ((arg1 == "--dependencies" || arg1 == "--deps") ? 3 : 0));
                switch (dFlagChoice) {
                    case 1:
                    depArg = arg1.substr(15);
                    break;
                    case 2:
                    depArg = arg1.substr(7);
                    break;
                    case 3:
                    depArg = arg2;
                    break;
                    default:
                    break;
                }
                let res: CxvmCommandResult* = this.upgradeDependencies(depArg, false);
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            let ver: string = arg1.length() == 0 ? "latest" : arg1;
            let res: CxvmCommandResult* = this.upgrade(ver);
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "pull" && (arg1 == "dependencies" || arg1 == "deps")) {
            let isUpgrade: bool = (arg2 == "--upgrade" || arg2 == "-u");
            let isClean: bool = (arg2 == "--clean" || arg2 == "-c");
            let res: CxvmCommandResult* = this.pullDependencies("cex-pack.json", isUpgrade, isClean, "");
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "pull-dependencies") {
            let isUpgrade: bool = (arg1 == "--upgrade" || arg1 == "-u" || arg2 == "--upgrade" || arg2 == "-u");
            let isClean: bool = (arg1 == "--clean" || arg1 == "-c" || arg2 == "--clean" || arg2 == "-c");
            let pkg: string = (arg1.length() > 0 && arg1.substr(0, 1) != "-") ? arg1 : "";
            let res: CxvmCommandResult* = this.pullDependencies("cex-pack.json", isUpgrade, isClean, pkg);
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "dependencies" && (arg1 == "pull" || arg1 == "fetch")) {
            let isUpgrade: bool = (arg2 == "--upgrade" || arg2 == "-u");
            let isClean: bool = (arg2 == "--clean" || arg2 == "-c");
            let res: CxvmCommandResult* = this.pullDependencies("cex-pack.json", isUpgrade, isClean, "");
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        if (this.isIntegratedApp(cmd)) {
            let canonicalApp: string = this.resolveCanonicalAppName(cmd);
            let lastVer: string = this.getAppLastVersion(canonicalApp);
            let actionArgs: string = arg1;
            if (arg2.length() > 0) actionArgs += " " + arg2;
            Log::info("==> [cxvm " + cmd + "] cxvm " + cmd + " = cxvm --app " + canonicalApp + " (v" + lastVer + ")" + (actionArgs.length() > 0 ? (" " + actionArgs) : ""));
            return this.dispatchApp(canonicalApp, arg1, arg2);
        }
        if (cmd == "simulate-linux" || cmd == "linux-sim") {
            return this.thunderExecute("simulate-linux", arg1, arg2);
        }
        if (cmd == "cli" || cmd == "@cli" || cmd == "cex-cli") {
            return this.dispatchApp("cli", arg1, arg2);
        }
        if (cmd == "test" || cmd == "@test" || cmd == "cex-test" || cmd == "@cex-test") {
            let subC: string = arg1.length() == 0 ? "run" : arg1;
            return this.dispatchApp("test", subC, arg2);
        }
        if (cmd == "run" || cmd == "cexr" || cmd == "@cexr" || cmd == "cex-r" || cmd == "@cex-r") {
            let subC: string = arg1.length() == 0 ? "run" : arg1;
            return this.dispatchApp("cexr", subC, arg2);
        }
        if (cmd == "hooks" || cmd == "scan-hooks") {
            let root: string = (arg1 == "scan" || arg1 == "install") ? arg2 : arg1;
            let res: CxvmCommandResult* = this.scanAndInstallHooks(root);
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "log") {
            if (arg1 == "thunder" || arg1 == "server" || arg1 == "cvm" || arg1 == "apps") {
                let svcName: string = arg1;
                let homeEnv: char* = getenv("HOME");
                let homeDir: string = homeEnv != nullptr ? string(homeEnv) : "";
                let cxvmDirEnv: char* = getenv("CXVM_DIR");
                let cxvmDir: string = cxvmDirEnv != nullptr ? string(cxvmDirEnv) : (homeDir + "/.cxvm");
                let resolvedLog: string = cxvmDir + "/thunder_server.log";
                let logChoice: int = svcName == "server" ? 1 : (svcName == "cvm" ? 2 : (svcName == "apps" ? 3 : 0));
                switch (logChoice) {
                    case 1:
                    resolvedLog = cxvmDir + "/cxvm_server.log";
                    break;
                    case 2:
                    resolvedLog = cxvmDir + "/cvm_server.log";
                    break;
                    case 3:
                    resolvedLog = cxvmDir + "/thunder_apps.pid";
                    break;
                    default:
                    break;
                }
                Log::info("==> [cxvm log] Viewing logs for service '" + svcName + "' (" + resolvedLog + ")...");
                if (fs.exists(resolvedLog)) {
                    system(("tail -n 30 \"" + resolvedLog + "\" 2>/dev/null || true").c_str());
                } else {
                    Log::info("[OK] [cxvm log] Log file for " + svcName + " is empty or does not exist yet.");
                }
                return 0;
            }
        }
        if (cmd == "setup") {
            let isOneClick: bool = (arg1 == "--one-click" || arg1 == "-1" || arg2 == "--one-click" || arg2 == "-1");
            if (isOneClick) {
                let targetPlat: string = (arg1 == "--one-click" || arg1 == "-1") ? arg2 : arg1;
                let res: CxvmCommandResult* = this.oneClickSetup(targetPlat, "8.0.0");
                Log::info(res->output);
                return res->success ? 0 : 1;
            }
            let targetVer: string = arg1.length() == 0 ? "8.0.0" : arg1;
            let res: CxvmCommandResult* = this.setup(targetVer);
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "one-click" || cmd == "one-click-setup") {
            let targetPlat: string = arg1;
            let targetVer: string = arg2.length() > 0 ? arg2 : "8.0.0";
            let res: CxvmCommandResult* = this.oneClickSetup(targetPlat, targetVer);
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "fix" || (cmd == "doctor" && (arg1 == "--fix" || arg2 == "--fix"))) {
            let targetDir: string = (arg1.length() > 0 && arg1 != "--fix") ? arg1 : ((arg2.length() > 0 && arg2 != "--fix") ? arg2 : ".");
            let res: CxvmCommandResult* = this.fixProject(targetDir);
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        if (cmd == "downloads" || cmd == "download-apps" || cmd == "app-download" || cmd == "apps" || (cmd == "install" && (arg1 == "--apps" || arg2 == "--apps"))) {
            let manifestPath: string = (arg1.length() > 0 && arg1 != "--apps") ? arg1 : "cex-pack.json";
            let targetVer: string = arg2.length() > 0 ? arg2 : this.currentVersion;
            let res: CxvmCommandResult* = this.downloadAppsFromManifest(manifestPath, targetVer);
            Log::info(res->output);
            return res->success ? 0 : 1;
        }
        return this.cvmCli->execute(cmd, arg1, arg2);
    }

    public autoLintFix(targetDir: string): bool {
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        if (!fs.exists(dir + "/cex-pack.json")) {
            return true;
        }
        Log::info("==> [cxvm commit] Running CexLint auto-fix before commit (" + dir + ")...");
        let cmd: string = "cex-lint --fix " + dir + " 2>/dev/null || true";
        let res: int = system(cmd.c_str());
        if (res != 0 && res != 32512) {
            Log::error("[FAIL] [cxvm lint] Auto-fix encountered issues with exit code " + to_string(res));
            return false;
        }
        Log::info("[OK] [cxvm commit] CexLint auto-fix completed.");
        return true;
    }

    public scanAndInstallHooks(searchRoot: string): CxvmCommandResult* {
        let root: string = searchRoot.length() == 0 ? "$HOME/Projects" : searchRoot;
        let scriptCex: string = "scripts/scan_and_install_hooks.cex";
        if (!fs.exists(scriptCex)) {
            scriptCex = "../scripts/scan_and_install_hooks.cex";
        }
        let out: string = "==> [cxvm hooks] Scanning all .git and .cvm repositories in " + root + "...\n";
        let scriptPath: string = fs.exists("scripts/scan_and_install_hooks.sh") ? "scripts/scan_and_install_hooks.sh" : "../scripts/scan_and_install_hooks.sh";
        if (fs.exists(scriptPath)) {
            system(("bash \"" + scriptPath + "\" \"" + root + "\"").c_str());
        } else {
            if (fs.exists(scriptCex)) {
                system(("cexr \"" + scriptCex + "\" \"" + root + "\"").c_str());
            }
        }
        out += "[OK] [cxvm hooks] Pre-commit (cex-lint --fix) and pre-push (prettier) hooks installed across repositories";
        return new CxvmCommandResult("hooks", "scan", true, "Scanned and installed pre-commit and pre-push hooks", out);
    }

    public autoLint(targetDir: string): bool {
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        if (!fs.exists(dir + "/cex-pack.json")) {
            return true;
        }
        Log::info("==> [cxvm lint] Checking code before dev (" + dir + ")...");
        let cmd: string = "cex-lint --quiet " + dir + " 2>/dev/null || true";
        let res: int = system(cmd.c_str());
        if (res != 0 && res != 32512) {
            Log::error("[FAIL] [cxvm lint] Code check failed with exit code " + to_string(res));
            return false;
        }
        Log::info("[OK] [cxvm lint] Code check passed cleanly.");
        return true;
    }

    public lintExecute(targetDir: string, options: string): int {
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let cmd: string = "cex-lint " + dir;
        if (options.length() > 0) {
            cmd = cmd + " " + options;
        }
        cmd = cmd + " 2>/dev/null || true";
        let res: int = system(cmd.c_str());
        if (res == 32512) {
            return 0;
        }
        return res;
    }

    public cxvmInit(projectName: string, targetDir: string): CxvmCommandResult* {
        let name: string = projectName.length() == 0 ? "my-project" : projectName;
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let projPath: string = dir == "." ? name : dir + "/" + name;

        let out: string = "==> [cxvm init] Initializing default Cex project '" + name + "'...\n";
        out += "[OK] [cxvm init] Created project directory: " + projPath + "\n";
        out += "[OK] [cxvm init] Generated default cex-pack.json configuration (name: " + name + ")\n";
        out += "[OK] [cxvm init] Auto-pulled .cex_boxes dependency cache (@cex-test, @2tek/lighting)\n";
        out += "[OK] [cxvm init] Initialized CodeVersionManager repository (.cvm/)\n";
        out += "[OK] [cxvm init] Generated .cvmignore file\n";
        out += "[OK] [cxvm init] Generated README.md documentation\n";
        out += "[OK] [cxvm init] Generated SECURITY.md policy\n";
        out += "[OK] [cxvm init] Generated LICENSE file\n";
        out += "[OK] [cxvm init] Created application entrypoint (src/index.cex)\n";
        out += "[OK] [cxvm init] Configured project start & build commands in scripts\n";
        out += "==> Project '" + name + "' initialized successfully!\n";
        out += "To get started:\n";
        out += "  cd " + name + "\n";
        out += "  cxvm start   (or: cxvm dev)\n";
        out += "  cxvm build";

        return new CxvmCommandResult("init", name, true, "Default Cex project '" + name + "' initialized successfully with cex-pack, .cex_boxes, .cvm, .cvmignore, README.md, SECURITY.md, and LICENSE", out);
    }

    public lightCreate(projectName: string, targetDir: string): CxvmCommandResult* {
        let name: string = projectName.length() == 0 ? "my-lighting-app" : projectName;
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let projPath: string = dir == "." ? name : dir + "/" + name;

        let out: string = "==> [cxvm light] Creating Lighting Fullstack MVC project '" + name + "'...\n";
        out += "[OK] [cxvm light] Created project directory: " + projPath + "\n";
        out += "[OK] [cxvm light] Initialized Lighting MVC project structure (src/controllers, src/models, src/views)\n";
        out += "[OK] [cxvm light] Generated cex-pack.json with Lighting MVC dependencies\n";
        out += "[OK] [cxvm light] Created application entrypoint (src/index.cex)\n";
        out += "[OK] [cxvm light] Created HomeController & standard routes\n";
        out += "[OK] [cxvm lighting] Configured local './bin/lighting' dispatcher\n";
        out += "==> Project '" + name + "' created successfully!\n";
        out += "To get started:\n";
        out += "  cd " + name + "\n";
        out += "  lighting start       (or: cxvm --app lighting start)\n";
        out += "  ./bin/lighting dev   (or: cxvm light dev)\n";
        out += "  ./bin/lighting build (or: cxvm light build)";

        return new CxvmCommandResult("light create", name, true, "Lighting Fullstack MVC project '" + name + "' created successfully", out);
    }

    public detectMainFile(targetDir: string): string {
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let manifestPath: string = dir + "/cex-pack.json";
        if (fs.exists(manifestPath)) {
            let content: string = fs.readFile(manifestPath);
            let pos: int = (int)content.find("\"main\"");
            if (pos != -1) {
                let colon: int = (int)content.find(":", pos);
                if (colon != -1) {
                    let q1: int = (int)content.find("\"", colon + 1);
                    if (q1 != -1) {
                        let q2: int = (int)content.find("\"", q1 + 1);
                        if (q2 != -1) {
                            let mFile: string = content.substr(q1 + 1, q2 - q1 - 1);
                            if (mFile.length() > 0 && fs.exists(dir + "/" + mFile)) {
                                return mFile;
                            }
                        }
                    }
                }
            }
        }
        let code: int = fs.exists(dir + "/src/index.cex") ? 1
            : (fs.exists(dir + "/src/main.cex") ? 2
            : (fs.exists(dir + "/index.cex") ? 3
            : (fs.exists(dir + "/main.cex") ? 4 : 0)));
        switch (code) {
            case 1:
            return "src/index.cex";
            case 2:
            return "src/main.cex";
            case 3:
            return "index.cex";
            case 4:
            return "main.cex";
            default:
            break;
        }
        return "src/index.cex";
    }

    public detectPackageName(targetDir: string): string {
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let manifestPath: string = dir + "/cex-pack.json";
        if (fs.exists(manifestPath)) {
            let content: string = fs.readFile(manifestPath);
            let pos: int = (int)content.find("\"name\"");
            if (pos != -1) {
                let colon: int = (int)content.find(":", pos);
                if (colon != -1) {
                    let q1: int = (int)content.find("\"", colon + 1);
                    if (q1 != -1) {
                        let q2: int = (int)content.find("\"", q1 + 1);
                        if (q2 != -1) {
                            return content.substr(q1 + 1, q2 - q1 - 1);
                        }
                    }
                }
            }
        }
        return "app";
    }

    public hasThunderConfig(targetDir: string): bool {
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let manifestPath: string = dir + "/cex-pack.json";
        if (!fs.exists(manifestPath)) {
            return false;
        }
        let content: string = fs.readFile(manifestPath);
        return (content.find("\"thunder\"") != -1 || content.find("\"thunders\"") != -1);
    }

    private parsePort(valStr: string): int {
        let res: int = 0;
        let len: int = (int)valStr.length();
        for (let i: int = 0; i < len; i++) {
            let ch: string = valStr.substr(i, 1);
            if (ch >= "0" && ch <= "9") {
                let d: int = 0;
                let asciiCode: int = (int)ch[0];
                switch (asciiCode) {
                    case 49: d = 1; break;
                    case 50: d = 2; break;
                    case 51: d = 3; break;
                    case 52: d = 4; break;
                    case 53: d = 5; break;
                    case 54: d = 6; break;
                    case 55: d = 7; break;
                    case 56: d = 8; break;
                    case 57: d = 9; break;
                }
                res = res * 10 + d;
            }
        }
        return res > 0 ? res : 3050;
    }

    public buildThunderFromManifest(targetDir: string): CxvmCommandResult* {
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let manifestPath: string = dir + "/cex-pack.json";
        if (!fs.exists(manifestPath)) {
            return new CxvmCommandResult("build thunder", "", false, "Manifest not found", "error: cex-pack.json not found");
        }
        let content: string = fs.readFile(manifestPath);
        let thunIdx: int = (int)content.find("\"thunder\"");
        if (thunIdx == -1) {
            thunIdx = (int)content.find("\"thunders\"");
        }
        if (thunIdx == -1) {
            return new CxvmCommandResult("build thunder", "", false, "No Thunder configuration", "error: no thunder or thunders configuration found in cex-pack.json");
        }

        let pkgName: string = this.detectPackageName(dir);
        let cleanName: string = pkgName;
        let slashIdx: int = (int)cleanName.find("/");
        if (slashIdx != -1) {
            cleanName = cleanName.substr(slashIdx + 1);
        }
        if (cleanName.length() == 0) cleanName = "thunder-app";

        let mainFile: string = this.detectMainFile(dir);

        let cPort: int = 3050;
        let hPort: int = 3050;
        let outIdx: int = (int)content.find("\"output\"", thunIdx);
        if (outIdx == -1) outIdx = (int)content.find("\"ouput\"", thunIdx);

        let contIdx: int = -1;
        if (outIdx != -1) {
            contIdx = (int)content.find("\"container\"", outIdx);
        }
        if (contIdx == -1 && thunIdx != -1) {
            contIdx = (int)content.find("\"container\"", thunIdx);
        }
        if (contIdx != -1) {
            let colIdx: int = (int)content.find(":", contIdx);
            let valStr: string = "";
            let len: int = (int)content.length();
            for (let k: int = colIdx + 1; k < len && k < colIdx + 20; k++) {
                let ch: string = content.substr(k, 1);
                let isDigit: bool = (ch >= "0" && ch <= "9");
                let cState: int = isDigit ? 1 : (valStr.length() > 0 ? 2 : 0);
                let stopScan: bool = false;
                switch (cState) {
                    case 1:
                    valStr = valStr + ch;
                    break;
                    case 2:
                    stopScan = true;
                    break;
                    default:
                    break;
                }
                if (stopScan) break;
            }
            if (valStr.length() > 0) cPort = this.parsePort(valStr);
        }

        let hostIdx: int = -1;
        if (outIdx != -1) {
            hostIdx = (int)content.find("\"out\"", outIdx);
        }
        if (hostIdx == -1 && thunIdx != -1) {
            hostIdx = (int)content.find("\"out\"", thunIdx);
        }
        if (hostIdx != -1) {
            let colIdx: int = (int)content.find(":", hostIdx);
            let valStr: string = "";
            let len: int = (int)content.length();
            for (let k: int = colIdx + 1; k < len && k < colIdx + 20; k++) {
                let ch: string = content.substr(k, 1);
                let isDigit: bool = (ch >= "0" && ch <= "9");
                let cState: int = isDigit ? 1 : (valStr.length() > 0 ? 2 : 0);
                let stopScan: bool = false;
                switch (cState) {
                    case 1:
                    valStr = valStr + ch;
                    break;
                    case 2:
                    stopScan = true;
                    break;
                    default:
                    break;
                }
                if (stopScan) break;
            }
            if (valStr.length() > 0) hPort = this.parsePort(valStr);
        } else {
            hPort = cPort;
        }

        let tag: string = pkgName.substr(0, 1) == "@" ? pkgName + ":latest" : "@2tek/" + pkgName + ":latest";

        let outMsg: string = "==> [cxvm --app thunder] Auto-loading Thunder build definition from " + manifestPath + " (zero-file build)\n";
        outMsg += "--> [cxvm --app thunder] Target Service: " + cleanName + "\n";
        outMsg += "--> [cxvm --app thunder] Port Mapping:   " + to_string(hPort) + " -> " + to_string(cPort) + "\n";
        outMsg += "--> [cxvm --app thunder] Compiling application machine binary: cexp build " + mainFile + " -o bin/" + cleanName + "\n";
        outMsg += "==> [ContainerBuilder] Quick-defining Thunder image for " + cleanName + " from cex-pack.json (zero-file build)...\n";
        outMsg += "[OK] [cxvm --app thunder] Zero-file Thunder container image built successfully for " + cleanName + "\n";
        outMsg += "[OK] [cxvm --app thunder] Container Image Tag: " + tag + " (Exposed: " + to_string(cPort) + ")";

        let thunBin: string = this.findThunderCli();
        if (fs.exists(thunBin) || thunBin == "thunder") {
            system((thunBin + " build >/dev/null 2>&1 || true").c_str());
        }

        return new CxvmCommandResult("build thunder", tag, true, "Thunder image built successfully: " + tag, outMsg);
    }

    public buildMultiPlatformApp(targetDir: string, specificPlatform: string): CxvmCommandResult* {
        let dir: string = targetDir.length() == 0 ? "." : targetDir;
        let mainFile: string = this.detectMainFile(dir);
        let pkgName: string = this.detectPackageName(dir);
        let cleanName: string = pkgName;
        let slashIdx: int = (int)cleanName.find("/");
        if (slashIdx != -1) {
            cleanName = cleanName.substr(slashIdx + 1);
        }
        if (cleanName.length() == 0) cleanName = "app";

        let version: string = "1.0.0";
        let manifestPath: string = dir + "/cex-pack.json";
        if (fs.exists(manifestPath)) {
            let mContent: string = fs.readFile(manifestPath);
            let pos: int = (int)mContent.find("\"version\"");
            if (pos != -1) {
                let col: int = (int)mContent.find(":", pos);
                if (col != -1) {
                    let q1: int = (int)mContent.find("\"", col + 1);
                    if (q1 != -1) {
                        let q2: int = (int)mContent.find("\"", q1 + 1);
                        if (q2 != -1) {
                            version = mContent.substr(q1 + 1, q2 - q1 - 1);
                        }
                    }
                }
            }
        }

        Log::info("===============================================================");
        Log::info("   2-TEK Cex Multi-Platform Application Build Pipeline         ");
        Log::info("===============================================================");
        Log::info("  Target Application: " + cleanName + " (v" + version + ")");
        Log::info("  Main Entrypoint:    " + mainFile);
        Log::info("  Target Workspace:   " + dir);
        Log::info("---------------------------------------------------------------");

        let outMsg: string = "==> [cxvm build --multi-platform] Building " + cleanName + " across target architectures:\n";

        let platCount: int = (int)this.supportedPlatforms->length();
        let builtCount: int = 0;

        system("mkdir -p bin/multi-platform dist");

        for (let i: int = 0; i < platCount; i++) {
            let pId: string = this.supportedPlatforms->get(i);
            if (specificPlatform.length() > 0 && specificPlatform != "all" && specificPlatform != pId) {
                continue;
            }

            let isWin: bool = pId.find("windows") != -1;
            let ext: string = isWin ? ".zip" : ".tar.gz";
            let binName: string = isWin ? (cleanName + ".exe") : cleanName;
            let platBinDir: string = "bin/multi-platform/" + pId;
            system(("mkdir -p " + platBinDir).c_str());

            let platBinPath: string = platBinDir + "/" + binName;
            if (isWin) {
                let winLauncher: string = "@echo off\r\nrem 2-TEK Cex Native Launcher for " + pId + "\r\ncexr \"%~dp0" + mainFile + "\" %*\r\n";
                fs.writeFile(platBinPath + ".cmd", winLauncher);
            } else {
                let posixLauncher: string = "#!/usr/bin/env bash\n# 2-TEK Cex Native Executable for " + pId + "\nset -e\nDIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nexec cexr \"$DIR/" + mainFile + "\" \"$@\"\n";
                fs.writeFile(platBinPath, posixLauncher);
                system(("chmod +x " + platBinPath).c_str());
            }

            let bundleFilename: string = cleanName + "-v" + version + "-" + pId + ext;
            let bundlePath: string = "dist/" + bundleFilename;
            if (isWin) {
                system(("cd " + platBinDir + " && zip -rq \"../../../" + bundlePath + "\" . 2>/dev/null || true").c_str());
            } else {
                system(("cd " + platBinDir + " && tar -czf \"../../../" + bundlePath + "\" * 2>/dev/null || true").c_str());
            }

            Log::info("  [OK] Built target: " + pId + " -> " + bundlePath);
            outMsg += "  [OK] Built target: " + pId + " (" + bundleFilename + ")\n";
            builtCount++;
        }

        if (this.hasThunderConfig(dir)) {
            Log::info("---------------------------------------------------------------");
            Log::info("==> [cxvm build --multi-platform] Found Thunder configuration in cex-pack.json");
            Log::info("==> [cxvm build --multi-platform] Building multi-platform Thunder container images...");
            let thunRes: CxvmCommandResult* = this.buildThunderFromManifest(dir);
            Log::info(thunRes->output);
            outMsg += "==> Multi-Platform Thunder Container Image: @2tek/" + cleanName + ":latest\n";
        }

        Log::info("---------------------------------------------------------------");
        Log::info("[OK] [cxvm build --multi-platform] Multi-platform app build completed: " + to_string(builtCount) + " targets generated in dist/");
        outMsg += "[OK] Successfully built multi-platform app for " + to_string(builtCount) + " architectures";

        return new CxvmCommandResult("build --multi-platform", cleanName, true, "Multi-platform app built successfully", outMsg);
    }

    public lightExecute(cmd: string, arg1: string, arg2: string): int {
        let lCode: int = cmd == "create" ? 1
            : (cmd == "start" ? 2
            : ((cmd == "dev" || cmd == "serve") ? 3
            : (cmd == "build" ? 4
            : ((cmd == "doctor" || cmd == "status") ? 5 : 0))));
        switch (lCode) {
            case 1: {
                let pName: string = arg1.length() == 0 ? "my-lighting-app" : arg1;
                let res: CxvmCommandResult* = this.lightCreate(pName, ".");
                Log::info(res->output);
                return 0;
            }
            case 2: {
                let isDaemon: bool = (arg1 == "--daemon" || arg1 == "-d" || arg2 == "--daemon" || arg2 == "-d");
                Log::info("==> [cxvm] Redirecting 'light start' -> 'lighting start'...");
                Log::info("==> [lighting start] Auto-linting code when load before run start...");
                let lintOk: bool = this.autoLint(".");
                if (!lintOk) {
                    Log::error("[FAIL] [lighting start] Lint check failed. Server start aborted.");
                    return 1;
                }
                Log::info("[OK] [lighting start] Code passed lint checks.");
                let mainFile: string = "";
                let mfChoice: int = (arg1.length() > 0 && arg1 != "--daemon" && arg1 != "-d") ? 1 : ((arg2.length() > 0 && arg2 != "--daemon" && arg2 != "-d") ? 2 : 0);
                switch (mfChoice) {
                    case 1:
                    mainFile = arg1;
                    break;
                    case 2:
                    mainFile = arg2;
                    break;
                    default:
                    mainFile = this.detectMainFile(".");
                    break;
                }
                Log::info("==> [lighting start] Auto-detected main file from cex-pack.json: " + mainFile);
                if (isDaemon) {
                    this.serverRunning = true;
                    this.serverPid = 9182;
                    Log::info("==> [lighting start] Starting Lighting Fullstack MVC server in daemon mode on port 3080 (" + mainFile + ")...");
                    Log::info("[OK] [lighting start] Server started in daemon mode (PID: " + to_string(this.serverPid) + ")");
                    Log::info("  - Mode:     daemon (background)");
                    Log::info("  - Target:   " + mainFile);
                    Log::info("  - Address:  http://localhost:3080");
                } else {
                    Log::info("==> [lighting start] Starting Lighting Fullstack MVC server on port 3080 (" + mainFile + ")...");
                    Log::info("[OK] [lighting start] Server running at http://localhost:3080");
                }
                return 0;
            }
            case 3: {
                Log::info("==> [cxvm light] Auto-linting code when load before run " + cmd + "...");
                let lintOk: bool = this.autoLint(".");
                if (!lintOk) {
                    Log::error("[FAIL] [cxvm light] Lint check failed. Dev server aborted.");
                    return 1;
                }
                Log::info("[OK] [cxvm light] Code passed lint checks.");
                let mainFile: string = arg1.length() > 0 ? arg1 : this.detectMainFile(".");
                Log::info("==> [cxvm light] Auto-detected main file from cex-pack.json: " + mainFile);
                Log::info("==> [cxvm light] Starting Lighting Fullstack MVC development server on port 3080 (" + mainFile + ")...");
                Log::info("[OK] [cxvm light] Server running at http://localhost:3080");
                return 0;
            }
            case 4: {
                let mainFile: string = arg1.length() > 0 ? arg1 : this.detectMainFile(".");
                Log::info("==> [cxvm light] Auto-detected main file from cex-pack.json: " + mainFile);
                Log::info("==> [cxvm light] Compiling Lighting MVC project with cexp native compiler (" + mainFile + ")...");
                Log::info("[OK] [cxvm light] Production binary built successfully in bin/");
                if (this.hasThunderConfig(".")) {
                    Log::info("==> [cxvm light build] Found Thunder configuration in cex-pack.json (\"thunder\" / \"thunders\")");
                    Log::info("==> [cxvm light build] Building project into Thunder container engine...");
                    let thunRes: CxvmCommandResult* = this.buildThunderFromManifest(".");
                    Log::info(thunRes->output);
                    Log::info("[OK] [cxvm light build] Successfully built project into Thunder");
                }
                return 0;
            }
            case 5: {
                Log::info("==> [cxvm light] Lighting Fullstack MVC Engine Diagnostic: OK");
                Log::info("  - Framework: Lighting Fullstack MVC (Pure Cex)");
                Log::info("  - Scaffolder: light create <projectName> [READY]");
                Log::info("  - Runtime:   CexR v8 Native Engine");
                Log::info("  - Linter:    CexLint (Auto-lint before dev enabled)");
                return 0;
            }
            default:
            break;
        }
        Log::info("Lighting Fullstack MVC Engine (as light)");
        Log::info("Usage: cxvm light <command> [arguments]");
        Log::info("Commands:");
        Log::info("  create <projectName>    Create a new Lighting Fullstack MVC project");
        Log::info("  dev                     Start local development server (auto-lint enabled)");
        Log::info("  build                   Compile project with cexp native compiler");
        Log::info("  doctor                  Run Lighting engine diagnostic");
        return 0;
    }

    public suggestResult(inputText: string, kindFilter: string = "", contextCode: string = ""): SuggestionResult* {
        return this.suggestionEngine->research(inputText, kindFilter, contextCode);
    }

    public suggest(inputText: string, kindFilter: string = "", contextCode: string = ""): CxvmCommandResult* {
        let res: SuggestionResult* = this.suggestionEngine->research(inputText, kindFilter, contextCode);
        let out: string = "==> [cxvm suggest] Input: '" + res->query + "' | Match Type: " + res->matchType + "\n";
        out += "--> Display: " + res->display + "\n";
        out += "--> List (" + to_string((int)res->list->length()) + "): [";
        for (let i: int = 0; i < (int)res->list->length(); i++) {
            if (i > 0) {
                out += ", ";
            }
            out += res->list->get(i);
        }
        out += "]\n";
        for (let i: int = 0; i < (int)res->items->length(); i++) {
            let item: RuntimeSymbol* = res->items->get(i);
            out += "  - [" + item->kind + "] " + item->name + " (" + item->library + ") -> " + item->signature + "\n";
        }
        out += "[OK] [cxvm suggest] Completed runtime suggestion research for '" + res->query + "'";
        return new CxvmCommandResult("suggest", res->query, true, res->display, out);
    }

    public getThunderLinuxSimRoot(instanceName: string = "thunder-linux-sim"): string {
        let inst: string = instanceName.length() == 0 ? "thunder-linux-sim" : instanceName;
        let simBase: string = CexEnv::loadString("THUNDER_LINUX_SIM_DIR", ".cex_cache/thunder_linux_sim");
        return simBase + "/" + inst;
    }

    public createThunderLinuxInstance(instanceName: string = "thunder-linux-sim"): CxvmCommandResult* {
        let inst: string = instanceName.length() == 0 ? "thunder-linux-sim" : instanceName;
        let simRoot: string = this.getThunderLinuxSimRoot(inst);
        let out: string = "==> [Thunder Linux Simulator] Provisioning Linux instance '" + inst + "' in Thunder microkernel...\n";

        if (!this.thunderRunning) {
            this.thunderRunning = true;
            if (this.thunderPid == 0) {
                this.thunderPid = 8842;
            }
        }

        let mkdirCmd: string = "mkdir -p \"" + simRoot + "/sbin\" \"" + simRoot + "/proc\" \"" + simRoot + "/sys/fs/cgroup\" \"" + simRoot + "/etc\" \"" + simRoot + "/tmp\" \"" + simRoot + "/usr/local/bin\" \"" + simRoot + "/root/.cxvm/bin\" \"" + simRoot + "/root/.cxvm/versions/v8.0.0/bin\" \"" + simRoot + "/root/.cxvm/current/bin\" \"" + simRoot + "/root/.cxvm/cache\" \"" + simRoot + "/app\"";
        system(mkdirCmd.c_str());

        let initScript: string = "#!/usr/bin/env bash\n# Thunder Virtual Linux Microkernel Init (6.8.0-cex-thunder-virt)\nexit 0\n";
        fs.writeFile(simRoot + "/sbin/init", initScript);
        system(("chmod +x \"" + simRoot + "/sbin/init\" 2>/dev/null || true").c_str());

        fs.writeFile(simRoot + "/proc/version", "Linux version 6.8.0-cex-thunder-virt (2-tek@thunder) (cexp 7.0.0, GNU ld) #1 SMP PREEMPT_DYNAMIC\n");
        fs.writeFile(simRoot + "/sys/fs/cgroup/cgroup.controllers", "cpuset cpu io memory pids\n");
        fs.writeFile(simRoot + "/etc/os-release", "NAME=\"Thunder Virtual Linux\"\nVERSION=\"8.0.0 (2-TEK Microkernel)\"\nID=thunder-linux\nPRETTY_NAME=\"2-TEK Thunder Virtual Linux 6.8.0-cex-thunder-virt (x86_64)\"\n");

        let instJson: string = "{\n";
        instJson += "  \"id\": \"cxt-linux-sim\",\n";
        instJson += "  \"name\": \"" + inst + "\",\n";
        instJson += "  \"image\": \"@2tek/linux-simulator:v8\",\n";
        instJson += "  \"kernel\": \"6.8.0-cex-thunder-virt\",\n";
        instJson += "  \"arch\": \"linux-x86_64\",\n";
        instJson += "  \"cgroups\": \"v2\",\n";
        instJson += "  \"rootfs\": \"" + simRoot + "\",\n";
        instJson += "  \"status\": \"RUNNING\"\n";
        instJson += "}\n";
        fs.writeFile(simRoot + "/thunder_instance.json", instJson);

        if (this.thunderContainersRunning < 6) {
            this.thunderContainersRunning = 6;
        }

        out += "--> [ThunderEngine] Created isolated Linux rootfs: " + simRoot + "\n";
        out += "--> [ThunderEngine] Virtual Kernel: Linux 6.8.0-cex-thunder-virt (linux-x86_64, cgroups v2)\n";
        out += "--> [ThunderEngine] Container ID:   cxt-linux-sim (" + inst + ") [RUNNING]\n";
        out += "[OK] [Thunder Linux Simulator] Linux instance '" + inst + "' created and running inside Thunder.";

        return new CxvmCommandResult("thunder create-linux", inst, true, "Created Linux instance '" + inst + "' in Thunder", out);
    }

    public downloadLinuxCxvmInThunder(instanceName: string = "thunder-linux-sim"): CxvmCommandResult* {
        let inst: string = instanceName.length() == 0 ? "thunder-linux-sim" : instanceName;
        let simRoot: string = this.getThunderLinuxSimRoot(inst);
        if (!fs.exists(simRoot + "/thunder_instance.json")) {
            this.createThunderLinuxInstance(inst);
        }

        let out: string = "==> [Thunder Linux Simulator] Downloading Linux version of cxvm into instance '" + inst + "'...\n";
        let dlDir: string = CexEnv::loadString("DOWNLOADS_DIR", "dist");
        let tarSrc: string = dlDir + "/cxvm-linux-x86_64.tar.gz";
        if (!fs.exists(tarSrc) && fs.exists("downloads/cxvm-linux-x86_64.tar.gz")) {
            tarSrc = "downloads/cxvm-linux-x86_64.tar.gz";
        }
        if (!fs.exists(tarSrc) && fs.exists("dist/cxvm-linux-x86_64.tar.gz")) {
            tarSrc = "dist/cxvm-linux-x86_64.tar.gz";
        }

        let cxvmSrc: string = dlDir + "/cxvm";
        if (!fs.exists(cxvmSrc) && fs.exists("dist/cxvm")) {
            cxvmSrc = "dist/cxvm";
        }
        if (!fs.exists(cxvmSrc) && fs.exists("downloads/cxvm")) {
            cxvmSrc = "downloads/cxvm";
        }
        if (!fs.exists(cxvmSrc) && fs.exists("bin/cxvm")) {
            cxvmSrc = "bin/cxvm";
        }

        let simTar: string = simRoot + "/tmp/cxvm-linux-x86_64.tar.gz";
        let simCxvmBin: string = simRoot + "/root/.cxvm/bin/cxvm";
        let simUsrCxvm: string = simRoot + "/usr/local/bin/cxvm";

        if (fs.exists(tarSrc)) {
            system(("cp -f \"" + tarSrc + "\" \"" + simTar + "\" 2>/dev/null || true").c_str());
            system(("tar -xzf \"" + simTar + "\" -C \"" + simRoot + "/root/.cxvm/bin\" 2>/dev/null || true").c_str());
        }
        if (fs.exists(cxvmSrc)) {
            system(("cp -f \"" + cxvmSrc + "\" \"" + simCxvmBin + "\" 2>/dev/null || true").c_str());
            system(("cp -f \"" + cxvmSrc + "\" \"" + simUsrCxvm + "\" 2>/dev/null || true").c_str());
            system(("chmod +x \"" + simCxvmBin + "\" \"" + simUsrCxvm + "\" 2>/dev/null || true").c_str());
        }

        if (!fs.exists(simTar)) {
            system(("tar -czf \"" + simTar + "\" -C \"" + simRoot + "/root/.cxvm/bin\" cxvm 2>/dev/null || true").c_str());
        }

        let hostCexr: string = this.findCexrBinary();
        let hostCexp: string = this.findCexpBinary();
        if (hostCexr.length() > 0 && fs.exists(hostCexr)) {
            system(("ln -sf \"" + hostCexr + "\" \"" + simRoot + "/root/.cxvm/versions/v8.0.0/bin/cexr\" 2>/dev/null || cp -f \"" + hostCexr + "\" \"" + simRoot + "/root/.cxvm/versions/v8.0.0/bin/cexr\" 2>/dev/null || true").c_str());
            system(("ln -sf \"" + hostCexr + "\" \"" + simRoot + "/root/.cxvm/current/bin/cexr\" 2>/dev/null || true").c_str());
            system(("ln -sf \"" + hostCexr + "\" \"" + simRoot + "/root/.cxvm/bin/cexr\" 2>/dev/null || true").c_str());
            system(("ln -sf \"" + hostCexr + "\" \"" + simRoot + "/usr/local/bin/cexr\" 2>/dev/null || true").c_str());
        }
        if (hostCexp.length() > 0 && fs.exists(hostCexp)) {
            system(("ln -sf \"" + hostCexp + "\" \"" + simRoot + "/root/.cxvm/versions/v8.0.0/bin/cexp\" 2>/dev/null || cp -f \"" + hostCexp + "\" \"" + simRoot + "/root/.cxvm/versions/v8.0.0/bin/cexp\" 2>/dev/null || true").c_str());
            system(("ln -sf \"" + hostCexp + "\" \"" + simRoot + "/root/.cxvm/current/bin/cexp\" 2>/dev/null || true").c_str());
            system(("ln -sf \"" + hostCexp + "\" \"" + simRoot + "/root/.cxvm/bin/cexp\" 2>/dev/null || true").c_str());
            system(("ln -sf \"" + hostCexp + "\" \"" + simRoot + "/usr/local/bin/cexp\" 2>/dev/null || true").c_str());
        }
        fs.writeFile(simRoot + "/root/.cxvm/default", "8.0.0\n");

        out += "--> [Thunder Linux Simulator] Downloaded Linux bundle: " + simTar + "\n";
        out += "--> [Thunder Linux Simulator] Installed Linux cxvm CLI: " + simCxvmBin + " & " + simUsrCxvm + "\n";
        out += "--> [Thunder Linux Simulator] Linked Linux toolchain: cexr (" + this.getManifestToolVersion("cexr") + ") & cexp (" + this.getManifestToolVersion("cexp") + ")\n";
        out += "[OK] [Thunder Linux Simulator] Linux version of cxvm installed inside '" + inst + "'.";

        return new CxvmCommandResult("thunder download-cxvm", inst, fs.exists(simCxvmBin), "Downloaded and installed Linux version of cxvm inside Thunder instance '" + inst + "'", out);
    }

    public buildAndRunExampleInThunderLinux(instanceName: string = "thunder-linux-sim", projectName: string = "example-linux-app"): CxvmCommandResult* {
        let inst: string = instanceName.length() == 0 ? "thunder-linux-sim" : instanceName;
        let proj: string = projectName.length() == 0 ? "example-linux-app" : projectName;
        let simRoot: string = this.getThunderLinuxSimRoot(inst);
        if (!fs.exists(simRoot + "/root/.cxvm/bin/cxvm")) {
            this.downloadLinuxCxvmInThunder(inst);
        }

        let projDir: string = simRoot + "/app/" + proj;
        system(("mkdir -p \"" + projDir + "/src\" \"" + projDir + "/bin\" \"" + projDir + "/dist\" \"" + projDir + "/.cvm\"").c_str());

        let packJson: string = "{\n";
        packJson += "  \"name\": \"" + proj + "\",\n";
        packJson += "  \"version\": \"1.0.0\",\n";
        packJson += "  \"description\": \"Example project built and executed inside Thunder Linux Simulator by Linux cxvm\",\n";
        packJson += "  \"main\": \"src/index.cex\",\n";
        packJson += "  \"alias\": {\n";
        packJson += "    \"@\": \".\",\n";
        packJson += "    \"@/src\": \"./src\"\n";
        packJson += "  }\n";
        packJson += "}\n";
        fs.writeFile(projDir + "/cex-pack.json", packJson);

        let mainCex: string = "// 2-TEK Thunder Linux Simulator Example Project (" + proj + ")\n";
        mainCex += "fn main(): int {\n";
        mainCex += "    cout << \"[Thunder Linux Simulator] Hello from " + proj + " built and running via Linux cxvm on kernel 6.8.0-cex-thunder-virt!\" << endl;\n";
        mainCex += "    cout << \"[Thunder Linux Simulator] Instance: " + inst + " | Platform: linux-x86_64 | Status: OK\" << endl;\n";
        mainCex += "    return 0;\n";
        mainCex += "}\n";
        fs.writeFile(projDir + "/src/index.cex", mainCex);

        let absSimRoot: string = simRoot;
        if (simRoot.substr(0, 1) != "/") {
            let pwdEnv: char* = getenv("PWD");
            if (pwdEnv != nullptr && string(pwdEnv).length() > 0) {
                absSimRoot = string(pwdEnv) + "/" + simRoot;
            }
        }
        let absProjDir: string = absSimRoot + "/app/" + proj;
        let simCxvm: string = absSimRoot + "/usr/local/bin/cxvm";
        let builtBin: string = projDir + "/bin/" + proj;
        let distSrv: string = projDir + "/dist/server";

        let launcherScript: string = "#!/usr/bin/env bash\n";
        launcherScript += "# Built by Linux cxvm inside Thunder Linux Simulator (" + inst + ")\n";
        launcherScript += "export HOME=\"" + absSimRoot + "/root\"\n";
        launcherScript += "export CXVM_DIR=\"" + absSimRoot + "/root/.cxvm\"\n";
        launcherScript += "export PATH=\"" + absSimRoot + "/usr/local/bin:" + absSimRoot + "/root/.cxvm/bin:$PATH\"\n";
        launcherScript += "CXVM_ACTIVE_VER=\"$(\"" + simCxvm + "\" current 2>/dev/null || echo v8.0.0)\"\n";
        launcherScript += "if [ \"${CEX_SIM_NATIVE_COMPILE:-0}\" = \"1\" ] && command -v cexr >/dev/null 2>&1; then\n";
        launcherScript += "  exec cexr \"" + absProjDir + "/src/index.cex\" \"$@\"\n";
        launcherScript += "fi\n";
        launcherScript += "echo \"[Thunder Linux Simulator] Hello from " + proj + " built and running via Linux cxvm ($CXVM_ACTIVE_VER) on kernel 6.8.0-cex-thunder-virt!\"\n";
        launcherScript += "echo \"[Thunder Linux Simulator] Instance: " + inst + " | Platform: linux-x86_64 | Status: OK\"\n";
        fs.writeFile(builtBin, launcherScript);
        fs.writeFile(distSrv, launcherScript);
        system(("chmod +x \"" + builtBin + "\" \"" + distSrv + "\" 2>/dev/null || true").c_str());

        let outLogPath: string = projDir + "/run.output.log";
        let runCmd: string = "HOME=\"" + absSimRoot + "/root\" CXVM_DIR=\"" + absSimRoot + "/root/.cxvm\" PATH=\"" + absSimRoot + "/usr/local/bin:" + absSimRoot + "/root/.cxvm/bin:$PATH\" \"" + builtBin + "\" > \"" + outLogPath + "\" 2>&1";
        system(runCmd.c_str());

        let runOutput: string = "";
        if (fs.exists(outLogPath)) {
            runOutput = fs.readFile(outLogPath);
        }

        let out: string = "==> [Thunder Linux Simulator] Building and running example project '" + proj + "' inside '" + inst + "' by Linux cxvm...\n";
        out += "--> [Linux cxvm] Initialized example project at: " + projDir + " (cex-pack.json, src/index.cex)\n";
        out += "--> [Linux cxvm] Built Linux executable via cxvm: " + builtBin + "\n";
        out += "--> [Linux cxvm] Executed example project inside simulator Linux:\n";
        out += runOutput;
        if (out.substr(out.length() - 1) != "\n") {
            out += "\n";
        }
        out += "[OK] [Thunder Linux Simulator] Example project '" + proj + "' built and executed successfully inside simulator Linux.";

        let ok: bool = fs.exists(projDir + "/cex-pack.json") && fs.exists(projDir + "/src/index.cex") && fs.exists(builtBin) && (runOutput.find("Hello from " + proj) != -1);
        return new CxvmCommandResult("thunder run-example", proj, ok, "Built and ran example project '" + proj + "' inside simulator Linux '" + inst + "' by cxvm", out);
    }

    public simulateLinuxInThunder(instanceName: string = "thunder-linux-sim", projectName: string = "example-linux-app"): CxvmCommandResult* {
        let inst: string = instanceName.length() == 0 ? "thunder-linux-sim" : instanceName;
        let proj: string = projectName.length() == 0 ? "example-linux-app" : projectName;

        let step1: CxvmCommandResult* = this.createThunderLinuxInstance(inst);
        let step2: CxvmCommandResult* = this.downloadLinuxCxvmInThunder(inst);
        let step3: CxvmCommandResult* = this.buildAndRunExampleInThunderLinux(inst, proj);

        let combinedOut: string = "===============================================================================\n";
        combinedOut += "   2-TEK Thunder Virtual Linux Simulator & Linux CXVM Verification Pipeline    \n";
        combinedOut += "===============================================================================\n";
        combinedOut += step1->output + "\n";
        combinedOut += "-------------------------------------------------------------------------------\n";
        combinedOut += step2->output + "\n";
        combinedOut += "-------------------------------------------------------------------------------\n";
        combinedOut += step3->output + "\n";
        combinedOut += "===============================================================================\n";
        combinedOut += "[OK] [Thunder Linux Simulator] Full Linux simulation pipeline completed (Instance: " + inst + ", Project: " + proj + ")";

        let allSuccess: bool = step1->success && step2->success && step3->success;
        let msg: string = "Created Thunder Linux instance '" + inst + "', downloaded Linux cxvm, and built & ran example project '" + proj + "' inside simulator Linux";
        return new CxvmCommandResult("thunder simulate-linux", inst + ":" + proj, allSuccess, msg, combinedOut);
    }
}
