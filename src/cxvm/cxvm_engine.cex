            out += "  - Dashboard:  http://localhost:" + to_string(this.thunderPort) + "\n";
            out += "  - Health API: http://localhost:" + to_string(this.thunderPort) + "/health";
            return new CxvmCommandResult("status thunder", to_string(this.thunderPort), true, "Thunder server running", out);
