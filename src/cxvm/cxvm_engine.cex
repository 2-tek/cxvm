        let thunSrvStr: string = this.thunderRunning ? "RUNNING [Single Process Standalone on port " + to_string(this.thunderPort) + ", PID: " + to_string(this.thunderPid) + "]" : "STOPPED (run: cxvm start thunder)";
        out += "  Thunder Daemon:    " + thunSrvStr + "\n";
