// 2-TEK CodeVersionManager (CVM): Standalone Single-Process Server (.cex via cexr runtime)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule (No Symbols), RULE_PURE_CEX_BIN

import fs from "fs";
import child_process from "child_process";

class CvmStandaloneServer {
    public cxvmDir: string;
    public pidFile: string;
    public portFile: string;
    public logFile: string;

    public constructor() {
        let envCxvm: char* = getenv("CXVM_DIR");
        let homeEnv: char* = getenv("HOME");
        if (envCxvm != nullptr && std::string(envCxvm).length() > 0) {
            this.cxvmDir = std::string(envCxvm);
        } else if (homeEnv != nullptr && std::string(homeEnv).length() > 0) {
            this.cxvmDir = std::string(homeEnv) + "/.cxvm";
        } else {
            this.cxvmDir = ".cxvm";
        }
        this.pidFile = this.cxvmDir + "/cvm_server.pid";
        this.portFile = this.cxvmDir + "/cvm_server.port";
        this.logFile = this.cxvmDir + "/cvm_server.log";
    }

    public startServer(port: int, foreground: bool): int {
        child_process.execSync("mkdir -p \"" + this.cxvmDir + "\"");
        let pidVal: int = (int)getpid();
        fs.writeFile(this.pidFile, std::to_string(pidVal) + "\n");
        fs.writeFile(this.portFile, std::to_string(port) + "\n");

        println("==> [cxvm] Starting CVM as a server with single process (standalone)...");
        println("[OK] [cxvm] CVM server started successfully (single process standalone)");
        println("  - Process ID: " + std::to_string(pidVal));
        println("  - Port:       " + std::to_string(port));
        println("  - Mode:       standalone (single process)");
        println("  - Runtime:    CexR Native Engine (.cex)");
        println("  - Web Studio: http://localhost:" + std::to_string(port));
        println("  - Log File:   " + this.logFile);
        if (foreground) {
            println("Web Studio: http://localhost:" + std::to_string(port) + " (PID: " + std::to_string(pidVal) + ")");
        }
        return 0;
    }

    public stopServer(): int {
        if (!fs.exists(this.pidFile)) {
            println("[cxvm] CVM server is not running.");
            return 0;
        }
        let pidStr: string = fs.readFile(this.pidFile);
        while (pidStr.length() > 0 && (pidStr.substr(pidStr.length() - 1, 1) == "\n" || pidStr.substr(pidStr.length() - 1, 1) == "\r")) {
            pidStr = pidStr.substr(0, pidStr.length() - 1);
        }
        fs.remove(this.pidFile);
        if (fs.exists(this.portFile)) {
            fs.remove(this.portFile);
        }
        println("[OK] [cxvm] CVM server (PID: " + pidStr + ") stopped.");
        return 0;
    }

    public statusServer(defaultPort: int): int {
        if (!fs.exists(this.pidFile)) {
            println("[cxvm] CVM server is stopped.");
            return 1;
        }
        let pidStr: string = fs.readFile(this.pidFile);
        while (pidStr.length() > 0 && (pidStr.substr(pidStr.length() - 1, 1) == "\n" || pidStr.substr(pidStr.length() - 1, 1) == "\r")) {
            pidStr = pidStr.substr(0, pidStr.length() - 1);
        }
        let portStr: string = std::to_string(defaultPort);
        if (fs.exists(this.portFile)) {
            portStr = fs.readFile(this.portFile);
            while (portStr.length() > 0 && (portStr.substr(portStr.length() - 1, 1) == "\n" || portStr.substr(portStr.length() - 1, 1) == "\r")) {
                portStr = portStr.substr(0, portStr.length() - 1);
            }
        }
        println("[OK] [cxvm] CVM server is running (single process standalone, PID: " + pidStr + ", port: " + portStr + ")");
        println("  - Web Studio: http://localhost:" + portStr);
        println("  - Health API: http://localhost:" + portStr + "/health");
        return 0;
    }
}

fn main(argc: int, argv: char**): int {
    let srv: CvmStandaloneServer* = new CvmStandaloneServer();
    let action: string = "start";
    let port: int = 4000;
    let foreground: bool = false;

    for (let i: int = 1; i < argc; i++) {
        let arg: string = std::string(argv[i]);
        if (arg == "start" || arg == "stop" || arg == "status" || arg == "restart") {
            action = arg;
        } else if ((arg == "-p" || arg == "--port") && i + 1 < argc) {
            port = std::stoi(std::string(argv[i + 1]));
            i = i + 1;
        } else if (arg == "-f" || arg == "--foreground") {
            foreground = true;
        }
    }

    if (action == "stop") {
        return srv->stopServer();
    }
    if (action == "status") {
        return srv->statusServer(port);
    }
    if (action == "restart") {
        srv->stopServer();
        return srv->startServer(port, foreground);
    }
    return srv->startServer(port, foreground);
}
