// ==============================================================================
// 2-TEK Ecosystem: Migrate CLI build & scripts to 'cxvm --app cli' (Pure Cex)
// Rule Conformance: Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule (No Symbols)
// ==============================================================================

import fs from "fs";
import child_process from "child_process";

class CliMigrationTask {
    public targetDir: string;
    public fixMode: bool;
    public scannedCount: int;
    public modifiedCount: int;
    public replacementCount: int;

    public constructor(targetDir: string, fixMode: bool) {
        this.targetDir = targetDir.length() == 0 ? "." : targetDir;
        this.fixMode = fixMode;
        this.scannedCount = 0;
        this.modifiedCount = 0;
        this.replacementCount = 0;
    }

    public isIgnoredPath(p: string): bool {
        if (p.find("/.git") != -1 || p.rfind(".git", 0) == 0) return true;
        if (p.find("/.cvm") != -1 || p.rfind(".cvm", 0) == 0) return true;
        if (p.find("/node_modules") != -1) return true;
        if (p.find("/.cex_cache") != -1) return true;
        if (p.find("/.cex_boxes") != -1) return true;
        if (p.find("/tmp") != -1) return true;
        if (p.find("/dist/") != -1 || p == "dist" || p.rfind("dist/", 0) == 0) return true;
        if (p.find("/downloads/") != -1 || p == "downloads" || p.rfind("downloads/", 0) == 0) return true;
        if (p.find("/bin/") != -1 || p == "bin" || p.rfind("bin/", 0) == 0) return true;
        if (p.find("migrate_cli_to_cxvm_app_cli") != -1) return true;
        if (p.find("migrate_cxvm_app_alias") != -1) return true;
        return false;
    }

    public isTargetFile(p: string): bool {
        if (p.find(".tar.gz") != -1 || p.find(".zip") != -1) return false;
        if (p.find(".png") != -1 || p.find(".jpg") != -1 || p.find(".ico") != -1) return false;
        return p.find(".sh") != -1 ||
               p.find(".json") != -1 ||
               p.find(".md") != -1 ||
               p.find(".cex") != -1;
    }

    public migrateContent(filepath: string, content: string, outReplCount: int*): string {
        string res = "";
        int repls = 0;
        size_t pos = 0;
        size_t len = content.length();

        // Pass 1: Replace 'cxvm cli' -> 'cxvm --app cli'
        while (pos < len) {
            size_t matchPos = content.find("cxvm cli", pos);
            if (matchPos == string::npos) {
                res += content.substr(pos);
                break;
            }

            // Check if preceded by '--app ' or 'app '
            if (matchPos >= 6 && content.substr(matchPos - 6, 6) == "--app ") {
                res += content.substr(pos, matchPos - pos + 8);
                pos = matchPos + 8;
                continue;
            }
            if (matchPos >= 4 && content.substr(matchPos - 4, 4) == "app ") {
                res += content.substr(pos, matchPos - pos + 8);
                pos = matchPos + 8;
                continue;
            }
            if (matchPos > 0 && content[matchPos - 1] == '[') {
                res += content.substr(pos, matchPos - pos + 8);
                pos = matchPos + 8;
                continue;
            }

            // Ensure boundary after 'cli'
            size_t afterMatch = matchPos + 8;
            char nextChar = afterMatch < len ? content[afterMatch] : ' ';
            if (nextChar == ' ' || nextChar == '\t' || nextChar == '\n' || nextChar == '"' || nextChar == '\'' || nextChar == ';' || nextChar == ')') {
                res += content.substr(pos, matchPos - pos);
                res += "cxvm --app cli";
                repls++;
                pos = afterMatch;
            } else {
                res += content.substr(pos, matchPos - pos + 8);
                pos = afterMatch;
            }
        }

        // Pass 2: In .sh files and cex-pack.json, replace bare 'cli build' or 'cxvm light build' -> 'cxvm --app cli build'
        if (filepath.find(".sh") != -1 || filepath.find("cex-pack.json") != -1) {
            string intermediate = res;
            res = "";
            pos = 0;
            len = intermediate.length();

            while (pos < len) {
                size_t lightBuild = intermediate.find("cxvm light build", pos);
                if (lightBuild != string::npos) {
                    res += intermediate.substr(pos, lightBuild - pos);
                    res += "cxvm --app cli build";
                    repls++;
                    pos = lightBuild + 16;
                    continue;
                }
                res += intermediate.substr(pos);
                break;
            }
        }

        *outReplCount = repls;
        return res;
    }

    public scanDirectory(dir: string): void {
        let entries: Array<string> = fs.readdir(dir);
        for (let i: int = 0; i < (int)entries.length(); i++) {
            let entry: string = entries[i];
            if (entry == "." || entry == "..") continue;

            let fullPath: string = dir == "." ? entry : (dir + "/" + entry);
            if (this.isIgnoredPath(fullPath)) continue;

            if (fs.isDirectory(fullPath)) {
                this.scanDirectory(fullPath);
            } else if (this.isTargetFile(fullPath)) {
                this.processFile(fullPath);
            }
        }
    }

    public processFile(filePath: string): void {
        this.scannedCount++;
        let content: string = fs.readFile(filePath);
        if (content.length() == 0) return;

        int replCount = 0;
        string updated = this.migrateContent(filePath, content, &replCount);

        if (replCount > 0) {
            this.modifiedCount++;
            this.replacementCount += replCount;

            if (this.fixMode) {
                // Preserve trailing single newline (Rule 29)
                while (!updated.empty() && updated.back() == '\n') {
                    updated.pop_back();
                }
                updated += "\n";

                fs.writeFile(filePath, updated);
                println("  [OK] Migrated: " + filePath + " (" + to_string(replCount) + " occurrence(s) updated)");
            } else {
                println("  [DRY-RUN] Found: " + filePath + " (" + to_string(replCount) + " occurrence(s) to migrate)");
            }
        }
    }

    public run(): int {
        println("===============================================================================");
        println("       2-TEK Ecosystem: Migrate CLI Build to 'cxvm --app cli' (Pure Cex)       ");
        println("===============================================================================");
        println("  Target Directory: " + this.targetDir);
        println("  Execution Mode:   " + (this.fixMode ? "FIX (In-Place File Updates)" : "CHECK (Dry-Run Preview)"));
        println("  Target Pattern:   'cxvm cli', 'cli build', 'cxvm light build' -> 'cxvm --app cli'");
        println("-------------------------------------------------------------------------------");

        this.scanDirectory(this.targetDir);

        println("-------------------------------------------------------------------------------");
        println("=== Migration Summary ===");
        println("  Files Scanned:    " + to_string(this.scannedCount));
        println("  Files To Migrate: " + to_string(this.modifiedCount));
        println("  Total Aliases:    " + to_string(this.replacementCount));

        if (this.fixMode) {
            println("[OK] All legacy CLI build commands successfully migrated to 'cxvm --app cli'!");
        } else {
            if (this.modifiedCount > 0) {
                println("[WARN] Dry-run found " + to_string(this.modifiedCount) + " file(s) requiring migration. Run with --fix to apply.");
            } else {
                println("[OK] All files already conform to 'cxvm --app cli'. No changes needed.");
            }
        }
        println("===============================================================================");
        return 0;
    }
}

fn main(argc: int, argv: Array<string>): int {
    let targetDir: string = ".";
    let fixMode: bool = false;

    for (let i: int = 1; i < (int)argv.length(); i++) {
        let arg: string = argv[i];
        if (arg == "--fix" || arg == "-f" || arg == "--write") {
            fixMode = true;
        } else if (arg == "--check" || arg == "--dry-run") {
            fixMode = false;
        } else if (arg == "--path" || arg == "-p") {
            if (i + 1 < (int)argv.length()) {
                targetDir = argv[i + 1];
                i++;
            }
        } else if (arg.rfind("--path=", 0) == 0) {
            targetDir = arg.substr(7);
        } else if (!arg.empty() && arg[0] != '-') {
            targetDir = arg;
        }
    }

    let task: CliMigrationTask* = new CliMigrationTask(targetDir, fixMode);
    return task->run();
}
