// 2-TEK CexR v8: Verification Test Suite for Always Cex-Lint Rule
// Conforms to Rule 69, Rule 29, Rule 72, Rule 80, Rule 81, Rule 82, Rule 83, Rule 85

import "@cex-test/src/assert.cex";
import "@cex-test/src/runner.cex";
import "../task_add_always_cex_lint_rule.cex";

fn main(): int {
    let suite: TestSuite* = new TestSuite("Always Cex-Lint Rule Test Suite");
    cex::GC::pin(suite);

    println("===============================================================================");
    println("      2-TEK CexR v8: Always Cex-Lint Rule Automated Test Suite                 ");
    println("===============================================================================");

    let migrator: AlwaysLintMigrator* = new AlwaysLintMigrator(false);

    // -------------------------------------------------------------
    // Test 1: Canonical Rule Has always_on Trigger
    // -------------------------------------------------------------
    let canonicalRule: string = migrator->getCanonicalRuleContent();
    Assert::isTrue(canonicalRule.find("trigger: always_on") != std::string::npos, "Rule contains always_on trigger frontmatter");
    Assert::isTrue(canonicalRule.find("RULE_CEX_LINT") != std::string::npos, "Rule contains RULE_CEX_LINT identifier");
    suite->addResult("test_canonical_rule_has_always_on", true, "", 1);

    // -------------------------------------------------------------
    // Test 2: Canonical Rule Has Strict Lint Gate & Syntax Standards
    // -------------------------------------------------------------
    Assert::isTrue(canonicalRule.find("MANDATORY ALWAYS AUTOMATIC LINT GATE") != std::string::npos, "Rule contains mandatory automatic lint gate");
    Assert::isTrue(canonicalRule.find("no-raw-include") != std::string::npos, "Rule enforces no-raw-include");
    Assert::isTrue(canonicalRule.find("this-dot") != std::string::npos, "Rule enforces this-dot");
    Assert::isTrue(canonicalRule.find("semi") != std::string::npos, "Rule enforces semi");
    Assert::isTrue(canonicalRule.find("eol-last") != std::string::npos, "Rule enforces eol-last (Rule 29)");
    suite->addResult("test_canonical_rule_syntax_standards", true, "", 1);

    // -------------------------------------------------------------
    // Test 3: Migrator Scans Target Projects
    // -------------------------------------------------------------
    let targetProjects: Array<string>* = new Array<string>();
    targetProjects->push(".");
    if (fs.exists("../MVC-Lighting")) targetProjects->push("../MVC-Lighting");
    if (fs.exists("../MVP-DeepSea")) targetProjects->push("../MVP-DeepSea");

    let summary: AlwaysLintMigrationSummary* = new AlwaysLintMigrationSummary();
    migrator->scanAndMigrate(targetProjects, summary);

    Assert::isTrue(summary->scannedProjects >= 1, "Scans at least 1 configured target project");
    suite->addResult("test_migrator_scans_target_projects", true, "", 1);

    TestReporter::printSummary(suite);
    return suite->failCount() > 0 ? 1 : 0;
}
