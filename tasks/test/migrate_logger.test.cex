// 2-TEK CexR v8: Verification Test Suite for Logger Migration
// Conforms to Rule 69, Rule 29, Rule 72, Rule 80, Rule 81, Rule 82, Rule 83

import "@cex-test/src/assert.cex";
import "@cex-test/src/runner.cex";
import "../migrate_logger_to_cex_logger.cex";

fn main(): int {
    let suite: TestSuite* = new TestSuite("Logger to Cex-Logger Migration Test Suite");
    cex::GC::pin(suite);

    println("===============================================================================");
    println("      2-TEK CexR v8: Logger -> Cex-Logger Automated Test Suite                 ");
    println("===============================================================================");

    let migrator: LoggerMigrator* = new LoggerMigrator(true);

    // -------------------------------------------------------------
    // Test 1: Inject cex-logger into Dependencies Block
    // -------------------------------------------------------------
    let sampleManifest: string = "{\n  \"name\": \"test-app\",\n  \"version\": \"1.0.0\",\n  \"dependencies\": {\n    \"@cex-service\": \"1.0.0\"\n  }\n}\n";
    let updatedManifest: string = migrator->updateManifestDependencies(sampleManifest);

    Assert::isTrue(updatedManifest.find("\"cex-logger\": \"1.0.0\"") != std::string::npos, "Adds cex-logger to dependencies");
    Assert::isTrue(updatedManifest.find("\"@cex-service\": \"1.0.0\"") != std::string::npos, "Preserves existing dependencies");
    suite->addResult("test_inject_cex_logger_dependencies", true, "", 1);

    // -------------------------------------------------------------
    // Test 2: Existing cex-logger Declaration Remains Untouched
    // -------------------------------------------------------------
    let cleanManifest: string = "{\n  \"name\": \"test-app\",\n  \"dependencies\": {\n    \"cex-logger\": \"1.0.0\"\n  }\n}\n";
    let unchanged: string = migrator->updateManifestDependencies(cleanManifest);
    Assert::equalsString(cleanManifest, unchanged, "Already configured manifest is not modified");
    suite->addResult("test_existing_cex_logger_untouched", true, "", 1);

    // -------------------------------------------------------------
    // Test 3: Upgrade Middleware runLogger to CexLogger::info
    // -------------------------------------------------------------
    let sampleMiddleware: string = "class LightingMiddleware {\n    public static runLogger(req: HttpRequest*): void {\n        print(\"  [Lighting MVC Logger] \");\n        print(req->method);\n        print(\" \");\n        println(req->path);\n    }\n}\n";
    let updatedMiddleware: string = migrator->updateMiddlewareContent(sampleMiddleware);

    Assert::isTrue(updatedMiddleware.find("CexLogger::info") != std::string::npos, "Replaces raw print with CexLogger::info");
    Assert::isTrue(updatedMiddleware.find("println(req->path)") == std::string::npos, "Removes raw println");
    suite->addResult("test_upgrade_middleware_run_logger", true, "", 1);

    // -------------------------------------------------------------
    // Test 4: Generate Canonical Log Bridge Content
    // -------------------------------------------------------------
    let bridge: string = migrator->generateLogBridgeContent();
    Assert::isTrue(bridge.find("@cex-logger/src/log.cex") != std::string::npos, "Bridge imports from @cex-logger");
    suite->addResult("test_generate_log_bridge", true, "", 1);

    TestReporter::printSummary(suite);
    return suite->failCount() > 0 ? 1 : 0;
}
