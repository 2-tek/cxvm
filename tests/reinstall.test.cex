// 2-TEK CXVM: Toolchain Reinstallation Subsystem Test Suite
// Powered by cext (@cext/src/runner.cex)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "@cext.book";
import fs from "fs";
import "@/src/types.cex";
import "@/src/cxvm_engine.cex";
import "@/src/app.cex";

int main() {
    println("===============================================================================");
    println("       2-TEK CXVM: Toolchain Reinstallation Subsystem Test Suite               ");
    println("===============================================================================");

    TestSuite* suite = new TestSuite("CXVM Reinstall Tests");

    CxvmEngine* cxvm = new CxvmEngine();
    FactoryApp* app = new FactoryApp(CxvmConstants::defaultPort());

    // 1. Direct engine reinstall
    CxvmCommandResult* reRes = cxvm->reinstall(CxvmConstants::defaultVersion());
    Assert::isTrue(reRes->success, "cxvm reinstall succeeds");
    Assert::equalsString(CxvmConstants::defaultVersion(), cxvm->currentVersion, "Active runtime version is default after reinstall");
    Assert::equalsString(CxvmConstants::defaultVersion(), cxvm->defaultVersion, "Default runtime version is default after reinstall");
    Assert::isTrue(cxvm->installedVersions->length() >= 2, "Installed versions contains reinstalled runtimes");
    Assert::isTrue(reRes->output.find("[cxvm reinstall] Initiating deep scan and complete reinstall") != -1, "Output confirms reinstall scan phase");
    Assert::isTrue(reRes->output.find("[Purge] Removed runtime") != -1, "Output confirms purge phase");
    Assert::isTrue(reRes->output.find("REINSTALL COMPLETE [OK]") != -1, "Output confirms REINSTALL COMPLETE [OK]");

    // 2. CLI cvmExecute routing: cxvm reinstall
    int execReinstall = cxvm->cvmExecute("reinstall", CxvmConstants::defaultVersion(), "");
    Assert::equalsInt(0, execReinstall, "cxvm reinstall returns exit code 0");

    // 3. CLI cvmExecute routing: cxvm cex reinstall
    int execCexReinstall = cxvm->cvmExecute("cex", "reinstall", CxvmConstants::defaultVersion());
    Assert::equalsInt(0, execCexReinstall, "cxvm cex reinstall returns exit code 0");

    // 4. CLI cvmExecute routing: cxvm cli reinstall
    int execCliReinstall = cxvm->cvmExecute("cli", "reinstall", CxvmConstants::defaultVersion());
    Assert::equalsInt(0, execCliReinstall, "cxvm cli reinstall returns exit code 0");

    // 5. REST API: POST /api/v1/reinstall
    HttpResponse* resPostReinstall = app->simulateRequest("POST", "/api/v1/reinstall", "{\"version\":\"" + CxvmConstants::defaultVersion() + "\"}", "application/json");
    Assert::equalsInt(200, resPostReinstall->statusCode, "POST /api/v1/reinstall returns 200 OK");
    Assert::isTrue(resPostReinstall->body.find("SUCCESS") != -1, "Reinstall API reports SUCCESS");
    Assert::isTrue(resPostReinstall->body.find("reinstall") != -1, "Reinstall API reports command reinstall");

    suite->addResult("test_cxvm_reinstall_subsystem", true, "", 1);

    println("\n");
    TestReporter::printSummary(suite);
    return suite->failCount() > 0 ? 1 : 0;
}
