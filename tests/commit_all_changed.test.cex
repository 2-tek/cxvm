// 2-TEK CXVM: Commit All Changed Across Ecosystem Submodules and Root Test Suite
// Conformance: Rule 29 (EOF), Rule 69 (Target), Rule 72 (Dynamic Paths), RULE_CVM_AGENT_VCS

import "@cex-test.book";
import fs from "fs";

int main() {
    println("===============================================================================");
    println("  2-TEK CXVM: Commit All Changed Across Ecosystem Submodules & Root Test Suite ");
    println("===============================================================================");

    Assert::reset();

    // TC-VCS-01: SSR documentation files exist and are populated
    string ssrDir = ".agents/ssr/02-11-2026/commit-all-changed";
    Assert::isTrue(fs.exists(ssrDir + "/ssr.md"), "TC-VCS-01: ssr.md must exist");
    Assert::isTrue(fs.exists(ssrDir + "/testcases.md"), "TC-VCS-01: testcases.md must exist");
    Assert::isTrue(fs.exists(ssrDir + "/expectation.md"), "TC-VCS-01: expectation.md must exist");
    Assert::isTrue(fs.exists(ssrDir + "/result.md"), "TC-VCS-01: result.md must exist");

    // TC-VCS-02: Target submodules exist and have valid manifests
    Assert::isTrue(fs.exists("cex_boxes/cex-dom/cex-pack.json"), "TC-VCS-02: cex_boxes/cex-dom/cex-pack.json exists");
    Assert::isTrue(fs.exists("cex_boxes/cex-gl/cex-pack.json"), "TC-VCS-02: cex_boxes/cex-gl/cex-pack.json exists");
    Assert::isTrue(fs.exists("cex_boxes/cex-lint/cex-pack.json"), "TC-VCS-02: cex_boxes/cex-lint/cex-pack.json exists");
    Assert::isTrue(fs.exists("compilers/v2-cex-compile-cpp-to-cpp/cex-pack.json"), "TC-VCS-02: compilers/v2/cex-pack.json exists");
    Assert::isTrue(fs.exists("compilers/v3-cex-compile-cex-to-cpp/cex-pack.json"), "TC-VCS-02: compilers/v3/cex-pack.json exists");
    Assert::isTrue(fs.exists("compilers/v4-cex-compile-cex-to-machine-code/cex-pack.json"), "TC-VCS-02: compilers/v4/cex-pack.json exists");
    Assert::isTrue(fs.exists("compilers/v5-cex-compile-cex-to-binary-code/cex-pack.json"), "TC-VCS-02: compilers/v5/cex-pack.json exists");
    Assert::isTrue(fs.exists("compilers/v6-cex-compile-cex-to-jit-runtime/cex-pack.json"), "TC-VCS-02: compilers/v6/cex-pack.json exists");
    Assert::isTrue(fs.exists("compilers/v7-cex-compile-cex-to-test-engine/cex-pack.json"), "TC-VCS-02: compilers/v7/cex-pack.json exists");

    // TC-VCS-03: Submodule cex-gl has dev window zoom controls and passes verification
    if (fs.exists("cex_boxes/cex-gl/src/window.cex")) {
        string winContent = fs.readFile("cex_boxes/cex-gl/src/window.cex");
        Assert::isTrue(winContent.find("getCloseButtonBounds") != -1, "TC-VCS-03: window.cex has getCloseButtonBounds");
        Assert::isTrue(winContent.find("getZoomInButtonBounds") != -1, "TC-VCS-03: window.cex has getZoomInButtonBounds");
        Assert::isTrue(winContent.find("getZoomOutButtonBounds") != -1, "TC-VCS-03: window.cex has getZoomOutButtonBounds");
    }

    // TC-VCS-04: Submodule cex-lint has no nested cex_boxes
    Assert::isFalse(fs.exists("cex_boxes/cex-lint/cex_boxes"), "TC-VCS-04: cex_boxes/cex-lint/cex_boxes must not exist");

    // TC-VCS-05: Compilers v2-v7 use cexr-factory in cex-pack.json build script
    string c2 = fs.readFile("compilers/v2-cex-compile-cpp-to-cpp/cex-pack.json");
    Assert::isTrue(c2.find("cexr-factory build") != -1, "TC-VCS-05: compilers/v2 uses cexr-factory build");
    string c3 = fs.readFile("compilers/v3-cex-compile-cex-to-cpp/cex-pack.json");
    Assert::isTrue(c3.find("cexr-factory build") != -1, "TC-VCS-05: compilers/v3 uses cexr-factory build");
    string c4 = fs.readFile("compilers/v4-cex-compile-cex-to-machine-code/cex-pack.json");
    Assert::isTrue(c4.find("cexr-factory build") != -1, "TC-VCS-05: compilers/v4 uses cexr-factory build");
    string c5 = fs.readFile("compilers/v5-cex-compile-cex-to-binary-code/cex-pack.json");
    Assert::isTrue(c5.find("cexr-factory build") != -1, "TC-VCS-05: compilers/v5 uses cexr-factory build");
    string c6 = fs.readFile("compilers/v6-cex-compile-cex-to-jit-runtime/cex-pack.json");
    Assert::isTrue(c6.find("cexr-factory build") != -1, "TC-VCS-05: compilers/v6 uses cexr-factory build");
    string c7 = fs.readFile("compilers/v7-cex-compile-cex-to-test-engine/cex-pack.json");
    Assert::isTrue(c7.find("cexr-factory build") != -1, "TC-VCS-05: compilers/v7 uses cexr-factory build");

    // TC-VCS-06: Root cex-pack.json version is incremented to 2.0.17
    Assert::isTrue(fs.exists("cex-pack.json"), "TC-VCS-06: root cex-pack.json must exist");
    if (fs.exists("cex-pack.json")) {
        string packContent = fs.readFile("cex-pack.json");
        Assert::isTrue(packContent.find("\"version\": \"2.0.17\"") != -1, "TC-VCS-06: root version must be 2.0.17");
    }

    // TC-VCS-07: Canonical Javis binary exists
    Assert::isTrue(fs.exists("documents/bin/javis"), "TC-VCS-07: documents/bin/javis must exist");

    int failures = Assert::getFailures();
    if (failures > 0) {
        println("\n[FAIL] Test suite completed with failures.");
        return 1;
    }
    println("\n[PASS] All testcases passed successfully.");
    return 0;
}
