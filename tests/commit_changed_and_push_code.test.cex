// 2-TEK CXVM: Commit Changed & Push Code Test Suite
// Conformance: Rule 29 (EOF), Rule 69 (Target), Rule 72 (Dynamic Paths), RULE_CVM_AGENT_VCS

import "@cex-test.book";
import fs from "fs";

int main() {
    println("===============================================================================");
    println("  2-TEK CXVM: Commit Changed & Push Code Test Suite                            ");
    println("===============================================================================");

    Assert::reset();

    // TC-ECO-01: SSR documentation files exist and are populated
    string ssrDir = ".agents/ssr/02-11-2026/commit-changed-and-push-code";
    Assert::isTrue(fs.exists(ssrDir + "/ssr.md"), "TC-ECO-01: ssr.md must exist");
    Assert::isTrue(fs.exists(ssrDir + "/testcases.md"), "TC-ECO-01: testcases.md must exist");
    Assert::isTrue(fs.exists(ssrDir + "/expectation.md"), "TC-ECO-01: expectation.md must exist");

    // TC-ECO-02: .gitmodules contains all required submodule definitions
    Assert::isTrue(fs.exists(".gitmodules"), "TC-ECO-02: .gitmodules must exist");
    if (fs.exists(".gitmodules")) {
        string gmContent = fs.readFile(".gitmodules");
        Assert::isTrue(gmContent.find("[submodule \"cex_boxes/cex-browser\"]") != -1, "TC-ECO-02: cex-browser defined in .gitmodules");
        Assert::isTrue(gmContent.find("[submodule \"cex_boxes/cex-thunder\"]") != -1, "TC-ECO-02: cex-thunder defined in .gitmodules");
        Assert::isTrue(gmContent.find("[submodule \"runtimes/cexr-bean\"]") != -1, "TC-ECO-02: cexr-bean defined in .gitmodules");
        Assert::isTrue(gmContent.find("[submodule \"runtimes/cexr-factory\"]") != -1, "TC-ECO-02: cexr-factory defined in .gitmodules");
    }

    // TC-ECO-03: Root cex-pack.json version is incremented to 2.0.15
    Assert::isTrue(fs.exists("cex-pack.json"), "TC-ECO-03: root cex-pack.json must exist");
    if (fs.exists("cex-pack.json")) {
        string packContent = fs.readFile("cex-pack.json");
        Assert::isTrue(packContent.find("\"version\": \"2.0.15\"") != -1, "TC-ECO-03: root version must be 2.0.15");
        Assert::isTrue(packContent.find("\"cex-browser\": \"2.0.0\"") != -1, "TC-ECO-03: cex-browser declared as dependency");
        Assert::isFalse(packContent.find("\"cex-view\"") != -1, "TC-ECO-03: cex-view eliminated from dependencies");
    }

    // TC-ECO-04: Submodule cex-browser has standalone binary
    Assert::isTrue(fs.exists("cex_boxes/cex-browser/.bin"), "TC-ECO-04: cex_boxes/cex-browser/.bin must exist");

    // TC-ECO-05: Javis standalone binaries exist in canonical paths
    Assert::isTrue(fs.exists("documents/bin/javis"), "TC-ECO-05: documents/bin/javis must exist");

    int failures = Assert::getFailures();
    if (failures > 0) {
        println("\n[FAIL] Test suite completed with failures.");
        return 1;
    }
    println("\n[PASS] All testcases passed successfully.");
    return 0;
}
