#include <iostream>
#include <fstream>
#include <string>
#include <sys/stat.h>

bool fileExists(const std::string& path) {
    struct stat st;
    return (stat(path.c_str(), &st) == 0 && !S_ISDIR(st.st_mode));
}

bool dirExists(const std::string& path) {
    struct stat st;
    return (stat(path.c_str(), &st) == 0 && S_ISDIR(st.st_mode));
}

bool fileContains(const std::string& path, const std::string& target) {
    std::ifstream file(path);
    if (!file.is_open()) return false;
    std::string content((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
    return content.find(target) != std::string::npos;
}

void assertCondition(bool cond, const std::string& passMsg, const std::string& failMsg, int& passCount, int& failCount) {
    if (cond) {
        std::cout << "  [PASS] " << passMsg << "\n";
        passCount++;
    } else {
        std::cout << "  [FAIL] " << failMsg << "\n";
        failCount++;
    }
}

int main() {
    let passCount: int = 0;
    let failCount: int = 0;

    std::cout << "=================================================================\n";
    std::cout << "Running Unit Test: Rename runtimes to cexr-factory\n";
    std::cout << "=================================================================\n";

    // 1. Directory presence and legacy absence
    let cexrFactoryExists: bool = dirExists("cexr-factory");
    let runtimesExists: bool = dirExists("runtimes");

    assertCondition(cexrFactoryExists && !runtimesExists,
        "Directory 'cexr-factory' exists and legacy 'runtimes' does not exist",
        "Directory state invalid: cexr-factory=" + std::to_string(cexrFactoryExists) + ", runtimes=" + std::to_string(runtimesExists),
        passCount, failCount);

    // 2. Core files inside cexr-factory
    let hasPack: bool = fileExists("cexr-factory/cex-pack.json");
    let hasIndex: bool = fileExists("cexr-factory/index.cex");
    let hasBuild: bool = fileExists("cexr-factory/build.cex");
    let hasTest: bool = fileExists("cexr-factory/test.cex");

    assertCondition(hasPack && hasIndex && hasBuild && hasTest,
        "All core files (cex-pack.json, index.cex, build.cex, test.cex) exist in cexr-factory",
        "One or more core files missing in cexr-factory",
        passCount, failCount);

    // 3. Manifest name declared as cexr-factory
    let hasCorrectName: bool = fileContains("cexr-factory/cex-pack.json", "\"name\": \"cexr-factory\"");
    assertCondition(hasCorrectName,
        "cexr-factory/cex-pack.json declares \"name\": \"cexr-factory\"",
        "cexr-factory/cex-pack.json does not declare \"name\": \"cexr-factory\"",
        passCount, failCount);

    std::cout << "=================================================================\n";
    std::cout << "Test Summary: " << passCount << " passed, " << failCount << " failed\n";
    std::cout << "=================================================================\n";

    return (failCount == 0) ? 0 : 1;
}
