// 2-TEK CXVM: Self-Repository Handle Not Defined in .agents Rule Verification Suite
// Powered by cext (@cext/src/runner.cex)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "@cext.book";
import fs from "fs";

class SelfRepositoryHelper {
    public static string resolve(string relPath) {
        if (fs.exists(relPath)) return relPath;
        if (fs.exists("../" + relPath)) return "../" + relPath;
        return relPath;
    }
}

int main() {
    let suite: TestSuite* = new TestSuite("Self Repository Handle Tests");

    // TC-SR-01: Canonical rule exists in .agents/rules/
    let rulePath: string = SelfRepositoryHelper::resolve(".agents/rules/RULE_SELF_REPOSITORY_HANDLE_NOT_DEFINED_IN_AGENTS.md");
    Assert::isTrue(fs.exists(rulePath), "Canonical rule file must exist in .agents/rules/");
    let content: string = fs.readFile(rulePath);
    Assert::isTrue(content.length() > 0, "Canonical rule must not be empty");
    suite->addResult("TC-SR-01", true, "", 1);

    // TC-SR-02: Mirrored rule exists in documents/rules/.agents/
    let mirrorPath: string = SelfRepositoryHelper::resolve("documents/rules/.agents/RULE_SELF_REPOSITORY_HANDLE_NOT_DEFINED_IN_AGENTS.md");
    Assert::isTrue(fs.exists(mirrorPath), "Mirrored rule file must exist in documents/rules/.agents/");
    let mirrorContent: string = fs.readFile(mirrorPath);
    Assert::isTrue(mirrorContent.length() > 0, "Mirrored rule must not be empty");
    suite->addResult("TC-SR-02", true, "", 1);

    // TC-SR-03: Lowercase mirror exists in both rule directories
    let lower1: string = SelfRepositoryHelper::resolve(".agents/rules/rule-self-repository-handle-not-defined-in-agents.md");
    let lower2: string = SelfRepositoryHelper::resolve("documents/rules/.agents/rule-self-repository-handle-not-defined-in-agents.md");
    Assert::isTrue(fs.exists(lower1), "Lowercase rule must exist in .agents/rules/");
    Assert::isTrue(fs.exists(lower2), "Lowercase rule must exist in documents/rules/.agents/");
    suite->addResult("TC-SR-03", true, "", 1);

    // TC-SR-04: RULE_STANDARDS.md integrates Section 12 for self-repository handling
    let stdPath: string = SelfRepositoryHelper::resolve(".agents/rules/RULE_STANDARDS.md");
    let stdContent: string = fs.readFile(stdPath);
    Assert::isTrue(stdContent.find("RULE_SELF_REPOSITORY_HANDLE_NOT_DEFINED_IN_AGENTS") != -1, "RULE_STANDARDS.md must reference the new rule");
    suite->addResult("TC-SR-04", true, "", 1);

    // TC-SR-05: Rule mandates autonomous self-repository handling
    Assert::isTrue(content.find("AUTONOMOUS SELF-REPOSITORY HANDLING") != -1, "Rule must mandate autonomous self-repository handling");
    suite->addResult("TC-SR-05", true, "", 1);

    // TC-SR-06: Rule mandates zero fatal crashes on unmapped submodules
    Assert::isTrue(content.find("ZERO FATAL") != -1, "Rule must mandate zero fatal crashes on unmapped submodules");
    suite->addResult("TC-SR-06", true, "", 1);

    // TC-SR-07: SSR documentation exists and is populated
    let ssrDir: string = SelfRepositoryHelper::resolve(".agents/ssr/31-10-2026/self-repository-handle-not-defined-in-agents");
    Assert::isTrue(fs.exists(ssrDir + "/ssr.md"), "ssr.md must exist");
    Assert::isTrue(fs.exists(ssrDir + "/testcases.md"), "testcases.md must exist");
    Assert::isTrue(fs.exists(ssrDir + "/expectation.md"), "expectation.md must exist");
    suite->addResult("TC-SR-07", true, "", 1);

    println("\n");
    TestReporter::printSummary(suite);
    return suite->failCount() > 0 ? 1 : 0;
}
