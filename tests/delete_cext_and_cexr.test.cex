// 2-TEK CXVM: Delete cext and cexr with Repository Test Suite (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule 44 (Explicit Typing)

import "@cex-test.book";
import fs from "fs";
import child_process from "child_process";

int main() {
    println("===============================================================================");
    println("     2-TEK CXVM: Delete cext & cexr with Repository Verification Suite         ");
    println("===============================================================================");

    TestSuite* suite = new TestSuite("Delete cext & cexr Verification Suite");

    // Test 1: Verify cex_boxes/cext directory does not exist
    println("  [Test 1] Verifying filesystem: cex_boxes/cext must NOT exist...");
    bool existsCext = fs.exists("cex_boxes/cext");
    Assert::isFalse(existsCext, "cex_boxes/cext directory must be deleted");
    suite->addResult("test_cext_dir_deleted", !existsCext, "", 1);

    // Test 2: Verify cex_boxes/cexr directory does not exist
    println("  [Test 2] Verifying filesystem: cex_boxes/cexr must NOT exist...");
    bool existsCexr = fs.exists("cex_boxes/cexr");
    Assert::isFalse(existsCexr, "cex_boxes/cexr directory must be deleted");
    suite->addResult("test_cexr_dir_deleted", !existsCexr, "", 1);

    // Test 3: Verify .gitmodules does not reference deps/cext
    println("  [Test 3] Verifying .gitmodules: must NOT contain deps/cext...");
    string gitmodules = fs.readFile(".gitmodules");
    bool hasCextSubmodule = (gitmodules.find("deps/cext") != std::string::npos);
    Assert::isFalse(hasCextSubmodule, ".gitmodules must not contain deps/cext");
    suite->addResult("test_gitmodules_cext_removed", !hasCextSubmodule, "", 1);

    // Test 4: Verify .gitmodules retains cex-test
    println("  [Test 4] Verifying .gitmodules: must retain cex-test...");
    bool hasCexTestSubmodule = (gitmodules.find("cex-test") != std::string::npos);
    Assert::isTrue(hasCexTestSubmodule, ".gitmodules must retain cex-test");
    suite->addResult("test_gitmodules_cex_test_retained", hasCexTestSubmodule, "", 1);

    // Test 5: Verify specialized submodules are retained on filesystem
    println("  [Test 5] Verifying specialized submodules are strictly retained...");
    bool hasFactory = fs.exists("cex_boxes/cexr-factory");
    bool hasDrawer = fs.exists("cex_boxes/cexr-drawer");
    bool hasDelivery = fs.exists("cex_boxes/cexr-delivery");
    bool hasBean = fs.exists("cex_boxes/cexr-bean") || fs.exists("cex_boxes/cxvm-bean");
    bool hasCexTest = fs.exists("cex_boxes/cex-test");
    Assert::isTrue(hasFactory, "cex_boxes/cexr-factory must be retained");
    Assert::isTrue(hasDrawer, "cex_boxes/cexr-drawer must be retained");
    Assert::isTrue(hasDelivery, "cex_boxes/cexr-delivery must be retained");
    Assert::isTrue(hasBean, "cex_boxes/cxvm-bean or cexr-bean must be retained");
    Assert::isTrue(hasCexTest, "cex_boxes/cex-test must be retained");
    bool allRetained = hasFactory && hasDrawer && hasDelivery && hasBean && hasCexTest;
    suite->addResult("test_submodules_retained", allRetained, "", 1);

    // Test 6: Verify remote GitHub repository 2-tek/cexr is deleted
    println("  [Test 6] Verifying GitHub remote repository: 2-tek/cexr must NOT exist...");
    string ghCheck = child_process.execSync("gh repo view 2-tek/cexr >/dev/null 2>&1 && echo 'EXISTS' || echo 'DELETED'");
    bool isRepoDeleted = (ghCheck.find("DELETED") != std::string::npos);
    Assert::isTrue(isRepoDeleted, "remote repo 2-tek/cexr must be deleted");
    suite->addResult("test_remote_cexr_repo_deleted", isRepoDeleted, "", 1);

    TestReporter::printSummary(suite);
    bool allPass = (Assert::getFailures() == 0) && (suite->failCount() == 0);
    return allPass ? 0 : 1;
}
