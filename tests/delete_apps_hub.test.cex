// 2-TEK CXVM: Delete Project and Repository apps-hub Test Suite (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule 44 (Explicit Typing)

import "@cext.book";
import fs from "fs";
import child_process from "child_process";

int main() {
    println("===============================================================================");
    println("     2-TEK CXVM: Delete apps-hub Project & Repository Verification Suite       ");
    println("===============================================================================");

    let suite: TestSuite* = new TestSuite("Delete apps-hub Verification Suite");

    // Test 1: Verify projects/apps-hub directory does not exist
    println("  [Test 1] Verifying filesystem: projects/apps-hub must NOT exist...");
    let existsDir: bool = fs.exists("projects/apps-hub");
    Assert::isFalse(existsDir, "projects/apps-hub directory must be deleted");
    suite->addResult("test_directory_deleted", !existsDir, "", 1);

    // Test 2: Verify .gitmodules does not reference projects/apps-hub
    println("  [Test 2] Verifying .gitmodules: must NOT contain projects/apps-hub...");
    let gitmodulesPath: string = fs.exists(".gitmodules") ? ".gitmodules" : (fs.exists("../.gitmodules") ? "../.gitmodules" : "");
    let gitmodules: string = gitmodulesPath.length() > 0 ? fs.readFile(gitmodulesPath) : "";
    let hasSubmodule: bool = (gitmodules.find("projects/apps-hub") != std::string::npos);
    Assert::isFalse(hasSubmodule, ".gitmodules must not contain projects/apps-hub");
    suite->addResult("test_gitmodules_cleaned", !hasSubmodule, "", 1);

    // Test 3: Verify git index does not contain projects/apps-hub gitlink entry
    println("  [Test 3] Verifying git stage index: must NOT track projects/apps-hub...");
    let gitLs: string = child_process.execSync("git ls-files --stage projects/apps-hub 2>/dev/null | tr -d '\\n'");
    Assert::equalsString("", gitLs, "git index must not contain projects/apps-hub");
    suite->addResult("test_git_index_cleaned", gitLs == "", "", 1);

    // Test 4: Verify root README.md has removed projects/apps-hub
    println("  [Test 4] Verifying README.md: must NOT reference projects/apps-hub...");
    let readmePath: string = (fs.exists("../README.md") && fs.exists("src")) ? "../README.md" : "README.md";
    let readme: string = fs.exists(readmePath) ? fs.readFile(readmePath) : "";
    let hasReadmeRef: bool = (readme.find("projects/apps-hub") != std::string::npos);
    Assert::isFalse(hasReadmeRef, "README.md must not reference projects/apps-hub");
    suite->addResult("test_readme_cleaned", !hasReadmeRef, "", 1);

    // Test 5: Verify remote GitHub repository 2-tek/mvc-lighting-hub is deleted
    println("  [Test 5] Verifying GitHub remote repository: 2-tek/mvc-lighting-hub must NOT exist...");
    let ghCheck: string = child_process.execSync("gh repo view 2-tek/mvc-lighting-hub >/dev/null 2>&1 && echo 'EXISTS' || echo 'DELETED' | tr -d '\\n'");
    let isRepoDeleted: bool = (ghCheck.find("DELETED") != std::string::npos);
    Assert::isTrue(isRepoDeleted, "remote repo 2-tek/mvc-lighting-hub must be deleted");
    suite->addResult("test_remote_repo_deleted", isRepoDeleted, "", 1);

    TestReporter::printSummary(suite);
    let allPass: bool = (Assert::getFailures() == 0) && (suite->failCount() == 0);
    return allPass ? 0 : 1;
}
