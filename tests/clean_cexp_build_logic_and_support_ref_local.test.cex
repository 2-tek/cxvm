// 2-TEK CXVM: Clean CexP Build Logic & Support Ref Local Test Suite
// Asserts that project builds use cexr-factory and ref: local downloads .bin only
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule (No Symbols), RULE_CEX_SCRIPT_ONLY

import "@cex-test.book";
import fs from "fs";

int main() {
    println("===============================================================================");
    println("   2-TEK CXVM: Clean CexP Build Logic & Ref Local Test Suite                  ");
    println("===============================================================================");

    Assert::reset();

    // 1. TC-BUILD-01: cxvm_engine.cex executeProjectBuild uses cexr-factory build
    string enginePath = fs.exists("src/cxvm_engine.cex") ? "src/cxvm_engine.cex" : (fs.exists("cxvm/src/cxvm_engine.cex") ? "cxvm/src/cxvm_engine.cex" : "../cxvm/src/cxvm_engine.cex");
    Assert::isTrue(fs.exists(enginePath), "cxvm_engine.cex must exist");
    if (fs.exists(enginePath)) {
        string engineContent = fs.readFile(enginePath);
        int epbPos = (int)engineContent.find("executeProjectBuild");
        Assert::isTrue(epbPos != -1, "executeProjectBuild function must exist in cxvm_engine.cex");
        Assert::isTrue(engineContent.find("cexr-factory build", epbPos) != -1, "executeProjectBuild must compile using cexr-factory build");
    }

    // 2. TC-BUILD-02: cxvm/build.cex uses cexr-factory
    string buildCexPath = fs.exists("build.cex") ? "build.cex" : (fs.exists("cxvm/build.cex") ? "cxvm/build.cex" : "../cxvm/build.cex");
    Assert::isTrue(fs.exists(buildCexPath), "cxvm/build.cex must exist");
    if (fs.exists(buildCexPath)) {
        string buildCexContent = fs.readFile(buildCexPath);
        Assert::isTrue(buildCexContent.find("cexr-factory") != -1, "cxvm/build.cex must resolve and invoke cexr-factory");
    }

    // 3. TC-BUILD-03: .git/hooks/pre-push uses cexr-factory build
    string hookPath = fs.exists(".git/hooks/pre-push") ? ".git/hooks/pre-push" : "../.git/hooks/pre-push";
    if (fs.exists(hookPath)) {
        string hookContent = fs.readFile(hookPath);
        Assert::isTrue(hookContent.find("cexr-factory build") != -1, ".git/hooks/pre-push must invoke cexr-factory build");
        Assert::isTrue(hookContent.find("cexp-v8-stable build") == -1, ".git/hooks/pre-push must NOT invoke cexp-v8-stable build");
    }

    // 4. TC-BUILD-04: Manifest scripts in cxvm and projects/cvm use cexr-factory build
    string cxvmPackPath = fs.exists("cex-pack.json") && fs.exists("src/cxvm_engine.cex") ? "cex-pack.json" : (fs.exists("cxvm/cex-pack.json") ? "cxvm/cex-pack.json" : "../cxvm/cex-pack.json");
    if (fs.exists(cxvmPackPath)) {
        string cxvmPackContent = fs.readFile(cxvmPackPath);
        Assert::isTrue(cxvmPackContent.find("\"build\": \"cexr-factory build src/index.cex -o .bin\"") != -1, "cxvm/cex-pack.json build script must use cexr-factory build");
    }

    string cvmPackPath = fs.exists("projects/cvm/cex-pack.json") ? "projects/cvm/cex-pack.json" : "../projects/cvm/cex-pack.json";
    if (fs.exists(cvmPackPath)) {
        string cvmPackContent = fs.readFile(cvmPackPath);
        Assert::isTrue(cvmPackContent.find("\"build\": \"cexr-factory build src/cli.cex -o .bin\"") != -1, "projects/cvm/cex-pack.json build script must use cexr-factory build");
    }

    // 5. TC-LOCAL-01: downloader.cex contains extractLockedRef and ref local support
    string dlPath = fs.exists("cex_boxes/cex-pack/src/downloader.cex") ? "cex_boxes/cex-pack/src/downloader.cex" : "../cex_boxes/cex-pack/src/downloader.cex";
    Assert::isTrue(fs.exists(dlPath), "downloader.cex must exist");
    if (fs.exists(dlPath)) {
        string dlContent = fs.readFile(dlPath);
        Assert::isTrue(dlContent.find("extractLockedRef") != -1, "downloader.cex must define extractLockedRef function");
        Assert::isTrue(dlContent.find("\"local\"") != -1, "downloader.cex must support 'local' ref");
        Assert::isTrue(dlContent.find(".bin") != -1, "downloader.cex must handle .bin copy for local ref");
    }

    // 6. TC-CLEAN-01: Zero nested cex_boxes in side projects
    Array<string>* pList = new Array<string>();
    pList->push("projects/code-storm/cex_boxes");
    pList->push("projects/cvm/cex_boxes");
    pList->push("projects/IAM/cex_boxes");
    pList->push("projects/mvc-lighting/cex_boxes");
    pList->push("cxvm/cex_boxes");
    pList->push("cexr-factory/cex_boxes");

    for (int i = 0; i < (int)pList->length(); i++) {
        string p = pList->get(i);
        string chkPath = fs.exists(p) ? p : ("../" + p);
        Assert::isFalse(fs.exists(chkPath), "Nested cex_boxes must be purged: " + p);
    }

    // 7. TC-BUILD-05: Side project build runners resolve cexr-factory
    Array<string>* buildRunners = new Array<string>();
    buildRunners->push("projects/mvc-lighting/build.cex");
    buildRunners->push("projects/IAM/build.cex");
    buildRunners->push("projects/cvm/build.cex");
    buildRunners->push("projects/code-storm/build.cex");
    buildRunners->push("cexr-factory/build.cex");

    for (int bi = 0; bi < (int)buildRunners->length(); bi++) {
        string bPath = buildRunners->get(bi);
        string realBPath = fs.exists(bPath) ? bPath : ("../" + bPath);
        if (fs.exists(realBPath)) {
            string bContent = fs.readFile(realBPath);
            Assert::isTrue(bContent.find("cexr-factory") != -1, bPath + " must resolve and invoke cexr-factory");
        }
    }

    // 8. TC-BUILD-06: cxvm/setup.cex uses cexr-factory build
    string setupCexPath = fs.exists("cxvm/setup.cex") ? "cxvm/setup.cex" : (fs.exists("setup.cex") ? "setup.cex" : "../cxvm/setup.cex");
    if (fs.exists(setupCexPath)) {
        string setupContent = fs.readFile(setupCexPath);
        Assert::isTrue(setupContent.find("\"cexr-factory\"") != -1, "cxvm/setup.cex must resolve compiler to cexr-factory");
        Assert::isTrue(setupContent.find("recompiled native machine binary via cexr-factory") != -1 || setupContent.find("Recompiled native machine binary via cexr-factory") != -1, "cxvm/setup.cex must log rebuild via cexr-factory");
    }

    // 9. TC-BUILD-07: Dockerfile and schema Dockerfile synthesis use cexr-factory build
    string iamDockerPath = fs.exists("projects/IAM/Dockerfile") ? "projects/IAM/Dockerfile" : "../projects/IAM/Dockerfile";
    if (fs.exists(iamDockerPath)) {
        string dContent = fs.readFile(iamDockerPath);
        Assert::isTrue(dContent.find("cexr-factory build") != -1, "projects/IAM/Dockerfile must use cexr-factory build");
    }

    int fails = Assert::getFailures();
    int checks = Assert::getTotalChecks();
    println("Checks verified: " + std::to_string(checks) + ", Failures: " + std::to_string(fails));

    if (fails > 0) {
        println("[FAIL] clean_cexp_build_logic_and_support_ref_local.test.cex: " + std::to_string(fails) + " assertion(s) failed!");
        return 1;
    }
    println("[OK] All clean cexp build logic and ref local checks passed!");
    return 0;
}
