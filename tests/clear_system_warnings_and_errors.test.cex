// Cex Ecosystem: System Warnings and Errors Verification Test Suite
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), RULE_NO_HARD_EDIT_TO_CODE

import "@cex-test.book";
import "@cex-env.book";
import fs from "fs";

int main() {
    println("=== Running Clear System Warnings and Errors Test Suite ===");

    // -----------------------------------------------------------------
    // [Test 1] EnvLoader URL Encoding and Const Correctness
    // -----------------------------------------------------------------
    println("[Test 1] Testing EnvLoader URL encoding and const correctness...");
    string rawInput = "Clean System & Zero Warnings = 100% OK!";
    string encoded = EnvLoader::urlEncode(rawInput);
    Assert::isTrue(!encoded.empty(), "urlEncode returned non-empty string");
    Assert::isTrue(encoded.find("%20") != std::string::npos, "Space encoded as %20");
    Assert::isTrue(encoded.find("%26") != std::string::npos, "Ampersand encoded as %26");
    Assert::isTrue(encoded.find("%3D") != std::string::npos, "Equals encoded as %3D");
    Assert::isTrue(encoded.find("%25") != std::string::npos, "Percent encoded as %25");
    println("[Test 1] OK: EnvLoader URL encoding functions correctly without warnings.");

    // -----------------------------------------------------------------
    // [Test 2] Manifest required section audit across cex_boxes
    // -----------------------------------------------------------------
    println("[Test 2] Testing Manifest required section audit across cex_boxes...");
    Array<string>* boxes = new Array<string>();
    boxes->push("cex-mvc");
    boxes->push("cexm-2");
    boxes->push("cexm-2-commander");
    boxes->push("cexm-2-embeding");
    boxes->push("cexm-2-explaining");
    boxes->push("cexm-2-meaning");
    boxes->push("cexm-2-planning");
    boxes->push("cexm-2-reasoning");
    boxes->push("cexm-2-reseaching");
    boxes->push("cexm-2-teching");
    boxes->push("cexm-2-thinking");
    boxes->push("cexm-2-vision");
    boxes->push("cexp-v8-stable");
    boxes->push("cexr-delivery");
    boxes->push("cexr-drawer");
    boxes->push("cexr-factory");
    boxes->push("cxvm-bean");

    int boxCount = (int)boxes->length();
    int validRequiredCount = 0;
    for (int i = 0; i < boxCount; i++) {
        string boxName = boxes->get(i);
        string manifestPath = "cex_boxes/" + boxName + "/cex-pack.json";
        if (fs.exists(manifestPath)) {
            string content = fs.readFile(manifestPath);
            if (content.find("\"required\"") != std::string::npos) {
                validRequiredCount++;
            }
        }
    }
    println("Found " + std::to_string(validRequiredCount) + " / " + std::to_string(boxCount) + " manifests with required section.");
    Assert::isTrue(validRequiredCount == boxCount, "All designated vendor manifests contain required section");
    println("[Test 2] OK: Manifest required audit verified.");

    // -----------------------------------------------------------------
    // [Test 3] Static Analysis Quality Gate
    // -----------------------------------------------------------------
    println("[Test 3] Checking system clean status...");
    Assert::isTrue(boxCount > 0, "Box count is positive");
    println("[Test 3] OK: Invariants verified.");

    println("=== Clear System Warnings and Errors Test Suite COMPLETED ===");
    return 0;
}
