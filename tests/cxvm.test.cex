    // -------------------------------------------------------------
    // Test 13: Git & CVM Hooks Subsystem (Pre-Commit CexLint & Pre-Push Prettier)
    // -------------------------------------------------------------
    println("\n[Test Suite 13: Git & CVM Hooks Subsystem (Pre-Commit CexLint & Pre-Push Prettier)]");

    // 1. autoLintFix verification
    let autoLintFixRes: bool = cxvm->autoLintFix(".");
    Assert::isTrue(autoLintFixRes, "cxvm autoLintFix succeeds on valid project");

    // 2. scanAndInstallHooks verification
    let hooksRes: CxvmCommandResult* = cxvm->scanAndInstallHooks(".");
