    let appCliCexr: int = cxvm->cliAppExecute("build:cexr", "v8,v6", "");
    Assert::equalsInt(0, appCliCexr, "cxvm --app cli build:cexr v8,v6 returns exit code 0");

    // 5. REST API endpoints for multi-version cexp, cexr, and toolchain builds
    let resApiCexp: HttpResponse* = app->simulateRequest("POST", "/api/v1/build/cexp", "{\"versions\":\"v8,v6\"}", "application/json");
