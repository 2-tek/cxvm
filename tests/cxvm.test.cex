    // -------------------------------------------------------------
    // Test 11: Auto-Upgrade Cex Toolchain (cxvm upgrade)
    // -------------------------------------------------------------
    println("\n[Test Suite 11: Auto-Upgrade Cex Toolchain (cxvm upgrade)]");
    let upRes1: CxvmCommandResult* = cxvm->upgrade("latest");
    Assert::isTrue(upRes1->success, "cxvm upgrade latest succeeds");
    Assert::equalsString("8.0.0", upRes1->version, "cxvm upgrade latest targets v8.0.0");
    Assert::isTrue(upRes1->output.find("cexr runtime engine upgraded") != -1, "Output confirms cexr runtime upgraded");
    Assert::isTrue(upRes1->output.find("cexp direct machine compiler upgraded") != -1, "Output confirms cexp compiler upgraded");
    Assert::isTrue(upRes1->output.find("cexr binary path:") != -1, "Output displays cexr binary path on upgrade");
    Assert::isTrue(upRes1->output.find("cexp binary path:") != -1, "Output displays cexp binary path on upgrade");

    let upExec1: int = cxvm->cvmExecute("upgrade", "", "");
    Assert::equalsInt(0, upExec1, "cxvm cvmExecute upgrade returns exit code 0");

    let upExec2: int = cxvm->cvmExecute("upgrade", "8.0.0", "");
    Assert::equalsInt(0, upExec2, "cxvm cvmExecute upgrade 8.0.0 returns exit code 0");

    let upResp: HttpResponse* = app->simulateRequest("GET", "/api/v1/upgrade", "", "application/json");
    Assert::equalsInt(200, upResp->statusCode, "GET /api/v1/upgrade returns 200 OK");
    Assert::isTrue(upResp->body.find("\"success\":true") != -1, "Upgrade API reports success:true");
    Assert::isTrue(upResp->body.find("cexr binary path:") != -1, "API body includes cexr binary path");
    Assert::isTrue(upResp->body.find("cexp binary path:") != -1, "API body includes cexp binary path");

    // Test upgrade --dependencies (pull, integrate to cxvm)
    let upDepRes: CxvmCommandResult* = cxvm->upgradeDependencies("cex-log,cex-test", false);
    Assert::isTrue(upDepRes->success, "cxvm upgradeDependencies succeeds");
    Assert::isTrue(upDepRes->output.find("Upgrading dependencies") != -1, "Output confirms upgrading dependencies");
    Assert::isTrue(upDepRes->output.find("Integrated cex-log into cxvm") != -1, "Output confirms cex-log integrated");
    Assert::isTrue(upDepRes->output.find("Integrated cex-test into cxvm") != -1, "Output confirms cex-test integrated");

    let upDepExec1: int = cxvm->cvmExecute("upgrade", "--dependencies", "cex-log");
    Assert::equalsInt(0, upDepExec1, "cxvm cvmExecute upgrade --dependencies cex-log returns exit code 0");

    let upDepExec2: int = cxvm->cvmExecute("upgrade", "--dependencies=cex-log", "");
    Assert::equalsInt(0, upDepExec2, "cxvm cvmExecute upgrade --dependencies=cex-log returns exit code 0");

    let upDepResp: HttpResponse* = app->simulateRequest("GET", "/api/v1/upgrade?dependencies=cex-log", "", "application/json");
    Assert::equalsInt(200, upDepResp->statusCode, "GET /api/v1/upgrade?dependencies=cex-log returns 200 OK");
    Assert::isTrue(upDepResp->body.find("\"success\":true") != -1, "Upgrade dependencies API reports success:true");

    // Test process preservation guard (Thunder, CVM, pending processes not killed on upgrade)
    let thunStartRes: CxvmCommandResult* = cxvm->startThunder(3050, true);
    Assert::isTrue(cxvm->thunderRunning, "Thunder server is running prior to upgrade");
    let upResGuard: CxvmCommandResult* = cxvm->upgrade("latest");
    Assert::isTrue(upResGuard->success, "cxvm upgrade latest succeeds with active Thunder");
    Assert::isTrue(cxvm->thunderRunning, "Thunder server remains running (NOT killed) after upgrade");
    Assert::isTrue(upResGuard->output.find("Preserved active Thunder container engine") != -1, "Output confirms Thunder preserved on upgrade");
    Assert::isTrue(upResGuard->output.find("Preserved all pending and running processes") != -1, "Output confirms no process killed on upgrade");

    let upDepGuard: CxvmCommandResult* = cxvm->upgradeDependencies("cex-log", false);
    Assert::isTrue(upDepGuard->success, "cxvm upgradeDependencies succeeds with active Thunder");
    Assert::isTrue(cxvm->thunderRunning, "Thunder server remains running (NOT killed) after upgradeDependencies");
    Assert::isTrue(upDepGuard->output.find("Preserved active Thunder container engine") != -1, "Output confirms Thunder preserved on upgradeDependencies");
    Assert::isTrue(upDepGuard->output.find("Preserved all pending and running processes") != -1, "Output confirms no process killed on upgradeDependencies");

    // Test cex-log integration (Stopwatch, Log, CexLog, CexLogger)
    let testSw: Stopwatch* = Log::start("test_suite_stopwatch");
    Assert::isTrue(testSw->isRunning, "Stopwatch is running");
    let testElapsed: double = testSw->stop();
    Assert::isTrue(testElapsed >= 0.0, "Stopwatch measures elapsed time >= 0");
    Log::info("Verified Log::info from cex-log");
    Log::debug("Verified Log::debug from cex-log");
    Log::warn("Verified Log::warn from cex-log");
    Log::delay("test_measurement_delay", 2.5);
    CexLog::info("Verified CexLog::info from cex-log bridge");
    CexLogger::info("Verified CexLogger::info from cex-logger bridge");
    Assert::isTrue(Log::isColorEnabled(), "Log color is enabled by default");
    Assert::isTrue(Log::getStatusColor("INFO") == "\033[32m", "Status color for INFO is green");
    Assert::isTrue(Log::getCurrentTime().length() == 8, "Current time format is HH:MM:SS");

    // Test cxvm log command for services
    let logExec1: int = cxvm->cvmExecute("log", "thunder", "");
    Assert::equalsInt(0, logExec1, "cxvm cvmExecute log thunder returns exit code 0");
    let logExec2: int = cxvm->cvmExecute("log", "server", "");
    Assert::equalsInt(0, logExec2, "cxvm cvmExecute log server returns exit code 0");

    suite->addResult("test_auto_upgrade_toolchain", true, "", 1);

    // -------------------------------------------------------------
    // Test 12: Pull Dependencies Subsystem (cxvm pull dependencies)
    // -------------------------------------------------------------
    println("\n[Test Suite 12: Pull Dependencies Subsystem (cxvm pull dependencies)]");
    let depsDir: string = cxvm->getDependenciesDir();
    Assert::isTrue(depsDir.length() > 0 && depsDir.find("dependencies") != -1, "Dependencies directory resolves to valid dependencies path");

    // Test pullDependencies normal
    let pullRes1: CxvmCommandResult* = cxvm->pullDependencies("cex-pack.json", false, false, "");
    Assert::isTrue(pullRes1->success, "cxvm pullDependencies succeeds");
    Assert::isTrue(pullRes1->output.find("dependencies successfully pulled") != -1, "Output confirms dependencies pulled");

    // Test pullDependencies with --upgrade (should cache old version to .old.zip)
    let pullRes2: CxvmCommandResult* = cxvm->pullDependencies("cex-pack.json", true, false, "");
    Assert::isTrue(pullRes2->success, "cxvm pullDependencies --upgrade succeeds");
    Assert::isTrue(pullRes2->output.find("Cached old version") != -1, "Output confirms old version cached");
    Assert::isTrue(pullRes2->output.find(".old.zip") != -1, "Output confirms .old.zip created");

    // Test pullDependencies with --clean (should clean .old.zip files)
    let pullRes3: CxvmCommandResult* = cxvm->pullDependencies("cex-pack.json", false, true, "");
    Assert::isTrue(pullRes3->success, "cxvm pullDependencies --clean succeeds");
    Assert::isTrue(pullRes3->output.find("Cleaned old cache backup files") != -1, "Output confirms .old.zip files cleaned");

    // Test CLI execution via cvmExecute
    let pullExec1: int = cxvm->cvmExecute("pull", "dependencies", "");
    Assert::equalsInt(0, pullExec1, "cxvm cvmExecute pull dependencies returns exit code 0");

    let pullExec2: int = cxvm->cvmExecute("pull-dependencies", "--clean", "");
    Assert::equalsInt(0, pullExec2, "cxvm cvmExecute pull-dependencies --clean returns exit code 0");

    let pullExec3: int = cxvm->cvmExecute("dependencies", "pull", "--upgrade");
    Assert::equalsInt(0, pullExec3, "cxvm cvmExecute dependencies pull --upgrade returns exit code 0");

