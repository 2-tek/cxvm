    let thunBuildRes: CxvmCommandResult* = cxvm->buildThunderFromManifest(".");
    Assert::isTrue(thunBuildRes->success, "cxvm builds thunder image from cex-pack.json");
    Assert::equalsString("@2tek/cxvm:latest", thunBuildRes->version, "Thunder image tag matches package");

