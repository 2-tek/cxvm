    Assert::isTrue(cvmPullDepRes->success, "cxvm cvmPull dependencies succeeds");

    // Test REST API endpoints
    let pullApiGet: HttpResponse* = app->simulateRequest("GET", "/api/v1/dependencies/pull", "", "application/json");
    Assert::equalsInt(200, pullApiGet->statusCode, "GET /api/v1/dependencies/pull returns 200 OK");
    Assert::isTrue(pullApiGet->body.find("\"status\":\"SUCCESS\"") != -1, "GET API reports status SUCCESS");

    let pullApiPost: HttpResponse* = app->simulateRequest("POST", "/api/v1/dependencies/pull", "{\"upgrade\":true,\"clean\":true}", "application/json");
    Assert::equalsInt(200, pullApiPost->statusCode, "POST /api/v1/dependencies/pull returns 200 OK");
    Assert::isTrue(pullApiPost->body.find("\"clean\":true") != -1, "POST API reports clean:true");

