    // -------------------------------------------------------------
    println("\n[Test Suite 10: Auto-Detect Main Entrypoint & Thunder Auto-Build from cex-pack.json]");
    let detectedMain: string = cxvm->detectMainFile(".");
    Assert::equalsString("src/index.cex", detectedMain, "cxvm auto-detects main entrypoint from cex-pack.json");

    let hasThun: bool = cxvm->hasThunderConfig(".");
