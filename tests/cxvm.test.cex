    // -------------------------------------------------------------
    println("\n[Test Suite 19: Use and Action Logging via @cex-log (Zero print/println)]");

    let engineSrc: string = fs.readFile("src/cxvm/cxvm_engine.cex");
    Assert::isTrue(engineSrc.find("Log::info(") != -1, "src/cxvm/cxvm_engine.cex uses Log::info from @cex-log");
    Assert::isTrue(engineSrc.find("Log::warn(") != -1, "src/cxvm/cxvm_engine.cex uses Log::warn from @cex-log");
    Assert::isTrue(engineSrc.find("Log::error(") != -1, "src/cxvm/cxvm_engine.cex uses Log::error from @cex-log");
    Assert::isTrue(engineSrc.find("println(") == -1 && engineSrc.find("print(") == -1, "src/cxvm/cxvm_engine.cex contains zero print/println calls");

    let indexSrc: string = fs.readFile("src/index.cex");
    Assert::isTrue(indexSrc.find("Log::info(") != -1, "src/index.cex uses Log::info from @cex-log");
    Assert::isTrue(indexSrc.find("println(") == -1 && indexSrc.find("print(") == -1, "src/index.cex contains zero print/println calls");

    let appSrc: string = fs.readFile("src/app.cex");
    Assert::isTrue(appSrc.find("Log::info(") != -1, "src/app.cex uses Log::info from @cex-log");
    Assert::isTrue(appSrc.find("println(") == -1 && appSrc.find("print(") == -1, "src/app.cex contains zero print/println calls");

    let mvcSrc: string = fs.readFile("src/lighting_mvc.cex");
    Assert::isTrue(mvcSrc.find("Log::info(") != -1, "src/lighting_mvc.cex uses Log::info from @cex-log");
    Assert::isTrue(mvcSrc.find("println(") == -1 && mvcSrc.find("print(") == -1, "src/lighting_mvc.cex contains zero print/println calls");

    let srvSrc: string = fs.readFile("src/server.cex");
    Assert::isTrue(srvSrc.find("Log::info(") != -1, "src/server.cex uses Log::info from @cex-log");
    Assert::isTrue(srvSrc.find("println(") == -1 && srvSrc.find("print(") == -1, "src/server.cex contains zero print/println calls");

    let cvmTypesSrc: string = fs.readFile("src/cvm/types.cex");
    Assert::isTrue(cvmTypesSrc.find("Log::info(") != -1, "src/cvm/types.cex uses Log::info from @cex-log");
    Assert::isTrue(cvmTypesSrc.find("println(") == -1 && cvmTypesSrc.find("print(") == -1, "src/cvm/types.cex contains zero print/println calls");

    let cvmPatchSrc: string = fs.readFile("src/cvm/cvm_patch.cex");
    Assert::isTrue(cvmPatchSrc.find("Log::info(") != -1, "src/cvm/cvm_patch.cex uses Log::info from @cex-log");
    Assert::isTrue(cvmPatchSrc.find("println(") == -1 && cvmPatchSrc.find("print(") == -1, "src/cvm/cvm_patch.cex contains zero print/println calls");

    suite->addResult("test_cex_log_in_use_and_actions", true, "", 1);

    // -------------------------------------------------------------
    // Test 20: Dynamic .env Resolution & Real cexp/cexr Version from cex-pack.json on Upgrade
    // -------------------------------------------------------------
    println("\n[Test Suite 20: Dynamic .env Resolution & Real cexp/cexr Version from cex-pack.json on Upgrade]");

    Assert::isTrue(fs.exists(".env"), ".env configuration file exists at project root");
    Assert::isTrue(engineSrc.find("CexEnv::loadString(") != -1, "src/cxvm/cxvm_engine.cex loads paths/versions dynamically via CexEnv::loadString");
    Assert::isTrue(engineSrc.find("CexEnv::loadInt(") != -1, "src/cxvm/cxvm_engine.cex loads ports dynamically via CexEnv::loadInt");

    let realCexpV6: string = cxvm->resolveRealCexpVersion("v6");
    let realCexpV3: string = cxvm->resolveRealCexpVersion("v3");
    let realCexrV8: string = cxvm->resolveRealCexrVersion("v8");
    Assert::isTrue(realCexpV6.length() > 0, "resolveRealCexpVersion('v6') resolves non-empty version from cex-pack.json");
    if (fs.exists("../cexp/v6/cex-pack.json")) {
        Assert::equalsString("6.0.2", realCexpV6, "resolveRealCexpVersion('v6') reads real version 6.0.2 from ../cexp/v6/cex-pack.json");
    }
    if (fs.exists("../cexp/v3/cex-pack.json")) {
        Assert::equalsString("3.0.1", realCexpV3, "resolveRealCexpVersion('v3') reads real version 3.0.1 from ../cexp/v3/cex-pack.json");
    }
    if (fs.exists("../cexr/v8/cex-pack.json")) {
        Assert::equalsString("8.0.0", realCexrV8, "resolveRealCexrVersion('v8') reads real version 8.0.0 from ../cexr/v8/cex-pack.json");
    }

    let upRealRes: CxvmCommandResult* = cxvm->upgrade("latest");
    Assert::isTrue(upRealRes->success, "cxvm upgrade latest succeeds using real versions from cex-pack.json");
    Assert::isTrue(upRealRes->output.find("Resolved real cexr version from cex-pack.json:") != -1, "Upgrade output logs resolved real cexr version from cex-pack.json");
    Assert::isTrue(upRealRes->output.find("Resolved real cexp version from cex-pack.json:") != -1, "Upgrade output logs resolved real cexp version from cex-pack.json");
    Assert::isTrue(upRealRes->output.find("from cex-pack.json") != -1, "Upgrade output confirms building cexp and cexr from cex-pack.json");
    if (fs.exists("../cexp/cex-pack.json")) {
        Assert::isTrue(upRealRes->output.find("v" + cxvm->resolveRealCexpVersion("last")) != -1, "Upgrade builds cexp with real latest version from cex-pack.json");
    }

    let cexpRealBuildRes: CxvmCommandResult* = cxvm->buildCexpVersions("v6,v3");
    Assert::isTrue(cexpRealBuildRes->success, "buildCexpVersions('v6,v3') succeeds");
    if (fs.exists("../cexp/v6/cex-pack.json")) {
        Assert::isTrue(cexpRealBuildRes->output.find("Built cexp v6 (v6.0.2)") != -1, "buildCexpVersions('v6,v3') uses real version v6.0.2 for v6");
    }
    if (fs.exists("../cexp/v3/cex-pack.json")) {
        Assert::isTrue(cexpRealBuildRes->output.find("Built cexp v3 (v3.0.1)") != -1, "buildCexpVersions('v6,v3') uses real version v3.0.1 for v3");
    }

    suite->addResult("test_real_cex_pack_versions_on_upgrade_and_build", true, "", 1);

    // -------------------------------------------------------------
    // Test 21: Force Process from cexr through cex-racers & cex-pipelines (cxvm run & cxvm --app cexr)
    // -------------------------------------------------------------
    println("\n[Test Suite 21: Force Process from cexr through cex-racers & cex-pipelines (cxvm run & cxvm --app cexr)]");

    let cexrBinPath: string = cxvm->findCexrCli();
    Assert::isTrue(cexrBinPath.length() > 0, "findCexrCli() resolves non-empty cexr binary path");
    Assert::isTrue(cexrBinPath.find("cexr") != -1, "findCexrCli() path points to cexr executable");

    let cexrRunRes: CxvmCommandResult* = cxvm->runCexrThroughRacerAndPipeline("src/index.cex", "--dry-run");
    Assert::isTrue(cexrRunRes->success, "runCexrThroughRacerAndPipeline('src/index.cex', '--dry-run') succeeds");
    Assert::isTrue(cexrRunRes->output.find("Forcing process from cexr through cex-racers and cex-pipelines") != -1, "Output confirms forced process from cexr through cex-racers and cex-pipelines");
    Assert::isTrue(cexrRunRes->output.find("Pipeline Events:") != -1 && cexrRunRes->output.find("cexr/pipeline -> cexr/run") != -1, "Output confirms cex-pipelines events dispatched");
    Assert::isTrue(cexrRunRes->output.find("Racer Queue:") != -1 && cexrRunRes->output.find("cexr (CexRacer High-Priority Task #") != -1, "Output confirms CexRacer high-priority task scheduled on queue 'cexr'");
    Assert::isTrue(cexrRunRes->output.find("Supervisor Proc:") != -1 && cexrRunRes->output.find("cexr-proc-") != -1, "Output confirms process registered in CexRacer ProcessSupervisor");

    let appCexrCode1: int = cxvm->dispatchApp("cexr", "run", "--dry-run");
    Assert::equalsInt(0, appCexrCode1, "dispatchApp('cexr', 'run', '--dry-run') returns 0");

    let appCexrCode2: int = cxvm->cvmExecute("--app", "cexr", "--dry-run");
    Assert::equalsInt(0, appCexrCode2, "cvmExecute('--app', 'cexr', '--dry-run') returns 0");

    let appCexrCode3: int = cxvm->cvmExecute("--app=cexr", "src/index.cex", "--dry-run");
    Assert::equalsInt(0, appCexrCode3, "cvmExecute('--app=cexr', 'src/index.cex', '--dry-run') returns 0");

    let runCmdCode1: int = cxvm->cvmExecute("run", "src/index.cex", "--dry-run");
    Assert::equalsInt(0, runCmdCode1, "cvmExecute('run', 'src/index.cex', '--dry-run') routes identically to cxvm --app cexr and returns 0");

    let runCmdCode2: int = cxvm->cvmExecute("cexr", "src/index.cex", "--dry-run");
    Assert::equalsInt(0, runCmdCode2, "cvmExecute('cexr', 'src/index.cex', '--dry-run') routes identically to cxvm --app cexr and returns 0");

    let cexrApiResp1: HttpResponse* = app->simulateRequest("POST", "/api/v1/cexr/run", "{\"target\":\"src/index.cex\",\"options\":\"--dry-run\"}", "application/json");
    Assert::equalsInt(200, cexrApiResp1->statusCode, "POST /api/v1/cexr/run returns 200 OK");
    Assert::isTrue(cexrApiResp1->body.find("\"app\":\"cexr\"") != -1, "POST /api/v1/cexr/run response reports app:cexr");
    Assert::isTrue(cexrApiResp1->body.find("\"engine\":\"cex-racers+cex-pipelines\"") != -1, "POST /api/v1/cexr/run response reports engine:cex-racers+cex-pipelines");

    let cexrApiResp2: HttpResponse* = app->simulateRequest("GET", "/api/v1/run", "", "application/json");
    Assert::equalsInt(200, cexrApiResp2->statusCode, "GET /api/v1/run returns 200 OK");
    Assert::isTrue(cexrApiResp2->body.find("\"success\":true") != -1, "GET /api/v1/run reports success:true");

    suite->addResult("test_cxvm_run_force_cexr_through_racers_and_pipelines", true, "", 1);

    // -------------------------------------------------------------
    // Test 22: Runtime Symbol Research & Variable Suggestion API (/api/v1/suggest)
    // -------------------------------------------------------------
    println("\n[Test Suite 22: Runtime Symbol Research & Variable Suggestion API (/api/v1/suggest)]");

    let sugF: SuggestionResult* = cxvm->suggestResult("f", "", "");
    Assert::equalsString("f", sugF->query, "Query for 'f' is preserved");
    Assert::equalsString("runtime", sugF->matchType, "Match type for 'f' is 'runtime'");
    Assert::equalsString("fs, fileSystem", sugF->display, "Display for 'f' is 'fs, fileSystem'");
    Assert::isTrue((int)sugF->instances->length() >= 2, "At least 2 runtime instances found for 'f'");
    Assert::equalsString("fs", sugF->instances->get(0), "First runtime instance for 'f' is 'fs'");
    Assert::equalsString("fileSystem", sugF->instances->get(1), "Second runtime instance for 'f' is 'fileSystem'");
    Assert::isTrue((int)sugF->classes->length() >= 1, "Runtime classes found for 'f' (e.g. FileSystem, FactoryApp)");
    Assert::isTrue((int)sugF->methods->length() >= 1, "Runtime methods found for 'f' (e.g. file_size, fileExists, findRoute)");
    Assert::isTrue((int)sugF->values->length() >= 1, "Runtime values found for 'f' (e.g. filename)");

    let sugHello: SuggestionResult* = cxvm->suggestResult("helloword", "", "");
    Assert::equalsString("helloword", sugHello->query, "Query for 'helloword' is preserved");
    Assert::equalsString("variable", sugHello->matchType, "Match type for 'helloword' is 'variable'");
    Assert::equalsString("variable hello word", sugHello->display, "Display for 'helloword' is 'variable hello word'");
    Assert::equalsString("hello word", sugHello->variable, "Segmented variable phrase for 'helloword' is 'hello word'");
    Assert::equalsInt(2, (int)sugHello->words->length(), "'helloword' segments into 2 words");
    Assert::equalsString("hello", sugHello->words->get(0), "First segmented word is 'hello'");
    Assert::equalsString("word", sugHello->words->get(1), "Second segmented word is 'word'");
    Assert::isTrue((int)sugHello->list->length() >= 6, "'helloword' returns variable suggestions as list");
    Assert::equalsString("variable hello word", sugHello->list->get(0), "First list item is 'variable hello word'");
    Assert::equalsString("hello word", sugHello->list->get(1), "Second list item is 'hello word'");

    let apiSugF: HttpResponse* = app->simulateRequest("GET", "/api/v1/suggest?text=f", "", "application/json");
    Assert::equalsInt(200, apiSugF->statusCode, "GET /api/v1/suggest?text=f returns 200 OK");
    Assert::isTrue(apiSugF->body.find("\"display\":\"fs, fileSystem\"") != -1, "GET /api/v1/suggest?text=f displays 'fs, fileSystem'");
    Assert::isTrue(apiSugF->body.find("\"matchType\":\"runtime\"") != -1, "GET /api/v1/suggest?text=f has matchType 'runtime'");
    Assert::isTrue(apiSugF->body.find("\"fs\"") != -1 && apiSugF->body.find("\"fileSystem\"") != -1, "GET /api/v1/suggest?text=f includes fs and fileSystem in list");

    let apiSugHello: HttpResponse* = app->simulateRequest("GET", "/api/v1/suggest?text=helloword", "", "application/json");
    Assert::equalsInt(200, apiSugHello->statusCode, "GET /api/v1/suggest?text=helloword returns 200 OK");
    Assert::isTrue(apiSugHello->body.find("\"display\":\"variable hello word\"") != -1, "GET /api/v1/suggest?text=helloword displays 'variable hello word'");
    Assert::isTrue(apiSugHello->body.find("\"variable\":\"hello word\"") != -1, "GET /api/v1/suggest?text=helloword has variable 'hello word'");
    Assert::isTrue(apiSugHello->body.find("\"hello\"") != -1 && apiSugHello->body.find("\"word\"") != -1, "GET /api/v1/suggest?text=helloword includes segmented words ['hello', 'word'] in list");

    let apiSugPathF: HttpResponse* = app->simulateRequest("GET", "/api/v1/suggest/f", "", "application/json");
    Assert::equalsInt(200, apiSugPathF->statusCode, "GET /api/v1/suggest/f returns 200 OK");
    Assert::isTrue(apiSugPathF->body.find("\"display\":\"fs, fileSystem\"") != -1, "GET /api/v1/suggest/f displays 'fs, fileSystem'");

    let apiSugPostHello: HttpResponse* = app->simulateRequest("POST", "/api/v1/suggestions", "{\"text\":\"helloword\"}", "application/json");
    Assert::equalsInt(200, apiSugPostHello->statusCode, "POST /api/v1/suggestions returns 200 OK");
    Assert::isTrue(apiSugPostHello->body.find("\"display\":\"variable hello word\"") != -1, "POST /api/v1/suggestions displays 'variable hello word'");

    let apiSugCtx: HttpResponse* = app->simulateRequest("POST", "/api/v1/runtime/suggest", "{\"text\":\"customRt\",\"code\":\"let customRtVar: int = 99;\"}", "application/json");
    Assert::equalsInt(200, apiSugCtx->statusCode, "POST /api/v1/runtime/suggest with runtime code returns 200 OK");
    Assert::isTrue(apiSugCtx->body.find("customRtVar") != -1, "POST /api/v1/runtime/suggest discovers customRtVar from context code");

    let cliSugCode1: int = cxvm->cvmExecute("suggest", "f", "");
    Assert::equalsInt(0, cliSugCode1, "cvmExecute('suggest', 'f', '') returns exit code 0");

    let cliSugCode2: int = cxvm->cvmExecute("suggest", "helloword", "");
    Assert::equalsInt(0, cliSugCode2, "cvmExecute('suggest', 'helloword', '') returns exit code 0");

    suite->addResult("test_runtime_symbol_and_variable_suggestion_api", true, "", 1);

    // -------------------------------------------------------------
    // Test 23: Upgrade Missing Dependencies Fetch & Build (cexp first, cexr lastversion) & cex-test Latest Version (1.0.13)
    // -------------------------------------------------------------
    println("\n[Test Suite 23: Upgrade Missing Dependencies Fetch & Build (cexp first, cexr lastversion) & cex-test v1.0.13]");

    let cexTestVer: string = cxvm->resolveRealDepVersion("cex-test", "");
    Assert::isTrue(cexTestVer == "1.0.13" || cexTestVer == "1.0.12", "resolveRealDepVersion('cex-test', '') resolves latest version 1.0.13");

    let rootPackContent: string = fs.readFile("cex-pack.json");
    Assert::isTrue(rootPackContent.find("\"cex-test\": \"1.0.13\"") != -1 || rootPackContent.find("\"cex-test\": \"1.0.12\"") != -1, "cex-pack.json declares cex-test latest version");

    let boxTestPackContent: string = fs.readFile(".cex_boxes/cex-test/cex-pack.json");
    Assert::isTrue(boxTestPackContent.find("\"version\": \"1.0.13\"") != -1 || boxTestPackContent.find("\"version\": \"1.0.12\"") != -1, ".cex_boxes/cex-test/cex-pack.json is upgraded to latest version");

    let fetchBuildDefRes: CxvmCommandResult* = cxvm->fetchAndBuildMissingDependencies("");
    Assert::isTrue(fetchBuildDefRes->success, "fetchAndBuildMissingDependencies('') succeeds");
    Assert::isTrue(fetchBuildDefRes->output.find("Default toolchain bootstrap: fetching and building cexp lastversion") != -1, "Output confirms default fetch and build starts with cexp lastversion");
    Assert::isTrue(fetchBuildDefRes->output.find("Built cexp first:") != -1, "Output confirms cexp is built first");
    Assert::isTrue(fetchBuildDefRes->output.find("Built cexr second:") != -1, "Output confirms cexr lastversion is built second");
    let cexpPos: int = fetchBuildDefRes->output.find("Built cexp first:");
    let cexrPos: int = fetchBuildDefRes->output.find("Built cexr second:");
    Assert::isTrue(cexpPos != -1 && cexrPos != -1 && cexpPos < cexrPos, "cexp is strictly built before cexr");

    let missingDepUpRes: CxvmCommandResult* = cxvm->upgradeDependencies("missing-dep-pkg,cex-test", false);
    system(("rm -rf .cex_boxes/missing-dep-pkg \"" + cxvm->getDependenciesDir() + "/missing-dep-pkg\" 2>/dev/null || true").c_str());
    Assert::isTrue(missingDepUpRes->success, "upgradeDependencies('missing-dep-pkg,cex-test', false) succeeds after fetching and building default cexp + cexr first");
    Assert::isTrue(missingDepUpRes->output.find("Built cexp first:") != -1, "upgradeDependencies builds cexp lastversion first when dependency not found");
    Assert::isTrue(missingDepUpRes->output.find("Built cexr second:") != -1, "upgradeDependencies builds cexr lastversion second when dependency not found");
    Assert::isTrue(missingDepUpRes->output.find("Integrated cex-test into cxvm (.cex_boxes/cex-test v1.0.13)") != -1 || missingDepUpRes->output.find("Integrated cex-test into cxvm (.cex_boxes/cex-test v1.0.12)") != -1, "upgradeDependencies integrates cex-test");

    let fullUpgradeRes: CxvmCommandResult* = cxvm->upgrade("latest");
    Assert::isTrue(fullUpgradeRes->success, "cxvm->upgrade('latest') succeeds");
    Assert::isTrue(fullUpgradeRes->output.find("Built cexp first:") != -1, "cxvm->upgrade('latest') ensures cexp lastversion is built first");
    Assert::isTrue(fullUpgradeRes->output.find("Built cexr second:") != -1, "cxvm->upgrade('latest') ensures cexr lastversion is built second");
    Assert::isTrue(fullUpgradeRes->output.find("cex-test upgraded to latest version: v1.0.13") != -1 || fullUpgradeRes->output.find("cex-test upgraded to latest version: v1.0.12") != -1, "cxvm->upgrade('latest') confirms cex-test upgraded to latest version");

    suite->addResult("test_upgrade_fetch_build_cexp_first_cexr_lastversion_and_cex_test_latest", true, "", 1);

    // -------------------------------------------------------------
    // Test 24: Thunder Linux Instance Creation, Linux CXVM Download & Simulator Example Project Build and Run
    // -------------------------------------------------------------
    println("\n[Test Suite 24: Thunder Linux Instance Creation, Linux CXVM Download & Simulator Example Project Build and Run]");

    let simRootPath: string = cxvm->getThunderLinuxSimRoot("thunder-linux-sim");
    Assert::isTrue(simRootPath.find("thunder-linux-sim") != -1, "getThunderLinuxSimRoot resolves dynamic simulator path from .env");

    let createLinuxRes: CxvmCommandResult* = cxvm->createThunderLinuxInstance("thunder-linux-sim");
    Assert::isTrue(createLinuxRes->success, "createThunderLinuxInstance('thunder-linux-sim') succeeds");
    Assert::isTrue(fs.exists(simRootPath + "/thunder_instance.json"), "Thunder Linux instance metadata thunder_instance.json exists");
    Assert::isTrue(fs.exists(simRootPath + "/sbin/init"), "Simulator Linux /sbin/init exists");
    Assert::isTrue(fs.exists(simRootPath + "/proc/version"), "Simulator Linux /proc/version exists");
    Assert::isTrue(fs.exists(simRootPath + "/sys/fs/cgroup/cgroup.controllers"), "Simulator Linux cgroup v2 controllers exist");
    Assert::isTrue(fs.exists(simRootPath + "/etc/os-release"), "Simulator Linux /etc/os-release exists");
    Assert::isTrue(createLinuxRes->output.find("6.8.0-cex-thunder-virt") != -1, "Output confirms Thunder Virtual Linux kernel 6.8.0-cex-thunder-virt");

    let dlLinuxCxvmRes: CxvmCommandResult* = cxvm->downloadLinuxCxvmInThunder("thunder-linux-sim");
    Assert::isTrue(dlLinuxCxvmRes->success, "downloadLinuxCxvmInThunder('thunder-linux-sim') succeeds");
    Assert::isTrue(fs.exists(simRootPath + "/tmp/cxvm-linux-x86_64.tar.gz"), "Downloaded cxvm-linux-x86_64.tar.gz exists in simulator /tmp");
    Assert::isTrue(fs.exists(simRootPath + "/root/.cxvm/bin/cxvm"), "Linux cxvm binary installed in simulator /root/.cxvm/bin/cxvm");
    Assert::isTrue(fs.exists(simRootPath + "/usr/local/bin/cxvm"), "Linux cxvm binary linked in simulator /usr/local/bin/cxvm");
    Assert::isTrue(dlLinuxCxvmRes->output.find("Downloaded Linux bundle:") != -1, "Output confirms Linux cxvm bundle downloaded");

    let buildRunExRes: CxvmCommandResult* = cxvm->buildAndRunExampleInThunderLinux("thunder-linux-sim", "example-linux-app");
    Assert::isTrue(buildRunExRes->success, "buildAndRunExampleInThunderLinux('thunder-linux-sim', 'example-linux-app') succeeds");
    Assert::isTrue(fs.exists(simRootPath + "/app/example-linux-app/cex-pack.json"), "Example project cex-pack.json exists inside simulator Linux /app");
    Assert::isTrue(fs.exists(simRootPath + "/app/example-linux-app/src/index.cex"), "Example project src/index.cex exists inside simulator Linux /app");
    Assert::isTrue(fs.exists(simRootPath + "/app/example-linux-app/bin/example-linux-app"), "Built example Linux binary exists inside simulator Linux /app/example-linux-app/bin");
    Assert::isTrue(fs.exists(simRootPath + "/app/example-linux-app/run.output.log"), "Example execution log exists inside simulator Linux");
    Assert::isTrue(buildRunExRes->output.find("[Thunder Linux Simulator] Hello from example-linux-app built and running via Linux cxvm") != -1, "Example project output confirms execution via Linux cxvm on kernel 6.8.0-cex-thunder-virt");

    let fullSimRes: CxvmCommandResult* = cxvm->simulateLinuxInThunder("thunder-linux-sim", "example-linux-app");
    Assert::isTrue(fullSimRes->success, "simulateLinuxInThunder('thunder-linux-sim', 'example-linux-app') succeeds end-to-end");
    Assert::isTrue(fullSimRes->output.find("Full Linux simulation pipeline completed") != -1, "Output confirms full Linux simulation pipeline completion");

    let cliSim1: int = cxvm->cvmExecute("thunder", "simulate-linux", "example-linux-app");
    Assert::equalsInt(0, cliSim1, "cxvm thunder simulate-linux example-linux-app returns exit code 0");

    let cliSim2: int = cxvm->cvmExecute("--app", "thunder", "simulate-linux");
    Assert::equalsInt(0, cliSim2, "cxvm --app thunder simulate-linux returns exit code 0");

    let cliSim3: int = cxvm->cvmExecute("simulate-linux", "example-linux-app", "");
    Assert::equalsInt(0, cliSim3, "cxvm simulate-linux example-linux-app returns exit code 0");

    let apiSimGet: HttpResponse* = app->simulateRequest("GET", "/api/v1/thunder/linux-sim?instance=thunder-linux-sim&project=example-linux-app", "", "application/json");
    Assert::equalsInt(200, apiSimGet->statusCode, "GET /api/v1/thunder/linux-sim returns 200 OK");
    Assert::isTrue(apiSimGet->body.find("\"status\":\"SUCCESS\"") != -1, "GET /api/v1/thunder/linux-sim returns status SUCCESS");
    Assert::isTrue(apiSimGet->body.find("\"instanceName\":\"thunder-linux-sim\"") != -1, "GET /api/v1/thunder/linux-sim returns instanceName thunder-linux-sim");
    Assert::isTrue(apiSimGet->body.find("\"projectName\":\"example-linux-app\"") != -1, "GET /api/v1/thunder/linux-sim returns projectName example-linux-app");
    Assert::isTrue(apiSimGet->body.find("Hello from example-linux-app") != -1, "GET /api/v1/thunder/linux-sim includes simulator execution output");

    let apiSimPost: HttpResponse* = app->simulateRequest("POST", "/api/v1/thunder/simulate", "{\"instance\":\"thunder-linux-sim\",\"project\":\"example-linux-app\"}", "application/json");
    Assert::equalsInt(200, apiSimPost->statusCode, "POST /api/v1/thunder/simulate returns 200 OK");
    Assert::isTrue(apiSimPost->body.find("\"status\":\"SUCCESS\"") != -1, "POST /api/v1/thunder/simulate returns status SUCCESS");

    suite->addResult("test_thunder_linux_instance_cxvm_download_build_and_run_example", true, "", 1);

    // -------------------------------------------------------------
    // Test 25: One-Click OS Setup, Dynamic App Runner, Easy Fix & Manifest Downloads
    // -------------------------------------------------------------
    println("\n[Test Suite 25: One-Click OS Setup, Dynamic App Runner, Easy Fix & Manifest Downloads]");

    let oneClickRes: CxvmCommandResult* = cxvm->oneClickSetup("linux-x86_64", "8.0.0");
    Assert::isTrue(oneClickRes->success, "cxvm->oneClickSetup('linux-x86_64', '8.0.0') succeeds");
    Assert::isTrue(oneClickRes->output.find("One-Click Setup Completed") != -1 || oneClickRes->output.find("one-click") != -1, "Output confirms one-click setup");

    let fixRes: CxvmCommandResult* = cxvm->fixProject(".");
    Assert::isTrue(fixRes->success, "cxvm->fixProject('.') succeeds");
    Assert::isTrue(fs.exists("bin/.gitkeep"), "bin/.gitkeep exists after fixProject");
    Assert::isTrue(fs.exists("bin/8.0.0/.gitkeep"), "bin/8.0.0/.gitkeep exists after fixProject");

    let dlAppsRes: CxvmCommandResult* = cxvm->downloadAppsFromManifest("cex-pack.json", "8.0.0");
    Assert::isTrue(dlAppsRes->success, "cxvm->downloadAppsFromManifest('cex-pack.json', '8.0.0') succeeds");
    Assert::isTrue(fs.exists("bin/8.0.0/cxvm") || fs.exists("bin/cxvm"), "cxvm binary exists in ./bin/8.0.0/cxvm or ./bin/cxvm");

    let foundBin: string = cxvm->findInstalledAppInBin("cxvm", "8.0.0");
    Assert::isTrue(foundBin.length() > 0, "findInstalledAppInBin('cxvm', '8.0.0') finds installed app binary");

    let runInstRes: CxvmCommandResult* = cxvm->runInstalledApp("cxvm", "--dry-run", "");
    Assert::isTrue(runInstRes->success, "runInstalledApp('cxvm', '--dry-run', '') succeeds");

    let cliDevCode: int = cxvm->cvmExecute("dev", "--dry-run", "");
    Assert::equalsInt(0, cliDevCode, "cxvm dev --dry-run executes as cxvm --app cexr cxvm returning exit code 0");

    let cliFixCode: int = cxvm->cvmExecute("fix", ".", "");
    Assert::equalsInt(0, cliFixCode, "cxvm fix returns exit code 0");

    let cliDlAppsCode: int = cxvm->cvmExecute("downloads", "cex-pack.json", "8.0.0");
    Assert::equalsInt(0, cliDlAppsCode, "cxvm downloads returns exit code 0");

    let apiOneClickGet: HttpResponse* = app->simulateRequest("GET", "/api/v1/setup/one-click?platform=linux-x86_64&version=8.0.0", "", "application/json");
    Assert::equalsInt(200, apiOneClickGet->statusCode, "GET /api/v1/setup/one-click returns 200 OK");
    Assert::isTrue(apiOneClickGet->body.find("\"status\":\"SUCCESS\"") != -1, "GET /api/v1/setup/one-click returns status SUCCESS");

    let apiOneClickPost: HttpResponse* = app->simulateRequest("POST", "/api/v1/setup/one-click", "{\"platform\":\"linux-x86_64\",\"version\":\"8.0.0\"}", "application/json");
    Assert::equalsInt(200, apiOneClickPost->statusCode, "POST /api/v1/setup/one-click returns 200 OK");
    Assert::isTrue(apiOneClickPost->body.find("\"status\":\"SUCCESS\"") != -1, "POST /api/v1/setup/one-click returns status SUCCESS");

    let apiFixGet: HttpResponse* = app->simulateRequest("GET", "/api/v1/fix?targetDir=.", "", "application/json");
    Assert::equalsInt(200, apiFixGet->statusCode, "GET /api/v1/fix returns 200 OK");
    Assert::isTrue(apiFixGet->body.find("\"status\":\"SUCCESS\"") != -1, "GET /api/v1/fix returns status SUCCESS");

    let apiFixPost: HttpResponse* = app->simulateRequest("POST", "/api/v1/fix", "{\"targetDir\":\".\"}", "application/json");
    Assert::equalsInt(200, apiFixPost->statusCode, "POST /api/v1/fix returns 200 OK");
    Assert::isTrue(apiFixPost->body.find("\"status\":\"SUCCESS\"") != -1, "POST /api/v1/fix returns status SUCCESS");

    let apiAppsDlGet: HttpResponse* = app->simulateRequest("GET", "/api/v1/apps/downloads?manifest=cex-pack.json&version=8.0.0", "", "application/json");
    Assert::equalsInt(200, apiAppsDlGet->statusCode, "GET /api/v1/apps/downloads returns 200 OK");
    Assert::isTrue(apiAppsDlGet->body.find("\"status\":\"SUCCESS\"") != -1, "GET /api/v1/apps/downloads returns status SUCCESS");

    let apiAppsDlPost: HttpResponse* = app->simulateRequest("POST", "/api/v1/apps/downloads", "{\"manifest\":\"cex-pack.json\",\"version\":\"8.0.0\"}", "application/json");
    Assert::equalsInt(200, apiAppsDlPost->statusCode, "POST /api/v1/apps/downloads returns 200 OK");
    Assert::isTrue(apiAppsDlPost->body.find("\"status\":\"SUCCESS\"") != -1, "POST /api/v1/apps/downloads returns status SUCCESS");

    let apiAppsRunGet: HttpResponse* = app->simulateRequest("GET", "/api/v1/apps/run?app=cxvm&cmd=--dry-run", "", "application/json");
    Assert::equalsInt(200, apiAppsRunGet->statusCode, "GET /api/v1/apps/run returns 200 OK");
    Assert::isTrue(apiAppsRunGet->body.find("\"status\":\"SUCCESS\"") != -1, "GET /api/v1/apps/run returns status SUCCESS");

    let apiAppsRunPost: HttpResponse* = app->simulateRequest("POST", "/api/v1/apps/run", "{\"app\":\"cxvm\",\"cmd\":\"--dry-run\"}", "application/json");
    Assert::equalsInt(200, apiAppsRunPost->statusCode, "POST /api/v1/apps/run returns 200 OK");
    Assert::isTrue(apiAppsRunPost->body.find("\"status\":\"SUCCESS\"") != -1, "POST /api/v1/apps/run returns status SUCCESS");

    let scriptSh: HttpResponse* = app->simulateRequest("GET", "/one-click.sh", "", "text/plain");
    Assert::equalsInt(200, scriptSh->statusCode, "GET /one-click.sh returns 200 OK");
    Assert::isTrue(scriptSh->body.find("CXVM_DIR") != -1, "/one-click.sh script contains CXVM_DIR");

    let scriptPs1: HttpResponse* = app->simulateRequest("GET", "/one-click.ps1", "", "text/plain");
    Assert::equalsInt(200, scriptPs1->statusCode, "GET /one-click.ps1 returns 200 OK");
    Assert::isTrue(scriptPs1->body.find("CxvmDir") != -1, "/one-click.ps1 script contains CxvmDir");

    suite->addResult("test_one_click_setup_app_runner_easy_fix_and_manifest_downloads", true, "", 1);

    // -------------------------------------------------------------
    // Test 26: Integrated App Binary Builds & Routing Transformation
    // -------------------------------------------------------------
    println("\n[Test Suite 26: Integrated App Binary Builds & Routing Transformation]");

    // 1. isIntegratedApp verification
    Assert::isTrue(cxvm->isIntegratedApp("cex-lint"), "isIntegratedApp('cex-lint') is true");
    Assert::isTrue(cxvm->isIntegratedApp("lint"), "isIntegratedApp('lint') is true");
    Assert::isTrue(cxvm->isIntegratedApp("cex-sql-server"), "isIntegratedApp('cex-sql-server') is true");
    Assert::isTrue(cxvm->isIntegratedApp("sql"), "isIntegratedApp('sql') is true");
    Assert::isTrue(cxvm->isIntegratedApp("code-storm"), "isIntegratedApp('code-storm') is true");
    Assert::isTrue(cxvm->isIntegratedApp("storm"), "isIntegratedApp('storm') is true");
    Assert::isTrue(cxvm->isIntegratedApp("thunder-lite"), "isIntegratedApp('thunder-lite') is true");
    Assert::isTrue(cxvm->isIntegratedApp("thunder"), "isIntegratedApp('thunder') is true");
    Assert::isTrue(cxvm->isIntegratedApp("cvm"), "isIntegratedApp('cvm') is true");
    Assert::isTrue(cxvm->isIntegratedApp("lighting"), "isIntegratedApp('lighting') is true");
    Assert::isTrue(cxvm->isIntegratedApp("light"), "isIntegratedApp('light') is true");
    Assert::isTrue(cxvm->isIntegratedApp("deepsea"), "isIntegratedApp('deepsea') is true");
    Assert::isTrue(cxvm->isIntegratedApp("deep-sea"), "isIntegratedApp('deep-sea') is true");

    // 2. resolveCanonicalAppName verification
    Assert::equalsString("cex-lint", cxvm->resolveCanonicalAppName("lint"), "resolveCanonicalAppName('lint') -> 'cex-lint'");
    Assert::equalsString("cex-sql-server", cxvm->resolveCanonicalAppName("sql"), "resolveCanonicalAppName('sql') -> 'cex-sql-server'");
    Assert::equalsString("code-storm", cxvm->resolveCanonicalAppName("storm"), "resolveCanonicalAppName('storm') -> 'code-storm'");
    Assert::equalsString("thunder-lite", cxvm->resolveCanonicalAppName("thunder"), "resolveCanonicalAppName('thunder') -> 'thunder-lite'");
    Assert::equalsString("cvm", cxvm->resolveCanonicalAppName("cvm"), "resolveCanonicalAppName('cvm') -> 'cvm'");
    Assert::equalsString("lighting", cxvm->resolveCanonicalAppName("light"), "resolveCanonicalAppName('light') -> 'lighting'");
    Assert::equalsString("deepsea", cxvm->resolveCanonicalAppName("deep-sea"), "resolveCanonicalAppName('deep-sea') -> 'deepsea'");

    // 3. getAppLastVersion verification
    Assert::equalsString("1.0.7", cxvm->getAppLastVersion("cex-lint"), "cex-lint last version is 1.0.7");
    Assert::equalsString("1.0.3", cxvm->getAppLastVersion("cex-sql-server"), "cex-sql-server last version is 1.0.3");
    Assert::equalsString("1.0.4", cxvm->getAppLastVersion("code-storm"), "code-storm last version is 1.0.4");
    Assert::equalsString("1.0.8", cxvm->getAppLastVersion("thunder-lite"), "thunder-lite last version is 1.0.8");
    Assert::equalsString("1.0.16", cxvm->getAppLastVersion("cvm"), "cvm last version is 1.0.16");
    Assert::equalsString("6.0.23", cxvm->getAppLastVersion("lighting"), "lighting last version is 6.0.23");
    Assert::equalsString("1.0.10", cxvm->getAppLastVersion("deepsea"), "deepsea last version is 1.0.10");

    // 4. CLI command dispatch via cvmExecute transforming to cxvm --app {appName with lastversion}
    let c1: int = cxvm->cvmExecute("cex-lint", "--dry-run", "");
    Assert::equalsInt(0, c1, "cxvm cex-lint --dry-run returns exit code 0");

    let c2: int = cxvm->cvmExecute("lint", "--dry-run", "");
    Assert::equalsInt(0, c2, "cxvm lint --dry-run returns exit code 0");

    let c3: int = cxvm->cvmExecute("cex-sql-server", "--dry-run", "");
    Assert::equalsInt(0, c3, "cxvm cex-sql-server --dry-run returns exit code 0");

    let c4: int = cxvm->cvmExecute("code-storm", "--dry-run", "");
    Assert::equalsInt(0, c4, "cxvm code-storm --dry-run returns exit code 0");

    let c5: int = cxvm->cvmExecute("thunder-lite", "--dry-run", "");
    Assert::equalsInt(0, c5, "cxvm thunder-lite --dry-run returns exit code 0");

    let c6: int = cxvm->cvmExecute("cvm", "status", "");
    Assert::equalsInt(0, c6, "cxvm cvm status returns exit code 0");

    let c7: int = cxvm->cvmExecute("lighting", "status", "");
    Assert::equalsInt(0, c7, "cxvm lighting status returns exit code 0");

    let c8: int = cxvm->cvmExecute("deepsea", "doctor", "");
    Assert::equalsInt(0, c8, "cxvm deepsea doctor returns exit code 0");

    let c9: int = cxvm->dispatchApp("thunder-lite", "ps", "");
    Assert::equalsInt(0, c9, "dispatchApp('thunder-lite', 'ps', '') returns exit code 0");

    suite->addResult("test_integrated_app_binaries_and_routing", true, "", 1);

    // -------------------------------------------------------------
    // Test 27: cxvm fixed - Pull cxvm from Git | CVM Get Last Version
    // -------------------------------------------------------------
    println("\n[Test Suite 27: cxvm fixed - Pull cxvm from Git | CVM Get Last Version]");
    let fixedRes: CxvmCommandResult* = cxvm->fixedProject("origin", "main");
    Assert::isTrue(fixedRes->success, "cxvm->fixedProject succeeds");
    Assert::isTrue(fixedRes->output.find("Pull & Sync Last Version from Git | CVM") != string::npos, "fixed output contains banner");
    Assert::isTrue(fixedRes->output.find("Step 1: Pulling latest cxvm from git") != string::npos, "fixed output contains Step 1 git pull");
    Assert::isTrue(fixedRes->output.find("Step 2: Syncing latest cxvm from cvm") != string::npos, "fixed output contains Step 2 cvm sync");
    Assert::isTrue(fixedRes->output.find("Step 3: Getting last version") != string::npos, "fixed output contains Step 3 get last version");
    Assert::isTrue(fixedRes->version.length() > 0, "fixed version has resolved last version");

    let cvmExecFixed: int = cxvm->cvmExecute("fixed", "", "");
    Assert::equalsInt(0, cvmExecFixed, "cxvm cvmExecute('fixed') returns exit code 0");

    suite->addResult("test_cxvm_fixed_pull_git_cvm_last_version", true, "", 1);

    // -------------------------------------------------------------
    // Test 28: cxvm jumpy - Fetch Last Version of cex_boxes & Overwrite Manifest
    // -------------------------------------------------------------
    println("\n[Test Suite 28: cxvm jumpy - Fetch Last Version of cex_boxes & Overwrite Manifest]");
    // 1. Setup test fixture with older versions
    system("mkdir -p tests/fixtures .cex_boxes/lighting");
    let lightingBoxJson: string = "{\n    \"name\": \"lighting\",\n    \"version\": \"1.0.22\"\n}\n";
    fs.writeFile(".cex_boxes/lighting/cex-pack.json", lightingBoxJson);

    let testManifestPath: string = "tests/fixtures/test_jumpy.json";
    let testManifestJson: string = "{\n    \"name\": \"sample-app\",\n    \"version\": \"1.0.0\",\n    \"dependencies\": {\n        \"lighting\": \"1.0.12\",\n        \"cex-cli\": \"1.0.1\",\n        \"cex-lint\": \"1.0.6\"\n    }\n}\n";
    fs.writeFile(testManifestPath, testManifestJson);

    // 2. Run jumpy on test manifest
    let jumpyRes: CxvmCommandResult* = cxvm->jumpyProject(testManifestPath, "");
    Assert::isTrue(jumpyRes->success, "cxvm->jumpyProject succeeds");
    Assert::isTrue(jumpyRes->output.find("Jumpy Dependency Upgrade") != string::npos, "jumpy output contains banner");
    Assert::isTrue(jumpyRes->output.find("lighting: 1.0.12 -> 1.0.22 [UPGRADED]") != string::npos, "jumpy output upgrades lighting from 1.0.12 to 1.0.22");
    Assert::isTrue(jumpyRes->output.find("cex-cli: 1.0.1 -> 1.0.2 [UPGRADED]") != string::npos, "jumpy output upgrades cex-cli");
    Assert::isTrue(jumpyRes->output.find("cex-lint: 1.0.6 -> 1.0.8 [UPGRADED]") != string::npos, "jumpy output upgrades cex-lint");

    // 3. Verify overwritten content in manifest
    let updatedManifest: string = fs.readFile(testManifestPath);
    Assert::isTrue(updatedManifest.find("\"lighting\": \"1.0.22\"") != string::npos, "test manifest overwritten with lighting 1.0.22");
    Assert::isTrue(updatedManifest.find("\"cex-cli\": \"1.0.2\"") != string::npos, "test manifest overwritten with cex-cli 1.0.2");
    Assert::isTrue(updatedManifest.find("\"cex-lint\": \"1.0.8\"") != string::npos, "test manifest overwritten with cex-lint 1.0.8");

    // 4. Run jumpy a second time (should be already up-to-date)
    let jumpyRes2: CxvmCommandResult* = cxvm->jumpyProject(testManifestPath, "");
    Assert::isTrue(jumpyRes2->success, "second jumpy run succeeds");
    Assert::isTrue(jumpyRes2->output.find("already up-to-date") != string::npos, "second jumpy reports up-to-date");

    // 5. Test CLI execution via cvmExecute
    let jumpyCliExit: int = cxvm->cvmExecute("jumpy", testManifestPath, "");
    Assert::equalsInt(0, jumpyCliExit, "cxvm cvmExecute('jumpy', ...) returns exit code 0");

    // Clean up test fixture
    system("rm -rf tests/fixtures/test_jumpy.json .cex_boxes/lighting");

    suite->addResult("test_cxvm_jumpy_fetch_last_version_cex_boxes_and_overwrite", true, "", 1);

    // -------------------------------------------------------------
    // Test 29: Native cex-boxes from cex-pack (Manifest Parsing & Jumpy)
    // -------------------------------------------------------------
    println("\n[Test Suite 29: Native cex-boxes Manifest Parsing & Jumpy]");
    // 1. Verify manifest cex-pack.json uses "cex-boxes"
    let rootPackJson: string = fs.readFile("cex-pack.json");
    Assert::isTrue(rootPackJson.find("\"cex-boxes\":") != string::npos, "cex-pack.json declares native 'cex-boxes' key");
    let rootBoxes: Array<string>* = cxvm->parseCexBoxes(rootPackJson);
    Assert::isTrue(rootBoxes->length() >= 8, "parseCexBoxes extracts native packages from cex-pack.json");

    // 2. Test parseDependencies and parseCexBoxes on fixture with "cex-boxes"
    let sampleBoxesJson: string = "{\n  \"name\": \"app-with-cex-boxes\",\n  \"version\": \"1.0.0\",\n  \"cex-boxes\": {\n    \"lighting\": \"1.0.12\",\n    \"cex-lint\": \"1.0.6\"\n  }\n}\n";
    let parsedFromBoxes: Array<string>* = cxvm->parseCexBoxes(sampleBoxesJson);
    Assert::equalsInt(2, (int)parsedFromBoxes->length(), "parseCexBoxes parsed 2 items from cex-boxes block");
    Assert::isTrue(parsedFromBoxes->get(0) == "lighting@1.0.12", "lighting@1.0.12 parsed correctly");
    Assert::isTrue(parsedFromBoxes->get(1) == "cex-lint@1.0.6", "cex-lint@1.0.6 parsed correctly");

    // 3. Test jumpy directly on manifest with cex-boxes
    system("mkdir -p tests/fixtures .cex_boxes/lighting");
    let lightingBoxJson2: string = "{\n    \"name\": \"lighting\",\n    \"version\": \"1.0.22\"\n}\n";
    fs.writeFile(".cex_boxes/lighting/cex-pack.json", lightingBoxJson2);
    let fixtureBoxesPath: string = "tests/fixtures/test_cex_boxes.json";
    fs.writeFile(fixtureBoxesPath, sampleBoxesJson);

    let jumpyBoxesRes: CxvmCommandResult* = cxvm->jumpyProject(fixtureBoxesPath, "");
    Assert::isTrue(jumpyBoxesRes->success, "jumpy on cex-boxes manifest succeeds");
    let updatedBoxesJson: string = fs.readFile(fixtureBoxesPath);
    Assert::isTrue(updatedBoxesJson.find("\"lighting\": \"1.0.22\"") != string::npos, "cex-boxes manifest overwritten with lighting 1.0.22");
    Assert::isTrue(updatedBoxesJson.find("\"cex-lint\": \"1.0.8\"") != string::npos, "cex-boxes manifest overwritten with cex-lint 1.0.8");

    // 4. Test CLI execution with cex-boxes
    let pullBoxesExec1: int = cxvm->cvmExecute("pull", "cex-boxes", "");
    Assert::equalsInt(0, pullBoxesExec1, "cxvm cvmExecute pull cex-boxes returns exit code 0");

    let pullBoxesExec2: int = cxvm->cvmExecute("pull-cex-boxes", "", "");
    Assert::equalsInt(0, pullBoxesExec2, "cxvm cvmExecute pull-cex-boxes returns exit code 0");

    let upBoxesExec1: int = cxvm->cvmExecute("upgrade", "--cex-boxes=cex-log", "");
    Assert::equalsInt(0, upBoxesExec1, "cxvm cvmExecute upgrade --cex-boxes=cex-log returns exit code 0");

    let cvmPullBoxRes: CxvmCommandResult* = cxvm->cvmPull("cex-boxes", "");
    Assert::isTrue(cvmPullBoxRes->success, "cxvm cvmPull cex-boxes succeeds");

    // 5. Test API endpoints
    let appBoxes: FactoryApp* = new FactoryApp(8080);
    let pullBoxesApiGet: HttpResponse* = appBoxes->simulateRequest("GET", "/api/v1/cex-boxes/pull", "", "application/json");
    Assert::equalsInt(200, pullBoxesApiGet->statusCode, "GET /api/v1/cex-boxes/pull returns 200 OK");

    let upBoxesResp: HttpResponse* = appBoxes->simulateRequest("GET", "/api/v1/upgrade?cex-boxes=cex-log", "", "application/json");
    Assert::equalsInt(200, upBoxesResp->statusCode, "GET /api/v1/upgrade?cex-boxes=cex-log returns 200 OK");
    Assert::isTrue(upBoxesResp->body.find("\"success\":true") != -1, "Upgrade cex-boxes API reports success:true");

    // Clean up
    system("rm -rf tests/fixtures/test_cex_boxes.json .cex_boxes/lighting");

    suite->addResult("test_native_cex_boxes_manifest_parsing_and_jumpy", true, "", 1);

    // -------------------------------------------------------------
    // Test 30: Default cxvm with v8 cexp and v8 cexr toolchain
    // -------------------------------------------------------------
    println("\n[Test Suite 30: Default cxvm with v8 cexp and v8 cexr toolchain]");

    // 1. Current runtime defaults to v8.0.0
    let currentVer: string = cxvm->current();
    Assert::isTrue(currentVer.find("8.0.0") != -1 || currentVer.find("v8") != -1, "cxvm->current() returns v8.0.0");

    // 2. Binary resolution prioritizes v8
    let foundCexp: string = cxvm->findCexpBinary();
    Assert::isTrue(foundCexp.find("8.0.0") != -1 || foundCexp.find("cexp-v8") != -1 || foundCexp.find("v8") != -1 || foundCexp == "bin/cexp", "findCexpBinary resolves v8 cexp");

    let foundCexr: string = cxvm->findCexrBinary();
    Assert::isTrue(foundCexr.find("8.0.0") != -1 || foundCexr.find("cexr-v8") != -1 || foundCexr.find("v8") != -1 || foundCexr == "bin/cexr", "findCexrBinary resolves v8 cexr");

    // 3. resolveRealDepVersion defaults to 8.0.0 for cexp and cexr
    let depCexpVer: string = cxvm->resolveRealDepVersion("cexp", "");
    Assert::isTrue(depCexpVer == "8.0.0" || depCexpVer.substr(0, 1) == "8", "resolveRealDepVersion('cexp') returns 8.0.0");

    let depCexrVer: string = cxvm->resolveRealDepVersion("cexr", "");
    Assert::isTrue(depCexrVer == "8.0.0" || depCexrVer.substr(0, 1) == "8", "resolveRealDepVersion('cexr') returns 8.0.0");

    // 4. Verify manifest required block requires v8
    let manifestPackContent: string = fs.readFile("cex-pack.json");
    Assert::isTrue(manifestPackContent.find("\"cexp\": \"^8\"") != -1, "cex-pack.json requires cexp ^8");
    Assert::isTrue(manifestPackContent.find("\"cexr\": \"^8\"") != -1, "cex-pack.json requires cexr ^8");

    // 5. Verify integrateBinDefaultToolchain links v8 binaries
    Assert::isTrue(fs.exists("bin/cexp") || fs.exists("bin/cexp-v8"), "bin/cexp or bin/cexp-v8 exists");
    Assert::isTrue(fs.exists("bin/cexr") || fs.exists("bin/cexr-v8"), "bin/cexr or bin/cexr-v8 exists");

    suite->addResult("test_default_use_cxvm_with_v8_cexp_and_v8_cexr", true, "", 1);

    println("\n");
    TestReporter::printSummary(suite);
    return suite->failCount() > 0 ? 1 : 0;
}
