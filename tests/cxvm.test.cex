    Assert::isTrue(tcRes->output.find("Built cexr v8") != -1, "Toolchain build includes cexr v8");
    Assert::isTrue(tcRes->output.find("Multi-version toolchain build (cexp + cexr) completed") != -1, "Toolchain summary present");

    // 4. CLI command dispatch via cvmExecute
    let cliCexpCode: int = cxvm->cvmExecute("build", "cexp", "v8,v6");
    Assert::equalsInt(0, cliCexpCode, "cxvm build cexp v8,v6 returns exit code 0");

    let cliCexrCode: int = cxvm->cvmExecute("build", "cexr", "v8,v6,v4");
    Assert::equalsInt(0, cliCexrCode, "cxvm build cexr v8,v6,v4 returns exit code 0");

