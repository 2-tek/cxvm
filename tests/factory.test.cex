// 2-TEK Factory: Comprehensive Verification Test Suite (C-ext)
// Powered by cex-test (@cex-test/src/runner.cex)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "@cex-test/src/assert.cex";
import "@cex-test/src/runner.cex";
import fs from "fs";
import "@/src/lighting_mvc.cex";
import "@/src/types.cex";
import "@/src/platform_model.cex";
import "@/src/version_model.cex";
import "@/src/artifact_model.cex";
import "@/src/dist_builder.cex";
import "@/src/cvm/types.cex";
import "@/src/cvm/hash_utils.cex";
import "@/src/cvm/object_store.cex";
import "@/src/cvm/diff_engine.cex";
import "@/src/cvm/cvm_patch.cex";
import "@/src/cvm/ref_manager.cex";
import "@/src/cvm/merge_manager.cex";
import "@/src/cvm/repository.cex";
import "@/src/cvm/cli.cex";
import "@/src/factory_controller.cex";
import "@/src/factory_views.cex";
import "@/src/cxvm_engine.cex";
import "@/src/app.cex";

fn main(): int {
    println("===============================================================================");
    println("       2-TEK Cex Factory & Cross-Platform Runtime Test Suite                   ");
    println("===============================================================================");

    let suite: TestSuite* = new TestSuite("Factory Package Tests");

    // -------------------------------------------------------------
    // Test 1: Factory Models & Schema Validation
    // -------------------------------------------------------------
    println("\n[Test Suite 1: Factory Models & Schema Validation]");
    let pValid: PlatformModel* = new PlatformModel("linux-x86_64", "linux", "x86_64", "x86_64-unknown-linux-gnu", "CexP v8", "tar.gz", "Linux x86_64");
    let valRes1: ModelValidationResult* = pValid->validate();
    Assert::isTrue(valRes1->isValid, "Valid platform passes validation");
    Assert::equalsInt(0, valRes1->getErrorCount(), "Valid platform has 0 errors");

    let pInvalid: PlatformModel* = new PlatformModel("invalid", "", "", "", "", "", "");
    let valRes2: ModelValidationResult* = pInvalid->validate();
    Assert::isFalse(valRes2->isValid, "Invalid platform fails validation");
    Assert::isTrue(valRes2->getErrorCount() >= 3, "Invalid platform detects missing OS, arch, triple");

    let vValid: VersionModel* = new VersionModel("8.0.0", "STABLE", "2026-10-07", "CexR v8 + CexP v8", "Stable release", true);
    let vVal: ModelValidationResult* = vValid->validate();
    Assert::isTrue(vVal->isValid, "Valid version passes validation");
    Assert::isTrue(vValid->toJson().find("8.0.0") != -1, "Version JSON contains version string");

    let vInvalid: VersionModel* = new VersionModel("8.0.0", "UNKNOWN_CHANNEL", "2026-10-07", "CexR v8 + CexP v8", "Invalid", false);
    let vValInv: ModelValidationResult* = vInvalid->validate();
    Assert::isFalse(vValInv->isValid, "Invalid channel fails validation");

    let aValid: ArtifactModel* = new ArtifactModel("cex-v8.0.0-linux-x86_64.tar.gz", "8.0.0", "linux", "x86_64", 2748, "886020858b17f0045dc9e3f5cb795d0b39ff7b73eb7377a7c4c2c4dcf4fd2b60", "/downloads/cex-v8.0.0-linux-x86_64.tar.gz");
    let aVal: ModelValidationResult* = aValid->validate();
    Assert::isTrue(aVal->isValid, "Valid artifact passes validation");
    suite->addResult("test_models_and_validation", true, "", 1);

    // -------------------------------------------------------------
    // Test 2: Cross-Platform Build Engine & cxvm/downloads Directory
    // -------------------------------------------------------------
    println("\n[Test Suite 2: Cross-Platform Build Engine & cxvm/downloads/ Invariants]");
    let downDir: string = fs.exists("dist") ? "dist" : (fs.exists("downloads") ? "downloads" : (fs.exists("cxvm/downloads") ? "cxvm/downloads" : "dist"));
    let builder: DistBuilder* = new DistBuilder(downDir);
    Assert::equalsInt(6, (int)builder->platforms->length(), "Factory supports 6 target architectures");
    Assert::equalsInt(6, (int)builder->versions->length(), "Factory tracks 6 release versions");
    Assert::equalsInt(36, (int)builder->artifacts->length(), "Factory manages 36 distribution packages (6 versions x 6 platforms)");

    Assert::isTrue(fs.exists(downDir + "/cex-v8.0.0-linux-x86_64.tar.gz"), "Linux x86_64 v8.0.0 bundle exists");
    Assert::isTrue(fs.exists(downDir + "/cex-v8.0.0-linux-aarch64.tar.gz"), "Linux aarch64 v8.0.0 bundle exists");
    Assert::isTrue(fs.exists(downDir + "/cex-v8.0.0-darwin-arm64.tar.gz"), "macOS Apple Silicon v8.0.0 bundle exists");
    Assert::isTrue(fs.exists(downDir + "/cex-v8.0.0-darwin-x86_64.tar.gz"), "macOS Intel v8.0.0 bundle exists");
    Assert::isTrue(fs.exists(downDir + "/cex-v8.0.0-windows-x64.zip"), "Windows x64 v8.0.0 zip bundle exists");
    Assert::isTrue(fs.exists(downDir + "/cex-v8.0.0-windows-arm64.zip"), "Windows arm64 v8.0.0 zip bundle exists");
    Assert::isTrue(fs.exists(downDir + "/cex-v6.0.0-linux-x86_64.tar.gz"), "Linux x86_64 v6.0.0 bundle exists");

    Assert::isTrue(fs.exists(downDir + "/install.sh"), "POSIX install.sh exists in downloads");
    Assert::isTrue(fs.exists(downDir + "/install.ps1"), "Windows install.ps1 exists in downloads");
    Assert::isTrue(fs.exists(downDir + "/cxvm"), "cxvm CLI exists in downloads");
    Assert::isTrue(fs.exists(downDir + "/cxvm.sh"), "cxvm.sh exists in downloads");
    Assert::isTrue(fs.exists(downDir + "/cxvm.ps1"), "cxvm.ps1 exists in downloads");
    Assert::isTrue(fs.exists(downDir + "/cxvm.cmd"), "cxvm.cmd exists in downloads");
    Assert::isTrue(fs.exists(downDir + "/cex-pack"), "cex-pack binary exists in downloads");
    Assert::isTrue(fs.exists("dist/cex-pack-bean/1.0.5/bin"), "cex-pack-bean built with exact version & type in ./dist/cex-pack-bean/1.0.5/bin");
    Assert::isTrue(fs.exists("dist/cex-pack/1.0.5/bin"), "cex-pack integrated inside ./dist/cex-pack/1.0.5/bin");
    Assert::isTrue(fs.exists("dist/cex-lint/1.0.8/bin"), "cex-lint binary build integrated into ./dist/cex-lint/1.0.8/bin");
    Assert::isTrue(fs.exists("dist/cexp-v8/8.0.0/bin"), "standalone cexp-v8 built with exact version & type in ./dist/cexp-v8/8.0.0/bin");
    Assert::isTrue(fs.exists("dist/cexp-v7/7.0.0/bin"), "standalone cexp-v7 built with exact version & type in ./dist/cexp-v7/7.0.0/bin");
    Assert::isTrue(fs.exists("dist/cexp-v6/6.0.2/bin"), "standalone cexp-v6 built with exact version & type in ./dist/cexp-v6/6.0.2/bin");
    Assert::isTrue(fs.exists("dist/cexp-v5/5.0.0/bin"), "standalone cexp-v5 built with exact version & type in ./dist/cexp-v5/5.0.0/bin");
    Assert::isTrue(fs.exists("dist/cexp-v4/4.0.0/bin"), "standalone cexp-v4 built with exact version & type in ./dist/cexp-v4/4.0.0/bin");
    Assert::isTrue(fs.exists("dist/cexp-v3/3.0.1/bin"), "standalone cexp-v3 built with exact version & type in ./dist/cexp-v3/3.0.1/bin");
    Assert::isTrue(fs.exists("dist/cexp-v2/2.0.0/bin"), "standalone cexp-v2 built with exact version & type in ./dist/cexp-v2/2.0.0/bin");
    Assert::isTrue(fs.exists("dist/cexp-v1/1.0.0/bin"), "standalone cexp-v1 built with exact version & type in ./dist/cexp-v1/1.0.0/bin");
    Assert::isTrue(fs.exists("dist/cexr-bean/1.0.26/bin"), "cexr-bean built with exact version & type in ./dist/cexr-bean/1.0.26/bin");
    Assert::isTrue(fs.exists("dist/cexr-delivery/1.0.26/bin"), "cexr-delivery built with exact version & type in ./dist/cexr-delivery/1.0.26/bin");
    Assert::isTrue(fs.exists("dist/cexr-drawer/1.0.26/bin"), "cexr-drawer built with exact version & type in ./dist/cexr-drawer/1.0.26/bin");
    Assert::isTrue(fs.exists("dist/cexr-factory/1.0.26/bin"), "cexr-factory built with exact version & type in ./dist/cexr-factory/1.0.26/bin");
    Assert::isFalse(fs.exists("dist/cxvm-bean/2.0.0/binary"), "binary deleted from ./dist/cxvm-bean/2.0.0/binary");
    Assert::isFalse(fs.exists("bin"), "obsolete ./bin directory removed in favor of ./dist");
    let mfRaw: string = fs.readFile("cex-pack.json");
    Assert::isTrue(mfRaw.find("\"lint\": \"cxvm --app cex-lint fix .\"") != -1, "cex-pack.json scripts.lint is configured as cxvm --app cex-lint fix .");
    Assert::isTrue(fs.exists(downDir + "/manifest.json"), "manifest.json exists in downloads");
    Assert::isTrue(fs.exists(downDir + "/SHA256SUMS"), "SHA256SUMS checksum file exists in downloads");
    Assert::isTrue(fs.exists("dist") && fs.exists("dist/cex-v8.0.0-linux-x86_64.tar.gz"), "dist/ directory contains cross-platform distribution bundles");
    Assert::isTrue(fs.exists("dist/manifest.json") && fs.exists("dist/cxvm"), "dist/ contains cxvm and manifest.json");
    suite->addResult("test_distribution_builder_and_artifacts", true, "", 1);

    // -------------------------------------------------------------
    // Test 3: CXVM Runtime Version Manager Operations (like nvm)
    // -------------------------------------------------------------
    println("\n[Test Suite 3: CXVM Version Manager Operations (like nvm)]");
    let cxvm: CxvmEngine* = new CxvmEngine();
    Assert::equalsString("v8.0.0", cxvm->current(), "Initial cxvm state has default v8.0.0 active");
    Assert::isTrue(cxvm->isVersionInstalled("8.0.0"), "Version 8.0.0 is marked as installed");

    let instRes1: CxvmCommandResult* = cxvm->install("2.0.0");
    Assert::isTrue(instRes1->success, "cxvm install 2.0.0 succeeds");
    Assert::equalsInt(2, (int)cxvm->installedVersions->length(), "cxvm has 2 installed versions");

    let useRes: CxvmCommandResult* = cxvm->use("2.0.0");
    Assert::isTrue(useRes->success, "cxvm use 2.0.0 switches active version");
    Assert::equalsString("v2.0.0", cxvm->current(), "Active version is now v2.0.0");

    let listOut: string = cxvm->list();
    Assert::isTrue(listOut.find("-> v2.0.0 (active") != -1, "cxvm list indicates active version with arrow");

    Assert::equalsInt(6, (int)cxvm->supportedPlatforms->length(), "cxvm supports 6 target architectures for download");
    Assert::isTrue(cxvm->isPlatformSupported("linux-x86_64"), "cxvm recognizes linux-x86_64");
    Assert::isTrue(cxvm->isPlatformSupported("windows-x64"), "cxvm recognizes windows-x64");
    Assert::isFalse(cxvm->isPlatformSupported("unknown-os"), "cxvm rejects unknown platform");

    let downRes: CxvmCommandResult* = cxvm->download("8.0.0", "linux-x86_64");
    Assert::isTrue(downRes->success, "cxvm download 8.0.0 linux-x86_64 succeeds");
    Assert::isTrue(downRes->output.find("cex-v8.0.0-linux-x86_64.tar.gz") != -1, "download output mentions linux tarball");

    let downAllRes: CxvmCommandResult* = cxvm->downloadAll("8.0.0");
    Assert::isTrue(downAllRes->success, "cxvm downloadAll 8.0.0 succeeds");
    Assert::isTrue(downAllRes->output.find("windows-x64.zip") != -1, "downloadAll output mentions windows zip");
    Assert::isTrue(downAllRes->output.find("darwin-arm64.tar.gz") != -1, "downloadAll output mentions macOS tarball");

    let docOut: string = cxvm->doctor();
    Assert::isTrue(docOut.find("HEALTHY [OK]") != -1, "cxvm doctor reports HEALTHY");
    Assert::isTrue(docOut.find("CexR Runtime:      v8") != -1, "cxvm doctor reports CexR v8 runtime");
    Assert::isTrue(docOut.find("CexP Compiler:     v8") != -1, "cxvm doctor reports CexP v8 compiler");
    Assert::isTrue(docOut.find("Pure Cex Native Engine") != -1, "cxvm doctor reports Pure Cex Native Engine");
    Assert::isTrue(docOut.find("Cross-Platform") != -1, "cxvm doctor reports cross-platform support");
    Assert::isTrue(docOut.find("Supported Targets: 6 architectures") != -1, "cxvm doctor reports 6 supported targets");
    Assert::isTrue(docOut.find("CVM VCS Engine") != -1, "cxvm doctor reports integrated CVM engine");
    Assert::isTrue(docOut.find("CVM Commands") != -1, "cxvm doctor reports CVM commands ready");

    let initRes: CxvmCommandResult* = cxvm->cxvmInit("my-project", ".");
    Assert::isTrue(initRes->success, "cxvm init succeeds with default name my-project");

    let setupCmdRes: CxvmCommandResult* = cxvm->setup("8.0.0");
    Assert::isTrue(setupCmdRes->success, "cxvm setup succeeds");
    Assert::equalsString("v8.0.0", cxvm->current(), "Active version after setup is v8.0.0");
    Assert::equalsString("factory", cxvm->defaultCexrEdition, "Default cexr runtime edition after setup is factory (cexr-factory)");
    Assert::equalsString("bean", cxvm->defaultBuildEdition, "Default cexr build edition after setup is bean (cexr-bean)");
    Assert::isTrue(setupCmdRes->output.find("cexr-factory") != -1, "Setup output displays default runtime cexr-factory");
    Assert::isTrue(setupCmdRes->output.find("cexr-bean") != -1, "Setup output displays default build cexr-bean");
    Assert::isTrue(setupCmdRes->output.find("cexr-delivery") != -1, "Setup output displays cexr-delivery via cexr -v");
    Assert::isTrue(setupCmdRes->output.find("cexr-drawer") != -1, "Setup output displays cexr-drawer via cexr -v");
    Assert::isTrue(setupCmdRes->output.find("CEX_DIR/cexp-v8/$version/bin") != -1, "Setup output displays CEX_DIR/cexp-v8/$version/bin");
    Assert::isTrue(setupCmdRes->output.find("./dist/cex-lint/1.0.8/bin") != -1, "Setup output displays ./dist/cex-lint/1.0.8/bin");

    let uninstRes: CxvmCommandResult* = cxvm->uninstall("2.0.0");
    Assert::isTrue(uninstRes->success, "cxvm uninstall 2.0.0 succeeds");
    Assert::equalsInt(2, (int)cxvm->installedVersions->length(), "cxvm has 2 versions remaining after setup & uninstall");
    Assert::equalsString("v8.0.0", cxvm->current(), "cxvm active version falls back to remaining version");

    let uninstActiveRes: CxvmCommandResult* = cxvm->uninstall("8.0.0");
    Assert::isTrue(uninstActiveRes->success, "cxvm uninstall 8.0.0 (active) succeeds");
    Assert::equalsString("v6.0.0", cxvm->current(), "cxvm active version switches to remaining installed version v6.0.0");

    let instRes: CxvmCommandResult* = cxvm->install("8.0.0");
    Assert::isTrue(instRes->success, "cxvm install 8.0.0 succeeds");

    let resetupRes: CxvmCommandResult* = cxvm->resetup("8.0.0");
    Assert::isTrue(resetupRes->success, "cxvm resetup 8.0.0 succeeds");
    Assert::equalsString("v8.0.0", cxvm->current(), "cxvm active version after resetup is v8.0.0");

    let execResetupRes: int = cxvm->cvmExecute("resetup", "8.0.0", "");
    Assert::equalsInt(0, execResetupRes, "cxvm cvmExecute resetup returns 0 OK");

    let execUninstRes: int = cxvm->cvmExecute("uninstall", "6.0.0", "");
    Assert::equalsInt(0, execUninstRes, "cxvm cvmExecute uninstall 6.0.0 returns 0 OK");

    let execInstRes: int = cxvm->cvmExecute("install", "6.0.0", "");
    Assert::equalsInt(0, execInstRes, "cxvm cvmExecute install 6.0.0 returns 0 OK");

    let appLintRes: int = cxvm->appExecute("cex-lint", "fix", ".");
    Assert::equalsInt(0, appLintRes, "cxvm --app cex-lint fix . returns 0 OK");
    let execLintRes: int = cxvm->cvmExecute("lint", ".", "");
    Assert::equalsInt(0, execLintRes, "cxvm lint routes to cxvm --app cex-lint fix .");
    let hookDevDefRes: int = cxvm->cvmExecute("dev", "src/index.cex", "");
    Assert::equalsInt(0, hookDevDefRes, "cxvm dev defaults to cexr-factory");
    let hookBuildDefRes: int = cxvm->cvmExecute("build", "src/index.cex", "");
    Assert::equalsInt(0, hookBuildDefRes, "cxvm build defaults to cexr-bean");
    let hookDevRes: int = cxvm->cvmExecute("dev", "bean", "src/index.cex");
    Assert::equalsInt(0, hookDevRes, "cxvm dev hooks to cxvm --app cexr bean dev src/index.cex");
    let hookBuildRes: int = cxvm->cvmExecute("build", "bean", "src/index.cex");
    Assert::equalsInt(0, hookBuildRes, "cxvm build hooks to cxvm --app cexr bean build src/index.cex");
    let hookStartRes: int = cxvm->cvmExecute("start", "bean", "src/index.cex");
    Assert::equalsInt(0, hookStartRes, "cxvm start hooks to cxvm --app cexr bean start src/index.cex");
    let hookCexpDevRes: int = cxvm->hookCexpExecute("cexr-factory", "dev", "src/index.cex");
    Assert::equalsInt(0, hookCexpDevRes, "hookCexpExecute cexp --app cexr-factory dev returns 0 OK");
    let hookCexpBuildRes: int = cxvm->hookCexpExecute("cexr-bean", "build", "src/index.cex");
    Assert::equalsInt(0, hookCexpBuildRes, "hookCexpExecute cexp --app cexr-bean build returns 0 OK");
    let execCexpAppRes: int = cxvm->cvmExecute("cexp", "--app", "cexr-factory");
    Assert::equalsInt(0, execCexpAppRes, "cxvm cexp --app cexr-factory returns 0 OK");
    let regCexDirRes: CxvmCommandResult* = cxvm->registerBinaryAppsInCexDir();
    Assert::isTrue(regCexDirRes->success, "registerBinaryAppsInCexDir succeeds");
    Assert::isTrue(regCexDirRes->output.find("CEX_DIR/cexp-v8") != -1, "register output contains cexp-v8");
    Assert::isTrue(regCexDirRes->output.find("CEX_DIR/cexr-factory") != -1, "register output contains cexr-factory");
    Assert::isTrue(regCexDirRes->output.find("CEX_DIR/cexr-bean") != -1, "register output contains cexr-bean");
    Assert::isTrue(regCexDirRes->output.find("CEX_DIR/cexr-factory/1.0.26/bin") != -1, "register output uses exact version 1.0.26 for cexr-factory");
    Assert::isTrue(regCexDirRes->output.find("CEX_DIR/cexr-bean/1.0.26/bin") != -1, "register output uses exact version 1.0.26 for cexr-bean");
    Assert::isTrue(regCexDirRes->output.find("CEX_DIR/cexr-delivery/1.0.26/bin") != -1, "register output uses exact version 1.0.26 for cexr-delivery");
    Assert::isTrue(regCexDirRes->output.find("CEX_DIR/cexr-drawer/1.0.26/bin") != -1, "register output uses exact version 1.0.26 for cexr-drawer");
    Assert::isTrue(regCexDirRes->output.find("CEX_DIR/bin") != -1, "register output contains CEX_DIR/bin");
    Assert::isTrue(regCexDirRes->output.find("CXMV_DIR/cxvm") != -1, "register output contains target build CXMV_DIR/cxvm");
    Assert::isTrue(regCexDirRes->output.find("./dist/$name-$type/$version/bin") != -1, "register output contains ./dist/$name-$type/$version/bin");
    Assert::isTrue(setupCmdRes->output.find("CXMV_DIR/cxvm") != -1, "setup output contains target build CXMV_DIR/cxvm");
    Assert::isTrue(setupCmdRes->output.find("./dist/$name-$type/$version/bin") != -1, "setup output contains ./dist/$name-$type/$version/bin");
    Assert::isTrue(fs.exists("setup.cex"), "setup.cex exists on root");
    Assert::isTrue(fs.exists("dist/setup.cex"), "dist/setup.cex exists in dist/");
    Assert::isTrue(fs.exists("dist/cxvm-bean/2.0.0/bin"), "dist/cxvm-bean/2.0.0/bin built and exists on disk");
    Assert::isFalse(fs.exists("dist/cxvm-bean/2.0.0/binary"), "dist/cxvm-bean/2.0.0/binary deleted");
    let appCxvmRes: int = cxvm->appExecute("cxvm", "build", "src/index.cex");
    Assert::equalsInt(0, appCxvmRes, "cxvm --app cxvm build returns 0 OK");
    let depsRes: CxvmCommandResult* = cxvm->setupDeps();
    Assert::isTrue(depsRes->success, "cxvm setupDeps succeeds");
    Assert::isTrue(depsRes->output.find("deps/$name-$type/$version") != -1, "setupDeps mentions target deps/$name-$type/$version");
    Assert::isTrue(depsRes->output.find("cexp-v8") != -1, "setupDeps resolves cexp-v8");
    Assert::isTrue(depsRes->output.find("cexr-bean") != -1, "setupDeps resolves cexr-bean");
    Assert::isTrue(depsRes->output.find("cexr-factory") != -1, "setupDeps resolves cexr-factory");
    Assert::isTrue(depsRes->output.find("cex-pack") != -1, "setupDeps resolves cex-pack");
    Assert::isTrue(depsRes->output.find("cex-lint") != -1, "setupDeps resolves cex-lint");
    Assert::isTrue(depsRes->output.find("cxvm-bean") != -1, "setupDeps resolves cxvm-bean");
    Assert::equalsString("8.0.0", cxvm->resolveLibVersion("cexp-v8"), "resolveLibVersion dynamically resolves cexp-v8");
    Assert::equalsString("1.0.26", cxvm->resolveLibVersion("cexr-bean"), "resolveLibVersion dynamically resolves cexr-bean");
    Assert::equalsString("1.0.26", cxvm->resolveLibVersion("cexr-factory"), "resolveLibVersion dynamically resolves cexr-factory");
    Assert::equalsString("1.0.5", cxvm->resolveLibVersion("cex-pack"), "resolveLibVersion dynamically resolves cex-pack");
    Assert::equalsString("1.0.8", cxvm->resolveLibVersion("cex-lint"), "resolveLibVersion dynamically resolves cex-lint");
    Assert::equalsString("2.0.0", cxvm->resolveLibVersion("cxvm-bean"), "resolveLibVersion dynamically resolves cxvm-bean");
    let depsRes2: CxvmCommandResult* = cxvm->setupDeps();
    Assert::isTrue(depsRes2->success, "second setupDeps execution succeeds");
    Assert::isTrue(depsRes2->output.find("skipping rebuild") != -1, "setupDeps skips rebuild when existing version exists");
    let execCexSetupRes: int = cxvm->cvmExecute("cex", "setup", "");
    Assert::equalsInt(0, execCexSetupRes, "cxvm cvmExecute cex setup returns 0 OK");
    let execSetupDepsRes: int = cxvm->cvmExecute("setup", "deps", "");
    Assert::equalsInt(0, execSetupDepsRes, "cxvm cvmExecute setup deps returns 0 OK");
    Assert::isTrue(setupCmdRes->output.find("Dependencies Build:") != -1, "setup output confirms dependencies built and cached");
    suite->addResult("test_cxvm_version_manager", true, "", 1);

    // -------------------------------------------------------------
    // Test 4: Lighting MVC Application Kernel & Endpoints
    // -------------------------------------------------------------
    println("\n[Test Suite 4: Lighting MVC Application Kernel & Endpoints]");
    let app: FactoryApp* = new FactoryApp(3080);
    app->start();
    Assert::isTrue(app->isRunning, "Factory app starts running");
    Assert::isTrue(app->router->getRouteCount() >= 10, "Factory router has at least 10 routes");

    let resHome: HttpResponse* = app->simulateRequest("GET", "/", "", "text/html");
    Assert::equalsInt(200, resHome->statusCode, "GET / returns 200 OK");
    Assert::isTrue(resHome->body.find("Cex Cross-Platform Factory") != -1, "Home view contains Factory title");
    Assert::isTrue(resHome->body.find("cxvm") != -1, "Home view contains cxvm reference");

    let resDown: HttpResponse* = app->simulateRequest("GET", "/downloads", "", "text/html");
    Assert::equalsInt(200, resDown->statusCode, "GET /downloads returns 200 OK");
    Assert::isTrue(resDown->body.find("cex-v8.0.0-linux-x86_64.tar.gz") != -1 || resDown->body.find("cex-v6.0.0-linux-x86_64.tar.gz") != -1, "Downloads view lists Linux bundle");

    let resDocs: HttpResponse* = app->simulateRequest("GET", "/cxvm", "", "text/html");
    Assert::equalsInt(200, resDocs->statusCode, "GET /cxvm returns 200 OK");
    Assert::isTrue(resDocs->body.find("Command Reference") != -1, "cxvm docs contains command table");

    let resSetup: HttpResponse* = app->simulateRequest("GET", "/setup", "", "text/html");
    Assert::equalsInt(200, resSetup->statusCode, "GET /setup returns 200 OK");
    Assert::isTrue(resSetup->body.find("CXVM Cross-Platform System Setup Window") != -1, "Setup window view contains title");

    let resSetupCex: HttpResponse* = app->simulateRequest("GET", "/setup.cex", "", "text/plain");
    Assert::equalsInt(200, resSetupCex->statusCode, "GET /setup.cex returns 200 OK");
    Assert::isTrue(resSetupCex->body.find("SetupRunner") != -1, "setup.cex contains SetupRunner");

    let resSh: HttpResponse* = app->simulateRequest("GET", "/install.sh", "", "text/x-shellscript");
    Assert::equalsInt(200, resSh->statusCode, "GET /install.sh returns 200 OK");
    Assert::isTrue(resSh->body.find("CXVM_DIR") != -1, "install.sh contains CXVM_DIR variable");

    let resStatus: HttpResponse* = app->simulateRequest("GET", "/api/v1/status", "", "application/json");
    Assert::equalsInt(200, resStatus->statusCode, "GET /api/v1/status returns 200 OK");
    Assert::isTrue(resStatus->body.find("ACTIVE") != -1, "Status reports ACTIVE");

    let resVers: HttpResponse* = app->simulateRequest("GET", "/api/v1/versions", "", "application/json");
    Assert::equalsInt(200, resVers->statusCode, "GET /api/v1/versions returns 200 OK");
    Assert::isTrue(resVers->body.find("8.0.0") != -1, "Versions list includes 8.0.0");

    let resPlat: HttpResponse* = app->simulateRequest("GET", "/api/v1/platforms", "", "application/json");
    Assert::equalsInt(200, resPlat->statusCode, "GET /api/v1/platforms returns 200 OK");
    Assert::isTrue(resPlat->body.find("linux-x86_64") != -1, "Platforms list includes linux-x86_64");

    let resSetupApi: HttpResponse* = app->simulateRequest("GET", "/api/v1/setup", "", "application/json");
    Assert::equalsInt(200, resSetupApi->statusCode, "GET /api/v1/setup returns 200 OK");
    Assert::isTrue(resSetupApi->body.find("dispatchers") != -1, "Setup API includes dispatchers info");

    let resBuild: HttpResponse* = app->simulateRequest("POST", "/api/v1/build", "", "application/json");
    Assert::equalsInt(200, resBuild->statusCode, "POST /api/v1/build returns 200 OK");
    Assert::isTrue(resBuild->body.find("SUCCESS") != -1, "Build reports SUCCESS");

    // Test cross-platform downloads endpoint
    let resCxvm: HttpResponse* = app->simulateRequest("GET", "/downloads/cxvm", "", "");
    Assert::equalsInt(200, resCxvm->statusCode, "GET /downloads/cxvm returns 200 OK");
    Assert::isTrue(resCxvm->body.find("cxvm()") != -1, "Downloaded cxvm contains CLI logic");

    let resCxvmPs1: HttpResponse* = app->simulateRequest("GET", "/downloads/cxvm.ps1", "", "");
    Assert::equalsInt(200, resCxvmPs1->statusCode, "GET /downloads/cxvm.ps1 returns 200 OK");
    Assert::isTrue(resCxvmPs1->body.find("switch ($Command)") != -1, "Downloaded cxvm.ps1 contains command switch");

    let resCxvmCmd: HttpResponse* = app->simulateRequest("GET", "/downloads/cxvm.cmd", "", "");
    Assert::equalsInt(200, resCxvmCmd->statusCode, "GET /downloads/cxvm.cmd returns 200 OK");

    let resBundle: HttpResponse* = app->simulateRequest("GET", "/downloads/cex-v8.0.0-linux-x86_64.tar.gz", "", "");
    Assert::equalsInt(200, resBundle->statusCode, "GET /downloads/cex-v8.0.0-linux-x86_64.tar.gz returns 200 OK");
    Assert::equalsString("application/gzip", resBundle->contentType, "Bundle served with application/gzip");

    let res404: HttpResponse* = app->simulateRequest("GET", "/nonexistent", "", "application/json");
    Assert::equalsInt(404, res404->statusCode, "Non-existent route returns 404 Not Found");

    app->stop();
    Assert::isFalse(app->isRunning, "Factory app kernel stops cleanly");
    suite->addResult("test_lighting_mvc_endpoints", true, "", 1);

    // -------------------------------------------------------------
    // Test 5: Cross-Platform Architecture Matrix Invariants
    // -------------------------------------------------------------
    println("\n[Test Suite 5: Cross-Platform Architecture Matrix Invariants]");
    let pList: Array<PlatformModel*>* = builder->platforms;
    let foundLinuxX64: bool = false;
    let foundLinuxArm: bool = false;
    let foundDarwinArm: bool = false;
    let foundDarwinX64: bool = false;
    let foundWinX64: bool = false;
    let foundWinArm: bool = false;

    for (let i: int = 0; i < (int)pList->length(); i++) {
        let p: PlatformModel* = pList->get(i);
        if (p->id === "linux-x86_64" && p->archiveFormat === "tar.gz") foundLinuxX64 = true;
        if (p->id === "linux-aarch64" && p->archiveFormat === "tar.gz") foundLinuxArm = true;
        if (p->id === "darwin-arm64" && p->archiveFormat === "tar.gz") foundDarwinArm = true;
        if (p->id === "darwin-x86_64" && p->archiveFormat === "tar.gz") foundDarwinX64 = true;
        if (p->id === "windows-x64" && p->archiveFormat === "zip") foundWinX64 = true;
        if (p->id === "windows-arm64" && p->archiveFormat === "zip") foundWinArm = true;
    }

    Assert::isTrue(foundLinuxX64, "Linux x86_64 with .tar.gz format verified");
    Assert::isTrue(foundLinuxArm, "Linux aarch64 with .tar.gz format verified");
    Assert::isTrue(foundDarwinArm, "macOS Apple Silicon arm64 with .tar.gz format verified");
    Assert::isTrue(foundDarwinX64, "macOS Intel x86_64 with .tar.gz format verified");
    Assert::isTrue(foundWinX64, "Windows x64 with .zip format verified");
    Assert::isTrue(foundWinArm, "Windows arm64 with .zip format verified");
    suite->addResult("test_platform_matrix_invariants", true, "", 1);

    // -------------------------------------------------------------
    // Test 6: Integrated CVM (CodeVersionManager) Operations in cxvm
    // -------------------------------------------------------------
    println("\n[Test Suite 6: Integrated CVM (CodeVersionManager) Subsystem in cxvm]");

    // 1. Status
    let cvmSt1: CxvmCommandResult* = cxvm->cvmStatus();
    Assert::isTrue(cvmSt1->success, "cxvm status succeeds");
    Assert::equalsString("main", cvmSt1->version, "Initial branch is main");

    // 2. Add
    let cvmAddRes: CxvmCommandResult* = cxvm->cvmAdd("src/test_sample.cex", "// Sample module\nfn hello(): void { println(\"hi\"); }\n");
    Assert::isTrue(cvmAddRes->success, "cxvm add file succeeds");
    Assert::equalsString("src/test_sample.cex", cvmAddRes->version, "Target file matches");

    // 3. Commit
    let cvmComRes: CxvmCommandResult* = cxvm->cvmCommit("feat(cxvm): integrate cvm into cxvm", "Antigravity", "antigravity@2tek.local");
    Assert::isTrue(cvmComRes->success, "cxvm commit succeeds");
    Assert::isTrue((int)cvmComRes->version.length() >= 7, "Commit hash generated");
    Assert::isTrue(cvmComRes->output.find("feat(cxvm): integrate cvm into cxvm") != -1, "Commit message in output");

    // 4. Push
    let cvmPushRes: CxvmCommandResult* = cxvm->cvmPush("origin", "main");
    Assert::isTrue(cvmPushRes->success, "cxvm push succeeds");
    Assert::isTrue(cvmPushRes->output.find("Successfully pushed branch main to origin") != -1, "Push output verifies remote push");
    Assert::isTrue(cvmPushRes->output.find("Auto-building to dist before push") != -1, "Push auto-builds to dist before push");
    Assert::isTrue(cvmPushRes->output.find("Target integrated binary built into: ./dist/$name-$type/$version/bin") != -1, "Push output verifies target integrated binary build");

    // 5. Pull
    let cvmPullRes: CxvmCommandResult* = cxvm->cvmPull("origin", "main");
    Assert::isTrue(cvmPullRes->success, "cxvm pull succeeds");
    Assert::isTrue(cvmPullRes->output.find("Already up to date") != -1, "Pull output verifies up to date");

    // 6. Branch & Checkout
    let cvmBrRes: CxvmCommandResult* = cxvm->cvmBranch("feature/vcs-integration");
    Assert::isTrue(cvmBrRes->success, "cxvm branch create succeeds");

    let cvmCoRes: CxvmCommandResult* = cxvm->cvmCheckout("feature/vcs-integration");
    Assert::isTrue(cvmCoRes->success, "cxvm checkout succeeds");

    let cvmBrList: CxvmCommandResult* = cxvm->cvmBranch("");
    Assert::isTrue(cvmBrList->success, "cxvm branch list succeeds");
    Assert::isTrue(cvmBrList->output.find("feature/vcs-integration (active)") != -1, "Active branch switched to new branch");

    // 7. Log
    let cvmLogRes: CxvmCommandResult* = cxvm->cvmLog();
    Assert::isTrue(cvmLogRes->success, "cxvm log succeeds");
    Assert::isTrue(cvmLogRes->output.find("feat(cxvm): integrate cvm into cxvm") != -1, "Log contains commit message");

    // 8. CLI Execute
    let cvmExecCode: int = cxvm->cvmExecute("status", "", "");
    Assert::equalsInt(0, cvmExecCode, "cxvm cvmExecute status returns exit code 0");

    // 9. HTTP REST API endpoints for CVM
    let resCvmStatus: HttpResponse* = app->simulateRequest("GET", "/api/v1/cvm/status", "", "application/json");
    Assert::equalsInt(200, resCvmStatus->statusCode, "GET /api/v1/cvm/status returns 200 OK");
    Assert::isTrue(resCvmStatus->body.find("SUCCESS") != -1, "CVM Status API reports SUCCESS");

    let resCvmCommit: HttpResponse* = app->simulateRequest("POST", "/api/v1/cvm/commit", "feat: http test commit", "application/json");
    Assert::equalsInt(200, resCvmCommit->statusCode, "POST /api/v1/cvm/commit returns 200 OK");

    let resCvmPush: HttpResponse* = app->simulateRequest("POST", "/api/v1/cvm/push", "", "application/json");
    Assert::equalsInt(200, resCvmPush->statusCode, "POST /api/v1/cvm/push returns 200 OK");

    suite->addResult("test_integrated_cvm_operations", true, "", 1);

    // -------------------------------------------------------------
    // Test 7: Setup CXVM into Virtual-Linux in Thunder
    // -------------------------------------------------------------
    println("\n[Test Suite 7: Setup CXVM into Virtual-Linux in Thunder]");

    let vlSetupRes: CxvmCommandResult* = cxvm->setupThunderVirtualLinux("8.0.0");
    Assert::isTrue(vlSetupRes->success, "setupThunderVirtualLinux succeeds");
    Assert::isTrue(cxvm->virtualLinuxReady, "Virtual-Linux environment in Thunder is marked ready");
    Assert::equalsString("6.8.0-cex-thunder-virt", cxvm->virtualLinuxKernel, "Virtual-Linux kernel is 6.8.0-cex-thunder-virt");
    Assert::equalsString("/root/.cxvm", cxvm->virtualLinuxRootfs, "Virtual-Linux CXVM_DIR is /root/.cxvm");
    Assert::equalsString("factory", cxvm->defaultCexrEdition, "Default cexr runtime inside virtual-linux is factory (cexr-factory)");
    Assert::equalsString("bean", cxvm->defaultBuildEdition, "Default cexr build inside virtual-linux is bean (cexr-bean)");
    Assert::isTrue(vlSetupRes->output.find("VIRTUAL-LINUX SETUP COMPLETE [OK]") != -1, "Output confirms VIRTUAL-LINUX SETUP COMPLETE [OK]");

    let execThSetup: int = cxvm->cvmExecute("thunder", "setup", "virtual-linux");
    Assert::equalsInt(0, execThSetup, "cxvm thunder setup virtual-linux returns exit code 0");

    let resVlPost: HttpResponse* = app->simulateRequest("POST", "/api/v1/thunder/virtual-linux/setup", "{\"version\":\"8.0.0\"}", "application/json");
    Assert::equalsInt(200, resVlPost->statusCode, "POST /api/v1/thunder/virtual-linux/setup returns 200 OK");
    Assert::isTrue(resVlPost->body.find("virtual-linux") != -1, "POST /api/v1/thunder/virtual-linux/setup reports virtual-linux environment");

    let resVlGet: HttpResponse* = app->simulateRequest("GET", "/api/v1/thunder/virtual-linux", "", "application/json");
    Assert::equalsInt(200, resVlGet->statusCode, "GET /api/v1/thunder/virtual-linux returns 200 OK");
    Assert::isTrue(resVlGet->body.find("\"virtualLinuxReady\":true") != -1, "GET /api/v1/thunder/virtual-linux reports virtualLinuxReady:true");

    suite->addResult("test_setup_cxvm_into_virtual_linux_in_thunder", true, "", 1);

    // -------------------------------------------------------------
    // Test 8: Linux Distribution Subsystem (install, uninstall, setup)
    // -------------------------------------------------------------
    println("\n[Test Suite 8: Linux Distribution Subsystem (install, uninstall, setup)]");

    let ldSetupRes: CxvmCommandResult* = cxvm->setupLinuxDistro("cex-linux", "1.0.0");
    Assert::isTrue(ldSetupRes->success, "setupLinuxDistro succeeds");
    Assert::isTrue(cxvm->linuxDistroReady, "Linux distro environment is marked ready");
    Assert::equalsString("cex-linux", cxvm->linuxDistroName, "Linux distro name is cex-linux");
    Assert::equalsString("1.0.0", cxvm->linuxDistroVersion, "Linux distro version is 1.0.0");
    Assert::equalsString("6.8.0-cex-rt", cxvm->linuxDistroKernel, "Linux distro kernel is 6.8.0-cex-rt");
    Assert::equalsString("/var/lib/cxvm/distros/cex-linux", cxvm->linuxDistroRootfs, "Linux distro rootfs is /var/lib/cxvm/distros/cex-linux");
    Assert::isTrue(ldSetupRes->output.find("LINUX-DISTRO SETUP COMPLETE [OK]") != -1, "Output confirms LINUX-DISTRO SETUP COMPLETE [OK]");

    let ldInstRes: CxvmCommandResult* = cxvm->installLinuxDistro("alpine", "3.19.0");
    Assert::isTrue(ldInstRes->success, "installLinuxDistro succeeds");
    Assert::equalsString("alpine", cxvm->linuxDistroName, "Active distro name is alpine");
    Assert::isTrue(ldInstRes->output.find("LINUX-DISTRO INSTALL COMPLETE [OK]") != -1, "Output confirms LINUX-DISTRO INSTALL COMPLETE [OK]");

    let execLdSetup: int = cxvm->cvmExecute("linux-distro", "setup", "cex-linux");
    Assert::equalsInt(0, execLdSetup, "cxvm linux-distro setup cex-linux returns exit code 0");

    let execLdInstall: int = cxvm->cvmExecute("linux-distro", "install", "debian");
    Assert::equalsInt(0, execLdInstall, "cxvm linux-distro install debian returns exit code 0");

    let execLdUninstall: int = cxvm->cvmExecute("linux-distro", "uninstall", "debian");
    Assert::equalsInt(0, execLdUninstall, "cxvm linux-distro uninstall debian returns exit code 0");

    let resLdPostSetup: HttpResponse* = app->simulateRequest("POST", "/api/v1/linux-distro/setup", "{\"name\":\"cex-linux\",\"version\":\"1.0.0\"}", "application/json");
    Assert::equalsInt(200, resLdPostSetup->statusCode, "POST /api/v1/linux-distro/setup returns 200 OK");
    Assert::isTrue(resLdPostSetup->body.find("cex-linux") != -1, "POST /api/v1/linux-distro/setup reports cex-linux");

    let resLdPostInst: HttpResponse* = app->simulateRequest("POST", "/api/v1/linux-distro/install", "{\"name\":\"ubuntu\",\"version\":\"24.04\"}", "application/json");
    Assert::equalsInt(200, resLdPostInst->statusCode, "POST /api/v1/linux-distro/install returns 200 OK");
    Assert::isTrue(resLdPostInst->body.find("ubuntu") != -1, "POST /api/v1/linux-distro/install reports ubuntu");

    let resLdGetStat: HttpResponse* = app->simulateRequest("GET", "/api/v1/linux-distro/status", "", "application/json");
    Assert::equalsInt(200, resLdGetStat->statusCode, "GET /api/v1/linux-distro/status returns 200 OK");
    Assert::isTrue(resLdGetStat->body.find("ubuntu") != -1, "GET /api/v1/linux-distro/status reports active ubuntu");

    let resLdPostUninst: HttpResponse* = app->simulateRequest("POST", "/api/v1/linux-distro/uninstall", "{\"name\":\"ubuntu\"}", "application/json");
    Assert::equalsInt(200, resLdPostUninst->statusCode, "POST /api/v1/linux-distro/uninstall returns 200 OK");
    Assert::isTrue(resLdPostUninst->body.find("SUCCESS") != -1, "POST /api/v1/linux-distro/uninstall reports SUCCESS");

    suite->addResult("test_linux_distro_cli_and_api", true, "", 1);

    // -------------------------------------------------------------
    // Test 9: Toolchain Reinstallation Subsystem
    // -------------------------------------------------------------
    println("\n[Test Suite 9: Toolchain Reinstallation Subsystem]");

    let reinRes: CxvmCommandResult* = cxvm->reinstall("8.0.0");
    Assert::isTrue(reinRes->success, "reinstall succeeds");
    Assert::equalsString("8.0.0", cxvm->currentVersion, "reinstall sets currentVersion to 8.0.0");
    Assert::isTrue(reinRes->output.find("REINSTALL COMPLETE [OK]") != -1, "reinstall output confirms completion");

    let reinExec: int = cxvm->cvmExecute("reinstall", "8.0.0", "");
    Assert::equalsInt(0, reinExec, "cxvm reinstall returns 0 OK");

    let reinCexExec: int = cxvm->cvmExecute("cex", "reinstall", "8.0.0");
    Assert::equalsInt(0, reinCexExec, "cxvm cex reinstall returns 0 OK");

    let reinCliExec: int = cxvm->cvmExecute("cli", "reinstall", "8.0.0");
    Assert::equalsInt(0, reinCliExec, "cxvm cli reinstall returns 0 OK");

    let resPostRein: HttpResponse* = app->simulateRequest("POST", "/api/v1/reinstall", "{\"version\":\"8.0.0\"}", "application/json");
    Assert::equalsInt(200, resPostRein->statusCode, "POST /api/v1/reinstall returns 200 OK");
    Assert::isTrue(resPostRein->body.find("SUCCESS") != -1, "POST /api/v1/reinstall reports SUCCESS");

    suite->addResult("test_reinstall_subsystem", true, "", 1);

    println("\n");
    TestReporter::printSummary(suite);
    return suite->failCount() > 0 ? 1 : 0;
}
