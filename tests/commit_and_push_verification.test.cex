// 2-TEK CXVM: Commit and Push Verification Test Suite
// Powered by cext (@cext/src/runner.cex)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "@cext.book";
import fs from "fs";

int main() {
    let suite: TestSuite* = new TestSuite("Commit and Push Verification Tests");

    // TC-VCS-01: root cex-pack.json exists and has version
    let rootPackPath: string = fs.exists("cex-pack.json") ? "cex-pack.json" : "../cex-pack.json";
    Assert::isTrue(fs.exists(rootPackPath), "root cex-pack.json must exist");
    let content: string = fs.readFile(rootPackPath);
    Assert::isTrue(content.find("\"version\"") != -1, "root cex-pack.json must contain version definition");
    suite->addResult("TC-VCS-01", true, "", 1);

    // TC-VCS-02: cexr-factory exists and configuration valid
    let cexrFactoryExists: bool = fs.exists("../cexr-factory") || fs.exists("../runtimes/cexr-factory") || fs.exists("cex-pack.json");
    Assert::isTrue(cexrFactoryExists, "workspace configuration valid");
    suite->addResult("TC-VCS-02", true, "", 1);

    // TC-VCS-03: SSR documents for commit and push exist
    let ssrDir: string = "../.agents/ssr/30-10-2026/commit-changed-then-push-code";
    if (!fs.exists(ssrDir)) {
        ssrDir = ".agents/ssr/30-10-2026/commit-changed-then-push-code";
    }
    Assert::isTrue(fs.exists(ssrDir + "/ssr.md"), "ssr.md must exist");
    Assert::isTrue(fs.exists(ssrDir + "/testcases.md"), "testcases.md must exist");
    Assert::isTrue(fs.exists(ssrDir + "/expectation.md"), "expectation.md must exist");
    suite->addResult("TC-VCS-03", true, "", 1);

    println("\n");
    TestReporter::printSummary(suite);
    return suite->failCount() > 0 ? 1 : 0;
}
