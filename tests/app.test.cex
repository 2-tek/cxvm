// 2-TEK CXVM: Lighting MVC Application Kernel & Core Endpoints Test Suite
// Powered by cext (@cext/src/runner.cex)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "@cext.book";
import fs from "fs";
import "@/src/types.cex";
import "@/src/app.cex";

int main() {
    println("===============================================================================");
    println("       2-TEK CXVM: Lighting MVC Application Kernel & Core Endpoints           ");
    println("===============================================================================");

    TestSuite* suite = new TestSuite("CXVM App & Core Endpoints Tests");

    FactoryApp* app = new FactoryApp(CxvmConstants::defaultPort());
    app->start();
    Assert::isTrue(app->isRunning, "Factory app starts running");

    HttpResponse* resHome = app->simulateRequest("GET", "/", "", "text/html");
    Assert::equalsInt(200, resHome->statusCode, "GET / returns 200 OK");
    Assert::isTrue(resHome->body.find("2-TEK Cex Factory") != -1, "Home view contains title");

    HttpResponse* resPlatforms = app->simulateRequest("GET", "/api/v1/platforms", "", "application/json");
    Assert::equalsInt(200, resPlatforms->statusCode, "GET /api/v1/platforms returns 200 OK");
    Assert::isTrue(resPlatforms->body.find("platforms") != -1, "Platforms response includes platforms");

    HttpResponse* resVersions = app->simulateRequest("GET", "/api/v1/versions", "", "application/json");
    Assert::equalsInt(200, resVersions->statusCode, "GET /api/v1/versions returns 200 OK");
    Assert::isTrue(resVersions->body.find("versions") != -1, "Versions response includes versions");

    HttpResponse* resStatus = app->simulateRequest("GET", "/api/v1/status", "", "application/json");
    Assert::equalsInt(200, resStatus->statusCode, "GET /api/v1/status returns 200 OK");
    Assert::isTrue(resStatus->body.find("currentActiveVersion") != -1, "Status API includes currentActiveVersion");

    suite->addResult("test_app_core_endpoints", true, "", 1);

    println("\n");
    TestReporter::printSummary(suite);
    return suite->failCount() > 0 ? 1 : 0;
}
