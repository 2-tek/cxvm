#!/usr/bin/env bash
# 2-TEK CexT: Native Test & Coverage Engine CLI Dispatcher (cext / cex-test)
# Target: use C-ex for native test runner, assertions, benchmarks, and test coverage generation
# Integrated Runtime: cexr-factory
# Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)
set -e

CXVM_DIR="${CXVM_DIR:-$HOME/.cxvm}"
CEX_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CEX_HOME="${CEX_HOME:-$(cd "$CEX_BIN_DIR/.." && pwd)}"
export PATH="$CEX_HOME/bin:$PATH"
export CEX_IN_TEST_RUN=1
export CEX_LINT="${CEX_LINT:-0}"

# Resolve cexr-factory runner
FACTORY_BIN="cexr-factory"
if [ -x "$CXVM_DIR/current/bin/cexr-factory" ]; then
  FACTORY_BIN="$CXVM_DIR/current/bin/cexr-factory"
elif [ -x "$CXVM_DIR/bin/cexr-factory" ]; then
  FACTORY_BIN="$CXVM_DIR/bin/cexr-factory"
fi

if [ "$1" = "--version" ] || [ "$1" = "-v" ] || [ "$1" = "version" ]; then
  echo "==============================================================="
  echo "      2-TEK CexT: Native Test & Coverage Engine CLI            "
  echo "      Target: @cext / cex-test powered by cexr-factory         "
  echo "              (LCOV, JSON, summary report, pipeline)           "
  echo "==============================================================="
  echo "Target: use C-ex for native test runner, assertions, benchmarks, and test coverage generation (LCOV, JSON, summary report)"
  echo "Runtime: cexr-factory (integrated)"
  echo "CexT Native Testing & Coverage Subsystem Ready."
  exit 0
fi

if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "help" ]; then
  echo "==============================================================="
  echo "      2-TEK CexT: Native Test & Coverage Engine CLI            "
  echo "      Target: @cext / cex-test powered by cexr-factory         "
  echo "              (LCOV, JSON, summary report, pipeline)           "
  echo "==============================================================="
  echo "Usage: cext <command> [arguments] [options]  (alias: cex-test)"
  echo ""
  echo "Commands:"
  echo "  run <test_file.cex> [options]       Execute test file via cexr-factory"
  echo "  pipeline <test_file.cex> [options]  Execute test file via reactive pipeline runner"
  echo "  coverage <test_file.cex> [options]  Run test and generate coverage report"
  echo "  build <file.cex> [-o <out>]         Compile standalone native binary via cexp-v8"
  echo "  compile <file.cex> [-o <out>]       Compile standalone native binary via cexp-v8"
  echo "  version                             Display version & target"
  echo "  help                                Show this help message"
  exit 0
fi

# 1. Local compiled binary check
if [ -x "./dist/cext" ] && file "./dist/cext" | grep -q "ELF" 2>/dev/null; then
  exec "./dist/cext" "$@"
fi
if [ -x "./dist/cex-test" ] && file "./dist/cex-test" | grep -q "ELF" 2>/dev/null; then
  exec "./dist/cex-test" "$@"
fi

# 2. Command routing for test execution via cexr-factory
cmd="$1"
if [ "$cmd" = "run" ] || [ "$cmd" = "test" ]; then
  shift
  test_target="$1"
  shift || true
  if [ -n "$test_target" ]; then
    echo "==> [cext] Spawning isolated new test process: $FACTORY_BIN $test_target"
    "$FACTORY_BIN" "$test_target" "$@"
    rc=$?
    if [ $rc -eq 0 ]; then
      echo "[OK] [cext] Isolated test process passed: $test_target"
    fi
    exit $rc
  else
    cmd=""
  fi
fi

# Auto-discovery if no target or "." or "all"
if [ -z "$cmd" ] || [ "$cmd" = "." ] || [ "$cmd" = "all" ]; then
  found=0
  echo "==> [cext] Auto-discovering test suites (spawning each via $FACTORY_BIN)..."
  for f in test/*.test.cex tests/*.test.cex; do
    if [ -f "$f" ]; then
      found=1
      echo "==> [cext] Spawning isolated new test process: $FACTORY_BIN $f"
      "$FACTORY_BIN" "$f" || exit 1
      echo "[OK] [cext] Isolated test process passed: $f"
    fi
  done
  if [ $found -eq 0 ]; then
    echo "[CexT Error]: No test files found in test/ or tests/"
    exit 1
  fi
  exit 0
fi

# If argument is a test file directly
if [ -f "$cmd" ]; then
  test_target="$cmd"
  shift
  echo "==> [cext] Spawning isolated new test process: $FACTORY_BIN $test_target"
  "$FACTORY_BIN" "$test_target" "$@"
  rc=$?
  if [ $rc -eq 0 ]; then
    echo "[OK] [cext] Isolated test process passed: $test_target"
  fi
  exit $rc
fi

# Fallback: dispatch to cext CLI script if available
for cand in \
  "./scripts/cli.cex" \
  "./src/cli.cex" \
  "$HOME/Projects/cex/cext/scripts/cli.cex" \
  "$CXVM_DIR/packages/cext/scripts/cli.cex" \
  "$CXVM_DIR/packages/cex-test/scripts/cli.cex"; do
  if [ -f "$cand" ]; then
    exec "$FACTORY_BIN" run "$cand" "$@"
  fi
done

echo "==> [cext] Executing: $FACTORY_BIN $@"
exec "$FACTORY_BIN" "$@"
