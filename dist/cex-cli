#!/usr/bin/env bash
# 2-TEK Cex-CLI Toolchain Dispatcher
# Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), RULE_PURE_CEX_BIN

CXVM_DIR="${CXVM_DIR:-$HOME/.cxvm}"

if [ "$1" = "reinstall" ]; then
  shift
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [ -x "$SCRIPT_DIR/cxvm" ]; then
    exec "$SCRIPT_DIR/cxvm" reinstall "$@"
  elif [ -x "$CXVM_DIR/bin/cxvm" ]; then
    exec "$CXVM_DIR/bin/cxvm" reinstall "$@"
  elif command -v cxvm >/dev/null 2>&1; then
    exec cxvm reinstall "$@"
  fi
fi

# Resolve cexr runner
CEXR_BIN="cexr"
if [ -x "$CXVM_DIR/current/bin/cexr" ]; then
  CEXR_BIN="$CXVM_DIR/current/bin/cexr"
elif [ -x "$CXVM_DIR/bin/cexr" ]; then
  CEXR_BIN="$CXVM_DIR/bin/cexr"
fi

# Dynamically walk up to find workspace root (Rule 72)
WORKSPACE_ROOT="$(pwd)"
CURR="$(pwd)"
while [ -n "$CURR" ] && [ "$CURR" != "/" ]; do
  if [ -d "$CURR/deps" ] || [ -f "$CURR/PROJECT_TARGET.md" ]; then
    WORKSPACE_ROOT="$CURR"
    break
  fi
  CURR="$(dirname "$CURR")"
done

# Locate cex-cli native .cex entrypoint
CEX_CLI_SRC=""
for cand in \
  "$WORKSPACE_ROOT/deps/cex-cli/src/index.cex" \
  "$WORKSPACE_ROOT/deps/cex-cli/src/cli.cex" \
  "$(pwd)/deps/cex-cli/src/index.cex" \
  "$(pwd)/../deps/cex-cli/src/index.cex" \
  "$(pwd)/.cex_boxes/cex-cli/src/index.cex" \
  "$(pwd)/.cex_boxes/cex-cli/src/cli.cex" \
  "$(pwd)/bin/cex-cli.cex"; do
  if [ -f "$cand" ]; then
    CEX_CLI_SRC="$cand"
    break
  fi
done

if [ -n "$CEX_CLI_SRC" ]; then
  exec "$CEXR_BIN" run "$CEX_CLI_SRC" "$@"
fi

echo "[ERROR] cex-cli.cex not found"
exit 1
