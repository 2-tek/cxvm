#!/usr/bin/env bash
# 2-TEK Cex-CLI Toolchain Dispatcher
# Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), RULE_PURE_CEX_BIN

CXVM_DIR="${CXVM_DIR:-$HOME/.cxvm}"

# 1. Prefer compiled native binary
if [ -x "$CXVM_DIR/bin/cex-cli" ]; then
  exec "$CXVM_DIR/bin/cex-cli" "$@"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for b_cand in \
  "$SCRIPT_DIR/../cex-cli/bin/cex-cli" \
  "$SCRIPT_DIR/../../cex-cli/bin/cex-cli" \
  "$(pwd)/../cex-cli/bin/cex-cli" \
  "$(pwd)/bin/cex-cli"; do
  if [ -x "$b_cand" ]; then
    exec "$b_cand" "$@"
  fi
done

# 2. Resolve cexr runner
CEXR_BIN="cexr"
if [ -x "$CXVM_DIR/current/bin/cexr" ]; then
  CEXR_BIN="$CXVM_DIR/current/bin/cexr"
elif [ -x "$CXVM_DIR/bin/cexr" ]; then
  CEXR_BIN="$CXVM_DIR/bin/cexr"
fi

# 3. Locate cex-cli native .cex entrypoint
CEX_CLI_SRC=""
for cand in \
  "$CXVM_DIR/packages/cex-cli/bin/cex-cli.cex" \
  "$CXVM_DIR/packages/cex-cli/src/index.cex" \
  "$SCRIPT_DIR/../cex-cli/src/index.cex" \
  "$SCRIPT_DIR/../../cex-cli/src/index.cex" \
  "$(pwd)/packages/cex-cli/bin/cex-cli.cex" \
  "$(pwd)/packages/cex-cli/src/index.cex" \
  "$(pwd)/../packages/cex-cli/bin/cex-cli.cex" \
  "$(pwd)/../packages/cex-cli/src/index.cex" \
  "$(pwd)/../cex-cli/src/index.cex" \
  "$(pwd)/.cex_boxes/cex-cli/src/index.cex"; do
  if [ -f "$cand" ]; then
    CEX_CLI_SRC="$cand"
    break
  fi
done

if [ -n "$CEX_CLI_SRC" ]; then
  exec "$CEXR_BIN" "$CEX_CLI_SRC" "$@"
fi

echo "[ERROR] cex-cli binary or source entrypoint not found"
exit 1
