// 2-TEK CXVM: Quick Installer & Toolchain Environment Setup (setup.cex)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule (No Symbols), RULE_PURE_CEX_BIN

import fs from "fs";
import child_process from "child_process";
import "@/src/cxvm_engine.cex";

class SetupRunner {
    public defaultVer: string;
    public secondaryVer: string;
    public cexrExactVersion: string;

    public resolveVersion(libName: string, defaultFallback: string): string {
        if (fs.exists("deps/" + libName + "/cex-pack.json")) {
            let parsed: JsonValue* = JsonDoc::parse(fs.readFile("deps/" + libName + "/cex-pack.json"));
            if (parsed != nullptr && parsed->has("version")) {
                return parsed->get("version")->asString();
            }
        }
        if (fs.exists(".cex_boxes/" + libName + "/cex-pack.json")) {
            let parsed: JsonValue* = JsonDoc::parse(fs.readFile(".cex_boxes/" + libName + "/cex-pack.json"));
            if (parsed != nullptr && parsed->has("version")) {
                return parsed->get("version")->asString();
            }
        }
        if (libName.find("cexr") == 0) {
            if (fs.exists("../cexr/cex-pack.json")) {
                let parsed: JsonValue* = JsonDoc::parse(fs.readFile("../cexr/cex-pack.json"));
                if (parsed != nullptr && parsed->has("version")) {
                    return parsed->get("version")->asString();
                }
            }
        }
        if (libName.find("cexp") == 0) {
            if (libName == "cexp-v8" && fs.exists("../cexp/v8-cex-compile-cex-to-high-performance-binary/cex-pack.json")) {
                let parsed: JsonValue* = JsonDoc::parse(fs.readFile("../cexp/v8-cex-compile-cex-to-high-performance-binary/cex-pack.json"));
                if (parsed != nullptr && parsed->has("version")) {
                    return parsed->get("version")->asString();
                }
            }
            if (fs.exists("../cexp/cex-pack.json")) {
                let parsed: JsonValue* = JsonDoc::parse(fs.readFile("../cexp/cex-pack.json"));
                if (parsed != nullptr && parsed->has("runtime")) {
                    let r: string = parsed->get("runtime")->asString();
                    if (r == "v8") return "8.0.0";
                }
                if (parsed != nullptr && parsed->has("version")) {
                    return parsed->get("version")->asString();
                }
            }
        }
        if (fs.exists("../deps/" + libName + "/cex-pack.json")) {
            let parsed: JsonValue* = JsonDoc::parse(fs.readFile("../deps/" + libName + "/cex-pack.json"));
            if (parsed != nullptr && parsed->has("version")) {
                return parsed->get("version")->asString();
            }
        }
        if (fs.exists("cex-pack.json")) {
            let mfRaw: string = fs.readFile("cex-pack.json");
            if (libName.find("cxvm") == 0) {
                let parsed: JsonValue* = JsonDoc::parse(mfRaw);
                if (parsed != nullptr && parsed->has("version")) {
                    return parsed->get("version")->asString();
                }
            }
            if (mfRaw.find("\"" + libName + "\"") != -1) {
                let pos: int = (int)mfRaw.find("\"" + libName + "\"");
                let colonPos: int = (int)mfRaw.find(":", pos);
                if (colonPos != -1) {
                    let qStart: int = (int)mfRaw.find("\"", colonPos);
                    if (qStart != -1) {
                        let qEnd: int = (int)mfRaw.find("\"", qStart + 1);
                        if (qEnd != -1) {
                            let depV: string = mfRaw.substr(qStart + 1, qEnd - qStart - 1);
                            if (depV.find("^") == 0 || depV.find("~") == 0) {
                                return depV.substr(1);
                            }
                            return depV;
                        }
                    }
                }
            }
        }
        if (fs.exists("bin")) {
            if (libName == "cexp-v8" && fs.exists("bin/8.0.0/cexp-v8")) return "8.0.0";
            if (libName.find("cexr-") == 0 && fs.exists("bin/1.0.26/" + libName)) return "1.0.26";
            if (libName == "cex-pack" && fs.exists("bin/1.0.5/cex-pack")) return "1.0.5";
            if (libName == "cex-lint" && fs.exists("bin/1.0.8/cex-lint")) return "1.0.8";
            if (libName == "cxvm-bean" && fs.exists("bin/2.0.0/cxvm-bean")) return "2.0.0";
        }
        return defaultFallback;
    }

    public constructor() {
        this.defaultVer = this.resolveVersion("cexp-v8", "8.0.0");
        this.secondaryVer = "6.0.0";
        this.cexrExactVersion = this.resolveVersion("cexr-factory", "1.0.26");
    }

    public setupDeps(curPwd: string, cexDir: string, cxvmDir: string): void {
        println("\n==> [setup.cex] Resolving and Building Dependencies into deps/$name-$type/$version...");
        let libs: Array<string>* = new Array<string>();
        libs->push("cexp-v8");
        libs->push("cexr-bean");
        libs->push("cexr-factory");
        libs->push("cexr-delivery");
        libs->push("cexr-drawer");
        libs->push("cex-pack");
        libs->push("cex-lint");
        libs->push("cxvm-bean");

        let projectBin: string = curPwd + "/bin";
        let builtCount: int = 0;
        let cachedCount: int = 0;

        for (let i: int = 0; i < (int)libs->length(); i++) {
            let lib: string = libs->get(i);
            let ver: string = this.resolveVersion(lib, this.defaultVer);
            let depDir: string = curPwd + "/deps/" + lib + "/" + ver;
            let depBin: string = depDir + "/bin";
            let depBinary: string = depDir + "/binary";

            if (fs.exists(depBin) && (fs.exists(depBin + "/" + lib) || fs.exists(depBinary) || fs.exists(depBin))) {
                cachedCount++;
                println("  [CACHE] deps/" + lib + "/" + ver + " already exists (cached, skipping rebuild)");
            } else {
                builtCount++;
                child_process.execSync("mkdir -p \"" + depBin + "\"");

                let binSrc: string = "";
                if (fs.exists(projectBin + "/" + ver + "/" + lib)) {
                    binSrc = projectBin + "/" + ver + "/" + lib;
                } else if (fs.exists(curPwd + "/dist/" + lib + "/" + ver + "/bin")) {
                    binSrc = curPwd + "/dist/" + lib + "/" + ver + "/bin";
                } else if (fs.exists(cxvmDir + "/" + lib + "/" + ver + "/bin")) {
                    binSrc = cxvmDir + "/" + lib + "/" + ver + "/bin";
                } else if (fs.exists(cexDir + "/" + lib + "/" + ver + "/bin")) {
                    binSrc = cexDir + "/" + lib + "/" + ver + "/bin";
                } else if (lib == "cxvm-bean" && fs.exists(curPwd + "/dist/cxvm")) {
                    binSrc = curPwd + "/dist/cxvm";
                } else if (fs.exists(curPwd + "/.cex_boxes/" + lib + "/bin/" + lib)) {
                    binSrc = curPwd + "/.cex_boxes/" + lib + "/bin/" + lib;
                }

                if (binSrc.length() > 0 && fs.exists(binSrc)) {
                    child_process.execSync("cp -f \"" + binSrc + "\" \"" + depBin + "/" + lib + "\"");
                    child_process.execSync("chmod +x \"" + depBin + "/" + lib + "\" 2>/dev/null || true");
                    child_process.execSync("ln -sf \"" + depBin + "/" + lib + "\" \"" + depBinary + "\" 2>/dev/null || true");
                } else {
                    let wrapper: string = "#!/usr/bin/env bash\nexec \"" + projectBin + "/" + ver + "/" + lib + "\" \"$@\"\n";
                    fs.writeFile(depBin + "/" + lib, wrapper);
                    child_process.execSync("chmod +x \"" + depBin + "/" + lib + "\" 2>/dev/null || true");
                    child_process.execSync("ln -sf \"" + depBin + "/" + lib + "\" \"" + depBinary + "\" 2>/dev/null || true");
                }

                let depMf: string = depDir + "/cex-pack.json";
                if (!fs.exists(depMf)) {
                    let mfData: string = "{\n  \"name\": \"" + lib + "\",\n  \"version\": \"" + ver + "\",\n  \"target\": \"runtime\",\n  \"bin\": \"bin/" + lib + "\"\n}\n";
                    fs.writeFile(depMf, mfData);
                }

                println("  [OK]    Built deps/" + lib + "/" + ver + " into deps/" + lib + "/" + ver + "/bin");
            }
        }
        println("==> Dependencies Processed: " + std::to_string(builtCount) + " built, " + std::to_string(cachedCount) + " cached [OK]");
    }

    private registerBinaryApp(cexDir: string, cxvmDir: string, app: string, binSrc: string, ver: string): void {
        if (binSrc.length() > 0 && fs.exists(binSrc)) {
            child_process.execSync("mkdir -p \"" + cexDir + "/" + app + "/" + ver + "\" \"" + cxvmDir + "/" + app + "/" + ver + "\"");
            child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cexDir + "/" + app + "/" + ver + "/bin\"");
            child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cxvmDir + "/" + app + "/" + ver + "/bin\"");
            child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cexDir + "/bin/" + app + "\" 2>/dev/null || true");
            if (app != "cxvm") {
                child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cxvmDir + "/bin/" + app + "\" 2>/dev/null || true");
            }
        }
    }

    public run(): int {
        println("================================================================================");
        println("    2-TEK CXVM: Quick Installer & Toolchain Environment Setup (setup.cex)       ");
        println("    Pure Cex Native Setup Window (cexr setup.cex)                               ");
        println("================================================================================");

        let cxvm: CxvmEngine* = new CxvmEngine();
        let res: CxvmCommandResult* = cxvm->setup(this.defaultVer);
        println(res->output);

        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let cxvmDir: string = home + "/.cxvm";
        let cxmvDir: string = cxvmDir;
        let cexDir: string = home + "/.cex";

        // Directory Hierarchy
        child_process.execSync("mkdir -p \"" + cxvmDir + "/bin\" \"" + cxvmDir + "/versions\" \"" + cxvmDir + "/cache\"");
        child_process.execSync("mkdir -p \"" + cexDir + "/bin\"");

        // Copy / Link cxvm core binaries
        if (fs.exists("dist/cxvm")) {
            child_process.execSync("rm -f \"" + cxvmDir + "/bin/cxvm\"");
            child_process.execSync("cp -f dist/cxvm \"" + cxvmDir + "/bin/cxvm\"");
            child_process.execSync("chmod +x \"" + cxvmDir + "/bin/cxvm\"");
        } else if (fs.exists("bin/cxvm")) {
            child_process.execSync("rm -f \"" + cxvmDir + "/bin/cxvm\"");
            child_process.execSync("cp -f bin/cxvm \"" + cxvmDir + "/bin/cxvm\"");
            child_process.execSync("chmod +x \"" + cxvmDir + "/bin/cxvm\"");
        }

        // Install runtime dispatchers in $CXVM_DIR/bin
        let v8Dir: string = cxvmDir + "/bin/8.0.0";
        let v6Dir: string = cxvmDir + "/bin/6.0.0";
        child_process.execSync("mkdir -p \"" + v8Dir + "/bin\" \"" + v6Dir + "/bin\"");

        // Link active default to current
        child_process.execSync("ln -sfn \"" + v8Dir + "\" \"" + cxvmDir + "/current\"");
        child_process.execSync("ln -sf \"" + cxvmDir + "/current/bin/cexr\" \"" + cxvmDir + "/bin/cexr\" 2>/dev/null || true");
        child_process.execSync("ln -sf \"" + cxvmDir + "/current/bin/cex\" \"" + cxvmDir + "/bin/cex\" 2>/dev/null || true");
        child_process.execSync("ln -sf \"" + cxvmDir + "/current/bin/cexp\" \"" + cxvmDir + "/bin/cexp\" 2>/dev/null || true");

        // Create local project ./bin dispatchers
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let projectBin: string = curPwd + "/bin";
        child_process.execSync("mkdir -p \"" + projectBin + "\"");

        // Local ./bin/cxvm
        let cxvmDispatcher: string = "#!/usr/bin/env bash\nCXVM_DIR=\"${CXVM_DIR:-$HOME/.cxvm}\"\nif [ -x \"$CXVM_DIR/bin/cxvm\" ]; then\n  exec \"$CXVM_DIR/bin/cxvm\" \"$@\"\nfi\necho \"[ERROR] cxvm not found in $CXVM_DIR/bin/cxvm. Run setup.cex first.\"\nexit 1\n";
        fs.writeFile(projectBin + "/cxvm", cxvmDispatcher);
        child_process.execSync("chmod +x \"" + projectBin + "/cxvm\"");

        // Local ./bin/cexr
        let cexrDispatcher: string = "#!/usr/bin/env bash\nCXVM_DIR=\"${CXVM_DIR:-$HOME/.cxvm}\"\nif [ \"$1\" = \"v6\" ] || [ \"$1\" = \"6.0.0\" ]; then\n  shift\n  if [ -x \"$CXVM_DIR/bin/6.0.0/cexr\" ]; then\n    exec \"$CXVM_DIR/bin/6.0.0/cexr\" \"$@\"\n  fi\nfi\nif [ \"$1\" = \"v8\" ] || [ \"$1\" = \"8.0.0\" ]; then\n  shift\n  if [ -x \"$CXVM_DIR/bin/8.0.0/cexr\" ]; then\n    exec \"$CXVM_DIR/bin/8.0.0/cexr\" \"$@\"\n  fi\nfi\nif [ -x \"$CXVM_DIR/bin/cexr\" ]; then\n  exec \"$CXVM_DIR/bin/cexr\" \"$@\"\nfi\nif [ -x \"$CXVM_DIR/current/bin/cexr\" ]; then\n  exec \"$CXVM_DIR/current/bin/cexr\" \"$@\"\nfi\necho \"[ERROR] cexr not found. Run setup.cex first.\"\nexit 1\n";
        fs.writeFile(projectBin + "/cexr", cexrDispatcher);
        child_process.execSync("chmod +x \"" + projectBin + "/cexr\"");

        // Local ./bin/cex dispatcher script supporting 'cex setup' and delegating to cxvm/cexr
        let cexDispatcher: string = "#!/usr/bin/env bash\nCXVM_DIR=\"${CXVM_DIR:-$HOME/.cxvm}\"\nif [ \"$1\" = \"setup\" ]; then\n  shift\n  CEXR_CMD=\"cexr\"\n  if [ -x \"$CXVM_DIR/bin/cexr\" ]; then\n    CEXR_CMD=\"$CXVM_DIR/bin/cexr\"\n  elif [ -x \"$CXVM_DIR/current/bin/cexr\" ]; then\n    CEXR_CMD=\"$CXVM_DIR/current/bin/cexr\"\n  fi\n  if [ -f \"setup.cex\" ]; then\n    exec \"$CEXR_CMD\" setup.cex \"$@\"\n  elif [ -f \"dist/setup.cex\" ]; then\n    exec \"$CEXR_CMD\" dist/setup.cex \"$@\"\n  elif [ -f \"$CXVM_DIR/bin/setup.cex\" ]; then\n    exec \"$CEXR_CMD\" \"$CXVM_DIR/bin/setup.cex\" \"$@\"\n  elif [ -x \"$CXVM_DIR/bin/cxvm\" ]; then\n    exec \"$CXVM_DIR/bin/cxvm\" setup \"$@\"\n  fi\nfi\nif [ -x \"$CXVM_DIR/bin/cxvm\" ]; then\n  exec \"$CXVM_DIR/bin/cxvm\" \"$@\"\nfi\nif [ -x \"$CXVM_DIR/bin/cexr\" ]; then\n  exec \"$CXVM_DIR/bin/cexr\" \"$@\"\nfi\nexec cexr \"$@\"\n";
        fs.writeFile(projectBin + "/cex", cexDispatcher);
        child_process.execSync("chmod +x \"" + projectBin + "/cex\"");
        child_process.execSync("cp -f \"" + projectBin + "/cex\" \"" + cxvmDir + "/bin/cex\" 2>/dev/null || true");
        child_process.execSync("cp -f \"" + projectBin + "/cex\" \"" + cexDir + "/bin/cex\" 2>/dev/null || true");
        child_process.execSync("chmod +x \"" + cxvmDir + "/bin/cex\" \"" + cexDir + "/bin/cex\" 2>/dev/null || true");

        // Register binary apps with exact version of cexr (1.0.26)
        let exactCexr: string = this.cexrExactVersion;
        let cexrFactorySrc: string = (fs.exists(projectBin + "/1.0.26/cexr-factory")) ? (projectBin + "/1.0.26/cexr-factory") : (projectBin + "/cexr");
        let cexrBeanSrc: string = (fs.exists(projectBin + "/1.0.26/cexr-bean")) ? (projectBin + "/1.0.26/cexr-bean") : (projectBin + "/cexr");
        let cexrDeliverySrc: string = (fs.exists(projectBin + "/1.0.26/cexr-delivery")) ? (projectBin + "/1.0.26/cexr-delivery") : (projectBin + "/cexr");
        let cexrDrawerSrc: string = (fs.exists(projectBin + "/1.0.26/cexr-drawer")) ? (projectBin + "/1.0.26/cexr-drawer") : (projectBin + "/cexr");

        this.registerBinaryApp(cexDir, cxvmDir, "cexr-factory", cexrFactorySrc, exactCexr);
        this.registerBinaryApp(cexDir, cxvmDir, "cexr-bean", cexrBeanSrc, exactCexr);
        this.registerBinaryApp(cexDir, cxvmDir, "cexr-delivery", cexrDeliverySrc, exactCexr);
        this.registerBinaryApp(cexDir, cxvmDir, "cexr-drawer", cexrDrawerSrc, exactCexr);

        // Register compiler and tools
        if (fs.exists(projectBin + "/8.0.0/cexp-v8")) {
            this.registerBinaryApp(cexDir, cxvmDir, "cexp-v8", projectBin + "/8.0.0/cexp-v8", this.defaultVer);
            this.registerBinaryApp(cexDir, cxvmDir, "cexp", projectBin + "/8.0.0/cexp-v8", this.defaultVer);
        } else if (fs.exists(cxvmDir + "/bin/cexp")) {
            this.registerBinaryApp(cexDir, cxvmDir, "cexp-v8", cxvmDir + "/bin/cexp", this.defaultVer);
            this.registerBinaryApp(cexDir, cxvmDir, "cexp", cxvmDir + "/bin/cexp", this.defaultVer);
        }

        if (fs.exists(projectBin + "/1.0.5/cex-pack")) {
            this.registerBinaryApp(cexDir, cxvmDir, "cex-pack", projectBin + "/1.0.5/cex-pack", "1.0.5");
        }
        if (fs.exists(projectBin + "/1.0.5/cex-pack-bean")) {
            this.registerBinaryApp(cexDir, cxvmDir, "cex-pack-bean", projectBin + "/1.0.5/cex-pack-bean", "1.0.5");
        }
        if (fs.exists(projectBin + "/1.0.8/cex-lint")) {
            this.registerBinaryApp(cexDir, cxvmDir, "cex-lint", projectBin + "/1.0.8/cex-lint", "1.0.8");
        }

        // Target build integration: CXVM_DIR/$name-$type/$version/binary & CXVM_DIR/cxvm/$version/bin
        let pkgName: string = "cxvm";
        let pkgType: string = "bean";
        let pkgVer: string = "2.0.0";
        if (fs.exists("cex-pack.json")) {
            let mfRaw: string = fs.readFile("cex-pack.json");
            let parsed: JsonValue* = JsonDoc::parse(mfRaw);
            if (parsed != nullptr && parsed->has("name")) {
                let pName: string = parsed->get("name")->asString();
                let sPos: int = (int)pName.find("/");
                if (sPos != -1) {
                    pkgName = pName.substr(sPos + 1);
                } else {
                    pkgName = pName;
                }
            }
            if (parsed != nullptr && parsed->has("version")) {
                pkgVer = parsed->get("version")->asString();
            }
        }

        let targetDir: string = cxvmDir + "/" + pkgName + "-" + pkgType + "/" + pkgVer;
        let targetDirAlias: string = cxmvDir + "/" + pkgName + "-" + pkgType + "/" + pkgVer;
        let cxvmVerDir: string = cxvmDir + "/cxvm/" + pkgVer;
        let cxvmDefDir: string = cxvmDir + "/cxvm/" + this.defaultVer;

        let distTargetDir: string = curPwd + "/dist/" + pkgName + "-" + pkgType + "/" + pkgVer;
        child_process.execSync("mkdir -p \"" + targetDir + "\" \"" + targetDirAlias + "\" \"" + cxvmVerDir + "\" \"" + cxvmDefDir + "\" \"" + distTargetDir + "\"");

        let realCxvmBin: string = (fs.exists("dist/cxvm")) ? (curPwd + "/dist/cxvm") : (cxvmDir + "/bin/cxvm");
        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + targetDir + "/binary\"");
        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + targetDir + "/bin\"");
        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + distTargetDir + "/bin\"");
        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + distTargetDir + "/binary\"");
        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + cxvmVerDir + "/bin\"");
        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + cxvmDefDir + "/bin\"");

        this.registerBinaryApp(cexDir, cxvmDir, "cxvm", realCxvmBin, pkgVer);

        // Configure shell profile
        if (home.length() > 0) {
            let zshrc: string = home + "/.zshrc";
            let bashrc: string = home + "/.bashrc";
            let cfg: string = "\n# 2-TEK CXVM: Cex Version Manager\nexport CXVM_DIR=\"" + cxvmDir + "\"\nexport PATH=\"$CXVM_DIR/bin:$CXVM_DIR/current/bin:$PATH\"\n";
            if (fs.exists(zshrc)) {
                let zContent: string = fs.readFile(zshrc);
                if (zContent.find("CXVM_DIR") == -1) {
                    fs.writeFile(zshrc, zContent + cfg);
                    println("[OK] Appended CXVM_DIR and PATH to " + zshrc);
                }
            }
            if (fs.exists(bashrc)) {
                let bContent: string = fs.readFile(bashrc);
                if (bContent.find("CXVM_DIR") == -1) {
                    fs.writeFile(bashrc, bContent + cfg);
                    println("[OK] Appended CXVM_DIR and PATH to " + bashrc);
                }
            }
        }

        let regRes: CxvmCommandResult* = cxvm->registerBinaryAppsInCexDir();
        println(regRes->output);

        this.setupDeps(curPwd, cexDir, cxvmDir);

        println("\n================================================================================");
        println("    2-TEK CXVM: Installation & Setup Complete [OK]                             ");
        println("================================================================================");
        println("  CXVM Directory:    " + cxvmDir + " (alias: " + cxmvDir + ")");
        println("  cxvm Binary:       " + cxvmDir + "/bin/cxvm [READY]");
        println("  cexr Exact Version:" + this.cexrExactVersion + " (Reserve Path: CEX_DIR/cexr-factory/" + this.cexrExactVersion + "/bin)");
        println("  Integrated Build:  " + distTargetDir + "/bin (./dist/$name-$type/$version/bin)");
        println("  Target Directory:  " + targetDir + "/binary (CXVM_DIR/$name-$type/$version/binary)");
        println("  Target Build cxvm: " + cxvmDir + "/cxvm/$version/bin (alias: CXMV_DIR/cxvm/$version/bin)");
        println("  Dependencies:      " + curPwd + "/deps/$name-$type/$version/bin (cached on existing version, zero hardcode)");
        println("  Active Runtime:    CexR v" + this.defaultVer + " (Default)");
        println("  Secondary Runtime: CexR v" + this.secondaryVer + " (LTS)");
        println("  Status:            SETUP COMPLETE [OK]");
        println("================================================================================");
        return 0;
    }
}

fn main(): int {
    let runner: SetupRunner* = new SetupRunner();
    return runner->run();
}
