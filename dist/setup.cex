// 2-TEK CXVM: Quick Installer & Toolchain Environment Setup (setup.cex)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule (No Symbols), RULE_PURE_CEX_BIN

import fs from "fs";
import child_process from "child_process";
import "@/src/cxvm_engine.cex";

class SetupRunner {
    public defaultVer: string;
    public secondaryVer: string;
    public cexrExactVersion: string;

    public resolveVersion(libName: string, defaultFallback: string): string {
        if (libName == "cexp-v8" || libName == "cexp") return "8.0.0";
        if (libName.find("cexr-") == 0 || libName == "cexr") return "1.0.26";
        if (libName == "cex-pack" || libName == "cex-pack-bean") return "1.0.5";
        if (libName == "cex-lint") return "1.0.8";
        if (libName == "cext" || libName == "cex-test") return "1.0.14";
        if (libName == "javis" || libName == "java") return "1.0.0";
        if (libName == "vision") return "2.0.0";
        if (libName == "ultron") return "1.0.0";
        if (libName.find("cxvm") == 0) return "2.0.0";
        return defaultFallback;
    }

    public setupJavis(subArg: string): int {
        let cxvm: CxvmEngine* = new CxvmEngine();
        return cxvm->setupJavis(subArg);
    }

    public constructor() {
        this.defaultVer = this.resolveVersion("cexp-v8", "8.0.0");
        this.secondaryVer = "6.0.0";
        this.cexrExactVersion = this.resolveVersion("cexr-factory", "1.0.26");
    }

    public setupDeps(curPwd: string, cexDir: string, cxvmDir: string): void {
        println("\n==> [setup.cex] Resolving and Building Dependencies into deps/$name-$type/$version...");
        let libs: Array<string>* = new Array<string>();
        libs->push("cexp-v8");
        libs->push("cexr-bean");
        libs->push("cexr-factory");
        libs->push("cexr-delivery");
        libs->push("cexr-drawer");
        libs->push("cex-pack");
        libs->push("cex-lint");
        libs->push("cext");
        libs->push("cxvm-bean");
        libs->push("javis");

        let builtCount: int = 0;
        let cachedCount: int = 0;

        for (let i: int = 0; i < (int)libs->length(); i++) {
            let lib: string = libs->get(i);
            let ver: string = this.resolveVersion(lib, this.defaultVer);
            let depDir: string = curPwd + "/deps/" + lib + "/" + ver;
            let depBin: string = depDir + "/bin";

            let isCxvmBean: bool = (lib == "cxvm-bean");
            if (!isCxvmBean && fs.exists(depBin) && (fs.exists(depBin + "/" + lib) || fs.exists(depBin))) {
                cachedCount++;
                println("  [CACHE] deps/" + lib + "/" + ver + " already exists (cached, skipping rebuild)");
            } else {
                builtCount++;
                child_process.execSync("mkdir -p \"" + depBin + "\"");

                let binSrc: string = "";
                if (fs.exists(curPwd + "/dist/" + lib + "/" + ver + "/bin")) {
                    binSrc = curPwd + "/dist/" + lib + "/" + ver + "/bin";
                } else if (fs.exists(curPwd + "/cxvm/dist/" + lib + "/" + ver + "/bin")) {
                    binSrc = curPwd + "/cxvm/dist/" + lib + "/" + ver + "/bin";
                } else if (fs.exists(cxvmDir + "/" + lib + "/" + ver + "/bin")) {
                    binSrc = cxvmDir + "/" + lib + "/" + ver + "/bin";
                } else if (fs.exists(cexDir + "/" + lib + "/" + ver + "/bin")) {
                    binSrc = cexDir + "/" + lib + "/" + ver + "/bin";
                } else if (lib == "cxvm-bean" && (fs.exists(curPwd + "/dist/cxvm") || fs.exists(curPwd + "/cxvm/dist/cxvm"))) {
                    binSrc = fs.exists(curPwd + "/dist/cxvm") ? (curPwd + "/dist/cxvm") : (curPwd + "/cxvm/dist/cxvm");
                } else if (fs.exists(curPwd + "/.cex_boxes/" + lib + "/bin/" + lib)) {
                    binSrc = curPwd + "/.cex_boxes/" + lib + "/bin/" + lib;
                }

                if (binSrc.length() > 0 && fs.exists(binSrc)) {
                    child_process.execSync("cp -f \"" + binSrc + "\" \"" + depBin + "/" + lib + "\"");
                    child_process.execSync("chmod +x \"" + depBin + "/" + lib + "\" 2>/dev/null || true");
                    if (isCxvmBean) {
                        child_process.execSync("cp -f \"" + binSrc + "\" \"" + depBin + "/cxvm\" 2>/dev/null || true");
                        child_process.execSync("chmod +x \"" + depBin + "/cxvm\" 2>/dev/null || true");
                    }
                } else {
                    let wrapper: string = "#!/usr/bin/env bash\nexec \"" + curPwd + "/dist/" + lib + "/" + ver + "/bin\" \"$@\"\n";
                    fs.writeFile(depBin + "/" + lib, wrapper);
                    child_process.execSync("chmod +x \"" + depBin + "/" + lib + "\" 2>/dev/null || true");
                }

                let depMf: string = depDir + "/cex-pack.json";
                if (!fs.exists(depMf)) {
                    let mfData: string = "{\n  \"name\": \"" + lib + "\",\n  \"version\": \"" + ver + "\",\n  \"target\": \"runtime\",\n  \"bin\": \"bin/" + lib + "\"\n}\n";
                    fs.writeFile(depMf, mfData);
                }

                println("  [OK]    Built deps/" + lib + "/" + ver + " into deps/" + lib + "/" + ver + "/bin");
            }
        }
        println("==> Dependencies Processed: " + std::to_string(builtCount) + " built, " + std::to_string(cachedCount) + " cached [OK]");
    }

    private registerBinaryApp(cexDir: string, cxvmDir: string, app: string, binSrc: string, ver: string): void {
        if (binSrc.length() > 0 && fs.exists(binSrc)) {
            child_process.execSync("mkdir -p \"" + cexDir + "/" + app + "/" + ver + "\" \"" + cxvmDir + "/" + app + "/" + ver + "\"");
            child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cexDir + "/" + app + "/" + ver + "/bin\"");
            child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cxvmDir + "/" + app + "/" + ver + "/bin\"");
            child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cexDir + "/bin/" + app + "\" 2>/dev/null || true");
            if (app != "cxvm") {
                child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cxvmDir + "/bin/" + app + "\" 2>/dev/null || true");
            }
        }
    }

    public run(): int {
        println("================================================================================");
        println("    2-TEK CXVM: Quick Installer & Toolchain Environment Setup (setup.cex)       ");
        println("    Pure Cex Native Setup Window (cexr setup.cex)                               ");
        println("================================================================================");

        let cxvm: CxvmEngine* = new CxvmEngine();
        let res: CxvmCommandResult* = cxvm->setup(this.defaultVer);
        println(res->output);

        let home: string = child_process.execSync("printf \"%s\" \"$HOME\"");
        let curPwd: string = child_process.execSync("pwd | tr -d '\\n'");
        let cxvmDir: string = home + "/.cxvm";
        let cxmvDir: string = cxvmDir;
        let cexDir: string = home + "/.cex";

        // Directory Hierarchy
        child_process.execSync("mkdir -p \"" + cxvmDir + "/bin\" \"" + cxvmDir + "/versions\" \"" + cxvmDir + "/cache\"");
        child_process.execSync("mkdir -p \"" + cexDir + "/bin\"");

        // Rebuild and install latest native machine binary from source (src/index.cex)
        let srcIndex: string = "";
        if (fs.exists(curPwd + "/src/index.cex")) {
            srcIndex = curPwd + "/src/index.cex";
        } else if (fs.exists(curPwd + "/cxvm/src/index.cex")) {
            srcIndex = curPwd + "/cxvm/src/index.cex";
        } else if (fs.exists("src/index.cex")) {
            srcIndex = "src/index.cex";
        } else if (fs.exists("cxvm/src/index.cex")) {
            srcIndex = "cxvm/src/index.cex";
        }

        let cexpBin: string = "";
        if (fs.exists(curPwd + "/dist/cexp-v8/8.0.0/bin")) {
            cexpBin = curPwd + "/dist/cexp-v8/8.0.0/bin";
        } else if (fs.exists(curPwd + "/cxvm/dist/cexp-v8/8.0.0/bin")) {
            cexpBin = curPwd + "/cxvm/dist/cexp-v8/8.0.0/bin";
        } else if (fs.exists(cxvmDir + "/bin/cexp")) {
            cexpBin = cxvmDir + "/bin/cexp";
        } else if (fs.exists(cexDir + "/bin/cexp")) {
            cexpBin = cexDir + "/bin/cexp";
        } else if (fs.exists(cexDir + "/bin/8.0.0/cexp")) {
            cexpBin = cexDir + "/bin/8.0.0/cexp";
        } else {
            cexpBin = "cexp";
        }

        let nativeDistBin: string = curPwd + "/dist/cxvm";
        if (srcIndex.length() > 0 && fs.exists(srcIndex)) {
            println("\n==> [setup.cex] Rebuilding latest native cxvm binary from source: " + srcIndex);
            child_process.execSync("mkdir -p \"" + curPwd + "/dist\"");
            try {
                child_process.execSync("CEX_LINT=0 \"" + cexpBin + "\" compile \"" + srcIndex + "\" -o \"" + nativeDistBin + "\" 2>/dev/null || true");
                child_process.execSync("chmod +x \"" + nativeDistBin + "\" 2>/dev/null || true");
                println("  [OK] Recompiled native machine binary via Cex v8: " + nativeDistBin);
            } catch (...) {
                println("  [WARN] Native compilation fallback: using existing binary if present");
            }
        }

        // Copy / Link cxvm core binaries
        let realCxvmBin: string = fs.exists(nativeDistBin) ? nativeDistBin : (fs.exists("dist/cxvm") ? (curPwd + "/dist/cxvm") : (fs.exists(cxvmDir + "/bin/cxvm") ? (cxvmDir + "/bin/cxvm") : ""));
        if (realCxvmBin.length() > 0 && fs.exists(realCxvmBin)) {
            child_process.execSync("cp -f \"" + realCxvmBin + "\" \"" + cxvmDir + "/bin/cxvm\"");
            child_process.execSync("cp -f \"" + realCxvmBin + "\" \"" + cexDir + "/bin/cxvm\"");
            child_process.execSync("chmod +x \"" + cxvmDir + "/bin/cxvm\" \"" + cexDir + "/bin/cxvm\"");
            println("  [OK] Installed latest cxvm binary to " + cxvmDir + "/bin/cxvm and " + cexDir + "/bin/cxvm");
        }

        // Copy setup.cex into $cxvmDir/bin and $cexDir/bin for global 'cxvm setup' dispatch
        let setupSrc: string = fs.exists("setup.cex") ? "setup.cex" : (fs.exists("cxvm/setup.cex") ? "cxvm/setup.cex" : (fs.exists(curPwd + "/setup.cex") ? (curPwd + "/setup.cex") : ""));
        if (setupSrc.length() > 0) {
            child_process.execSync("cp -f \"" + setupSrc + "\" \"" + cxvmDir + "/bin/setup.cex\"");
            child_process.execSync("cp -f \"" + setupSrc + "\" \"" + cexDir + "/bin/setup.cex\"");
            child_process.execSync("chmod +x \"" + cxvmDir + "/bin/setup.cex\" \"" + cexDir + "/bin/setup.cex\" 2>/dev/null || true");
        }

        // Install runtime dispatchers in $CXVM_DIR/bin
        let v8Dir: string = cxvmDir + "/bin/8.0.0";
        let v6Dir: string = cxvmDir + "/bin/6.0.0";
        child_process.execSync("mkdir -p \"" + v8Dir + "/bin\" \"" + v6Dir + "/bin\"");

        // Link active default to current and v8/v6 aliases
        child_process.execSync("ln -sfn \"" + v8Dir + "\" \"" + cxvmDir + "/current\"");
        child_process.execSync("ln -sfn \"8.0.0\" \"" + cxvmDir + "/bin/v8.0.0\" 2>/dev/null || true");
        child_process.execSync("ln -sfn \"6.0.0\" \"" + cxvmDir + "/bin/v6.0.0\" 2>/dev/null || true");
        child_process.execSync("ln -sf \"" + cxvmDir + "/current/bin/cexr\" \"" + cxvmDir + "/bin/cexr\" 2>/dev/null || true");
        child_process.execSync("ln -sf \"" + cxvmDir + "/current/bin/cex\" \"" + cxvmDir + "/bin/cex\" 2>/dev/null || true");
        child_process.execSync("ln -sf \"" + cxvmDir + "/current/bin/cexp\" \"" + cxvmDir + "/bin/cexp\" 2>/dev/null || true");

        // Create local project ./dist dispatchers
        let projectDist: string = curPwd + "/dist";
        child_process.execSync("mkdir -p \"" + projectDist + "\"");

        // Local ./dist/cxvm.sh shell dispatcher backup
        if (!fs.exists(projectDist + "/cxvm.sh")) {
            let cxvmDispatcher: string = "#!/usr/bin/env bash\nCXVM_DIR=\"${CXVM_DIR:-$HOME/.cxvm}\"\nif [ -x \"$CXVM_DIR/bin/cxvm\" ]; then\n  exec \"$CXVM_DIR/bin/cxvm\" \"$@\"\nfi\necho \"[ERROR] cxvm not found in $CXVM_DIR/bin/cxvm. Run setup.cex first.\"\nexit 1\n";
            fs.writeFile(projectDist + "/cxvm.sh", cxvmDispatcher);
            child_process.execSync("chmod +x \"" + projectDist + "/cxvm.sh\"");
        }

        // Local ./dist/cexr
        let cexrDispatcher: string = "#!/usr/bin/env bash\nCXVM_DIR=\"${CXVM_DIR:-$HOME/.cxvm}\"\nif [ \"$1\" = \"v6\" ] || [ \"$1\" = \"6.0.0\" ]; then\n  shift\n  if [ -x \"$CXVM_DIR/bin/6.0.0/cexr\" ]; then\n    exec \"$CXVM_DIR/bin/6.0.0/cexr\" \"$@\"\n  fi\nfi\nif [ \"$1\" = \"v8\" ] || [ \"$1\" = \"8.0.0\" ]; then\n  shift\n  if [ -x \"$CXVM_DIR/bin/8.0.0/cexr\" ]; then\n    exec \"$CXVM_DIR/bin/8.0.0/cexr\" \"$@\"\n  fi\nfi\nif [ -x \"$CXVM_DIR/bin/cexr\" ]; then\n  exec \"$CXVM_DIR/bin/cexr\" \"$@\"\nfi\nif [ -x \"$CXVM_DIR/current/bin/cexr\" ]; then\n  exec \"$CXVM_DIR/current/bin/cexr\" \"$@\"\nfi\necho \"[ERROR] cexr not found. Run setup.cex first.\"\nexit 1\n";
        fs.writeFile(projectDist + "/cexr", cexrDispatcher);
        child_process.execSync("chmod +x \"" + projectDist + "/cexr\"");

        // Local ./dist/cex dispatcher script supporting 'cex setup' and delegating to cxvm/cexr
        let cexDispatcher: string = "#!/usr/bin/env bash\nCXVM_DIR=\"${CXVM_DIR:-$HOME/.cxvm}\"\nif [ \"$1\" = \"setup\" ]; then\n  shift\n  CEXR_CMD=\"cexr\"\n  if [ -x \"$CXVM_DIR/bin/cexr\" ]; then\n    CEXR_CMD=\"$CXVM_DIR/bin/cexr\"\n  elif [ -x \"$CXVM_DIR/current/bin/cexr\" ]; then\n    CEXR_CMD=\"$CXVM_DIR/current/bin/cexr\"\n  fi\n  if [ -f \"setup.cex\" ]; then\n    exec \"$CEXR_CMD\" setup.cex \"$@\"\n  elif [ -f \"dist/setup.cex\" ]; then\n    exec \"$CEXR_CMD\" dist/setup.cex \"$@\"\n  elif [ -f \"$CXVM_DIR/bin/setup.cex\" ]; then\n    exec \"$CEXR_CMD\" \"$CXVM_DIR/bin/setup.cex\" \"$@\"\n  elif [ -x \"$CXVM_DIR/bin/cxvm\" ]; then\n    exec \"$CXVM_DIR/bin/cxvm\" setup \"$@\"\n  fi\nfi\nif [ -x \"$CXVM_DIR/bin/cxvm\" ]; then\n  exec \"$CXVM_DIR/bin/cxvm\" \"$@\"\nfi\nif [ -x \"$CXVM_DIR/bin/cexr\" ]; then\n  exec \"$CXVM_DIR/bin/cexr\" \"$@\"\nfi\nexec cexr \"$@\"\n";
        fs.writeFile(projectDist + "/cex", cexDispatcher);
        child_process.execSync("chmod +x \"" + projectDist + "/cex\"");
        child_process.execSync("cp -f \"" + projectDist + "/cex\" \"" + cxvmDir + "/bin/cex\" 2>/dev/null || true");
        child_process.execSync("cp -f \"" + projectDist + "/cex\" \"" + cexDir + "/bin/cex\" 2>/dev/null || true");
        child_process.execSync("chmod +x \"" + cxvmDir + "/bin/cex\" \"" + cexDir + "/bin/cex\" 2>/dev/null || true");

        // Register binary apps with exact version of cexr (1.0.26)
        let exactCexr: string = this.cexrExactVersion;
        let cexrFactorySrc: string = (fs.exists(curPwd + "/dist/cexr-factory/1.0.26/bin")) ? (curPwd + "/dist/cexr-factory/1.0.26/bin") : ((fs.exists(curPwd + "/cxvm/dist/cexr-factory/1.0.26/bin")) ? (curPwd + "/cxvm/dist/cexr-factory/1.0.26/bin") : (curPwd + "/dist/cexr-factory"));
        let cexrBeanSrc: string = (fs.exists(curPwd + "/dist/cexr-bean/1.0.26/bin")) ? (curPwd + "/dist/cexr-bean/1.0.26/bin") : ((fs.exists(curPwd + "/cxvm/dist/cexr-bean/1.0.26/bin")) ? (curPwd + "/cxvm/dist/cexr-bean/1.0.26/bin") : (curPwd + "/dist/cexr-bean"));
        let cexrDeliverySrc: string = (fs.exists(curPwd + "/dist/cexr-delivery/1.0.26/bin")) ? (curPwd + "/dist/cexr-delivery/1.0.26/bin") : ((fs.exists(curPwd + "/cxvm/dist/cexr-delivery/1.0.26/bin")) ? (curPwd + "/cxvm/dist/cexr-delivery/1.0.26/bin") : (curPwd + "/dist/cexr-delivery"));
        let cexrDrawerSrc: string = (fs.exists(curPwd + "/dist/cexr-drawer/1.0.26/bin")) ? (curPwd + "/dist/cexr-drawer/1.0.26/bin") : ((fs.exists(curPwd + "/cxvm/dist/cexr-drawer/1.0.26/bin")) ? (curPwd + "/cxvm/dist/cexr-drawer/1.0.26/bin") : (curPwd + "/dist/cexr-drawer"));

        this.registerBinaryApp(cexDir, cxvmDir, "cexr-factory", cexrFactorySrc, exactCexr);
        this.registerBinaryApp(cexDir, cxvmDir, "cexr-bean", cexrBeanSrc, exactCexr);
        this.registerBinaryApp(cexDir, cxvmDir, "cexr-delivery", cexrDeliverySrc, exactCexr);
        this.registerBinaryApp(cexDir, cxvmDir, "cexr-drawer", cexrDrawerSrc, exactCexr);

        // Register compiler and tools
        let cexpV8Src: string = fs.exists(curPwd + "/dist/cexp-v8/8.0.0/bin") ? (curPwd + "/dist/cexp-v8/8.0.0/bin") : (fs.exists(curPwd + "/cxvm/dist/cexp-v8/8.0.0/bin") ? (curPwd + "/cxvm/dist/cexp-v8/8.0.0/bin") : "");
        if (cexpV8Src.length() > 0) {
            this.registerBinaryApp(cexDir, cxvmDir, "cexp-v8", cexpV8Src, this.defaultVer);
            this.registerBinaryApp(cexDir, cxvmDir, "cexp", cexpV8Src, this.defaultVer);
        } else if (fs.exists(cxvmDir + "/bin/cexp")) {
            this.registerBinaryApp(cexDir, cxvmDir, "cexp-v8", cxvmDir + "/bin/cexp", this.defaultVer);
            this.registerBinaryApp(cexDir, cxvmDir, "cexp", cxvmDir + "/bin/cexp", this.defaultVer);
        }

        let packSrc: string = fs.exists(curPwd + "/../deps/cex-pack/bin/cex-pack") ? (curPwd + "/../deps/cex-pack/bin/cex-pack") : (fs.exists(curPwd + "/dist/cex-pack/1.0.5/bin") ? (curPwd + "/dist/cex-pack/1.0.5/bin") : (fs.exists(curPwd + "/cxvm/dist/cex-pack/1.0.5/bin") ? (curPwd + "/cxvm/dist/cex-pack/1.0.5/bin") : ""));
        if (packSrc.length() > 0) {
            this.registerBinaryApp(cexDir, cxvmDir, "cex-pack", packSrc, "1.0.5");
        }
        let packBeanSrc: string = fs.exists(curPwd + "/dist/cex-pack-bean/1.0.5/bin") ? (curPwd + "/dist/cex-pack-bean/1.0.5/bin") : (fs.exists(curPwd + "/cxvm/dist/cex-pack-bean/1.0.5/bin") ? (curPwd + "/cxvm/dist/cex-pack-bean/1.0.5/bin") : "");
        if (packBeanSrc.length() > 0) {
            this.registerBinaryApp(cexDir, cxvmDir, "cex-pack-bean", packBeanSrc, "1.0.5");
        }
        let lintSrc: string = fs.exists(curPwd + "/../deps/cex-lint/bin/cex-lint") ? (curPwd + "/../deps/cex-lint/bin/cex-lint") : (fs.exists(curPwd + "/dist/cex-lint/1.0.8/bin") ? (curPwd + "/dist/cex-lint/1.0.8/bin") : (fs.exists(curPwd + "/cxvm/dist/cex-lint/1.0.8/bin") ? (curPwd + "/cxvm/dist/cex-lint/1.0.8/bin") : ""));
        if (lintSrc.length() > 0) {
            this.registerBinaryApp(cexDir, cxvmDir, "cex-lint", lintSrc, "1.0.8");
        }
        let cextSrc: string = fs.exists(curPwd + "/dist/cext/1.0.14/bin") ? (curPwd + "/dist/cext/1.0.14/bin") : (fs.exists(curPwd + "/cxvm/dist/cext/1.0.14/bin") ? (curPwd + "/cxvm/dist/cext/1.0.14/bin") : "");
        if (cextSrc.length() > 0) {
            this.registerBinaryApp(cexDir, cxvmDir, "cext", cextSrc, "1.0.14");
        }

        // Register Integrated Cognitive AI Models: javis, vision, ultron
        let docsDir: string = "";
        let candidatesDocs: Array<string>* = new Array<string>();
        candidatesDocs->push(curPwd);
        candidatesDocs->push(curPwd + "/../documents");
        candidatesDocs->push(curPwd + "/documents");
        candidatesDocs->push(curPwd + "/../../documents");
        candidatesDocs->push(home + "/Projects/cex/documents");
        candidatesDocs->push(home + "/.cex/documents");
        candidatesDocs->push(cxvmDir + "/documents");
        for (let dIdx: int = 0; dIdx < (int)candidatesDocs->length(); dIdx++) {
            let dPath: string = candidatesDocs->get(dIdx);
            if (fs.exists(dPath + "/bin/javis")) {
                docsDir = dPath;
                break;
            }
        }
        if (docsDir.length() > 0) {
            let javisSrc: string = docsDir + "/bin/javis";
            let ultronSrc: string = docsDir + "/bin/ultron";
            let visionSrc: string = docsDir + "/bin/vision";
            let cexm2VisionSrc: string = docsDir + "/bin/cexm-2-vision";

            this.registerBinaryApp(cexDir, cxvmDir, "javis", javisSrc, "1.0.0");
            this.registerBinaryApp(cexDir, cxvmDir, "java", javisSrc, "1.0.0");
            this.registerBinaryApp(cexDir, cxvmDir, "ultron", ultronSrc, "1.0.0");
            this.registerBinaryApp(cexDir, cxvmDir, "vision", visionSrc, "2.0.0");
            this.registerBinaryApp(cexDir, cxvmDir, "cexm-2-vision", cexm2VisionSrc, "2.0.0");
        }

        // Target build integration: CXVM_DIR/cxvm/$version/bin & ./dist/$name-$type/$version/bin
        let pkgName: string = "cxvm";
        let pkgType: string = "bean";
        let pkgVer: string = "2.0.0";
        if (fs.exists("cex-pack.json")) {
            let mfRaw: string = fs.readFile("cex-pack.json");
            let parsed: JsonValue* = JsonDoc::parse(mfRaw);
            if (parsed != nullptr && parsed->has("name")) {
                let pName: string = parsed->get("name")->asString();
                let sPos: int = (int)pName.find("/");
                if (sPos != -1) {
                    pkgName = pName.substr(sPos + 1);
                } else {
                    pkgName = pName;
                }
            }
            if (parsed != nullptr && parsed->has("version")) {
                pkgVer = parsed->get("version")->asString();
            }
        }

        let targetDir: string = cxvmDir + "/" + pkgName + "-" + pkgType + "/" + pkgVer;
        let targetDirAlias: string = cxmvDir + "/" + pkgName + "-" + pkgType + "/" + pkgVer;
        let cxvmVerDir: string = cxvmDir + "/cxvm/" + pkgVer;
        let cxvmDefDir: string = cxvmDir + "/cxvm/" + this.defaultVer;

        let distTargetDir: string = curPwd + "/dist/" + pkgName + "-" + pkgType + "/" + pkgVer;
        child_process.execSync("mkdir -p \"" + targetDir + "\" \"" + targetDirAlias + "\" \"" + cxvmVerDir + "\" \"" + cxvmDefDir + "\" \"" + distTargetDir + "\"");

        if (fs.exists(curPwd + "/dist/cxvm")) {
            realCxvmBin = curPwd + "/dist/cxvm";
        }
        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + targetDir + "/bin\"");
        child_process.execSync("ln -sf \"../../cxvm\" \"" + distTargetDir + "/bin\"");
        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + cxvmVerDir + "/bin\"");
        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + cxvmDefDir + "/bin\"");

        this.registerBinaryApp(cexDir, cxvmDir, "cxvm", realCxvmBin, pkgVer);

        // Configure shell profile
        if (home.length() > 0) {
            let zshrc: string = home + "/.zshrc";
            let bashrc: string = home + "/.bashrc";
            let cfg: string = "\n# 2-TEK CXVM: Cex Version Manager\nexport CXVM_DIR=\"" + cxvmDir + "\"\nexport PATH=\"$CXVM_DIR/bin:$CXVM_DIR/current/bin:$PATH\"\n";
            if (fs.exists(zshrc)) {
                let zContent: string = fs.readFile(zshrc);
                if (zContent.find("CXVM_DIR") == -1) {
                    fs.writeFile(zshrc, zContent + cfg);
                    println("[OK] Appended CXVM_DIR and PATH to " + zshrc);
                }
            }
            if (fs.exists(bashrc)) {
                let bContent: string = fs.readFile(bashrc);
                if (bContent.find("CXVM_DIR") == -1) {
                    fs.writeFile(bashrc, bContent + cfg);
                    println("[OK] Appended CXVM_DIR and PATH to " + bashrc);
                }
            }
        }

        let regRes: CxvmCommandResult* = cxvm->registerBinaryAppsInCexDir();
        println(regRes->output);

        this.setupDeps(curPwd, cexDir, cxvmDir);

        // Install Git pre-push hook for automated dist build before push
        let prePushContent: string = "#!/usr/bin/env bash\n# 2-TEK CXVM: Auto build to dist before push code (pre-push hook)\n# Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule (No Symbols)\nset -e\n\necho \"==> [git pre-push hook] Auto-building to dist before push...\"\n\nREPO_ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"\n\nif [ -x \"$REPO_ROOT/dist/cxvm\" ]; then\n  \"$REPO_ROOT/dist/cxvm\" build || true\nelif [ -f \"$REPO_ROOT/dist/cxvm\" ]; then\n  bash \"$REPO_ROOT/dist/cxvm\" build || true\nelif [ -x \"$REPO_ROOT/bin/cxvm\" ]; then\n  \"$REPO_ROOT/bin/cxvm\" build || true\nelif [ -f \"$REPO_ROOT/bin/cxvm\" ]; then\n  bash \"$REPO_ROOT/bin/cxvm\" build || true\nelif [ -n \"$CXVM_DIR\" ] && [ -x \"$CXVM_DIR/bin/cxvm\" ]; then\n  \"$CXVM_DIR/bin/cxvm\" build || true\nelif [ -x \"$HOME/.cxvm/bin/cxvm\" ]; then\n  \"$HOME/.cxvm/bin/cxvm\" build || true\nelif command -v cxvm >/dev/null 2>&1; then\n  cxvm build || true\nfi\n\necho \"[OK] [git pre-push hook] Auto-build to dist completed before push.\"\nexit 0\n";

        let gitHooksDir: string = child_process.execSync("git rev-parse --git-path hooks 2>/dev/null | tr -d '\\n'");
        if (gitHooksDir.length() > 0) {
            child_process.execSync("mkdir -p \"" + gitHooksDir + "\"");
            fs.writeFile(gitHooksDir + "/pre-push", prePushContent);
            child_process.execSync("chmod +x \"" + gitHooksDir + "/pre-push\" 2>/dev/null || true");
            println("[OK] Installed Git pre-push hook in " + gitHooksDir + "/pre-push");
        }
        child_process.execSync("mkdir -p \"" + curPwd + "/.githooks\"");
        fs.writeFile(curPwd + "/.githooks/pre-push", prePushContent);
        child_process.execSync("chmod +x \"" + curPwd + "/.githooks/pre-push\" 2>/dev/null || true");
        println("[OK] Configured repository Git pre-push hook in " + curPwd + "/.githooks/pre-push");

        println("\n================================================================================");
        println("    2-TEK CXVM: Installation & Setup Complete [OK]                             ");
        println("================================================================================");
        println("  CXVM Directory:    " + cxvmDir + " (alias: " + cxmvDir + ")");
        println("  cxvm Binary:       " + cxvmDir + "/bin/cxvm [READY]");
        println("  cexr Exact Version:" + this.cexrExactVersion + " (Reserve Path: CEX_DIR/cexr-factory/" + this.cexrExactVersion + "/bin)");
        println("  Integrated Build:  " + distTargetDir + "/bin (./dist/$name-$type/$version/bin)");
        println("  Target Build cxvm: " + cxvmDir + "/cxvm/$version/bin (alias: CXMV_DIR/cxvm/$version/bin)");
        println("  Dependencies:      " + curPwd + "/deps/$name-$type/$version/bin (cached on existing version, zero hardcode)");
        println("  Git Pre-Push Hook: .git/hooks/pre-push (auto-build to dist before push) [OK]");
        println("  Active Runtime:    CexR v" + this.defaultVer + " (Default)");
        println("  Secondary Runtime: CexR v" + this.secondaryVer + " (LTS)");
        println("  AI Models in PATH: javis (alias: java), vision, ultron integrated into $CXVM_DIR/bin & $CEX_DIR/bin [OK]");
        println("  Status:            SETUP COMPLETE [OK]");
        println("================================================================================");
        return 0;
    }
}

fn main(argc: int, argv: char**): int {
    let runner: SetupRunner* = new SetupRunner();
    if (argc > 1) {
        let arg1: string = std::string(argv[1]);
        if (arg1 == "javis" || arg1 == "java") {
            let subArg: string = argc > 2 ? std::string(argv[2]) : "";
            return runner->setupJavis(subArg);
        }
    }
    return runner->run();
}
