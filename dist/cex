#!/usr/bin/env bash
CXVM_DIR="${CXVM_DIR:-$HOME/.cxvm}"
if [ "$1" = "setup" ]; then
  shift
  CEXR_CMD="cexr"
  if [ -x "$CXVM_DIR/bin/cexr" ]; then
    CEXR_CMD="$CXVM_DIR/bin/cexr"
  elif [ -x "$CXVM_DIR/current/bin/cexr" ]; then
    CEXR_CMD="$CXVM_DIR/current/bin/cexr"
  fi
  if [ -f "setup.cex" ]; then
    exec "$CEXR_CMD" setup.cex "$@"
  elif [ -f "dist/setup.cex" ]; then
    exec "$CEXR_CMD" dist/setup.cex "$@"
  elif [ -f "$CXVM_DIR/bin/setup.cex" ]; then
    exec "$CEXR_CMD" "$CXVM_DIR/bin/setup.cex" "$@"
  elif [ -x "$CXVM_DIR/bin/cxvm" ]; then
    exec "$CXVM_DIR/bin/cxvm" setup "$@"
  fi
fi
if [ -x "$CXVM_DIR/bin/cxvm" ]; then
  exec "$CXVM_DIR/bin/cxvm" "$@"
fi
if [ -x "$CXVM_DIR/bin/cexr" ]; then
  exec "$CXVM_DIR/bin/cexr" "$@"
fi
exec cexr "$@"
