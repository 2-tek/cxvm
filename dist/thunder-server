def main():
    parser = argparse.ArgumentParser(description="2-TEK Thunder Standalone Single-Process Server")
    parser.add_argument("action", nargs="?", default="start", choices=["start", "stop", "status", "restart", "ps", "images"], help="Action to perform")
    parser.add_argument("-p", "--port", type=int, default=DEFAULT_PORT, help="Port to listen on (default: 3050)")
    parser.add_argument("-f", "--foreground", action="store_true", help="Run in foreground instead of background daemon")
    parser.add_argument("--pidfile", type=str, default="", help="Custom PID file path")
    parser.add_argument("--logfile", type=str, default="", help="Custom log file path")

    args = parser.parse_args()

    if args.action == "stop":
        return stop_server(args.pidfile)
    elif args.action == "status":
        return status_server(args.pidfile)
    elif args.action == "restart":
        stop_server(args.pidfile)
        time.sleep(0.5)
        return start_server(args.port, args.foreground, args.pidfile, args.logfile)
    elif args.action == "ps":
        list_containers()
        return 0
    elif args.action == "images":
        list_images()
        return 0
    else:
        return start_server(args.port, args.foreground, args.pidfile, args.logfile)

if __name__ == "__main__":
    sys.exit(main() or 0)
