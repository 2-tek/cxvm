class ThunderHandler(BaseHTTPRequestHandler):
    def _send_json(self, status, payload):
        body = json.dumps(payload, indent=2).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def _send_html(self, status, html):
        body = html.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path.rstrip("/")
        if not path:
            path = "/"

        if path in ("/", "/dashboard"):
            port = self.server.server_port
            return self._send_html(200, render_dashboard_html(port))

        elif path in ("/health", "/api/v1/health"):
            return self._send_json(200, {
                "status": "HEALTHY",
                "service": "2-TEK Thunder Container Engine",
                "mode": "standalone",
                "singleProcess": True,
                "pid": os.getpid(),
                "port": self.server.server_port,
                "kernel": "Linux 6.8.0-2tek-microkernel",
                "containersRunning": len([c for c in CONTAINERS if c["status"] == "RUNNING"]),
                "totalImages": len(IMAGES_STORE),
                "timestamp": time.time()
            })

        elif path == "/api/v1/thunder/status":
            return self._send_json(200, {
                "status": "HEALTHY",
                "engine": "ThunderEngine",
                "controlPort": self.server.server_port,
                "singleProcess": True,
                "pid": os.getpid(),
                "containersRunning": len([c for c in CONTAINERS if c["status"] == "RUNNING"]),
                "totalContainers": len(CONTAINERS),
                "totalImages": len(IMAGES_STORE),
                "kernel": {
                    "release": "6.8.0-2tek-microkernel",
                    "architecture": "x86_64",
                    "namespaces": ["PID", "NET", "MNT", "UTS", "IPC"],
                    "cgroups": "v2",
                    "vfs": "overlayfs"
                },
                "autoScale": {
                    "enabled": True,
                    "minReplicas": 1,
                    "maxReplicas": 10,
                    "targetCpuPct": 75
                }
            })

        elif path == "/api/v1/thunder/containers":
            return self._send_json(200, {
                "status": "SUCCESS",
                "total": len(CONTAINERS),
                "containers": CONTAINERS
            })

        elif path == "/api/v1/thunder/images":
            return self._send_json(200, {
                "status": "SUCCESS",
                "total": len(IMAGES_STORE),
                "images": IMAGES_STORE
            })

        elif path == "/api/v1/thunder/stats":
            total_cpu = sum(c["cpu"] for c in CONTAINERS if c["status"] == "RUNNING")
            total_mem = sum(c["memoryMb"] for c in CONTAINERS if c["status"] == "RUNNING")
            return self._send_json(200, {
                "status": "SUCCESS",
                "totalCpu": round(total_cpu, 2),
                "totalMemoryMb": total_mem,
                "activeContainers": len([c for c in CONTAINERS if c["status"] == "RUNNING"]),
                "requestsPerSecond": 420
            })

        else:
            return self._send_json(404, {"error": "Not Found", "path": self.path})

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path.rstrip("/")
        global CONTAINER_COUNTER

        length = int(self.headers.get("Content-Length", 0))
        raw_body = self.rfile.read(length).decode("utf-8") if length > 0 else "{}"
        try:
            body = json.loads(raw_body)
        except Exception:
            body = {}

        if path == "/api/v1/thunder/containers/run":
            name = body.get("name") or f"container-{CONTAINER_COUNTER}"
            image = body.get("image") or "@2tek/cxvm:latest"
            h_port = body.get("hostPort") or (8080 + CONTAINER_COUNTER)
            c_port = body.get("containerPort") or 8080

            new_c = {
                "id": f"cxt-{CONTAINER_COUNTER}a8f9",
                "name": name,
                "image": image,
                "hostPort": h_port,
                "containerPort": c_port,
                "status": "RUNNING",
                "pid": 200 + CONTAINER_COUNTER,
                "cpu": 0.5,
                "memoryMb": 32,
                "maxMemoryMb": 512,
                "uptimeSec": 0
            }
            CONTAINERS.append(new_c)
            CONTAINER_COUNTER += 1
            return self._send_json(200, {"status": "SUCCESS", "message": f"Container {name} started", "container": new_c})

        elif path == "/api/v1/thunder/containers/stop":
            target = body.get("id") or body.get("name") or ""
            stopped = False
            for c in CONTAINERS:
                if c["id"] == target or c["name"] == target:
                    c["status"] = "STOPPED"
                    c["cpu"] = 0.0
                    stopped = True
                    break
            if stopped:
                return self._send_json(200, {"status": "SUCCESS", "message": f"Container {target} stopped"})
            return self._send_json(404, {"status": "FAILED", "message": f"Container {target} not found"})

        else:
            return self._send_json(404, {"error": "Not Found", "path": self.path})

    def log_message(self, format, *args):
        # Suppress noisy standard logs in daemon mode
        pass

def start_server(port, foreground=False, pidfile="", logfile=""):
    cxvm_dir = get_cxvm_dir()
    os.makedirs(cxvm_dir, exist_ok=True)

    if not pidfile:
        pidfile = os.path.join(cxvm_dir, "thunder_server.pid")
    if not logfile:
        logfile = os.path.join(cxvm_dir, "thunder_server.log")
    portfile = os.path.join(cxvm_dir, "thunder_server.port")

    # Check if already running
    if os.path.exists(pidfile):
        try:
            with open(pidfile, "r") as f:
                old_pid = int(f.read().strip())
            os.kill(old_pid, 0)
            print(f"[cxvm] Thunder server is already running (single process standalone, PID: {old_pid}, port: {port})")
            return 0
        except (OSError, ValueError):
            try:
                os.remove(pidfile)
            except OSError:
                pass

    if not foreground:
        # Fork daemon process
        child_pid = os.fork()
        if child_pid > 0:
            with open(pidfile, "w") as f:
                f.write(str(child_pid) + "\n")
            with open(portfile, "w") as f:
                f.write(str(port) + "\n")

            time.sleep(0.3)
            print("==> [cxvm] Starting Thunder as a server with single process (standalone)...")
            print("[OK] [cxvm] Thunder server started successfully (single process standalone)")
            print(f"  - Process ID: {child_pid}")
            print(f"  - Port:       {port}")
            print("  - Mode:       standalone (single process)")
            print(f"  - Dashboard:  http://localhost:{port}")
            print(f"  - Endpoints:  /api/v1/thunder/status, /api/v1/thunder/containers, /health")
            sys.exit(0)

        # Child daemon process
        os.setsid()
        so = open(logfile, "a+")
        se = open(logfile, "a+")
        os.dup2(so.fileno(), sys.stdout.fileno())
        os.dup2(se.fileno(), sys.stderr.fileno())

    try:
        httpd = HTTPServer(("0.0.0.0", port), ThunderHandler)
    except OSError as e:
        sys.stderr.write(f"Error binding Thunder server to port {port}: {e}\n")
        return 1

    with open(pidfile, "w") as f:
        f.write(str(os.getpid()) + "\n")
    with open(portfile, "w") as f:
        f.write(str(port) + "\n")

    if foreground:
        print(f"==> [cxvm] Thunder server running in foreground on port {port} (PID: {os.getpid()})")
        print(f"--> Dashboard: http://localhost:{port}")

    def shutdown_handler(signum, frame):
        try:
            if os.path.exists(pidfile):
                os.remove(pidfile)
            if os.path.exists(portfile):
                os.remove(portfile)
        except OSError:
            pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, shutdown_handler)
    signal.signal(signal.SIGINT, shutdown_handler)

    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        try:
            if os.path.exists(pidfile):
                os.remove(pidfile)
            if os.path.exists(portfile):
                os.remove(portfile)
        except OSError:
            pass
    return 0

def stop_server(pidfile=""):
    cxvm_dir = get_cxvm_dir()
    if not pidfile:
        pidfile = os.path.join(cxvm_dir, "thunder_server.pid")
    portfile = os.path.join(cxvm_dir, "thunder_server.port")

    if not os.path.exists(pidfile):
        print("[cxvm] Thunder server is not running.")
        return 0

    try:
        with open(pidfile, "r") as f:
            pid = int(f.read().strip())
    except (ValueError, OSError):
        print("[cxvm] Invalid Thunder server PID file. Cleaning up.")
        if os.path.exists(pidfile):
            os.remove(pidfile)
        return 0

    try:
        os.kill(pid, signal.SIGTERM)
        time.sleep(0.3)
        try:
            os.kill(pid, 0)
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
        print(f"[OK] [cxvm] Thunder server (PID: {pid}) stopped.")
    except OSError as e:
        print(f"[cxvm] Process {pid} was not running: {e}")

    for p in (pidfile, portfile):
        if os.path.exists(p):
            try:
                os.remove(p)
            except OSError:
                pass
    return 0

def status_server(pidfile=""):
    cxvm_dir = get_cxvm_dir()
    if not pidfile:
        pidfile = os.path.join(cxvm_dir, "thunder_server.pid")
    portfile = os.path.join(cxvm_dir, "thunder_server.port")

    if os.path.exists(pidfile):
        try:
            with open(pidfile, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            port = DEFAULT_PORT
            if os.path.exists(portfile):
                with open(portfile, "r") as f:
                    port = int(f.read().strip())
            print(f"[OK] [cxvm] Thunder server is running (single process standalone, PID: {pid}, port: {port})")
            print(f"  - Dashboard:  http://localhost:{port}")
            print(f"  - Health API: http://localhost:{port}/health")
            return 0
        except (OSError, ValueError):
            print("[cxvm] Thunder server PID file exists but process is dead. Cleaning up.")
            os.remove(pidfile)
            return 1
    else:
        print("[cxvm] Thunder server is stopped.")
        return 1

