#!/usr/bin/env bash
# 2-TEK CodeVersionManager (CVM) Standalone Single-Process Server Dispatcher (.cex via cexr runtime)
# Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule (No Symbols), RULE_PURE_CEX_BIN

set -e

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CXVM_DIR="${CXVM_DIR:-$HOME/.cxvm}"

CEXR_BIN=""
for r_cand in \
  "$SELF_DIR/cexr" \
  "$SELF_DIR/../bin/cexr" \
  "$CXVM_DIR/current/bin/cexr" \
  "$CXVM_DIR/bin/cexr"; do
  if [ -x "$r_cand" ] && [ ! -d "$r_cand" ]; then
    CEXR_BIN="$r_cand"
    break
  fi
done
if [ -z "$CEXR_BIN" ]; then
  CEXR_BIN="$(command -v cexr 2>/dev/null || echo "cexr")"
fi

CVM_SRV_SRC=""
for s_cand in \
  "$SELF_DIR/cvm-server.cex" \
  "$SELF_DIR/../scripts/cvm_server.cex" \
  "$(pwd)/scripts/cvm_server.cex" \
  "$CXVM_DIR/bin/cvm-server.cex"; do
  if [ -f "$s_cand" ]; then
    CVM_SRV_SRC="$s_cand"
    break
  fi
done

if [ -n "$CVM_SRV_SRC" ]; then
  exec "$CEXR_BIN" "$CVM_SRV_SRC" "$@"
fi

echo "[ERROR] cvm_server.cex not found for cexr runtime execution" >&2
exit 1
