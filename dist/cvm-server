            ok, out, err = run_git(["pull", remote])
            self.send_json(200, {
                "status": "SUCCESS" if ok else "WARNING",
                "message": out or err
            })
            return

        self.send_json(404, {"error": "Not Found", "path": path})

def start_server(port, foreground=False, pidfile=None, logfile=None):
    cxvm_dir = get_cxvm_dir()
    os.makedirs(cxvm_dir, exist_ok=True)

    if not pidfile:
        pidfile = os.path.join(cxvm_dir, "cvm_server.pid")
    if not logfile:
        logfile = os.path.join(cxvm_dir, "cvm_server.log")

    # Check if already running
    if os.path.exists(pidfile):
        try:
            with open(pidfile, "r") as f:
                old_pid = int(f.read().strip())
            os.kill(old_pid, 0)
            print(f"[cxvm] CVM server is already running (single process standalone, PID: {old_pid}, port: {port})")
            return 0
        except (OSError, ValueError):
            os.remove(pidfile)

    if not foreground:
        # Daemonize as single process
        pid = os.fork()
        if pid > 0:
            # Parent: wait briefly, record pid, report success
            time.sleep(0.3)
            with open(pidfile, "w") as f:
                f.write(str(pid) + "\n")
            with open(os.path.join(cxvm_dir, "cvm_server.port"), "w") as f:
                f.write(str(port) + "\n")

            print(f"==> [cxvm] Starting CVM as a server with single process (standalone)...")
            print(f"[OK] [cxvm] CVM server started successfully (single process standalone)")
            print(f"  - Process ID: {pid}")
            print(f"  - Port:       {port}")
            print(f"  - Mode:       standalone (single process)")
            print(f"  - Web Studio: http://localhost:{port}")
            print(f"  - Log File:   {logfile}")
            return 0

        # Child daemon process
        os.setsid()
        # Redirect standard file descriptors to logfile
        log_fd = open(logfile, "a")
        os.dup2(log_fd.fileno(), sys.stdout.fileno())
        os.dup2(log_fd.fileno(), sys.stderr.fileno())

    # Write pidfile for foreground or daemon child
    with open(pidfile, "w") as f:
        f.write(str(os.getpid()) + "\n")
    with open(os.path.join(cxvm_dir, "cvm_server.port"), "w") as f:
        f.write(str(port) + "\n")

    def handle_exit(signum, frame):
        try:
            if os.path.exists(pidfile):
                os.remove(pidfile)
        except Exception:
            pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, handle_exit)
    signal.signal(signal.SIGINT, handle_exit)

    server = HTTPServer(("0.0.0.0", port), CvmHttpHandler)
    if foreground:
        print(f"==> [cxvm] Starting CVM as a server with single process (standalone) on port {port}...")
        print(f"Web Studio: http://localhost:{port} (PID: {os.getpid()})")
    try:
        server.serve_forever()
    finally:
        if os.path.exists(pidfile):
            os.remove(pidfile)
    return 0

def stop_server(pidfile=None):
    cxvm_dir = get_cxvm_dir()
    if not pidfile:
        pidfile = os.path.join(cxvm_dir, "cvm_server.pid")

    if not os.path.exists(pidfile):
        print("[cxvm] CVM server is not running.")
        return 0

    try:
        with open(pidfile, "r") as f:
            pid = int(f.read().strip())
        os.kill(pid, signal.SIGTERM)
        time.sleep(0.3)
        if os.path.exists(pidfile):
            os.remove(pidfile)
        print(f"[OK] [cxvm] CVM server (PID: {pid}) stopped.")
        return 0
    except OSError as e:
        print(f"[cxvm] Could not stop CVM server: {e}")
        if os.path.exists(pidfile):
            os.remove(pidfile)
        return 1

def status_server(pidfile=None):
    cxvm_dir = get_cxvm_dir()
    if not pidfile:
        pidfile = os.path.join(cxvm_dir, "cvm_server.pid")
    portfile = os.path.join(cxvm_dir, "cvm_server.port")

    port = DEFAULT_PORT
    if os.path.exists(portfile):
        try:
            with open(portfile, "r") as f:
                port = int(f.read().strip())
        except Exception:
            pass

    if os.path.exists(pidfile):
        try:
            with open(pidfile, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            print(f"[OK] [cxvm] CVM server is running (single process standalone, PID: {pid}, port: {port})")
            print(f"  - Web Studio: http://localhost:{port}")
            print(f"  - Health API: http://localhost:{port}/health")
            return 0
        except OSError:
            print("[cxvm] CVM server is stopped (stale PID file removed).")
            os.remove(pidfile)
            return 1
    else:
        print("[cxvm] CVM server is stopped.")
        return 1

def main():
    parser = argparse.ArgumentParser(description="2-TEK CVM Standalone Single-Process Server")
    parser.add_argument("action", nargs="?", default="start", choices=["start", "stop", "status", "restart"], help="Action to perform")
    parser.add_argument("-p", "--port", type=int, default=DEFAULT_PORT, help="Port to listen on (default: 4000)")
    parser.add_argument("-f", "--foreground", action="store_true", help="Run in foreground instead of background daemon")
    parser.add_argument("--pidfile", type=str, default="", help="Custom PID file path")
    parser.add_argument("--logfile", type=str, default="", help="Custom log file path")

    args = parser.parse_args()

    if args.action == "stop":
        return stop_server(args.pidfile)
    elif args.action == "status":
        return status_server(args.pidfile)
    elif args.action == "restart":
        stop_server(args.pidfile)
        time.sleep(0.5)
        return start_server(args.port, args.foreground, args.pidfile, args.logfile)
    else:
        return start_server(args.port, args.foreground, args.pidfile, args.logfile)

if __name__ == "__main__":
    sys.exit(main() or 0)
