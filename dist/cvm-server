#!/usr/bin/env python3
"""
2-TEK CodeVersionManager (CVM) — Standalone Single-Process Server
Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)
Runs as a standalone single process with zero heavy multi-process frameworks.
Provides CVM Web Studio UI and REST APIs:
  - GET  /                     -> Visual CVM Web Studio Dashboard
  - GET  /health               -> Server health & single-process PID status
  - GET  /api/v1/health        -> Health JSON
  - GET  /api/v1/cvm/status    -> Git/CVM working tree status
  - POST /api/v1/cvm/commit    -> Commit staged files
  - POST /api/v1/cvm/push      -> Push commits to upstream
  - POST /api/v1/cvm/pull      -> Pull latest commits
  - GET  /api/v1/cvm/log       -> Commit history
  - GET  /api/v1/cvm/diff      -> Working tree diff
"""

import sys
import os
import json
import time
import signal
import argparse
import subprocess
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs

DEFAULT_PORT = 4000

def get_cxvm_dir():
    return os.environ.get("CXVM_DIR") or os.path.expanduser("~/.cxvm")

def run_git(args, cwd=None):
    try:
        res = subprocess.run(
            ["git"] + args,
            cwd=cwd or os.getcwd(),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=15
        )
        return res.returncode == 0, res.stdout.strip(), res.stderr.strip()
    except Exception as e:
        return False, "", str(e)

def get_repo_status():
    branch = "unknown"
    ok, out, _ = run_git(["rev-parse", "--abbrev-ref", "HEAD"])
    if ok and out:
        branch = out

    ok, out, _ = run_git(["status", "--porcelain"])
    lines = [l for l in out.splitlines() if l.strip()]
    staged = [l for l in lines if l[0] in ("M", "A", "D", "R")]
    modified = [l for l in lines if len(l) > 1 and l[1] == "M"]
    untracked = [l for l in lines if l.startswith("??")]

    ok_remote, remote_out, _ = run_git(["remote", "get-url", "origin"])
    remote_url = remote_out if ok_remote else "none"

    return {
        "status": "SUCCESS",
        "branch": branch,
        "isClean": len(lines) == 0,
        "remote": remote_url,
        "stagedCount": len(staged),
        "modifiedCount": len(modified),
        "untrackedCount": len(untracked),
        "totalChanges": len(lines),
        "files": lines[:30],
        "serverMode": "standalone (single process)"
    }

class CvmHttpHandler(BaseHTTPRequestHandler):
    server_version = "CVM-Server/2.0 (Standalone Single-Process)"

    def log_message(self, format, *args):
        # Clean logging format
        sys.stderr.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {self.address_string()} - {format % args}\n")
        sys.stderr.flush()

    def send_json(self, status_code, data):
        body = json.dumps(data, indent=2).encode("utf-8")
        self.send_response(status_code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path

        if path in ("/health", "/api/v1/health"):
            self.send_json(200, {
                "status": "HEALTHY",
                "service": "2-TEK CodeVersionManager (CVM)",
                "mode": "standalone",
                "singleProcess": True,
                "pid": os.getpid(),
                "port": self.server.server_port,
                "cwd": os.getcwd(),
                "timestamp": time.time()
            })
            return

        if path == "/api/v1/cvm/status":
            st = get_repo_status()
            self.send_json(200, st)
            return

        if path == "/api/v1/cvm/log":
            ok, out, err = run_git(["log", "-n", "10", "--pretty=format:%h|%an|%s|%cr"])
            commits = []
            if ok and out:
                for line in out.splitlines():
                    parts = line.split("|")
                    if len(parts) >= 4:
                        commits.append({
                            "hash": parts[0],
                            "author": parts[1],
                            "message": parts[2],
                            "date": parts[3]
                        })
            self.send_json(200, {
                "status": "SUCCESS",
                "commits": commits,
                "count": len(commits)
            })
            return

        if path == "/api/v1/cvm/diff":
            ok, out, _ = run_git(["diff"])
            self.send_json(200, {
                "status": "SUCCESS",
                "diff": out,
                "hasChanges": len(out) > 0
            })
            return

