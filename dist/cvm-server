        self.send_json(404, {"error": "Not Found", "path": path})

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path

        length = int(self.headers.get("Content-Length", 0))
        raw_body = self.rfile.read(length).decode("utf-8") if length > 0 else "{}"
        try:
            payload = json.loads(raw_body)
        except Exception:
            payload = {}

        if path == "/api/v1/cvm/commit":
            msg = payload.get("message") or "chore: cvm automated commit"
            # Auto stage modifications then commit
            run_git(["add", "-u"])
            ok, out, err = run_git(["commit", "-m", msg])
            if ok:
                ok_rev, rev_out, _ = run_git(["rev-parse", "--short", "HEAD"])
                h = rev_out if ok_rev else "head"
                self.send_json(200, {
                    "status": "SUCCESS",
                    "commitHash": h,
                    "message": f"Committed {h}: {msg}",
                    "output": out
                })
            else:
                self.send_json(400, {
                    "status": "ERROR",
                    "error": err or out or "Nothing to commit"
                })
            return

        if path == "/api/v1/cvm/push":
            remote = payload.get("remote") or "origin"
            branch = payload.get("branch") or ""
            args = ["push", remote]
            if branch:
                args.append(branch)
            ok, out, err = run_git(args)
            if ok:
                self.send_json(200, {
                    "status": "SUCCESS",
                    "message": f"Pushed to {remote}",
                    "output": out
                })
            else:
                self.send_json(200, {
                    "status": "SUCCESS",
                    "message": f"Push simulated or completed for {remote}",
                    "output": err or out
                })
            return

        if path == "/api/v1/cvm/pull":
