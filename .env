# 2-TEK cxvm Dynamic Environment Configuration (Rule 72 & RULE_NO_HARDCODE_PATH_FROM_ENV)
APP_NAME=2-TEK cxvm Engine
PORT=3080
CVM_PORT=4000
THUNDER_PORT=3050
CXVM_DIR=$HOME/.cxvm
CXVM_DEFAULT_VERSION=8.0.0
CXVM_LTS_VERSION=6.0.0
DOWNLOADS_DIR=dist
PUBLIC_DIR=public
SCRIPTS_DIR=scripts
MANIFEST_PATH=cex-pack.json
MAIN_ENTRYPOINT=src/index.cex
SERVER_BINARY=./dist/server
CVM_REPO_DIR=.
CVM_DEFAULT_BRANCH=main
CVM_DEFAULT_REMOTE=origin
PROJECTS_ROOT=$HOME/Projects
LIGHTING_HOME=$CXVM_DIR/packages/lighting
CEXP_REPO_DIR=../cexp
CEXR_REPO_DIR=../cexr
CEX_FACTORY_URL=https://raw.githubusercontent.com/2-tek/cxvm/main
CEX_TEST_TIMEOUT_MS=360000
THUNDER_LINUX_SIM_DIR=.cex_cache/thunder_linux_sim
