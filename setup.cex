// 2-TEK CXVM: Quick Installer & Toolchain Environment Setup (setup.cex)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule (No Symbols), RULE_PURE_CEX_BIN

import fs from "fs";
import child_process from "child_process";
import "./src/types.cex";
import "./src/cxvm_engine.cex";

class SetupRunner {
    public string defaultVer;
    public string secondaryVer = "6.0.0";
    public string cexrExactVersion;
    public bool isForce = false;

    public string resolveVersion(string libName, string defaultFallback) {
        int vCode = (libName == "cexp-v8" || libName == "cexp" || libName == "cexp-v8-stable" || libName == "v8-stable") ? 1 :
            ((libName.find("cexr-") == 0 || libName == "cexr") ? 2 :
            ((libName == "cex-pack" || libName == "cex-pack-bean") ? 3 :
            ((libName == "cex-lint") ? 4 :
            ((libName == "cext" || libName == "cex-test") ? 5 :
            ((libName == "cex-cli" || libName == "cli" || libName == "cex-cvm-cli") ? 6 :
            ((libName == "mvc-lighting" || libName == "lighting") ? 13 :
            ((libName == "cex-service" || libName == "cex-s") ? 7 :
            ((libName == "cex-std") ? 8 :
            ((libName == "javis" || libName == "java" || libName == "models" || libName == "ultron") ? 9 :
            ((libName == "vision" || libName.find("cexm-2") == 0) ? 10 :
            ((libName == "cex-builder" || libName == "builder") ? 12 :
            ((libName.find("cxvm") == 0) ? 11 : 0)))))))))));

        switch (vCode) {
            case 1: return "8.0.0";
            case 2: return "1.0.26";
            case 3: return "1.0.5";
            case 4: return "1.0.8";
            case 5: return "1.0.14";
            case 6: return "1.0.0";
            case 7: return "1.0.0";
            case 8: return "1.0.0";
            case 9: return "1.0.0";
            case 10: return "2.0.0";
            case 11: return "2.1.43";
            case 12: return "1.0.0";
            case 13: return "6.1.10";
            default: return defaultFallback;
        }
    }

    public int setupJavis(string subArg) {
        CxvmEngine* cxvm = new CxvmEngine();
        return cxvm->setupJavis(subArg);
    }

    public int setupModels(string subArg) {
        CxvmEngine* cxvm = new CxvmEngine();
        return cxvm->setupModels(subArg);
    }

    public int buildModels(string subArg) {
        CxvmEngine* cxvm = new CxvmEngine();
        return cxvm->buildModels(subArg);
    }

    public constructor() {
        this.defaultVer = this.resolveVersion("cexp-v8-stable", "8.0.0");
        this.cexrExactVersion = this.resolveVersion("cexr-factory", "1.0.26");
    }

    public void setupDeps(string curPwd, string cexDir, string cxvmDir) {
        println("\n==> [setup.cex] Resolving and Configuring Packages into cex_boxes (use cex_boxes only)...");
        Array<string>* libs = new Array<string>();
        libs->push("cexp-v8");
        libs->push("cexp-v8-stable");
        libs->push("cexr-bean");
        libs->push("cexr-factory");
        libs->push("cexr-delivery");
        libs->push("cexr-drawer");
        libs->push("cex-pack");
        libs->push("cex-lint");
        libs->push("cext");
        libs->push("cex-test");
        libs->push("cex-cli");
        libs->push("cex-cvm-cli");
        libs->push("mvc-lighting");
        libs->push("cex-std");
        libs->push("cxvm-bean");
        libs->push("javis");
        libs->push("models");
        libs->push("vision");
        libs->push("ultron");
        libs->push("cex-builder");
        libs->push("builder");

        string mfPath = curPwd + "/cex-pack.json";
        if (fs.exists(mfPath)) {
            string mfRaw = fs.readFile(mfPath);
            JsonValue* parsed = JsonDoc::parse(mfRaw);
            if (parsed != nullptr) {
                if (parsed->has("dependencies")) {
                    JsonValue* depObj = (JsonValue*)parsed->get("dependencies");
                    if (depObj != nullptr) {
                        std::vector<std::string> dKeys = depObj->keys();
                        for (size_t k = 0; k < dKeys.size(); k++) {
                            string kName = dKeys[k];
                            bool existsInList = false;
                            for (int j = 0; j < (int)libs->length(); j++) {
                                if (libs->get(j) == kName) { existsInList = true; break; }
                            }
                            if (!existsInList) {
                                libs->push(kName);
                            }
                        }
                    }
                }
            }
        }

        string home = child_process.execSync("printf \"%s\" \"$HOME\"");
        int builtCount = 0;
        int cachedCount = 0;

        for (int i = 0; i < (int)libs->length(); i++) {
            string lib = libs->get(i);
            string ver = this.resolveVersion(lib, this.defaultVer);
            string boxDir = curPwd + "/cex_boxes/" + lib;
            string boxBin = boxDir + "/bin";

            bool isCxvmBean = (lib == "cxvm-bean");
            if (!this.isForce && !isCxvmBean && fs.exists(boxBin) && (fs.exists(boxBin + "/" + lib) || fs.exists(boxBin))) {
                cachedCount++;
                println("  [CACHE] cex_boxes/" + lib + " already exists (cached, skipping rebuild)");
            } else {
                builtCount++;
                child_process.execSync("mkdir -p \"" + boxBin + "\"");

                string candPackageDir = "";
                Array<string>* candPaths = new Array<string>();
                candPaths->push(curPwd + "/../cex/cex_boxes/" + lib);
                candPaths->push(curPwd + "/../cex/cxvm/cex_boxes/" + lib);
                candPaths->push(home + "/Projects/cex/cex_boxes/" + lib);
                candPaths->push(home + "/Projects/cex/cxvm/cex_boxes/" + lib);
                candPaths->push(home + "/.cxvm/cex_boxes/" + lib);
                candPaths->push(home + "/.cex/cex_boxes/" + lib);
                if (lib == "cext") {
                    candPaths->push(curPwd + "/cex_boxes/cex-test");
                    candPaths->push(home + "/Projects/cex/cex_boxes/cex-test");
                }
                if (lib == "cex-test") {
                    candPaths->push(curPwd + "/cex_boxes/cext");
                    candPaths->push(home + "/Projects/cex/cex_boxes/cext");
                }
                if (lib == "cex-builder" || lib == "builder") {
                    candPaths->push(curPwd + "/cex_boxes/cex-builder");
                    candPaths->push(curPwd + "/cex_boxes/builder");
                    candPaths->push(curPwd + "/../cex/cex_boxes/cex-builder");
                    candPaths->push(curPwd + "/../cex/cex_boxes/builder");
                    candPaths->push(home + "/Projects/cex/cex_boxes/cex-builder");
                    candPaths->push(home + "/Projects/cex/cex_boxes/builder");
                }

                for (int cIdx = 0; cIdx < (int)candPaths->length(); cIdx++) {
                    string cp = candPaths->get(cIdx);
                    if (fs.exists(cp) && fs.isDir(cp)) {
                        candPackageDir = cp;
                        break;
                    }
                }

                if (candPackageDir.length() > 0) {
                    child_process.execSync("cp -rn \"" + candPackageDir + "\"/* \"" + boxDir + "/\" 2>/dev/null || true");
                } else {
                    string gitRepo = "https://github.com/2-tek/" + lib + ".git";
                    child_process.execSync("git clone --depth 1 \"" + gitRepo + "\" \"" + boxDir + "\" 2>/dev/null || git clone --depth 1 \"https://github.com/2-tek/cex-" + lib + ".git\" \"" + boxDir + "\" 2>/dev/null || true");
                }

                string binSrc = "";
                if (fs.exists(boxDir + "/bin/" + lib)) {
                    binSrc = boxDir + "/bin/" + lib;
                }
                if (binSrc.length() == 0 && candPackageDir.length() > 0 && fs.exists(candPackageDir + "/bin/" + lib)) {
                    binSrc = candPackageDir + "/bin/" + lib;
                }
                if (binSrc.length() == 0 && fs.exists(cxvmDir + "/" + lib + "/" + ver + "/bin")) {
                    binSrc = cxvmDir + "/" + lib + "/" + ver + "/bin";
                }
                if (binSrc.length() == 0 && fs.exists(cexDir + "/" + lib + "/" + ver + "/bin")) {
                    binSrc = cexDir + "/" + lib + "/" + ver + "/bin";
                }
                if (binSrc.length() == 0 && lib == "cxvm-bean") {
                    if (fs.exists(curPwd + "/bin/cxvm")) {
                        binSrc = curPwd + "/bin/cxvm";
                    }
                    if (binSrc.length() == 0 && fs.exists(cxvmDir + "/bin/cxvm")) {
                        binSrc = cxvmDir + "/bin/cxvm";
                    }
                }
                if (binSrc.length() == 0 && fs.exists(curPwd + "/cex_boxes/" + lib + "/bin/" + lib)) {
                    binSrc = curPwd + "/cex_boxes/" + lib + "/bin/" + lib;
                }
                if (binSrc.length() == 0 && (lib == "cex-builder" || lib == "builder")) {
                    if (fs.exists(curPwd + "/cex_boxes/cex-builder/bin/cex-builder")) {
                        binSrc = curPwd + "/cex_boxes/cex-builder/bin/cex-builder";
                    }
                    if (binSrc.length() == 0 && fs.exists(curPwd + "/cex_boxes/builder/bin/builder")) {
                        binSrc = curPwd + "/cex_boxes/builder/bin/builder";
                    }
                    if (binSrc.length() == 0 && fs.exists(cxvmDir + "/bin/cex-builder")) {
                        binSrc = cxvmDir + "/bin/cex-builder";
                    }
                }

                if (binSrc.length() > 0 && fs.exists(binSrc)) {
                    child_process.execSync("cp -f \"" + binSrc + "\" \"" + boxBin + "/" + lib + "\"");
                    child_process.execSync("chmod +x \"" + boxBin + "/" + lib + "\" 2>/dev/null || true");
                    if (isCxvmBean) {
                        child_process.execSync("cp -f \"" + binSrc + "\" \"" + boxBin + "/cxvm\" 2>/dev/null || true");
                        child_process.execSync("chmod +x \"" + boxBin + "/cxvm\" 2>/dev/null || true");
                    }
                } else {
                    string wrapper = "#!/usr/bin/env bash\nexec \"" + cxvmDir + "/bin/" + lib + "\" \"$@\"\n";
                    fs.writeFile(boxBin + "/" + lib, wrapper);
                    child_process.execSync("chmod +x \"" + boxBin + "/" + lib + "\" 2>/dev/null || true");
                }

                string boxMf = boxDir + "/cex-pack.json";
                if (!fs.exists(boxMf)) {
                    string mfData = "{\n  \"name\": \"" + lib + "\",\n  \"version\": \"" + ver + "\",\n  \"target\": \"runtime\",\n  \"bin\": \"bin/" + lib + "\"\n}\n";
                    fs.writeFile(boxMf, mfData);
                }

                println("  [OK]    Configured cex_boxes/" + lib + " into cex_boxes/" + lib + "/bin");
            }
        }
        if (fs.exists(curPwd + "/cex_boxes/cex-test") && !fs.exists(curPwd + "/cex_boxes/cext")) {
            child_process.execSync("cp -r \"" + curPwd + "/cex_boxes/cex-test\" \"" + curPwd + "/cex_boxes/cext\" 2>/dev/null || true");
        }
        if (fs.exists(curPwd + "/cex_boxes/cext") && !fs.exists(curPwd + "/cex_boxes/cex-test")) {
            child_process.execSync("cp -r \"" + curPwd + "/cex_boxes/cext\" \"" + curPwd + "/cex_boxes/cex-test\" 2>/dev/null || true");
        }
        if (fs.exists(curPwd + "/cex_boxes/cex-builder") && !fs.exists(curPwd + "/cex_boxes/builder")) {
            child_process.execSync("cp -r \"" + curPwd + "/cex_boxes/cex-builder\" \"" + curPwd + "/cex_boxes/builder\" 2>/dev/null || true");
        }
        if (fs.exists(curPwd + "/cex_boxes/builder") && !fs.exists(curPwd + "/cex_boxes/cex-builder")) {
            child_process.execSync("cp -r \"" + curPwd + "/cex_boxes/builder\" \"" + curPwd + "/cex_boxes/cex-builder\" 2>/dev/null || true");
        }
        println("==> Packages Processed: " + std::to_string(builtCount) + " configured, " + std::to_string(cachedCount) + " cached [OK]");
    }

    private void registerBinApp(string cexDir, string cxvmDir, string app, string binSrc, string ver) {
        if (binSrc.length() > 0 && fs.exists(binSrc)) {
            child_process.execSync("mkdir -p \"" + cexDir + "/" + app + "/" + ver + "\" \"" + cxvmDir + "/" + app + "/" + ver + "\"");
            child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cexDir + "/" + app + "/" + ver + "/bin\"");
            child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cxvmDir + "/" + app + "/" + ver + "/bin\"");
            child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cexDir + "/bin/" + app + "\" 2>/dev/null || true");
            if (app != "cxvm") {
                child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cxvmDir + "/bin/" + app + "\" 2>/dev/null || true");
            }
            if (fs.exists(cxvmDir + "/current/bin")) {
                child_process.execSync("ln -sf \"" + binSrc + "\" \"" + cxvmDir + "/current/bin/" + app + "\" 2>/dev/null || true");
            }
        }
    }

    private void registerBinaryApp(string cexDir, string cxvmDir, string app, string binSrc, string ver) {
        this.registerBinApp(cexDir, cxvmDir, app, binSrc, ver);
    }

    public int run() {
        println("================================================================================");
        println("    2-TEK CXVM: Quick Installer & Toolchain Environment Setup (setup.cex)       ");
        println("    Pure Cex Native Setup Window (cexr setup.cex)                               ");
        println("================================================================================");

        CxvmEngine* cxvm = new CxvmEngine();
        CxvmCommandResult* res = cxvm->setup(this.defaultVer);
        println(res->output);

        string home = child_process.execSync("printf \"%s\" \"$HOME\"");
        string curPwd = child_process.execSync("pwd | tr -d '\\n'");
        string cxvmDir = home + "/.cxvm";
        string cxmvDir = cxvmDir;
        string cexDir = home + "/.cex";

        // Directory Hierarchy
        child_process.execSync("mkdir -p \"" + cxvmDir + "/bin\" \"" + cxvmDir + "/versions\" \"" + cxvmDir + "/cache\"");
        child_process.execSync("mkdir -p \"" + cexDir + "/bin\"");

        // Rebuild and install latest native machine binary from source (src/index.cex)
        string srcIndex = "";
        if (fs.exists(curPwd + "/src/index.cex")) {
            srcIndex = curPwd + "/src/index.cex";
        }
        if (srcIndex.length() == 0 && fs.exists(curPwd + "/cxvm/src/index.cex")) {
            srcIndex = curPwd + "/cxvm/src/index.cex";
        }
        if (srcIndex.length() == 0 && fs.exists("src/index.cex")) {
            srcIndex = "src/index.cex";
        }
        if (srcIndex.length() == 0 && fs.exists("cxvm/src/index.cex")) {
            srcIndex = "cxvm/src/index.cex";
        }

        string cexpBin = "cexp";
        if (fs.exists(curPwd + "/compilers/v8-stable/.bin")) {
            cexpBin = curPwd + "/compilers/v8-stable/.bin";
        }
        if (cexpBin == "cexp" && fs.exists(curPwd + "/compilers/v8-stable/bin/v8-stable")) {
            cexpBin = curPwd + "/compilers/v8-stable/bin/v8-stable";
        }
        if (cexpBin == "cexp" && fs.exists(cxvmDir + "/bin/8.0.0/cexp-v8-stable")) {
            cexpBin = cxvmDir + "/bin/8.0.0/cexp-v8-stable";
        }
        if (cexpBin == "cexp" && fs.exists(cxvmDir + "/bin/cexp-v8-stable")) {
            cexpBin = cxvmDir + "/bin/cexp-v8-stable";
        }
        if (cexpBin == "cexp" && fs.exists(cxvmDir + "/bin/cexp")) {
            cexpBin = cxvmDir + "/bin/cexp";
        }
        if (cexpBin == "cexp" && fs.exists(cexDir + "/bin/cexp")) {
            cexpBin = cexDir + "/bin/cexp";
        }
        if (cexpBin == "cexp" && fs.exists(cexDir + "/bin/8.0.0/cexp")) {
            cexpBin = cexDir + "/bin/8.0.0/cexp";
        }

        string nativeDistBin = curPwd + "/.bin";

        // Cross-platform check: If on Darwin and cexpBin is an ELF binary, remediate to prevent exec format error
        try {
            string unameOut = child_process.execSync("uname -s 2>/dev/null | tr -d '\\n'");
            if (unameOut == "Darwin" && fs.exists(cexpBin)) {
                string fileOut = child_process.execSync("file \"" + cexpBin + "\" 2>/dev/null");
                if (fileOut.find("ELF") != std::string::npos) {
                    println("  [WARN] Linux ELF binary detected on macOS Darwin for cexp: " + cexpBin);
                    println("  [INFO] Invoking Javis autonomous cross-platform repair...");
                    string fixWrapper = "#!/usr/bin/env bash\n# Native Darwin fallback wrapper\nif [ \"$1\" = \"compile\" ] || [ \"$1\" = \"build\" ]; then\n  SRC=\"$2\"; shift 2; OUT=\"bin/app\"\n  while [ $# -gt 0 ]; do\n    if [ \"$1\" = \"-o\" ]; then OUT=\"$2\"; shift 2; else shift; fi\n  done\n  mkdir -p \"$(dirname \"$OUT\")\"\n  if command -v clang++ >/dev/null 2>&1; then exec clang++ -std=c++20 -O3 -w \"$SRC\" -o \"$OUT\"; elif command -v g++ >/dev/null 2>&1; then exec g++ -std=c++20 -O3 -w \"$SRC\" -o \"$OUT\"; fi\nfi\nexit 0\n";
                    fs.writeFile(cexDir + "/bin/8.0.0/cexp", fixWrapper);
                    child_process.execSync("chmod +x \"" + cexDir + "/bin/8.0.0/cexp\" 2>/dev/null || true");
                    cexpBin = cexDir + "/bin/8.0.0/cexp";
                }
            }
        } catch (const Error& error) { throw new Error("OPERATION_FAILED", "Caught unhandled error: " + to_string(error)); }

        if (srcIndex.length() > 0 && fs.exists(srcIndex)) {
            println("\n==> [setup.cex] Rebuilding latest native cxvm binary from source: " + srcIndex);
            try {
                child_process.execSync("CEX_LINT=0 \"" + cexpBin + "\" compile \"" + srcIndex + "\" -o \"" + nativeDistBin + "\" 2>/dev/null || true");
                child_process.execSync("chmod +x \"" + nativeDistBin + "\" 2>/dev/null || true");
                println("  [OK] Recompiled native machine binary via Cex v8: " + nativeDistBin);
            } catch (const Error& error) {
                println("  [WARN] Native compilation fallback: using existing binary if present");
            }
        }

        // Copy / Link cxvm core binaries
        string realCxvmBin = fs.exists(nativeDistBin) ? nativeDistBin : (fs.exists(cxvmDir + "/bin/cxvm") ? (cxvmDir + "/bin/cxvm") : "");
        bool isDarwin = false;
        try {
            string uOut = child_process.execSync("uname -s 2>/dev/null | tr -d '\\n'");
            if (uOut == "Darwin") isDarwin = true;
        } catch (const Error& error) { throw new Error("OPERATION_FAILED", "Caught unhandled error: " + to_string(error)); }

        if (isDarwin && realCxvmBin.length() > 0 && fs.exists(realCxvmBin)) {
            try {
                string fOut = child_process.execSync("file \"" + realCxvmBin + "\" 2>/dev/null");
            } catch (const Error& error) { throw new Error("OPERATION_FAILED", "Caught unhandled error: " + to_string(error)); }
        }

        if (realCxvmBin.length() > 0 && fs.exists(realCxvmBin)) {
            child_process.execSync("if [ -L \"" + curPwd + "/.bin\" ]; then rm -f \"" + curPwd + "/.bin\"; fi");
            child_process.execSync("cp -f \"" + realCxvmBin + "\" \"" + curPwd + "/.bin\" 2>/dev/null || true");
            child_process.execSync("chmod +x \"" + curPwd + "/.bin\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + realCxvmBin + "\" \"" + cxvmDir + "/bin/cxvm\"");
            child_process.execSync("cp -f \"" + realCxvmBin + "\" \"" + cexDir + "/bin/cxvm\"");
            child_process.execSync("chmod +x \"" + cxvmDir + "/bin/cxvm\" \"" + cexDir + "/bin/cxvm\"");
            println("  [OK] Installed latest cxvm binary to " + curPwd + "/.bin, " + cxvmDir + "/bin/cxvm and " + cexDir + "/bin/cxvm");
        }

        // Copy setup.cex into $cxvmDir/bin and $cexDir/bin for global 'cxvm setup' dispatch
        string setupSrc = fs.exists("setup.cex") ? "setup.cex" : (fs.exists("cxvm/setup.cex") ? "cxvm/setup.cex" : (fs.exists(curPwd + "/setup.cex") ? (curPwd + "/setup.cex") : ""));
        if (setupSrc.length() > 0) {
            child_process.execSync("cp -f \"" + setupSrc + "\" \"" + cxvmDir + "/bin/setup.cex\"");
            child_process.execSync("cp -f \"" + setupSrc + "\" \"" + cexDir + "/bin/setup.cex\"");
            child_process.execSync("chmod +x \"" + cxvmDir + "/bin/setup.cex\" \"" + cexDir + "/bin/setup.cex\" 2>/dev/null || true");
        }

        // Install runtime dispatchers in $CXVM_DIR/bin
        string v8Dir = cxvmDir + "/bin/8.0.0";
        string v6Dir = cxvmDir + "/bin/6.0.0";
        child_process.execSync("mkdir -p \"" + v8Dir + "/bin\" \"" + v6Dir + "/bin\"");

        // Link active default to current and v8/v6 aliases
        child_process.execSync("ln -sfn \"" + v8Dir + "\" \"" + cxvmDir + "/current\"");
        child_process.execSync("ln -sfn \"8.0.0\" \"" + cxvmDir + "/bin/v8.0.0\" 2>/dev/null || true");
        child_process.execSync("ln -sfn \"6.0.0\" \"" + cxvmDir + "/bin/v6.0.0\" 2>/dev/null || true");
        child_process.execSync("ln -sf \"" + cxvmDir + "/current/bin/cexr\" \"" + cxvmDir + "/bin/cexr\" 2>/dev/null || true");
        child_process.execSync("ln -sf \"" + cxvmDir + "/current/bin/cex\" \"" + cxvmDir + "/bin/cex\" 2>/dev/null || true");
        child_process.execSync("ln -sf \"" + cxvmDir + "/current/bin/cexp\" \"" + cxvmDir + "/bin/cexp\" 2>/dev/null || true");

        // Global ./bin/cex dispatcher script supporting 'cex setup' and delegating to cxvm/cexr
        string cexDispatcher = "#!/usr/bin/env bash\nCXVM_DIR=\"\${CXVM_DIR:-$HOME/.cxvm}\"\nif [ \"$1\" = \"setup\" ]; then\n  shift\n  CEXR_CMD=\"cexr\"\n  if [ -x \"$CXVM_DIR/bin/cexr\" ]; then\n    CEXR_CMD=\"\$CXVM_DIR/bin/cexr\"\n  elif [ -x \"$CXVM_DIR/current/bin/cexr\" ]; then\n    CEXR_CMD=\"\$CXVM_DIR/current/bin/cexr\"\n  fi\n  if [ -f \"setup.cex\" ]; then\n    exec \"\$CEXR_CMD\" setup.cex \"$@\"\n  elif [ -f \"\$CXVM_DIR/bin/setup.cex\" ]; then\n    exec \"\$CEXR_CMD\" \"\$CXVM_DIR/bin/setup.cex\" \"$@\"\n  elif [ -x \"\$CXVM_DIR/bin/cxvm\" ]; then\n    exec \"\$CXVM_DIR/bin/cxvm\" setup \"$@\"\n  fi\nfi\nif [ -x \"\$CXVM_DIR/bin/cxvm\" ]; then\n  exec \"\$CXVM_DIR/bin/cxvm\" \"$@\"\nfi\nif [ -x \"\$CXVM_DIR/bin/cexr\" ]; then\n  exec \"\$CXVM_DIR/bin/cexr\" \"$@\"\nfi\nexec cexr \"$@\"\n";
        fs.writeFile(cxvmDir + "/bin/cex", cexDispatcher);
        fs.writeFile(cexDir + "/bin/cex", cexDispatcher);
        child_process.execSync("chmod +x \"" + cxvmDir + "/bin/cex\" \"" + cexDir + "/bin/cex\" 2>/dev/null || true");

        // Register bin apps with exact version of cexr (1.0.26)
        string exactCexr = this.cexrExactVersion;
        string cexrFactorySrc = fs.exists(curPwd + "/cexr-factory/.bin") ? (curPwd + "/cexr-factory/.bin") : (fs.exists(curPwd + "/runtimes/.bin") ? (curPwd + "/runtimes/.bin") : (fs.exists(curPwd + "/runtimes/cexr-factory/.bin") ? (curPwd + "/runtimes/cexr-factory/.bin") : (fs.exists(curPwd + "/runtimes/cexr-factory/bin/cexr-factory") ? (curPwd + "/runtimes/cexr-factory/bin/cexr-factory") : (fs.exists(cxvmDir + "/bin/8.0.0/cexr") ? (cxvmDir + "/bin/8.0.0/cexr") : (cxvmDir + "/bin/cexr-factory")))));
        string cexrBeanSrc = fs.exists(curPwd + "/cexr-factory/.bin") ? (curPwd + "/cexr-factory/.bin") : (fs.exists(curPwd + "/runtimes/.bin") ? (curPwd + "/runtimes/.bin") : (fs.exists(curPwd + "/runtimes/cexr-bean/.bin") ? (curPwd + "/runtimes/cexr-bean/.bin") : (fs.exists(curPwd + "/runtimes/cexr-bean/bin/cexr-bean") ? (curPwd + "/runtimes/cexr-bean/bin/cexr-bean") : (fs.exists(cxvmDir + "/bin/cexr-bean") ? (cxvmDir + "/bin/cexr-bean") : cexrFactorySrc))));
        string cexrDeliverySrc = fs.exists(curPwd + "/cexr-factory/.bin") ? (curPwd + "/cexr-factory/.bin") : (fs.exists(curPwd + "/runtimes/.bin") ? (curPwd + "/runtimes/.bin") : (fs.exists(curPwd + "/runtimes/cexr-delivery/.bin") ? (curPwd + "/runtimes/cexr-delivery/.bin") : (fs.exists(curPwd + "/runtimes/cexr-delivery/bin/cexr-delivery") ? (curPwd + "/runtimes/cexr-delivery/bin/cexr-delivery") : (fs.exists(cxvmDir + "/bin/cexr-delivery") ? (cxvmDir + "/bin/cexr-delivery") : cexrFactorySrc))));
        string cexrDrawerSrc = fs.exists(curPwd + "/cexr-factory/.bin") ? (curPwd + "/cexr-factory/.bin") : (fs.exists(curPwd + "/runtimes/.bin") ? (curPwd + "/runtimes/.bin") : (fs.exists(curPwd + "/runtimes/cexr-drawer/.bin") ? (curPwd + "/runtimes/cexr-drawer/.bin") : (fs.exists(curPwd + "/runtimes/cexr-drawer/bin/cexr-drawer") ? (curPwd + "/runtimes/cexr-drawer/bin/cexr-drawer") : (fs.exists(cxvmDir + "/bin/cexr-drawer") ? (cxvmDir + "/bin/cexr-drawer") : cexrFactorySrc))));

        if (isDarwin) {
            string darwinCexr = fs.exists(cexDir + "/bin/8.0.0/cexr") ? (cexDir + "/bin/8.0.0/cexr") : (cxvmDir + "/bin/cexr");
            if (fs.exists(cexrFactorySrc)) {
                try {
                    string fOut = child_process.execSync("file \"" + cexrFactorySrc + "\" 2>/dev/null");
                    if (fOut.find("ELF") != std::string::npos && fs.exists(darwinCexr)) {
                        cexrFactorySrc = darwinCexr;
                        cexrBeanSrc = darwinCexr;
                        cexrDeliverySrc = darwinCexr;
                        cexrDrawerSrc = darwinCexr;
                    }
                } catch (const Error& error) { throw new Error("OPERATION_FAILED", "Caught unhandled error: " + to_string(error)); }
            }
        }

        this.registerBinApp(cexDir, cxvmDir, "cexr-factory", cexrFactorySrc, exactCexr);
        this.registerBinApp(cexDir, cxvmDir, "cexr-bean", cexrBeanSrc, exactCexr);
        this.registerBinApp(cexDir, cxvmDir, "cexr-delivery", cexrDeliverySrc, exactCexr);
        this.registerBinApp(cexDir, cxvmDir, "cexr-drawer", cexrDrawerSrc, exactCexr);

        // cexr defaults to cexr-factory
        this.registerBinApp(cexDir, cxvmDir, "cexr", cexrFactorySrc, exactCexr);

        // Register compiler and tools: cexp is a call to cexp-v8-stable
        string cexpV8StableSrc = fs.exists(curPwd + "/compilers/v8-stable/.bin") ? (curPwd + "/compilers/v8-stable/.bin") : (fs.exists(curPwd + "/compilers/v8-stable/bin/v8-stable") ? (curPwd + "/compilers/v8-stable/bin/v8-stable") : (fs.exists(home + "/Projects/cex/compilers/v8-cex-compile-cex-to-high-performance-binary/bin/8.0.0-stable/cexp-v8-stable") ? (home + "/Projects/cex/compilers/v8-cex-compile-cex-to-high-performance-binary/bin/8.0.0-stable/cexp-v8-stable") : (fs.exists(cxvmDir + "/bin/cexp-v8-stable") ? (cxvmDir + "/bin/cexp-v8-stable") : "")));
        string cexpV8Src = fs.exists(cxvmDir + "/bin/8.0.0/cexp") ? (cxvmDir + "/bin/8.0.0/cexp") : "";

        string cexpCanonicalSrc = (cexpV8StableSrc.length() > 0) ? cexpV8StableSrc : cexpV8Src;
        if (cexpCanonicalSrc.length() > 0) {
            this.registerBinApp(cexDir, cxvmDir, "cexp", cexpCanonicalSrc, this.defaultVer);
            child_process.execSync("mkdir -p \"" + v8Dir + "/bin\" \"" + cxvmDir + "/bin/8.0.0\" \"" + cxvmDir + "/versions/v8.0.0/bin\" \"" + cxvmDir + "/versions/8.0.0/bin\" \"" + cxvmDir + "/versions/v/bin\" \"" + cxvmDir + "/current/bin\" \"" + cexDir + "/bin/8.0.0\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + v8Dir + "/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/current/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/8.0.0/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/bin/8.0.0/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/versions/v8.0.0/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/versions/8.0.0/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/versions/v/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/cexp\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/bin/cexp-v8-stable\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/1.0.12/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/1.0.23/cexp\" 2>/dev/null || true");
            child_process.execSync("ln -sf \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/1.0.25/cexp\" 2>/dev/null || true");
            child_process.execSync("rm -rf \"" + cxvmDir + "/tmp/dependencies\" 2>/dev/null || true");
            if (fs.exists(curPwd + "/cexp/bin/1.0.25/cexp-v8")) {
                child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + curPwd + "/cexp/bin/1.0.25/cexp-v8\" 2>/dev/null || true");
            }
            if (fs.exists(curPwd + "/cexp/bin/cex")) {
                child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + curPwd + "/cexp/bin/cex\" 2>/dev/null || true");
            }
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/versions/v/bin/cexr\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/bin/8.0.0/cexr\" 2>/dev/null || true");
            child_process.execSync("mkdir -p \"" + cxvmDir + "/bin/8.0.0/bin\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cxvmDir + "/bin/8.0.0/bin/cexr\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/8.0.0/cexr\" 2>/dev/null || true");
            child_process.execSync("mkdir -p \"" + cexDir + "/bin/cexp-v8/8.0.0\" \"" + cexDir + "/versions\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/bin/cexp-v8/8.0.0/bin\" 2>/dev/null || true");
            child_process.execSync("cp -f \"" + cexpCanonicalSrc + "\" \"" + cexDir + "/versions/v8\" 2>/dev/null || true");

            string v7Src = curPwd + "/compilers/v7-cex-compile-cex-to-test-engine/bin/7.0.0/cexp";
            if (fs.exists(v7Src)) {
                child_process.execSync("mkdir -p \"" + cexDir + "/bin/cexp-v7/7.0.0\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + v7Src + "\" \"" + cexDir + "/bin/cexp-v7/7.0.0/bin\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + v7Src + "\" \"" + curPwd + "/compilers/v7-cex-compile-cex-to-test-engine/bin/v7\" 2>/dev/null || true");
            }
            string v1Src = curPwd + "/compilers/v1-cpp-compile-cex-to-cpp/bin/1.0.0/cexp";
            if (fs.exists(v1Src)) {
                child_process.execSync("mkdir -p \"" + cexDir + "/bin/cexp-v1/1.0.0\" \"" + cexDir + "/cexp-v1/1.0.25\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + v1Src + "\" \"" + cexDir + "/bin/cexp-v1/1.0.0/bin\" 2>/dev/null || true");
                child_process.execSync("cp -f \"" + v1Src + "\" \"" + cexDir + "/cexp-v1/1.0.25/bin\" 2>/dev/null || true");
            }

            child_process.execSync("find \"" + curPwd + "/projects\" -type f \\( -name \"cexp-v8*\" -o -name \"cexr\" -o -name \"cexr-v8\" \\) -exec cp -f \"" + cexpCanonicalSrc + "\" {} \\; 2>/dev/null || true");
            child_process.execSync("find \"" + curPwd + "/cex_boxes\" -type f \\( -name \"cexp-v8*\" -o -name \"cexr\" -o -name \"cexr-v8\" \\) -exec cp -f \"" + cexpCanonicalSrc + "\" {} \\; 2>/dev/null || true");
            child_process.execSync("find \"" + curPwd + "/cxvm/cex_boxes\" -type f \\( -name \"cexp-v8*\" -o -name \"cexr\" -o -name \"cexr-v8\" \\) -exec cp -f \"" + cexpCanonicalSrc + "\" {} \\; 2>/dev/null || true");
        }
        if (cexpCanonicalSrc.length() == 0 && fs.exists(cxvmDir + "/bin/cexp-v8-stable")) {
            this.registerBinApp(cexDir, cxvmDir, "cexp", cxvmDir + "/bin/cexp-v8-stable", this.defaultVer);
        }
        if (cexpCanonicalSrc.length() == 0 && fs.exists(cxvmDir + "/bin/cexp")) {
            this.registerBinApp(cexDir, cxvmDir, "cexp", cxvmDir + "/bin/cexp", this.defaultVer);
        }

        if (cexpV8StableSrc.length() > 0) {
            this.registerBinApp(cexDir, cxvmDir, "cexp-v8-stable", cexpV8StableSrc, this.defaultVer);
            this.registerBinApp(cexDir, cxvmDir, "v8-stable", cexpV8StableSrc, this.defaultVer);
        }
        if (cexpV8Src.length() > 0) {
            this.registerBinApp(cexDir, cxvmDir, "cexp-v8", cexpV8Src, this.defaultVer);
        }

        string packSrc = fs.exists(curPwd + "/cex_boxes/cex-pack/bin/cex-pack") ? (curPwd + "/cex_boxes/cex-pack/bin/cex-pack") : (fs.exists(cxvmDir + "/bin/cex-pack") ? (cxvmDir + "/bin/cex-pack") : "");
        if (packSrc.length() > 0) {
            this.registerBinApp(cexDir, cxvmDir, "cex-pack", packSrc, "2.0.0");
        }
        string packBeanSrc = fs.exists(cxvmDir + "/bin/cex-pack-bean") ? (cxvmDir + "/bin/cex-pack-bean") : "";
        if (packBeanSrc.length() > 0) {
            this.registerBinApp(cexDir, cxvmDir, "cex-pack-bean", packBeanSrc, "2.0.0");
        }
        string lintSrc = fs.exists(curPwd + "/cex_boxes/cex-lint/bin/cex-lint") ? (curPwd + "/cex_boxes/cex-lint/bin/cex-lint") : (fs.exists(cxvmDir + "/bin/8.0.0/cex-lint") ? (cxvmDir + "/bin/8.0.0/cex-lint") : (fs.exists(cxvmDir + "/bin/cex-lint") ? (cxvmDir + "/bin/cex-lint") : ""));
        if (lintSrc.length() > 0) {
            this.registerBinApp(cexDir, cxvmDir, "cex-lint", lintSrc, "2.0.0");
        }
        string cextSrc = fs.exists(cxvmDir + "/bin/8.0.0/cext") ? (cxvmDir + "/bin/8.0.0/cext") : (fs.exists(cxvmDir + "/bin/cext") ? (cxvmDir + "/bin/cext") : "");
        if (cextSrc.length() > 0) {
            this.registerBinApp(cexDir, cxvmDir, "cext", cextSrc, "2.0.0");
        }

        string builderSrc = fs.exists(curPwd + "/cex_boxes/cex-builder/bin/cex-builder") ? (curPwd + "/cex_boxes/cex-builder/bin/cex-builder") : (fs.exists(curPwd + "/cex_boxes/builder/bin/builder") ? (curPwd + "/cex_boxes/builder/bin/builder") : (fs.exists(cxvmDir + "/bin/cex-builder") ? (cxvmDir + "/bin/cex-builder") : ""));
        if (builderSrc.length() > 0) {
            this.registerBinApp(cexDir, cxvmDir, "cex-builder", builderSrc, "1.0.0");
            this.registerBinApp(cexDir, cxvmDir, "builder", builderSrc, "1.0.0");
        }

        // Register Integrated Cognitive AI Models: javis, vision, ultron
        string docsDir = "";
        Array<string>* candidatesDocs = new Array<string>();
        candidatesDocs->push(curPwd);
        candidatesDocs->push(curPwd + "/../documents");
        candidatesDocs->push(curPwd + "/documents");
        candidatesDocs->push(curPwd + "/../../documents");
        candidatesDocs->push(home + "/Projects/cex/documents");
        candidatesDocs->push(home + "/.cex/documents");
        candidatesDocs->push(cxvmDir + "/documents");
        for (int dIdx = 0; dIdx < (int)candidatesDocs->length(); dIdx++) {
            string dPath = candidatesDocs->get(dIdx);
            if (fs.exists(dPath + "/bin/javis")) {
                docsDir = dPath;
                break;
            }
        }
        string javisCanonical = cxvmDir + "/javis-runtime/1.1.70/bin";
        string javisSrc = fs.exists(javisCanonical) ? javisCanonical : (docsDir.length() > 0 ? (docsDir + "/bin/javis") : "");
        if (javisSrc.length() > 0) {
            this.registerBinApp(cexDir, cxvmDir, "javis", javisSrc, "1.0.0");
            this.registerBinApp(cexDir, cxvmDir, "java", javisSrc, "1.0.0");
        }
        if (docsDir.length() > 0) {
            string ultronSrc = docsDir + "/bin/ultron";
            string visionSrc = docsDir + "/bin/vision";
            string cexm2VisionSrc = docsDir + "/bin/cexm-2-vision";

            this.registerBinApp(cexDir, cxvmDir, "ultron", ultronSrc, "1.0.0");
            this.registerBinApp(cexDir, cxvmDir, "vision", visionSrc, "2.0.0");
            this.registerBinApp(cexDir, cxvmDir, "cexm-2-vision", cexm2VisionSrc, "2.0.0");
        }

        // Target build integration: CXVM_DIR/cxvm/$version/bin & {rootProjectPath}/.bin
        string pkgName = "cxvm";
        string pkgType = "bean";
        string pkgVer = "2.0.0";
        if (fs.exists("cex-pack.json")) {
            string mfRaw = fs.readFile("cex-pack.json");
            JsonValue* parsed = JsonDoc::parse(mfRaw);
            if (parsed != nullptr && parsed->has("name")) {
                string pName = parsed->get("name")->asString();
                int sPos = (int)pName.find("/");
                if (sPos != -1) {
                    pkgName = pName.substr(sPos + 1);
                } else {
                    pkgName = pName;
                }
            }
            if (parsed != nullptr && parsed->has("version")) {
                pkgVer = parsed->get("version")->asString();
            }
        }

        string targetDir = cxvmDir + "/" + pkgName + "-" + pkgType + "/" + pkgVer;
        string targetDirAlias = cxmvDir + "/" + pkgName + "-" + pkgType + "/" + pkgVer;
        string cxvmVerDir = cxvmDir + "/cxvm/" + pkgVer;
        string cxvmDefDir = cxvmDir + "/cxvm/" + this.defaultVer;

        child_process.execSync("mkdir -p \"" + targetDir + "\" \"" + targetDirAlias + "\" \"" + cxvmVerDir + "\" \"" + cxvmDefDir + "\"");

        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + curPwd + "/.bin\" 2>/dev/null || true");
        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + targetDir + "/bin\"");
        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + cxvmVerDir + "/bin\"");
        child_process.execSync("ln -sf \"" + realCxvmBin + "\" \"" + cxvmDefDir + "/bin\"");

        this.registerBinApp(cexDir, cxvmDir, "cxvm", realCxvmBin, pkgVer);

        // Configure shell profile
        if (home.length() > 0) {
            string zshrc = home + "/.zshrc";
            string bashrc = home + "/.bashrc";
            string cfg = "\n# 2-TEK CXVM: Cex Version Manager\nexport CXVM_DIR=\"" + cxvmDir + "\"\nexport PATH=\"$CXVM_DIR/bin:$CXVM_DIR/current/bin:$PATH\"\n";
            if (fs.exists(zshrc)) {
                string zContent = fs.readFile(zshrc);
                if (zContent.find("CXVM_DIR") == -1) {
                    fs.writeFile(zshrc, zContent + cfg);
                    println("[OK] Appended CXVM_DIR and PATH to " + zshrc);
                }
            }
            if (fs.exists(bashrc)) {
                string bContent = fs.readFile(bashrc);
                if (bContent.find("CXVM_DIR") == -1) {
                    fs.writeFile(bashrc, bContent + cfg);
                    println("[OK] Appended CXVM_DIR and PATH to " + bashrc);
                }
            }
        }

        CxvmCommandResult* regRes = cxvm->registerBinaryAppsInCexDir();
        println(regRes->output);

        this.setupDeps(curPwd, cexDir, cxvmDir);
        cxvm->buildModels("");
        cxvm->rebuildAndInstallBin();

        // Install Git pre-push hook for automated .bin build before push
        string prePushContent = "#!/usr/bin/env bash\n# 2-TEK CXVM: Auto build to .bin before push code (pre-push hook)\n# Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths), Rule (No Symbols)\nset -e\n\necho \"==> [git pre-push hook] Auto-building to .bin before push...\"\n\nREPO_ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"\n\nif [ -x \"$REPO_ROOT/.bin\" ]; then\n  \"$REPO_ROOT/.bin\" build || true\nelif [ -x \"$REPO_ROOT/bin/cxvm\" ]; then\n  \"$REPO_ROOT/bin/cxvm\" build || true\nelif [ -f \"$REPO_ROOT/bin/cxvm\" ]; then\n  bash \"$REPO_ROOT/bin/cxvm\" build || true\nelif [ -n \"$CXVM_DIR\" ] && [ -x \"$CXVM_DIR/bin/cxvm\" ]; then\n  \"$CXVM_DIR/bin/cxvm\" build || true\nelif [ -x \"$HOME/.cxvm/bin/cxvm\" ]; then\n  \"$HOME/.cxvm/bin/cxvm\" build || true\nelif command -v cxvm >/dev/null 2>&1; then\n  cxvm build || true\nfi\n\necho \"[OK] [git pre-push hook] Auto-build to .bin completed before push.\"\nexit 0\n";

        string gitHooksDir = child_process.execSync("git rev-parse --git-path hooks 2>/dev/null | tr -d '\\n'");
        if (gitHooksDir.length() > 0) {
            child_process.execSync("mkdir -p \"" + gitHooksDir + "\"");
            fs.writeFile(gitHooksDir + "/pre-push", prePushContent);
            child_process.execSync("chmod +x \"" + gitHooksDir + "/pre-push\" 2>/dev/null || true");
            println("[OK] Installed Git pre-push hook in " + gitHooksDir + "/pre-push");
        }
        child_process.execSync("mkdir -p \"" + curPwd + "/.githooks\"");
        fs.writeFile(curPwd + "/.githooks/pre-push", prePushContent);
        child_process.execSync("chmod +x \"" + curPwd + "/.githooks/pre-push\" 2>/dev/null || true");
        println("[OK] Configured repository Git pre-push hook in " + curPwd + "/.githooks/pre-push");

        println("\n================================================================================");
        println("    2-TEK CXVM: Installation & Setup Complete [OK]                             ");
        println("================================================================================");
        println("  CXVM Directory:    " + cxvmDir + " (alias: " + cxmvDir + ")");
        println("  cxvm Binary:       " + cxvmDir + "/bin/cxvm [READY]");
        println("  cexr Exact Version:" + this.cexrExactVersion + " (Reserve Path: CEX_DIR/cexr-factory/" + this.cexrExactVersion + "/bin)");
        println("  Integrated Build:  {rootProjectPath}/.bin (./.bin)");
        println("  Target Build cxvm: " + cxvmDir + "/cxvm/$version/bin (alias: CXMV_DIR/cxvm/$version/bin)");
        println("  Package Store:     " + curPwd + "/cex_boxes (pure cex_boxes only, zero deps)");
        println("  Git Pre-Push Hook: .git/hooks/pre-push (auto-build to .bin before push) [OK]");
        println("  Active Runtime:    CexR v" + this.defaultVer + " (Default)");
        println("  Secondary Runtime: CexR v" + this.secondaryVer + " (LTS)");
        println("  AI Models in PATH: javis (alias: java), vision, ultron integrated into $CXVM_DIR/bin & $CEX_DIR/bin [OK]");
        println("  Status:            SETUP COMPLETE [OK]");
        println("================================================================================");
        return 0;
    }
}

int main(int argc, char** argv) {
    SetupRunner* runner = new SetupRunner();
    if (argc > 1) {
        string arg1 = std::string(argv[1]);
        if (arg1 == "javis" || arg1 == "java") {
            string subArg = "";
            for (int j = 2; j < argc; j++) {
                if (j > 2) subArg += " ";
                subArg += std::string(argv[j]);
            }
            return runner->setupJavis(subArg);
        }
        if (arg1 == "models" || arg1 == "model" || arg1 == "--rebuild-models" || arg1 == "rebuild-models") {
            string subArg = "";
            for (int j = 2; j < argc; j++) {
                if (j > 2) subArg += " ";
                subArg += std::string(argv[j]);
            }
            return runner->setupModels(subArg);
        }
        for (int aIdx = 1; aIdx < argc; aIdx++) {
            string aStr = std::string(argv[aIdx]);
            if (aStr == "--force" || aStr == "-f" || aStr == "force" || aStr == "resetup") {
                runner->isForce = true;
            }
        }
    }
    return runner->run();
}
